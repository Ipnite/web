---
interface Props { lang?: "en" | "es" | "pt"; }
const { lang = "en" } = Astro.props;
const prefix = lang === "es" ? "/es" : lang === "pt" ? "/pt-br" : "";
const founderProfile = `${prefix}/rafael-betanzos-san-juan/`;
const copy = lang === "es" ? {eyebrow:"PERSONAS, EXPERIENCIA Y TECNOLOGÍA",title:["Nuestra","filosofía"],statement:"Las herramientas que antes pertenecían a unos pocos están pasando a estar al alcance de todos.",mission:"Encender el potencial del ingenio humano, protegiendo los activos que definen el futuro.",primary:"Empezar a redactar con IPnite",secondary:"Cómo funciona",team:"Un equipo conectado por la innovación",skills:"PI + producto + seguridad",roles:["Estrategia de PI","Tecnología y seguridad","Tramitación de PI"]} : lang === "pt" ? {eyebrow:"PESSOAS, EXPERIÊNCIA E TECNOLOGIA",title:["Nossa","filosofia"],statement:"As ferramentas que antes pertenciam a poucos estão cada vez mais ao alcance de todos.",mission:"Despertar o potencial da engenhosidade humana, protegendo os ativos que definem o futuro.",primary:"Começar a redigir com a IPnite",secondary:"Como funciona",team:"Uma equipe conectada pela inovação",skills:"PI + produto + segurança",roles:["Estratégia de PI","Tecnologia e segurança","Prosecução de PI"]} : {eyebrow:"PEOPLE, EXPERIENCE, AND TECHNOLOGY",title:["Our","Philosophy"],statement:"Tools that once belonged to a few are moving within reach of everyone.",mission:"Igniting the potential of human ingenuity by protecting the assets that define the future.",primary:"Start drafting with IPnite",secondary:"How It Works",team:"A team connected by innovation",skills:"IP + product + security",roles:["IP strategy","Technology and security","IP prosecution"]};
const founder={name:"Rafael Betanzos",role:copy.roles[0],image:"/images/rafael.jpg"};
---
<section class="story-hero" aria-labelledby="story-heading"><div class="story-copy"><p class="eyebrow">{copy.eyebrow}</p><h1 id="story-heading"><span>{copy.title[0]}</span> <strong>{copy.title[1]}</strong></h1><p class="statement">{copy.statement}</p><p class="mission">{copy.mission}</p><div class="actions"><a class="button primary" href="https://app.ipnite.com/" target="_blank" rel="noopener noreferrer">{copy.primary}</a><a class="button" href={`${prefix}/#how-it-works`}>{copy.secondary}</a></div></div><div class="story-visual" aria-label={copy.team}><img class="brain" src="/images/cerebro.png" alt="" aria-hidden="true"/><a class="person rafael" href={founderProfile} aria-label={`${founder.name}: ${founder.role}`}><img src={founder.image} alt={founder.name} loading="eager"/><div><strong>{founder.name}</strong><span>{founder.role}</span></div></a><div class="chip countries"><b>MX</b><b>AR</b><strong>LATAM</strong></div><div class="chip skills">{copy.skills}</div></div></section>
<style>
.story-hero{position:relative;width:min(100%,1280px);margin:0 auto;min-height:650px;display:grid;grid-template-columns:minmax(0,1.02fr) minmax(430px,.98fr);align-items:center;gap:clamp(28px,4vw,64px);isolation:isolate;overflow:hidden;border-radius:clamp(28px,3vw,50px);background:radial-gradient(circle at 86% 20%,rgba(107,42,47,.17),transparent 35%),rgba(217,217,217,.16);padding:clamp(34px,5vw,70px);box-shadow:inset 0 1px 0 rgba(255,255,255,.52),inset 0 -1px 1px rgba(0,0,0,.1)}.story-copy{position:relative;z-index:5}.eyebrow{margin:0 0 18px;color:#6b2a2f;font:900 13px/1.35 Roboto,sans-serif;letter-spacing:.13em}.story-hero h1{max-width:650px;margin:0;color:#505050;font-family:"Roboto Slab",serif;font-size:clamp(48px,5.3vw,72px);font-weight:400;letter-spacing:-.025em;line-height:1.02;text-wrap:balance}.story-hero h1 span{color:#6b2a2f}.story-hero h1 strong{font-weight:800}.statement{max-width:620px;margin:24px 0 0;font:500 clamp(18px,1.6vw,21px)/1.52 Roboto,sans-serif}.mission{max-width:620px;margin:12px 0 0;color:#6b2a2f;font:800 clamp(16px,1.35vw,18px)/1.5 Roboto,sans-serif}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.button{min-height:46px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #6b2a2f;border-radius:999px;background:#ededed;padding:10px 22px;color:#4c0815;font:800 16px/1.2 "Roboto Slab",serif;text-align:center;text-decoration:none;transition:.18s}.button.primary,.button:hover{background:#6b2a2f;color:#fff}.button:hover{transform:translateY(-2px)}.story-visual{position:relative;min-height:500px}.brain{position:absolute;inset:50% auto auto 50%;width:520px;transform:translate(-42%,-50%);opacity:.18;filter:blur(1px)}.person{position:absolute;z-index:2;overflow:hidden;border:1px solid rgba(107,42,47,.14);border-radius:24px;background:#fff;box-shadow:0 18px 38px rgba(76,8,21,.14)}.person img{width:100%;display:block;object-fit:cover;object-position:center top;background:#7d4147}.person div{padding:11px 13px 13px}.person strong,.person span{display:block;font-family:Roboto,sans-serif}.person strong{color:#4c0815;font-size:13px}.person span{margin-top:4px;color:#6e6869;font-size:10px;font-weight:700}.rafael{left:50%;top:48%;width:280px;transform:translate(-50%,-50%) rotate(-1deg)}.rafael img{height:320px}.chip{position:absolute;z-index:4;border:1px solid rgba(107,42,47,.15);border-radius:16px;background:#fff;color:#4c0815;box-shadow:0 12px 28px rgba(76,8,21,.13);font:900 12px Roboto,sans-serif}.countries{left:6px;top:32px;display:flex;align-items:center;gap:6px;padding:8px}.countries b{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:#6b2a2f;color:#fff}.countries strong{padding:0 6px}.skills{right:4px;bottom:32px;padding:13px 16px}
@media(max-width:1000px){.story-hero{grid-template-columns:1fr;padding-bottom:38px}.story-copy{text-align:center}.story-hero h1,.statement,.mission{margin-left:auto;margin-right:auto}.actions{justify-content:center}.story-visual{width:min(100%,620px);margin:0 auto}}@media(max-width:600px){.story-hero{min-height:0;padding:32px 20px 24px;border-radius:28px}.story-hero h1{font-size:clamp(43px,13vw,55px)}.statement{font-size:17px}.actions{display:grid}.button{width:100%}.story-visual{min-height:400px;margin-top:8px}.brain{width:390px}.rafael{width:210px}.rafael img{height:235px}.person div{padding:8px}.person strong{font-size:10px}.person span{font-size:8px}.chip{font-size:9px}.countries{left:-6px;top:10px}.countries b{width:28px;height:28px}.skills{right:-4px;bottom:8px;padding:10px 12px}}@media(prefers-reduced-motion:reduce){.button{transition:none}}
</style>
