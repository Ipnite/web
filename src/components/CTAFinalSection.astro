---
// Fuente: FinalCallToActionSection.tsx (Figma 4:488)
// top: 5759, height: 349
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: "Tu idea es valiosa. Protéjela",
      body: "Asegura hoy tu fecha de prioridad con un flujo serio y guiado, creado para inventores.",
      button: "Comenzar a redactar tu patente",
      buttonLabel: "Comenzar a redactar tu patente",
    }
  : lang === "pt"
  ? {
      heading: "Sua ideia é valiosa. Proteja-a",
      body: "Garanta hoje sua data de prioridade com um fluxo sério e guiado, criado para inventores.",
      button: "Comecar a redigir sua patente",
      buttonLabel: "Comecar a redigir sua patente",
    }
  : {
      heading: "Your Idea Is Valuable. Protect It",
      body: "Secure your priority date today, with a serious, guided workflow built for inventors.",
      button: "Start Drafting Your Patent",
      buttonLabel: "Start drafting your patent",
    };
---

<section
  aria-labelledby="cta-heading"
  class="relative w-full overflow-hidden bg-white"
  style="height: 349px;"
>
  <!-- Imágenes decorativas cerebro -->
  <img
    class="absolute top-0 left-0 w-[350px] h-[349px] object-cover pointer-events-none"
    alt="" aria-hidden="true"
    src="/images/cta-final.png"
    loading="lazy"
  />
  <img
    class="absolute top-[26px] left-[1052px] w-[382px] h-[323px] object-cover pointer-events-none"
    alt="" aria-hidden="true"
    src="/images/cta-final-2.png"
    loading="lazy"
  />

  <!-- Glass card -->
  <div
    class="cta-final__card absolute top-4 left-[calc(50%-656px)] w-[1313px] h-[312px] bg-[#d9d9d933] rounded-[50px] backdrop-blur-[2px]"
    style="box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 1px 0 0 rgba(255,255,255,.32),inset 0 -1px 1px rgba(0,0,0,.13),inset -1px 0 1px rgba(0,0,0,.11)"
  ></div>

  <!-- Contenido -->
  <h2 id="cta-heading" class="absolute top-[52px] left-[calc(50%-405px)] w-[810px] [font-family:'Roboto_Slab',serif] font-normal text-[#4c0815] text-5xl text-center tracking-[-0.91px] leading-[55.2px] whitespace-nowrap"><span class="font-medium">{copy.heading.split(". ")[0]}. </span><strong class="font-extrabold">{copy.heading.split(". ")[1]}</strong></h2>
  <p class="absolute top-[135px] left-[calc(50%-252px)] w-[504px] [font-family:'Roboto',sans-serif] font-medium text-[#505050] text-2xl text-center tracking-[-0.46px] leading-9">{copy.body}</p>

  <div class="cta-final__button absolute top-[241px] left-1/2 w-[333px] h-[45px] -translate-x-1/2 bg-[#ededed] rounded-[40px] border border-solid border-[#6b2a2f]">
    <a
      href="https://app.ipnite.com"
      target="_blank"
      rel="noopener noreferrer"
      class="absolute inset-0 flex items-center justify-center [font-family:'Roboto_Slab',serif] font-extrabold text-[#4c0815] text-2xl text-center tracking-[-0.46px] leading-9 underline whitespace-nowrap"
      aria-label={copy.buttonLabel}
    >
      {copy.button}
    </a>
  </div>
</section>

<style>
  section[aria-labelledby="cta-heading"] > .cta-final__button {
    width: min(420px, 90vw) !important;
    min-height: 52px !important;
    height: auto !important;
  }

  section[aria-labelledby="cta-heading"] a {
    position: relative !important;
    inset: auto !important;
    min-height: 52px;
    padding: 10px 20px;
    white-space: normal !important;
    line-height: 1.2 !important;
  }

  @media (max-width: 900px) {
    section[aria-labelledby="cta-heading"] {
      height: auto !important;
      padding: 56px 16px 68px;
      overflow: hidden;
    }

    section[aria-labelledby="cta-heading"] > .cta-final__card {
      display: none;
    }

    section[aria-labelledby="cta-heading"] > img[aria-hidden="true"] {
      opacity: 0.18;
      width: 240px !important;
      height: auto !important;
    }

    section[aria-labelledby="cta-heading"] > .absolute.top-\[52px\] {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      max-width: 420px;
      margin: 0 auto !important;
      white-space: normal !important;
      font-size: 34px !important;
      line-height: 1.12 !important;
      text-wrap: balance;
    }

    section[aria-labelledby="cta-heading"] > p {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      max-width: 420px;
      margin: 18px auto 0 !important;
      font-size: 18px !important;
      line-height: 1.45 !important;
      text-wrap: pretty;
    }

    section[aria-labelledby="cta-heading"] > .cta-final__button {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      max-width: 340px;
      min-height: 52px !important;
      height: auto !important;
      margin: 24px auto 0 !important;
      transform: none !important;
    }

    section[aria-labelledby="cta-heading"] a {
      position: relative !important;
      inset: auto !important;
      min-height: 52px;
      padding: 10px 18px;
      font-size: 18px !important;
      white-space: normal !important;
      text-align: center !important;
      line-height: 1.2 !important;
    }
  }
</style>
