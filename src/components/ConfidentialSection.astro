---
// Fuente: PricingPlanSection.tsx (Figma 102:96)
// top: 4106, height: ~200
---

<section
  aria-label="Confidential by design"
  class="relative w-full overflow-hidden bg-white"
  style="height: 236px;"
>
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-0 pt-3" style="width:1440px;margin:auto;left:0;right:0;">
    <div class="relative flex items-center">
      <!-- Ícono izquierdo -->
      <div class="confidential-icon confidential-icon--left" aria-hidden="true">
        <img alt="" src="/icons/lupa.svg" />
      </div>

      <!-- Badge principal -->
      <div class="relative w-[628px] h-[78px] flex items-center justify-center">
        <div class="absolute inset-0 bg-[#ededed] rounded-[78px]"></div>
        <h2 class="relative [font-family:'Roboto_Slab',serif] font-extrabold text-[#4c0815] text-[46.8px] text-center tracking-[1.87px] leading-[70.2px] whitespace-nowrap">
          Confidential by design
        </h2>
      </div>

      <!-- Ícono derecho -->
      <div class="confidential-icon confidential-icon--right" aria-hidden="true">
        <img alt="" src="/icons/candado.svg" />
      </div>
    </div>

    <p class="mt-6 w-[543px] [font-family:'Roboto_Slab',serif] font-normal text-[#505050] text-[25.8px] text-center tracking-[-0.49px] leading-[38.8px]">
      <span class="font-medium">We don't use your data for training, <br /></span>
      <strong class="font-bold text-[28.2px]">nor do we keep your ideas</strong>
    </p>
  </div>
</section>

<style>
  .confidential-icon {
    position: absolute;
    top: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #6b2a2f;
    border-radius: 999px;
    background: transparent;
    box-shadow: 0 8px 18px rgba(107, 42, 47, 0.10);
  }

  .confidential-icon--left { left: -64px; }
  .confidential-icon--right { right: -64px; }

  .confidential-icon img {
    width: 28px;
    height: 28px;
    display: block;
    object-fit: contain;
  }

  @media (max-width: 760px) {
    section[aria-label="Confidential by design"] {
      height: auto !important;
      padding: 46px 16px 30px;
    }

    section[aria-label="Confidential by design"] > div {
      position: relative !important;
      width: 100% !important;
      left: auto !important;
      right: auto !important;
      margin: 0 auto !important;
      padding-top: 0 !important;
    }

    .confidential-icon--left { left: -16px; }
    .confidential-icon--right { right: -16px; }
  }
</style>
