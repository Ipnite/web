---
// Fuente: ContactFormSection.tsx (Figma 4:448)
// top: 5080, height: 680
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: "Contacto",
      name: "Nombre",
      namePlaceholder: "Escribe tu nombre...",
      email: "Correo",
      emailPlaceholder: "Escribe tu correo...",
      subject: "Asunto",
      subjectPlaceholder: "Escribe el asunto...",
      message: "Mensaje",
      messagePlaceholder: "Escribe tu mensaje...",
      button: "Enviar",
      alt: "Profesional con una laptop y un cuaderno, lista para contactar a IPnite",
      note: "También puedes escribirnos directamente a",
      sending: "Enviando…",
      success: "¡Gracias! Recibimos tu mensaje y te responderemos pronto.",
      error: "No pudimos enviar tu mensaje. Inténtalo de nuevo o escríbenos a",
      salesSubject: "Plan Institucional — solicitud de información",
    }
  : lang === "pt"
  ? {
      heading: "Contato",
      name: "Nome",
      namePlaceholder: "Digite seu nome...",
      email: "E-mail",
      emailPlaceholder: "Digite seu e-mail...",
      subject: "Assunto",
      subjectPlaceholder: "Digite o assunto...",
      message: "Mensagem",
      messagePlaceholder: "Digite sua mensagem...",
      button: "Enviar",
      alt: "Profissional com um laptop e um caderno, pronta para contatar a IPnite",
      note: "Você também pode nos escrever diretamente em",
      sending: "Enviando…",
      success: "Obrigado! Recebemos sua mensagem e responderemos em breve.",
      error: "Não foi possível enviar sua mensagem. Tente novamente ou escreva para",
      salesSubject: "Plano Institucional — pedido de informações",
    }
  : {
      heading: "Contact",
      name: "Name",
      namePlaceholder: "Enter your name...",
      email: "Email",
      emailPlaceholder: "Enter your email address...",
      subject: "Subject",
      subjectPlaceholder: "Enter your subject...",
      message: "Message",
      messagePlaceholder: "Enter your message...",
      button: "Send",
      alt: "Professional holding a laptop and notebook, ready to contact IPnite",
      note: "You can also write to us directly at",
      sending: "Sending…",
      success: "Thank you! We received your message and will reply soon.",
      error: "We couldn't send your message. Please try again or write to us at",
      salesSubject: "Institutional plan — information request",
    };

// Web3Forms public access key; inline scripts can't read import.meta.env, so it travels in a hidden field.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="relative w-full overflow-hidden bg-white"
  style="height: 750px;"
>
  <div class="absolute inset-0" style="width:1440px;margin:auto;left:0;right:0;">
    <h2 id="contact-heading" class="absolute top-5 left-[187px] w-[210px] [font-family:'Roboto_Slab',serif] font-bold text-[#6b2a2f] text-5xl tracking-[0] leading-[72px] whitespace-nowrap">{copy.heading}</h2>

    <!-- Formulario -->
    <form
      class="absolute top-[123px] left-[190px] w-[425px]"
      method="post"
      action="https://api.web3forms.com/submit"
      data-analytics-form="contact"
      data-contact-form
      data-sales-subject={copy.salesSubject}
      data-sending={copy.sending}
      data-success={copy.success}
      data-error={copy.error}
    >
      <input type="hidden" name="access_key" value={web3formsKey} />
      <!-- Honeypot: real users leave this unchecked; do not remove. -->
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

      <!-- Name -->
      <div class="absolute top-0 left-0 w-[409px]">
        <label for="contact-name" class="block [font-family:'Roboto',sans-serif] font-medium text-[#4c0815] text-[21px] leading-normal">{copy.name}</label>
        <input
          id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder={copy.namePlaceholder}
          class="mt-[5px] w-[409px] h-12 rounded-full bg-white pl-5 pr-5 [font-family:'Roboto',sans-serif] text-[#4c0815] text-[21px] shadow-[0px_4px_4px_#6b2a2f0d] outline-none placeholder:text-[#adadad] border border-[#6b2a2f20] focus:border-[#6b2a2f]"
        />
      </div>

      <!-- Email -->
      <div class="absolute top-[109px] left-0 w-[409px]">
        <label for="contact-email" class="block [font-family:'Roboto',sans-serif] font-medium text-[#4c0815] text-[21px] leading-normal">{copy.email}</label>
        <input
          id="contact-email" name="email" type="email" autocomplete="email" required maxlength="160" placeholder={copy.emailPlaceholder}
          class="mt-[5px] w-[409px] h-12 rounded-full bg-white pl-5 pr-5 [font-family:'Roboto',sans-serif] text-[#4c0815] text-[21px] shadow-[0px_4px_4px_#6b2a2f0d] outline-none placeholder:text-[#adadad] border border-[#6b2a2f20] focus:border-[#6b2a2f]"
        />
      </div>

      <!-- Subject -->
      <div class="absolute top-[216px] left-0 w-[409px]">
        <label for="contact-subject" class="block [font-family:'Roboto',sans-serif] font-medium text-[#4c0815] text-[21px] leading-normal">{copy.subject}</label>
        <input
          id="contact-subject" name="subject" type="text" required maxlength="160" placeholder={copy.subjectPlaceholder}
          class="mt-[5px] w-[409px] h-12 rounded-full bg-white pl-5 pr-5 [font-family:'Roboto',sans-serif] text-[#4c0815] text-[21px] shadow-[0px_4px_4px_#0000000d] outline-none placeholder:text-[#adadad] border border-[#6b2a2f20] focus:border-[#6b2a2f]"
        />
      </div>

      <!-- Message -->
      <div class="absolute top-[320px] left-0 w-[409px]">
        <label for="contact-message" class="block [font-family:'Roboto',sans-serif] font-medium text-[#4c0815] text-[21px] leading-normal">{copy.message}</label>
        <textarea
          id="contact-message" name="message" required maxlength="3000" placeholder={copy.messagePlaceholder}
          rows="4"
          class="mt-[5px] w-[409px] h-[110px] resize-none rounded-[14px] bg-white pl-5 pr-5 pt-[11px] [font-family:'Roboto',sans-serif] text-[#4c0815] text-[21px] shadow-[0px_4px_4px_#6b2a2f0d] outline-none placeholder:text-[#adadad] border border-[#6b2a2f20] focus:border-[#6b2a2f]"
        ></textarea>
      </div>

      <!-- Send button -->
      <button
        type="submit"
        class="absolute top-[497px] left-[300px] w-[109px] h-[35px] rounded-[50px] border border-solid border-[#6b2a2f] bg-[#ededed]"
      >
        <span data-contact-button-label class="flex items-center justify-center h-full [font-family:'Roboto_Slab',serif] font-extrabold text-[#4c0815] text-2xl text-center tracking-[-0.46px] leading-9 whitespace-nowrap">
          {copy.button}
        </span>
      </button>
      <p data-contact-status role="status" aria-live="polite" class="contact-note absolute top-[548px] left-0 w-[409px] [font-family:'Roboto',sans-serif] text-[14px] leading-[1.5] text-[#505050]">
        {copy.note} <a href="mailto:info@ipnite.com" class="font-bold text-[#6b2a2f] underline">info@ipnite.com</a>.
      </p>
    </form>

    <!-- Imagen decorativa derecha -->
    <img
      class="absolute top-0 left-[810px] w-[497px] h-[588px] object-contain"
      alt={copy.alt}
      src="/images/contact.png" width="497" height="588"
      loading="lazy"
    />
  </div>
</section>

<script is:inline>
  (() => {
    const fallbackLink = '<a href="mailto:info@ipnite.com" class="font-bold text-[#6b2a2f] underline">info@ipnite.com</a>.';
    document.querySelectorAll("[data-contact-form]").forEach((form) => {
      const subject = form.querySelector("[name=subject]");
      if (subject && new URLSearchParams(window.location.search).get("plan") === "institutional" && !subject.value) {
        subject.value = form.dataset.salesSubject || "";
      }
      const button = form.querySelector("button[type=submit]");
      const label = form.querySelector("[data-contact-button-label]");
      const status = form.querySelector("[data-contact-status]");
      const buttonText = label ? label.textContent : "";
      const showError = () => {
        status.textContent = `${form.dataset.error} `;
        status.insertAdjacentHTML("beforeend", fallbackLink);
      };
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.checkValidity() || button.disabled) return;
        const data = new FormData(form);
        if (data.get("botcheck")) return;
        const value = (key) => String(data.get(key) || "").trim();
        button.disabled = true;
        if (label) label.textContent = form.dataset.sending;
        try {
          if (!value("access_key")) throw new Error("Missing PUBLIC_WEB3FORMS_KEY");
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              access_key: value("access_key"),
              name: value("name"),
              email: value("email"),
              subject: value("subject"),
              message: value("message"),
              botcheck: false,
            }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.success) throw new Error(result.message || `HTTP ${response.status}`);
          form.reset();
          status.textContent = form.dataset.success;
          window.ipniteAnalytics?.track("generate_lead", { form_name: "contact" });
        } catch (error) {
          console.warn("[IPnite Contact]", error);
          showError();
        } finally {
          button.disabled = false;
          if (label) label.textContent = buttonText;
        }
      });
    });
  })();
</script>

<style>
  @media (max-width: 1320px) {
    #contact {
      height: auto !important;
      overflow: visible !important;
      padding: 48px 16px 64px;
    }

    #contact > div {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px !important;
      display: grid;
      gap: 24px;
    }

    #contact-heading,
    #contact form,
    #contact form > div,
    #contact form button,
    #contact > div > img {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
    }

    #contact-heading {
      margin: 0;
      text-align: center;
      font-size: 42px !important;
      line-height: 1.1 !important;
      white-space: normal !important;
    }

    #contact form {
      display: grid;
      gap: 16px;
      order: 2;
    }

    #contact form label {
      font-size: 16px !important;
    }

    #contact input,
    #contact textarea {
      width: 100% !important;
      font-size: 16px !important;
      padding-left: 18px !important;
    }

    #contact textarea {
      min-height: 118px;
    }

    #contact .contact-note {
      position: relative !important;
      top: auto !important;
      width: 100% !important;
      margin: 0;
      text-align: center;
    }

    #contact form button {
      justify-self: center;
      width: 132px !important;
      height: 42px !important;
      margin-top: 4px;
    }

    #contact form button span {
      font-size: 20px !important;
    }

    #contact > div > img {
      order: 1;
      max-width: 300px;
      margin: 0 auto;
      display: block;
    }
  }

  @media (min-width: 761px) and (max-width: 1320px) {
    #contact {
      padding: 56px clamp(24px, 5vw, 64px) 72px;
    }

    #contact > div {
      max-width: 960px !important;
      margin: 0 auto;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
      column-gap: 56px;
      align-items: center;
    }

    #contact-heading {
      grid-column: 1 / -1;
      text-align: left;
    }

    #contact form {
      order: 1;
    }

    #contact > div > img {
      order: 2;
      max-width: 380px;
    }
  }
</style>
