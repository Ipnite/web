---
import { marketPricing, type MarketCode } from "../config/pricing";

interface Props { lang?: "en" | "es" | "pt"; }
const { lang = "en" } = Astro.props;
const labels = lang === "es"
  ? { label: "País o región", select: "Seleccionar país o región" }
  : lang === "pt"
  ? { label: "País ou região", select: "Selecionar país ou região" }
  : { label: "Country or region", select: "Select country or region" };
const order: MarketCode[] = ["US", "MX", "AR", "BR", "LATAM"];
---

<label class="country-selector">
  <span>{labels.label}</span>
  <select aria-label={labels.select} data-country-selector>
    {order.map((code) => <option value={code}>{marketPricing[code].countryLabel[lang]}</option>)}
  </select>
</label>

<script is:inline>
  (() => {
    const supportedMarkets = new Set(["US", "MX", "AR", "BR", "LATAM"]);
    const defaultMarkets = { en: "US", es: "LATAM", pt: "BR" };
    const htmlLang = document.documentElement.lang;
    const currentLocale = htmlLang === "pt-BR" ? "pt" : htmlLang.startsWith("es") ? "es" : "en";
    document.querySelectorAll("[data-country-selector]").forEach((select) => {
      let stored = "";
      try { stored = localStorage.getItem("ipnite_market") || ""; } catch (error) {}
      const marketLocale = stored === "US" ? "en" : stored === "BR" ? "pt" : "es";
      const market = supportedMarkets.has(stored) && marketLocale === currentLocale ? stored : defaultMarkets[currentLocale];
      select.value = market;
      select.addEventListener("change", () => {
        const nextMarket = select.value;
        try { localStorage.setItem("ipnite_market", nextMarket); } catch (error) {}

        // The market also determines the site's language: US → English,
        // LATAM/MX/AR → Spanish, and BR → Portuguese. Localized URLs differ per
        // language, so the page's own hreflang alternates give the destination.
        const nextLocale = nextMarket === "US" ? "en" : nextMarket === "BR" ? "pt" : "es";
        if (nextLocale === currentLocale) return;
        const hreflang = nextLocale === "pt" ? "pt-BR" : nextLocale;
        const alternate = document.querySelector(`link[rel="alternate"][hreflang="${hreflang}"]`);
        const fallback = nextLocale === "es" ? "/es/" : nextLocale === "pt" ? "/pt-br/" : "/";
        const target = alternate ? new URL(alternate.href).pathname : fallback;
        window.location.assign(`${target}${window.location.hash}`);
      });
    });
  })();
</script>

<style>
  .country-selector{display:flex;align-items:center;gap:8px;color:#6b2a2f;font-family:"Roboto Slab",serif;font-size:13px;font-weight:700;white-space:nowrap}
  .country-selector select{max-width:200px;border:1px solid rgba(107,42,47,.3);border-radius:999px;background:#fff;color:#4c0815;padding:6px 28px 6px 11px;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer}
  .country-selector select:focus-visible{outline:3px solid rgba(107,42,47,.25);outline-offset:2px}
  @media(max-width:1120px){.country-selector{justify-self:center;flex-direction:column}.country-selector select{max-width:220px}}
</style>
