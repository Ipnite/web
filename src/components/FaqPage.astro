---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface TrustCard {
  title: string;
  body: string;
}

interface Props {
  lang?: string;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath: string;
  keywords?: string;
  heroLabel: string;
  heroPill: string;
  heroHeading: string;
  heroSubtitle: string;
  heroLead: string;
  primaryActionLabel: string;
  listActionLabel: string;
  howItWorksLabel: string;
  noteStrong: string;
  noteText: string;
  visualNodeOne: string;
  visualNodeTwo: string;
  visualNodeThree: string;
  visualNodeFour: string;
  visualCenterLabel: string;
  listPill: string;
  listHeading: string;
  listIntro: string;
  trustPill: string;
  trustHeading: string;
  trustCards: TrustCard[];
  ctaHeading: string;
  ctaText: string;
  ctaButtonLabel: string;
  faqs: FaqItem[];
}

const {
  lang,
  title,
  description,
  canonicalPath,
  alternatePath,
  keywords,
  heroLabel,
  heroPill,
  heroHeading,
  heroSubtitle,
  heroLead,
  primaryActionLabel,
  listActionLabel,
  howItWorksLabel,
  noteStrong,
  noteText,
  visualNodeOne,
  visualNodeTwo,
  visualNodeThree,
  visualNodeFour,
  visualCenterLabel,
  listPill,
  listHeading,
  listIntro,
  trustPill,
  trustHeading,
  trustCards,
  ctaHeading,
  ctaText,
  ctaButtonLabel,
  faqs,
} = Astro.props;

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  keywords={keywords}
  structuredData={faqStructuredData}
>
  <section class="faq-page">
    <div class="faq-glow faq-glow-left" aria-hidden="true"></div>
    <div class="faq-glow faq-glow-right" aria-hidden="true"></div>

    <section class="faq-hero" aria-labelledby="faq-heading">
      <p class="faq-pill">{heroPill}</p>
      <h1 id="faq-heading">{heroHeading}</h1>
      <p class="faq-subtitle">{heroSubtitle}</p>
      <p class="faq-lead">{heroLead}</p>
      <div class="faq-actions">
        <a href="https://app.ipnite.com/" target="_blank" rel="noopener" class="faq-button faq-button-primary">{primaryActionLabel}</a>
        <a href="#faq-list" class="faq-button faq-button-secondary">{listActionLabel}</a>
        <a href="/#how-it-works" class="faq-button faq-button-secondary">{howItWorksLabel}</a>
      </div>
      <div class="faq-note">
        <span aria-hidden="true">!</span>
        <p>
          <strong>{noteStrong}</strong> {noteText}
        </p>
      </div>
      <PageHeroImage label={heroLabel} />
    </section>

    <section class="faq-visual" aria-label={heroPill}>
      <div class="faq-line faq-line-one" aria-hidden="true"></div>
      <div class="faq-line faq-line-two" aria-hidden="true"></div>
      <div class="faq-line faq-line-three" aria-hidden="true"></div>
      <div class="faq-line faq-line-four" aria-hidden="true"></div>
      <div class="faq-node faq-node-one">{visualNodeOne}</div>
      <div class="faq-node faq-node-two">{visualNodeTwo}</div>
      <div class="faq-node faq-node-three">{visualNodeThree}</div>
      <div class="faq-node faq-node-four">{visualNodeFour}</div>
      <div class="faq-center">
        <strong>?</strong>
        <span>{visualCenterLabel}</span>
      </div>
    </section>

    <section id="faq-list" class="faq-list-section" aria-labelledby="faq-list-heading">
      <div class="faq-section-head">
        <p class="faq-pill">{listPill}</p>
        <h2 id="faq-list-heading">{listHeading}</h2>
        <p>{listIntro}</p>
      </div>

      <div class="faq-list">
        {faqs.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span class="faq-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="faq-question">{item.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="faq-trust" aria-labelledby="faq-trust-heading">
      <div class="faq-section-head">
        <p class="faq-pill">{trustPill}</p>
        <h2 id="faq-trust-heading">{trustHeading}</h2>
      </div>
      <div class="trust-grid">
        {trustCards.map((card) => (
          <article>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="faq-cta" aria-labelledby="faq-cta-heading">
      <h2 id="faq-cta-heading">{ctaHeading}</h2>
      <p>{ctaText}</p>
      <a href="https://app.ipnite.com/" target="_blank" rel="noopener" class="faq-button">{ctaButtonLabel}</a>
    </section>
  </section>
</BaseLayout>

<style>
  .faq-page {
    position: relative;
    overflow: hidden;
    background: #fff;
    color: #505050;
    font-family: "Roboto", sans-serif;
    padding: 0 24px 84px;
  }

  .faq-glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 999px;
    background: rgba(107, 42, 47, 0.12);
    filter: blur(130px);
    pointer-events: none;
  }

  .faq-glow-left {
    left: -230px;
    top: 210px;
  }

  .faq-glow-right {
    right: -250px;
    top: 920px;
  }

  .faq-hero,
  .faq-visual,
  .faq-list-section,
  .faq-trust,
  .faq-cta {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .faq-hero {
    min-height: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 78px 0 52px;
  }

  .faq-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 33px;
    background: #6b2a2f;
    color: #ededed;
    font-family: "Roboto Slab", serif;
    font-size: 15px;
    font-weight: 800;
    line-height: 1;
    padding: 10px 20px;
    text-transform: uppercase;
  }

  .faq-section-head .faq-pill {
    color: #ededed;
    font-size: 15px;
    line-height: 1;
  }

  .faq-hero h1,
  .faq-section-head h2,
  .faq-cta h2 {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-weight: 800;
    letter-spacing: 0;
  }

  .faq-hero h1 {
    max-width: 940px;
    font-size: clamp(56px, 8vw, 98px);
    line-height: 0.98;
  }

  .faq-subtitle {
    max-width: 880px;
    margin: 24px auto 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 600;
    line-height: 1.12;
  }

  .faq-lead,
  .faq-section-head p,
  .faq-answer p,
  .trust-grid p,
  .faq-cta p {
    color: #505050;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.65;
  }

  .faq-lead {
    max-width: 780px;
    margin: 24px auto 0;
  }

  .faq-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 34px;
  }

  .faq-button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 40px;
    border: 1px solid #6b2a2f;
    background: #ededed;
    color: #4c0815;
    padding: 0 26px;
    font-family: "Roboto Slab", serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    text-decoration: underline;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }

  .faq-button-secondary {
    background: #fff;
  }

  .faq-button:hover {
    transform: translateY(-3px);
    background: #6b2a2f;
    color: #fff;
    box-shadow: 0 18px 38px rgba(107, 42, 47, 0.15);
  }

  .faq-note {
    max-width: 820px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 24px auto 0;
    border: 1px solid rgba(154, 106, 32, 0.24);
    border-radius: 22px;
    background: #fff8e8;
    padding: 14px 16px;
    text-align: left;
  }

  .faq-note span {
    width: 24px;
    height: 24px;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(154, 106, 32, 0.12);
    color: #9a6a20;
    font-weight: 900;
  }

  .faq-note p {
    margin: 0;
    color: #9a6a20;
    font-size: 14px;
    line-height: 1.55;
  }

  .faq-note strong {
    color: #9a6a20;
  }

  .faq-visual {
    min-height: 270px;
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 40px;
    background:
      linear-gradient(rgba(107, 42, 47, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(107, 42, 47, 0.045) 1px, transparent 1px),
      #fff;
    background-size: 36px 36px;
    box-shadow: 0 26px 60px rgba(107, 42, 47, 0.09);
  }

  .faq-node {
    position: absolute;
    width: 122px;
    height: 78px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(107, 42, 47, 0.16);
    border-radius: 24px;
    background: #fff;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.05);
  }

  .faq-node-one { left: 8%; top: 22%; }
  .faq-node-two { right: 9%; top: 22%; }
  .faq-node-three { left: 18%; bottom: 16%; }
  .faq-node-four { right: 18%; bottom: 16%; }

  .faq-center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170px;
    height: 170px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(107, 42, 47, 0.22);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 18px rgba(107, 42, 47, 0.035), 0 26px 52px rgba(0, 0, 0, 0.06);
    transform: translate(-50%, -50%);
  }

  .faq-center strong {
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
  }

  .faq-center span {
    margin-top: 8px;
    color: #938d8e;
    font-family: "Roboto Slab", serif;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .faq-line {
    position: absolute;
    height: 2px;
    background: rgba(107, 42, 47, 0.16);
  }

  .faq-line-one { left: 22%; top: 38%; width: 28%; transform: rotate(10deg); }
  .faq-line-two { left: 50%; top: 38%; width: 28%; transform: rotate(-10deg); }
  .faq-line-three { left: 28%; top: 64%; width: 24%; transform: rotate(-12deg); }
  .faq-line-four { left: 50%; top: 64%; width: 24%; transform: rotate(12deg); }

  .faq-list-section,
  .faq-trust {
    padding: 82px 0 0;
  }

  .faq-section-head {
    max-width: 820px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .faq-section-head h2,
  .faq-cta h2 {
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.12;
  }

  .faq-section-head p:last-child {
    margin: 18px auto 0;
  }

  .faq-list {
    max-width: 1000px;
    display: grid;
    gap: 14px;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.028);
    overflow: hidden;
  }

  .faq-item summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 22px 24px;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-number {
    color: rgba(107, 42, 47, 0.38);
    font-family: "Roboto Slab", serif;
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
  }

  .faq-question {
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.25;
  }

  .faq-icon {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(107, 42, 47, 0.08);
    color: #6b2a2f;
    font-weight: 900;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .faq-item[open] .faq-icon {
    background: #6b2a2f;
    color: #fff;
    transform: rotate(45deg);
  }

  .faq-answer {
    margin: 0 24px;
    border-top: 1px solid rgba(107, 42, 47, 0.12);
    padding: 18px 0 24px 62px;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .trust-grid article {
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 30px;
    background: #fff;
    padding: 28px;
    text-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.028);
  }

  .trust-grid h3 {
    margin: 0;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 30px;
    font-weight: 800;
  }

  .trust-grid p {
    margin: 14px 0 0;
    font-size: 16px;
  }

  .faq-cta {
    margin-top: 84px;
    border-radius: 40px;
    background: #6b2a2f;
    padding: 64px 28px;
    text-align: center;
  }

  .faq-cta h2,
  .faq-cta p {
    color: #fff;
  }

  .faq-cta p {
    max-width: 760px;
    margin: 18px auto 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .faq-cta .faq-button {
    margin-top: 28px;
    border-color: #fff;
    background: #fff;
    color: #4c0815;
  }

  @media (max-width: 980px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .faq-page {
      padding: 0 14px 58px;
    }

    .faq-hero {
      min-height: auto;
      padding: 58px 0 42px;
    }

    .faq-hero h1 {
      font-size: 50px;
    }

    .faq-subtitle {
      font-size: 30px;
    }

    .faq-actions {
      gap: 10px;
    }

    .faq-button {
      width: 100%;
      max-width: 330px;
      font-size: 16px;
    }

    .faq-note {
      flex-direction: column;
    }

    .faq-visual {
      min-height: 290px;
      border-radius: 28px;
    }

    .faq-node {
      width: 92px;
      height: 62px;
      border-radius: 20px;
      font-size: 11px;
    }

    .faq-line {
      display: none;
    }

    .faq-center {
      width: 128px;
      height: 128px;
    }

    .faq-center strong {
      font-size: 48px;
    }

    .faq-node-one { left: 4%; top: 15%; }
    .faq-node-two { right: 4%; top: 15%; }
    .faq-node-three { left: 6%; bottom: 12%; }
    .faq-node-four { right: 6%; bottom: 12%; }

    .faq-list-section,
    .faq-trust {
      padding-top: 54px;
    }

    .faq-section-head h2,
    .faq-cta h2 {
      font-size: 38px;
    }

    .faq-item summary {
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      padding: 18px;
    }

    .faq-number {
      font-size: 28px;
    }

    .faq-question {
      font-size: 18px;
    }

    .faq-answer {
      margin: 0 18px;
      padding: 16px 0 20px;
    }

    .faq-cta {
      margin-top: 58px;
      border-radius: 28px;
      padding: 48px 20px;
    }
  }
</style>
