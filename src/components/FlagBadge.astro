---
interface Props {
  country: "Mexico" | "Argentina";
  label?: string;
}

const { country, label } = Astro.props;
const displayLabel = label ?? country;
---

<span class="flag-badge" title={displayLabel} aria-label={displayLabel}>
  {country === "Mexico" ? (
    <svg viewBox="0 0 3 2" width="20" height="14" role="img" aria-hidden="true">
      <rect width="1" height="2" x="0" fill="#006847" />
      <rect width="1" height="2" x="1" fill="#ffffff" />
      <rect width="1" height="2" x="2" fill="#ce1126" />
      <circle cx="1.5" cy="1" r="0.28" fill="#006847" />
    </svg>
  ) : (
    <svg viewBox="0 0 3 2" width="20" height="14" role="img" aria-hidden="true">
      <rect width="3" height="2" fill="#ffffff" />
      <rect width="3" height="0.6" y="0" fill="#74acdf" />
      <rect width="3" height="0.6" y="1.4" fill="#74acdf" />
      <circle cx="1.5" cy="1" r="0.22" fill="#f6b40e" />
    </svg>
  )}
  <span>{displayLabel}</span>
</span>

<style>
  .flag-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #505050;
    font-size: 13px;
    font-weight: 600;
  }

  .flag-badge svg {
    flex-shrink: 0;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(107, 42, 47, 0.15);
  }
</style>
