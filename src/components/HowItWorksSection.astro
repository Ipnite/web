---
// Fuente: ProcessOverviewSection.tsx (Figma 4:348)
// top: 3232, height: 648
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      title: ["Como funciona", "IPnite"],
      subtitle: "Cuatro pasos",
      alt: "Ilustración del flujo de redacción de patentes",
      step1: "Describe tu invención",
      step2: "Los agentes analizan la estructura y las referencias",
      step3: "Se genera el borrador de patente",
      step4: "Revisa y exporta el documento o continúa con la presentación",
    }
  : lang === "pt"
  ? {
      title: ["Como funciona", "a IPnite"],
      subtitle: "Fluxo em quatro passos",
      alt: "Ilustração do fluxo de redação de patentes",
      step1: "Descreva sua invenção",
      step2: "Os agentes analisam a estrutura e as referências",
      step3: "O rascunho da patente é gerado",
      step4: "Revise e exporte o documento ou continue com o depósito",
    }
  : {
      title: ["How It Works", ""],
      subtitle: "Four-step Workflow",
      alt: "Illustration of the patent drafting workflow",
      step1: "Describe your invention",
      step2: "Agents analyze the structure and references",
      step3: "The patent draft is generated",
      step4: "Review and export the document or continue with the filing",
    };
---

<section
  id="how-it-works"
  aria-labelledby="hiw-heading"
  class="relative w-full overflow-hidden bg-white"
  style="height: 648px;"
>
  <div class="absolute inset-0" style="width:1440px;margin:auto;left:0;right:0;">
    <!-- Título -->
    <h2
      id="hiw-heading"
      class="absolute top-[11px] left-[calc(50%-214px)] w-[429px] [font-family:'Roboto_Slab',serif] text-[#6b2a2f] text-[64px] tracking-[0] leading-[96px] whitespace-nowrap"
    >
      <span class="font-normal">{copy.title[0]}</span>
      {copy.title[1] ? <strong class="font-bold">{copy.title[1]}</strong> : null}
    </h2>

    <p class="absolute top-[105px] left-[calc(50%-111px)] w-[222px] [font-family:'Roboto',sans-serif] font-bold italic text-[#505050] text-2xl text-center tracking-[-0.46px] leading-9 whitespace-nowrap">
      {copy.subtitle}
    </p>

    <!-- Ilustración izquierda -->
    <img
      class="absolute top-[93px] left-[120px] w-[522px] h-[480px] object-contain"
      alt={copy.alt}
      src="/images/how-it-works.png"
      loading="lazy"
    />

    <!-- Pasos (grid 2x2) -->
    <div class="absolute top-[215px] left-[636px] w-[614px] h-[294px]">
      <!-- Paso 1: Describe -->
      <article class="absolute top-0 left-0 w-[304px] h-[140px]" aria-label="Step 1">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] border border-[#f0ebe9] shadow-[0_5px_12px_rgba(107,42,47,0.18)]"></div>
        <span class="absolute top-[84px] left-[30px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#3f3f46] text-[18px] text-center tracking-[-0.38px] leading-[24px] whitespace-nowrap">
          {copy.step1}
        </span>
        <div class="hiw-step__icon absolute top-0 left-[121px] w-[62px] h-[62px] rounded-full flex items-center justify-center" aria-hidden="true">
          <span>1</span>
        </div>
      </article>

      <!-- Paso 2: Analyze -->
      <article class="absolute top-0 left-[312px] w-[304px] h-[140px]" aria-label="Step 2">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] border border-[#f0ebe9] shadow-[0_5px_12px_rgba(107,42,47,0.18)]"></div>
        <p class="absolute top-[72px] left-[30px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#3f3f46] text-[18px] text-center tracking-[-0.38px] leading-[24px]">
          <span class="font-normal">{copy.step2}</span>
        </p>
        <div class="hiw-step__icon absolute top-0 left-[121px] w-[62px] h-[62px] rounded-full flex items-center justify-center" aria-hidden="true">
          <span>2</span>
        </div>
      </article>

      <!-- Paso 3: Generated -->
      <article class="absolute top-[154px] left-0 w-[304px] h-[140px]" aria-label="Step 3">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] border border-[#f0ebe9] shadow-[0_5px_12px_rgba(107,42,47,0.18)]"></div>
        <p class="absolute top-[74px] left-[31px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#3f3f46] text-[18px] text-center tracking-[-0.38px] leading-[24px]">
          <span class="font-normal">{copy.step3}</span>
        </p>
        <div class="hiw-step__icon absolute top-0 left-[121px] w-[62px] h-[62px] rounded-full flex items-center justify-center" aria-hidden="true">
          <span>3</span>
        </div>
      </article>

      <!-- Paso 4: Review & Export -->
      <article class="absolute top-[154px] left-[312px] w-[304px] h-[140px]" aria-label="Step 4">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] border border-[#f0ebe9] shadow-[0_5px_12px_rgba(107,42,47,0.18)]"></div>
        <p class="absolute top-[62px] left-[30px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#3f3f46] text-[18px] text-center tracking-[-0.38px] leading-[24px]">
          <span class="font-normal">{copy.step4}</span>
        </p>
        <div class="hiw-step__icon absolute top-0 left-[121px] w-[62px] h-[62px] rounded-full flex items-center justify-center" aria-hidden="true">
          <span>4</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .hiw-step__icon {
    background: #6b2a2f;
    border: 2px solid #6b2a2f;
    box-shadow: 0 8px 18px rgba(107, 42, 47, 0.10);
  }

  .hiw-step__icon span {
    color: #fff;
    font-family: "Roboto Slab", serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    #how-it-works {
      height: auto !important;
      overflow: visible !important;
      padding: 48px 16px 58px;
    }

    #how-it-works > div {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px !important;
      display: grid;
      gap: 14px;
    }

    #hiw-heading,
    #how-it-works > div > p,
    #how-it-works > div > img,
    #how-it-works > div > div {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
    }

    #hiw-heading {
      margin: 0 !important;
      text-align: center;
      font-size: 42px !important;
      line-height: 1.08 !important;
      white-space: normal !important;
    }

    #how-it-works > div > p {
      margin: 0 auto 8px;
      font-size: 18px !important;
      line-height: 1.35 !important;
      white-space: normal !important;
    }

    #how-it-works > div > img {
      max-width: 310px;
      margin: 0 auto 6px;
      display: block;
    }

    #how-it-works > div > div {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #how-it-works article {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 96px;
      display: grid;
      grid-template-columns: 52px 1fr;
      align-items: center;
      gap: 14px;
      padding: 16px 18px;
      border-radius: 26px;
      border: 1px solid #f0ebe9;
      background: #fff;
      box-shadow: 0 5px 12px rgba(107, 42, 47, 0.18);
    }

    #how-it-works article > div:first-child:not(.hiw-step__icon) {
      display: none !important;
    }

    #how-it-works .hiw-step__icon {
      grid-column: 1;
      grid-row: 1;
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 52px !important;
      height: 52px !important;
    }

    #how-it-works .hiw-step__icon span {
      font-size: 24px !important;
    }

    #how-it-works article > span,
    #how-it-works article > p {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      grid-column: 2;
      grid-row: 1;
      font-size: 14px !important;
      line-height: 1.35 !important;
      letter-spacing: 0 !important;
      white-space: normal !important;
      text-align: left !important;
      color: #2b2b2f !important;
      font-weight: 400 !important;
      margin: 0 !important;
      align-self: center;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }

    #how-it-works article > p > span {
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }
  }
</style>
