---
interface Props { lang?: "en" | "es" | "pt"; }
const { lang = "en" } = Astro.props;
import { routeFor, type RouteKey } from "../data/routes";
const copy = lang === "es" ? {
  title: "Cómo funciona el Redactor",
  lead: "De tu invención a una solicitud estructurada para revisión.",
  cards: [["Describe tu invención", "Explica el problema técnico, la solución y sus variantes.", "invention-disclosure"], ["Reivindicaciones", "Define las características que quieres proteger.", "ai-drafting"], ["Descripción", "Desarrolla la explicación técnica y el resumen.", "patent-specification"], ["Dibujos", "Acompaña el texto con figuras de referencia.", "drawings"], ["Revisión de calidad", "Revisa la coherencia y el formato del borrador.", "patent-quality-review"], ["Exportación", "Obtén el documento para revisión y presentación.", "patent-export"]],
} : lang === "pt" ? {
  title: "Como funciona o The Drafter",
  lead: "Da sua invenção a um pedido estruturado para revisão.",
  cards: [["Descreva sua invenção", "Explique o problema técnico, a solução e suas variantes.", "invention-disclosure"], ["Reivindicações", "Defina as características que deseja proteger.", "ai-drafting"], ["Relatório descritivo", "Desenvolva a explicação técnica e o resumo.", "patent-specification"], ["Desenhos", "Complemente o texto com figuras de referência.", "drawings"], ["QA", "Revise a coerência e a formatação do rascunho.", "patent-quality-review"], ["Exportação", "Obtenha o documento para revisão e depósito.", "patent-export"]],
} : {
  title: "How The Drafter works",
  lead: "From your invention to a structured application ready for review.",
  cards: [["Describe your invention", "Explain the technical problem, solution, and alternatives.", "invention-disclosure"], ["Claims", "Define the features you want to protect.", "ai-drafting"], ["Specification", "Develop the technical description and abstract.", "patent-specification"], ["Drawings", "Support the text with reference figures.", "drawings"], ["QA", "Review the consistency and formatting of the draft.", "patent-quality-review"], ["Export", "Get the document for review and filing.", "patent-export"]],
};
const productEvents: Record<string, { cta: string; event?: string }> = {
  "prior-art": { cta: "prior_art_search", event: "prior_art_search_clicked" },
  "ai-drafting": { cta: "ai_patent_drafting", event: "start_drafting_clicked" },
  drawings: { cta: "patent_drawings", event: "patent_drawing_clicked" },
  "invention-disclosure": { cta: "invention_disclosure", event: "start_drafting_clicked" },
  "patent-specification": { cta: "patent_specification", event: "start_drafting_clicked" },
  "patent-quality-review": { cta: "patent_quality_review", event: "start_drafting_clicked" },
  "patent-export": { cta: "patent_export", event: "start_drafting_clicked" },
  portfolio: { cta: "patent_portfolio_management", event: "portfolio_management_clicked" },
};

const imageAlt = lang === "es" ? "Ilustración del flujo de trabajo de patentes" : lang === "pt" ? "Ilustração do fluxo de trabalho de patentes" : "Illustration of the patent workflow";
---

<section id="how-it-works" aria-labelledby="hiw-heading" class="relative w-full overflow-hidden bg-white" data-analytics-location="platform_overview">
  <div class="absolute inset-0" style="width:1440px;margin:auto;left:0;right:0;">
    <h2 id="hiw-heading" class="text-center [font-family:'Roboto_Slab',serif] text-[#6b2a2f]">{copy.title}</h2>
    <p class="hiw-lead">{copy.lead}</p>
    <img class="object-contain" alt={imageAlt} src="/images/how-it-works.png" width="522" height="480" loading="lazy" />
    <div class="hiw-steps">
      {copy.cards.map(([title, body, key], index) => (
        <article aria-labelledby={`hiw-step-${index + 1}`}>
          <p>
            <strong id={`hiw-step-${index + 1}`} class="hiw-step__title">{title}</strong>
            <span>{body}</span>
            {key && <a class="hiw-step__link" href={routeFor(key as RouteKey, lang)} data-analytics-cta={productEvents[key].cta} data-analytics-event={productEvents[key].event}>
              {lang === "es" ? "Conocer la herramienta" : lang === "pt" ? "Conhecer a ferramenta" : "Explore the tool"} →
            </a>}
          </p>
          <div class="hiw-step__icon rounded-full flex items-center justify-center" aria-hidden="true"><span>{index + 1}</span></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>

  .hiw-step__title { display: block; margin-bottom: 8px; color: #6b2a2f; }
  .hiw-step__note { display: block; margin-top: 6px; }
  .hiw-step__link { display: block; margin-top: 12px; color: #4c0815; font-weight: 700; }
  #how-it-works > div > p.hiw-lead { font: 500 19px/1.6 Roboto, sans-serif !important; color: #505050; }

  @media (min-width: 1280px) {
    #how-it-works { padding: 48px 16px 58px; }
    #how-it-works > div {
      position: relative; width: min(100%, 1200px) !important;
      display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: 28px 40px; align-items: center;
    }
    #hiw-heading { grid-column: 1 / -1; margin: 0 auto; max-width: 960px; font-size: 56px; line-height: 1.16; text-wrap: balance; }
    .hiw-lead { grid-column: 1 / -1; max-width: 830px; margin: 0 auto; text-align: center; }
    #how-it-works img { width: 100%; height: auto; }
    .hiw-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
    #how-it-works article { position: relative; margin-top: 31px; padding: 46px 20px 22px; border-radius: 31px; border: 1px solid #f0ebe9; background: #fff; box-shadow: 0 5px 12px rgba(107,42,47,.18); }
    #how-it-works article p { margin: 0; text-align: center; color: #3f3f46; font: 400 16px/1.4 Roboto, sans-serif; }
    #how-it-works .hiw-step__icon { position: absolute; top: -31px; left: calc(50% - 31px); width: 62px; height: 62px; }
  }

  .hiw-step__icon {
    background: #6b2a2f;
    border: 2px solid #6b2a2f;
    box-shadow: 0 8px 18px rgba(107, 42, 47, 0.10);
  }

  .hiw-step__icon span {
    color: #fff;
    font-family: "Roboto Slab", serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 1279px) {
    #how-it-works {
      height: auto !important;
      overflow: visible !important;
      padding: 48px 16px 58px;
    }

    #how-it-works > div {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 520px !important;
      display: grid;
      gap: 14px;
    }

    #hiw-heading,
    #how-it-works > div > p,
    #how-it-works > div > img,
    #how-it-works > div > div {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      transform: none !important;
    }

    #hiw-heading {
      margin: 0 !important;
      text-align: center;
      font-size: clamp(38px, 10vw, 42px) !important;
      line-height: 1.08 !important;
      white-space: normal !important;
    }

    #how-it-works > div > p {
      margin: 0 auto 8px;
      font-size: clamp(24px, 6.5vw, 28px) !important;
      line-height: 1.2 !important;
      text-align: center;
      white-space: normal !important;
    }

    #how-it-works > div > img {
      max-width: 310px;
      margin: 0 auto 6px;
      display: block;
    }

    #how-it-works > div > div {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #how-it-works article {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 96px;
      display: grid;
      grid-template-columns: 52px 1fr;
      align-items: center;
      gap: 14px;
      padding: 16px 18px;
      border-radius: 26px;
      border: 1px solid #f0ebe9;
      background: #fff;
      box-shadow: 0 5px 12px rgba(107, 42, 47, 0.18);
    }

    #how-it-works article > div:first-child:not(.hiw-step__icon) {
      display: none !important;
    }

    #how-it-works .hiw-step__icon {
      grid-column: 1;
      grid-row: 1;
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 52px !important;
      height: 52px !important;
    }

    #how-it-works .hiw-step__icon span {
      font-size: 24px !important;
    }

    #how-it-works article > span,
    #how-it-works article > p {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      grid-column: 2;
      grid-row: 1;
      font-size: 14px !important;
      line-height: 1.35 !important;
      letter-spacing: 0 !important;
      white-space: normal !important;
      text-align: left !important;
      color: #2b2b2f !important;
      font-weight: 400 !important;
      margin: 0 !important;
      align-self: center;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }

    #how-it-works article > p > span {
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }
  }

  @media (min-width: 901px) and (max-width: 1279px) {
    #how-it-works {
      padding: 56px clamp(24px, 5vw, 64px) 64px;
    }

    #how-it-works > div {
      max-width: 1080px !important;
      margin: 0 auto;
      grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
      column-gap: 40px;
      align-items: center;
    }

    #hiw-heading,
    #how-it-works > div > p {
      grid-column: 1 / -1;
    }

    #how-it-works > div > img {
      max-width: 400px;
      margin: 0 auto;
    }

    #how-it-works > div > div {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #how-it-works article > span,
    #how-it-works article > p {
      font-size: 16px !important;
    }
  }
</style>
