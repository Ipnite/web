---
interface Props { lang?: "en" | "es" | "pt"; }
const { lang = "en" } = Astro.props;
import { routeFor, type RouteKey } from "../data/routes";
const copy = lang === "es" ? {
  eyebrow: "UNA PLATAFORMA INTEGRAL DE PATENTES", title: "Del descubrimiento a la cartera de propiedad intelectual",
  lead: "IPnite conecta las tareas esenciales del trabajo de patentes para que inventores, startups y profesionales de PI pasen de la idea a una solicitud lista para presentar, con contexto y control.",
  cards: [["Búsqueda de antecedentes","Investiga referencias relevantes y organiza los hallazgos antes de redactar.","prior-art"],["Redacción con IA","Convierte la divulgación técnica en reivindicaciones y un borrador estructurado.","ai-drafting"],["Presentación asistida","Recibe asistencia para preparar la presentación de tu solicitud de patente.","filing","Disponible en jurisdicciones seleccionadas"],["Gestión de cartera","Mantén solicitudes, documentos, fechas y alertas en un solo espacio.","portfolio"]],
} : lang === "pt" ? {
  eyebrow: "UMA PLATAFORMA INTEGRADA DE PATENTES", title: "Da descoberta ao portfólio de propriedade intelectual",
  lead: "A IPnite conecta as tarefas essenciais do trabalho de patentes para que inventores, startups e profissionais de PI passem da ideia a um pedido pronto para depósito, com contexto e controle.",
  cards: [["Busca de anterioridade","Pesquise referências relevantes e organize os resultados antes de redigir.","prior-art"],["Redação com IA","Transforme a divulgação técnica em reivindicações e um rascunho estruturado.","ai-drafting"],["Depósito assistido","Receba assistência para preparar o depósito do seu pedido de patente.","filing","Disponível em jurisdições selecionadas"],["Gestão de portfólio","Mantenha pedidos, documentos, prazos e alertas em um só espaço.","portfolio"]],
} : {
  eyebrow: "A COMPLETE PATENT WORKFLOW", title: "From discovery to intellectual property portfolio",
  lead: "IPnite connects the essential parts of patent work so inventors, startups, and IP professionals can move from idea to filing-ready application with context and control.",
  cards: [["Prior-art search","Investigate relevant references and organize findings before drafting.","prior-art"],["AI-assisted drafting","Turn a technical disclosure into claims and a structured application draft.","ai-drafting"],["Assisted filing","Get assistance preparing to file your patent application.","filing","For selected jurisdictions"],["Portfolio management","Keep applications, documents, deadlines, and alerts in one workspace.","portfolio"]],
};
const productEvents: Record<string, { cta: string; event?: string }> = {
  "prior-art": { cta: "prior_art_search", event: "prior_art_search_clicked" },
  "ai-drafting": { cta: "ai_patent_drafting", event: "start_drafting_clicked" },
  filing: { cta: "assisted_filing" },
  portfolio: { cta: "patent_portfolio_management", event: "portfolio_management_clicked" },
};

const imageAlt = lang === "es" ? "Ilustración del flujo de trabajo de patentes" : lang === "pt" ? "Ilustração do fluxo de trabalho de patentes" : "Illustration of the patent workflow";
---

<section id="how-it-works" aria-labelledby="hiw-heading" class="relative w-full overflow-hidden bg-white" data-analytics-location="platform_overview">
  <div class="absolute inset-0" style="width:1440px;margin:auto;left:0;right:0;">
    <h2 id="hiw-heading" class="text-center [font-family:'Roboto_Slab',serif] text-[#6b2a2f]">{copy.title}</h2>
    <p class="hiw-lead">{copy.lead}</p>
    <img class="object-contain" alt={imageAlt} src="/images/how-it-works.png" width="522" height="480" loading="lazy" />
    <div class="hiw-steps">
      {copy.cards.map(([title, body, key, note], index) => (
        <article aria-labelledby={`hiw-step-${index + 1}`}>
          <p>
            <strong id={`hiw-step-${index + 1}`} class="hiw-step__title">{title}</strong>
            <span>{body}</span>
            {note && <small class="hiw-step__note">({note})</small>}
            <a class="hiw-step__link" href={key === "filing" ? "https://app.ipnite.com" : routeFor(key as RouteKey, lang)} data-analytics-cta={productEvents[key].cta} data-analytics-event={productEvents[key].event}>
              {lang === "es" ? "Conocer la herramienta" : lang === "pt" ? "Conhecer a ferramenta" : "Explore the tool"} →
            </a>
          </p>
          <div class="hiw-step__icon rounded-full flex items-center justify-center" aria-hidden="true"><span>{index + 1}</span></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>

  .hiw-step__title { display: block; margin-bottom: 8px; color: #6b2a2f; }
  .hiw-step__note { display: block; margin-top: 6px; }
  .hiw-step__link { display: block; margin-top: 12px; color: #4c0815; font-weight: 700; }
  #how-it-works > div > p.hiw-lead { font: 500 19px/1.6 Roboto, sans-serif !important; color: #505050; }

  @media (min-width: 1280px) {
    #how-it-works { padding: 48px 16px 58px; }
    #how-it-works > div {
      position: relative; width: min(100%, 1200px) !important;
      display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: 28px 40px; align-items: center;
    }
    #hiw-heading { grid-column: 1 / -1; margin: 0 auto; max-width: 960px; font-size: 56px; line-height: 1.16; text-wrap: balance; }
    .hiw-lead { grid-column: 1 / -1; max-width: 830px; margin: 0 auto; text-align: center; }
    #how-it-works img { width: 100%; height: auto; }
    .hiw-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
    #how-it-works article { position: relative; margin-top: 31px; padding: 46px 20px 22px; border-radius: 31px; border: 1px solid #f0ebe9; background: #fff; box-shadow: 0 5px 12px rgba(107,42,47,.18); }
    #how-it-works article p { margin: 0; text-align: center; color: #3f3f46; font: 400 16px/1.4 Roboto, sans-serif; }
    #how-it-works .hiw-step__icon { position: absolute; top: -31px; left: calc(50% - 31px); width: 62px; height: 62px; }
  }

  .hiw-step__icon {
    background: #6b2a2f;
    border: 2px solid #6b2a2f;
    box-shadow: 0 8px 18px rgba(107, 42, 47, 0.10);
  }

  .hiw-step__icon span {
    color: #fff;
    font-family: "Roboto Slab", serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 1279px) {
    #how-it-works {
      height: auto !important;
      overflow: visible !important;
      padding: 48px 16px 58px;
    }

    #how-it-works > div {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 520px !important;
      display: grid;
      gap: 14px;
    }

    #hiw-heading,
    #how-it-works > div > p,
    #how-it-works > div > img,
    #how-it-works > div > div {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      transform: none !important;
    }

    #hiw-heading {
      margin: 0 !important;
      text-align: center;
      font-size: clamp(38px, 10vw, 42px) !important;
      line-height: 1.08 !important;
      white-space: normal !important;
    }

    #how-it-works > div > p {
      margin: 0 auto 8px;
      font-size: clamp(24px, 6.5vw, 28px) !important;
      line-height: 1.2 !important;
      text-align: center;
      white-space: normal !important;
    }

    #how-it-works > div > img {
      max-width: 310px;
      margin: 0 auto 6px;
      display: block;
    }

    #how-it-works > div > div {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #how-it-works article {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 96px;
      display: grid;
      grid-template-columns: 52px 1fr;
      align-items: center;
      gap: 14px;
      padding: 16px 18px;
      border-radius: 26px;
      border: 1px solid #f0ebe9;
      background: #fff;
      box-shadow: 0 5px 12px rgba(107, 42, 47, 0.18);
    }

    #how-it-works article > div:first-child:not(.hiw-step__icon) {
      display: none !important;
    }

    #how-it-works .hiw-step__icon {
      grid-column: 1;
      grid-row: 1;
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 52px !important;
      height: 52px !important;
    }

    #how-it-works .hiw-step__icon span {
      font-size: 24px !important;
    }

    #how-it-works article > span,
    #how-it-works article > p {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      grid-column: 2;
      grid-row: 1;
      font-size: 14px !important;
      line-height: 1.35 !important;
      letter-spacing: 0 !important;
      white-space: normal !important;
      text-align: left !important;
      color: #2b2b2f !important;
      font-weight: 400 !important;
      margin: 0 !important;
      align-self: center;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }

    #how-it-works article > p > span {
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }
  }

  @media (min-width: 901px) and (max-width: 1279px) {
    #how-it-works {
      padding: 56px clamp(24px, 5vw, 64px) 64px;
    }

    #how-it-works > div {
      max-width: 1080px !important;
      margin: 0 auto;
      grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
      column-gap: 40px;
      align-items: center;
    }

    #hiw-heading,
    #how-it-works > div > p {
      grid-column: 1 / -1;
    }

    #how-it-works > div > img {
      max-width: 400px;
      margin: 0 auto;
    }

    #how-it-works > div > div {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #how-it-works article > span,
    #how-it-works article > p {
      font-size: 16px !important;
    }
  }
</style>
