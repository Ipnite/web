---
// Fuente: ProcessOverviewSection.tsx (Figma 4:348)
// top: 3232, height: 648
---

<section
  id="how-it-works"
  aria-labelledby="hiw-heading"
  class="relative w-full overflow-hidden bg-white"
  style="height: 648px;"
>
  <div class="absolute inset-0" style="width:1440px;margin:auto;left:0;right:0;">
    <!-- Título -->
    <h2
      id="hiw-heading"
      class="absolute top-[11px] left-[calc(50%-214px)] w-[429px] [font-family:'Roboto_Slab',serif] text-[#6b2a2f] text-[64px] tracking-[0] leading-[96px] whitespace-nowrap"
    >
      <span class="font-normal">How It </span>
      <strong class="font-bold">Works</strong>
    </h2>

    <p class="absolute top-[105px] left-[calc(50%-111px)] w-[222px] [font-family:'Roboto',sans-serif] font-bold italic text-[#505050] text-2xl text-center tracking-[-0.46px] leading-9 whitespace-nowrap">
      Four-step Workflow
    </p>

    <!-- Ilustración izquierda -->
    <img
      class="absolute top-[93px] left-[120px] w-[522px] h-[480px] object-contain"
      alt="Illustration of the patent drafting workflow"
      src="/images/how-it-works.png"
      loading="lazy"
    />

    <!-- Pasos (grid 2x2) -->
    <div class="absolute top-[215px] left-[636px] w-[614px] h-[294px]">
      <!-- Paso 1: Describe -->
      <article class="absolute top-0 left-0 w-[304px] h-[140px]" aria-label="Step 1">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] shadow-[0px_4.8px_4.8px_#8c595e0d]"></div>
        <span class="absolute top-[84px] left-[30px] w-[242px] [font-family:'Roboto',sans-serif] font-medium text-[#505050] text-xl text-center tracking-[-0.38px] leading-[23px] whitespace-nowrap">
          Describe your invention
        </span>
        <div class="absolute top-0 left-[121px] w-[62px] h-[62px] bg-[#6b2a2f] rounded-full flex items-center justify-center" aria-hidden="true">
          <img class="w-[18px] h-[30px]" alt="" src="/icons/step-1.svg" />
        </div>
      </article>

      <!-- Paso 2: Analyze -->
      <article class="absolute top-0 left-[312px] w-[304px] h-[140px]" aria-label="Step 2">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] shadow-[0px_4.8px_4.8px_#8c595e0d]"></div>
        <p class="absolute top-[72px] left-[30px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#505050] text-xl text-center tracking-[-0.38px] leading-[23px]">
          <span class="font-medium">Agents </span>
          <strong class="font-semibold">analyze </strong>
          <span class="font-medium">the structure and references</span>
        </p>
        <div class="absolute top-0 left-[121px] w-[62px] h-[62px] bg-[#6b2a2f] rounded-full flex items-center justify-center" aria-hidden="true">
          <img class="w-[22px] h-[31px]" alt="" src="/icons/step-2.svg" />
        </div>
      </article>

      <!-- Paso 3: Generated -->
      <article class="absolute top-[154px] left-0 w-[304px] h-[140px]" aria-label="Step 3">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] shadow-[0px_4.8px_4.8px_#8c595e0d]"></div>
        <p class="absolute top-[74px] left-[31px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#505050] text-xl text-center tracking-[-0.38px] leading-[23px]">
          <span class="font-medium">The patent draft is </span>
          <strong class="font-semibold">generated</strong>
        </p>
        <div class="absolute top-0 left-[121px] w-[62px] h-[62px] bg-[#6b2a2f] rounded-full flex items-center justify-center" aria-hidden="true">
          <img class="w-[22px] h-[31px]" alt="" src="/icons/step-3.svg" />
        </div>
      </article>

      <!-- Paso 4: Review & Export -->
      <article class="absolute top-[154px] left-[312px] w-[304px] h-[140px]" aria-label="Step 4">
        <div class="absolute top-[39px] left-0 w-[302px] h-[101px] bg-white rounded-[31px] shadow-[0px_4.8px_4.8px_#8c595e0d]"></div>
        <p class="absolute top-[62px] left-[30px] w-[242px] [font-family:'Roboto',sans-serif] font-normal text-[#505050] text-xl text-center tracking-[-0.38px] leading-[23px]">
          <strong class="font-semibold">Review and export the document</strong>
          <span class="font-medium"> or continue <br />with the filing</span>
        </p>
        <div class="absolute top-0 left-[121px] w-[62px] h-[62px] bg-[#6b2a2f] rounded-full flex items-center justify-center" aria-hidden="true">
          <img class="w-[22px] h-[30px]" alt="" src="/icons/step-4.svg" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  @media (max-width: 760px) {
    #how-it-works {
      height: auto !important;
      overflow: visible !important;
      padding: 48px 16px 58px;
    }

    #how-it-works > div {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px !important;
      display: grid;
      gap: 14px;
    }

    #hiw-heading,
    #how-it-works > div > p,
    #how-it-works > div > img,
    #how-it-works > div > div {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
    }

    #hiw-heading {
      margin: 0 !important;
      text-align: center;
      font-size: 42px !important;
      line-height: 1.08 !important;
      white-space: normal !important;
    }

    #how-it-works > div > p {
      margin: 0 auto 8px;
      font-size: 18px !important;
      line-height: 1.35 !important;
      white-space: normal !important;
    }

    #how-it-works > div > img {
      max-width: 310px;
      margin: 0 auto 6px;
      display: block;
    }

    #how-it-works > div > div {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #how-it-works article {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 94px;
      display: grid;
      grid-template-columns: 52px 1fr;
      align-items: center;
      gap: 14px;
      padding: 16px 18px;
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 14px 30px rgba(107, 42, 47, 0.07);
    }

    #how-it-works article > div:first-child {
      display: none;
    }

    #how-it-works article > div:last-child {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 52px !important;
      height: 52px !important;
      grid-column: 1;
      grid-row: 1;
    }

    #how-it-works article > span,
    #how-it-works article > p {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      grid-column: 2;
      grid-row: 1;
      font-size: 15px !important;
      line-height: 1.35 !important;
      letter-spacing: 0 !important;
      white-space: normal !important;
      text-align: left !important;
    }
  }
</style>
