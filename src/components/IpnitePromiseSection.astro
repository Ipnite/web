---
// Fuente: index.tsx sección "The Ipnite Promise" (Figma 4:221)
// Posición Figma: top-1454, height-626
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      badge: "POR QUÉ LO HACEMOS",
      heading: "El sueño de Ipnite",
      missionLabel: "Nuestra misión",
      mission: "Encender el potencial de la ingeniosidad humana asegurando los activos que definen el futuro.",
      visionLabel: "Nuestra visión",
      vision: "Un mundo donde cada creador tenga las herramientas para proteger su brillo.",
      alt: "El sueño de Ipnite",
    }
  : lang === "pt"
  ? {
      badge: "POR QUE FAZEMOS ISSO",
      heading: "O sonho da Ipnite",
      missionLabel: "Nossa missão",
      mission: "Despertar o potencial da engenhosidade humana garantindo os ativos que definem o futuro.",
      visionLabel: "Nossa visão",
      vision: "Um mundo onde cada criador tenha as ferramentas para proteger seu brilho.",
      alt: "O sonho da Ipnite",
    }
  : {
      badge: "WHY WE DO IT",
      heading: "The Ipnite Dream",
      missionLabel: "Our Mission",
      mission: "To ignite the potential of human ingenuity by securing the assets that define the future.",
      visionLabel: "Our Vision",
      vision: "A world where every creator has the tools to protect their brilliance.",
      alt: "The Ipnite Dream",
    };
---

<section
  aria-labelledby="promise-heading"
  class="relative w-full overflow-hidden bg-white"
  style="height: 568px;"
>
  <!-- Gradiente izquierdo -->
  <div
    class="absolute top-[710px] left-10 w-[464px] h-[433px] bg-[#6b2a2f66] rounded-[50%] blur-[42.72px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="absolute inset-0 w-[1440px] mx-auto">
    <div class="promise-copy absolute top-[20px] left-[82px] w-[620px] h-[548px] flex flex-col justify-center gap-6">
      <h2 id="promise-heading" class="text-[64px] leading-[1.08] text-left">
        <span class="font-normal text-[#6b2a2f]">{lang === "es" ? "El sueño de" : lang === "pt" ? "O sonho da" : "The Ipnite"}</span>
        <strong class="promise-heading__punch font-bold text-[#505050]">{lang === "en" ? "Dream" : "IPnite"}</strong>
      </h2>
      <div class="promise-copy__body w-[511px] flex flex-col gap-8">
        <p class="text-[#505050] text-xl leading-[1.55]">
          <strong class="font-bold text-[#6b2a2f]">{copy.missionLabel}</strong>
          {" "}{copy.mission}
        </p>
        <p class="text-[#505050] text-xl leading-[1.55]">
          <strong class="font-bold text-[#6b2a2f]">{copy.visionLabel}</strong>
          {" "}{copy.vision}
        </p>
      </div>
    </div>

    <!-- Imagen derecha -->
    <div class="absolute top-[20px] left-[926px] w-[462px] h-[560px]">
      <img
        class="absolute top-0 left-0 z-10 w-[500px] h-[562px] object-contain"
        alt={copy.alt}
        src="/images/the-ipnite-dream.png"
        loading="lazy"
      />
    </div>

  </div>
</section>

<style>
  .promise-heading__punch { margin-left: 0.18em; }
  .promise-copy h2 { margin: 0; font-family: "Roboto Slab", serif; }
  .promise-copy__body { font-family: "Roboto", sans-serif; }
  @media (max-width: 900px) {
    .promise-copy { height: auto !important; gap: 24px; }
    .promise-copy__body { width: 100% !important; }

    section[aria-labelledby="promise-heading"] {
      height: auto !important;
      padding: 56px 16px 72px;
      overflow: hidden;
    }

    section[aria-labelledby="promise-heading"] > .absolute.inset-0.w-\[1440px\].mx-auto {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin: 0 auto !important;
    }

    section[aria-labelledby="promise-heading"] > .absolute.inset-0.w-\[1440px\].mx-auto > * {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
    }

    section[aria-labelledby="promise-heading"] h2 {
      font-size: 42px !important;
      line-height: 1.12 !important;
    }

    section[aria-labelledby="promise-heading"] h2 + div {
      width: 100% !important;
    }

    section[aria-labelledby="promise-heading"] p {
      font-size: 18px !important;
      line-height: 1.55 !important;
    }

    section[aria-labelledby="promise-heading"] .absolute.top-\[20px\].left-\[926px\] {
      display: none;
    }
  }
</style>
