---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      eyebrow: "JURISDICCIONES",
      title: "Donde IPnite puede usarse hoy",
      body: "Un mapamundi editorial que muestra las jurisdicciones activas con foco en America, sin romper la estetica de la landing.",
      countLabel: "jurisdicciones",
    }
  : {
      eyebrow: "JURISDICTIONS",
      title: "Where IPnite can be used today",
      body: "An editorial world map that shows the active jurisdictions with a focus on the Americas, without breaking the landing aesthetic.",
      countLabel: "jurisdictions",
    };

const chips = [
  { label: "US", class: "us", x: "24%", y: "36%" },
  { label: "Mexico", class: "mexico", x: "27%", y: "48%" },
  { label: "Argentina", class: "argentina", x: "42%", y: "78%" },
  { label: "Brasil", class: "brazil", x: "48%", y: "66%" },
  { label: "PCT", class: "pct", x: "70%", y: "16%" },
  { label: "EPO", class: "epo", x: "67%", y: "33%" },
];
---

<section class="jurisdictions" aria-labelledby="jurisdictions-heading">
  <div class="jurisdictions__inner">
    <div class="jurisdictions__copy">
      <div class="jurisdictions__eyebrow">{copy.eyebrow}</div>
      <h2 id="jurisdictions-heading">{copy.title}</h2>
      <p>{copy.body}</p>
    </div>

    <div class="jurisdictions__visual" aria-label={copy.title}>
      <div class="jurisdictions__stage">
        <svg class="jurisdictions__svg" viewBox="0 0 1200 760" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="mapGlow" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="rgba(123,29,44,0.10)" />
              <stop offset="100%" stop-color="rgba(123,29,44,0.02)" />
            </linearGradient>
          </defs>

          <rect x="48" y="42" width="1104" height="676" rx="40" fill="#fff" stroke="rgba(123,29,44,0.08)" />
          <circle cx="600" cy="380" r="250" fill="url(#mapGlow)" opacity=".55" />

          <circle cx="600" cy="380" r="292" fill="none" stroke="rgba(123,29,44,0.16)" stroke-width="2" />
          <circle cx="600" cy="380" r="242" fill="none" stroke="rgba(123,29,44,0.10)" stroke-width="1.4" />
          <circle cx="600" cy="380" r="202" fill="none" stroke="rgba(123,29,44,0.10)" stroke-width="1.4" />
          <ellipse cx="600" cy="380" rx="292" ry="210" fill="none" stroke="rgba(123,29,44,0.10)" stroke-width="1.3" />
          <ellipse cx="600" cy="380" rx="248" ry="292" fill="none" stroke="rgba(123,29,44,0.08)" stroke-width="1.3" />
          <ellipse cx="600" cy="380" rx="182" ry="292" fill="none" stroke="rgba(123,29,44,0.08)" stroke-width="1.3" />

          <path d="M306 178c65-34 147-42 204-19 46 19 61 56 53 93-7 32-29 53-51 71-28 23-40 45-36 71 4 29-12 59-47 75-34 16-82 15-118 2-29-10-49-28-66-48-19-22-31-50-28-81 3-34 19-65 41-88 17-17 29-33 48-50Z" fill="#6b2a2f" fill-opacity=".22" stroke="#6b2a2f" stroke-opacity=".28" stroke-width="2.2" />
          <path d="M451 205c41 14 74 41 95 73 18 27 24 59 21 95-2 32-16 62-39 88-20 22-29 44-31 70-3 31 6 57 25 83 10 14 15 23 15 35 0 18-12 30-28 36-19 8-41 7-61 2-28-8-50-25-69-47-29-33-46-74-49-119-4-57 11-113 45-164 24-36 49-61 76-72Z" fill="#6b2a2f" fill-opacity=".18" stroke="#6b2a2f" stroke-opacity=".22" stroke-width="2" />

          <path d="M774 164c53 0 108 17 140 51 28 30 32 71 21 102-12 33-34 53-53 73-20 21-29 45-28 73 1 31 15 56 38 80 22 24 30 50 26 79-3 30-20 51-46 63-31 15-66 13-101 7-39-7-74-26-104-53-25-24-41-48-48-76-6-24-2-50 11-75 12-23 25-43 31-64 8-27 3-54-3-79-7-26-13-56 2-89 15-34 52-65 114-72Z" fill="rgba(123,29,44,0.10)" stroke="rgba(123,29,44,0.20)" stroke-width="2" />
          <path d="M901 192c39 6 67 22 90 46 20 21 28 44 28 69 0 27-8 49-23 68-14 18-25 34-28 56-3 21 2 40 17 58 14 17 31 26 46 36 17 11 27 27 27 47 0 26-16 46-41 56-24 10-49 8-71 5-29-4-53-17-77-35-29-22-44-47-47-76-2-24 4-47 16-70 11-20 18-37 17-58-1-27-11-46-22-67-13-23-19-48-8-74 15-37 59-61 104-61Z" fill="none" stroke="rgba(123,29,44,0.20)" stroke-width="2" />
          <path d="M808 443c35 3 61 17 78 36 14 16 20 35 17 53-2 19-14 37-33 52-19 16-42 24-65 25-24 2-46-5-64-19-17-13-24-31-19-49 4-17 17-31 31-43 15-13 25-24 31-36 7-14 15-21 24-19Z" fill="#6b2a2f" fill-opacity=".14" stroke="#6b2a2f" stroke-opacity=".20" stroke-width="2" />

          <path d="M710 528c24 17 39 38 43 63 4 27-2 51-15 70-13 18-32 31-55 37-25 7-47 6-66-2-18-8-30-22-34-39-4-18 1-35 10-51 9-16 18-28 22-41 4-12 12-22 25-30 15-9 41-11 70-7Z" fill="#6b2a2f" fill-opacity=".20" stroke="#6b2a2f" stroke-opacity=".24" stroke-width="2" />

          <path d="M101 250c26 10 43 24 54 43 13 23 16 47 10 74-6 27-22 48-45 61-23 13-50 16-75 9-22-6-38-18-45-36-7-17-5-35 6-53 12-20 21-37 24-54 3-18 12-34 27-46 13-11 28-14 44-8Z" fill="rgba(123,29,44,0.06)" stroke="rgba(123,29,44,0.12)" stroke-width="2" />

          <path d="M253 468c18 8 31 20 38 37 8 18 7 34 1 51-6 16-18 30-34 40-16 10-33 14-51 11-18-3-31-11-39-24-8-13-9-27-4-40 5-12 13-21 20-29 8-9 13-17 15-26 2-11 8-19 18-23 11-5 24-5 36-1Z" fill="rgba(123,29,44,0.16)" stroke="rgba(123,29,44,0.20)" stroke-width="2" />

          <path d="M988 546c20 5 35 14 45 29 10 14 13 30 10 46-3 16-12 31-27 42-14 11-31 17-48 18-17 1-31-4-42-13-11-9-16-22-14-36 2-13 9-25 18-34 10-9 16-18 18-27 2-10 8-17 18-21 8-4 16-5 22-4Z" fill="rgba(123,29,44,0.08)" stroke="rgba(123,29,44,0.14)" stroke-width="2" />

          <path d="M170 268h890M145 380h910M178 492h850" stroke="rgba(123,29,44,0.10)" stroke-width="1.3" fill="none" />
          <path d="M344 130c-25 53-38 119-38 250 0 126 13 195 38 245M600 96c0 84 0 199 0 570M856 130c25 53 38 119 38 250 0 126-13 195-38 245" stroke="rgba(123,29,44,0.08)" stroke-width="1.2" fill="none" />
        </svg>

        <div class="jurisdictions__count-wrap">
          <strong class="jurisdictions__count" data-jurisdictions-count="6">0</strong>
          <span>{copy.countLabel}</span>
        </div>

        {chips.map((chip) => (
          <div
            class={`jurisdictions__chip jurisdictions__chip--${chip.class}`}
            style={`left:${chip.x};top:${chip.y};`}
            data-analytics-label={`Jurisdiction ${chip.label}`}
          >
            <span>{chip.label}</span>
          </div>
        ))}

        <div class="jurisdictions__legend jurisdictions__legend--left">
          <span>US</span>
          <span>Mexico</span>
          <span>Argentina</span>
          <span>Brasil</span>
        </div>

        <div class="jurisdictions__legend jurisdictions__legend--right">
          <span>PCT</span>
          <span>EPO</span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.currentScript && document.currentScript.closest('.jurisdictions');
      if (!root) return;

      var counter = root.querySelector('[data-jurisdictions-count]');
      if (counter && 'IntersectionObserver' in window) {
        var started = false;
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting || started) return;
            started = true;
            var end = parseInt(counter.getAttribute('data-jurisdictions-count') || '6', 10);
            var current = 0;
            var steps = 24;
            var tick = function () {
              current += 1;
              counter.textContent = String(Math.min(end, Math.ceil((current / steps) * end)));
              if (current < steps) window.requestAnimationFrame(tick);
            };
            window.requestAnimationFrame(tick);
            observer.disconnect();
          });
        }, { threshold: 0.35 });

        observer.observe(root);
      } else if (counter) {
        counter.textContent = '6';
      }
    })();
  </script>
</section>

<style>
  .jurisdictions {
    position: relative;
    overflow: hidden;
    background: #fff;
    padding: 18px clamp(18px, 5vw, 80px) 100px;
  }

  .jurisdictions__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.86fr 1.14fr;
    gap: 28px;
    align-items: center;
  }

  .jurisdictions__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 18px;
    border-radius: 999px;
    background: #6b2a2f;
    color: #ededed;
    font-family: "Roboto Slab", serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .jurisdictions__copy h2 {
    margin: 12px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 800;
    line-height: 1.08;
  }

  .jurisdictions__copy p {
    margin: 18px 0 0;
    max-width: 540px;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.6;
  }

  .jurisdictions__visual {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jurisdictions__stage {
    position: relative;
    width: min(100%, 760px);
    aspect-ratio: 1.45 / 1;
  }

  .jurisdictions__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .jurisdictions__count-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 176px;
    height: 176px;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid rgba(107, 42, 47, 0.22);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(4px);
    box-shadow:
      0 0 0 18px rgba(107, 42, 47, 0.03),
      0 26px 52px rgba(0, 0, 0, 0.05);
    z-index: 3;
  }

  .jurisdictions__count {
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 58px;
    font-weight: 800;
    line-height: 1;
  }

  .jurisdictions__count-wrap span {
    margin-top: 8px;
    color: #8f6e72;
    font-family: "Roboto", sans-serif;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .24em;
  }

  .jurisdictions__chip {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 4;
    padding: 9px 13px;
    border-radius: 999px;
    border: 1px solid rgba(107, 42, 47, 0.18);
    background: #fff;
    color: #4c0815;
    box-shadow: 0 10px 24px rgba(76, 8, 21, 0.08);
  }

  .jurisdictions__chip span {
    display: block;
    font-family: "Roboto", sans-serif;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .14em;
    white-space: nowrap;
  }

  .jurisdictions__legend {
    position: absolute;
    bottom: 26px;
    display: grid;
    gap: 10px;
    color: rgba(76, 8, 21, 0.82);
    font-family: "Roboto", sans-serif;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .16em;
    z-index: 2;
  }

  .jurisdictions__legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .jurisdictions__legend span::before {
    content: "";
    width: 18px;
    height: 2px;
    border-radius: 999px;
    background: #6b2a2f;
    opacity: .72;
  }

  .jurisdictions__legend--left {
    left: 68px;
  }

  .jurisdictions__legend--right {
    right: 72px;
  }

  .jurisdictions__chip--us { animation: jurisFloat 5.4s ease-in-out infinite; }
  .jurisdictions__chip--mexico { animation: jurisFloat 5.4s ease-in-out infinite .18s; }
  .jurisdictions__chip--argentina { animation: jurisFloat 5.4s ease-in-out infinite .36s; }
  .jurisdictions__chip--brazil { animation: jurisFloat 5.4s ease-in-out infinite .54s; }
  .jurisdictions__chip--pct { animation: jurisFloat 5.4s ease-in-out infinite .72s; }
  .jurisdictions__chip--epo { animation: jurisFloat 5.4s ease-in-out infinite .9s; }

  @keyframes jurisFloat {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-7px); }
  }

  @media (max-width: 980px) {
    .jurisdictions__inner {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .jurisdictions__visual {
      min-height: 500px;
    }
  }

  @media (max-width: 640px) {
    .jurisdictions {
      padding: 24px 16px 82px;
    }

    .jurisdictions__copy p {
      font-size: 16px;
    }

    .jurisdictions__visual {
      min-height: 370px;
    }

    .jurisdictions__count-wrap {
      width: 132px;
      height: 132px;
    }

    .jurisdictions__count {
      font-size: 42px;
    }

    .jurisdictions__chip {
      padding: 7px 10px;
    }

    .jurisdictions__chip span {
      font-size: 10px;
    }

    .jurisdictions__legend {
      bottom: 12px;
      gap: 6px;
      font-size: 9px;
    }

    .jurisdictions__legend--left {
      left: 10px;
    }

    .jurisdictions__legend--right {
      right: 10px;
    }
  }
</style>
