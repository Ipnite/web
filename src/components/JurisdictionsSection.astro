---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      eyebrow: "JURISDICCIONES",
      title: "Donde IPnite puede usarse hoy",
      body: "Un mapamundi editorial con foco en las jurisdicciones activas para que se vea como parte del sistema, no como un bloque técnico.",
      countLabel: "jurisdicciones",
    }
  : {
      eyebrow: "JURISDICTIONS",
      title: "Where IPnite can be used today",
      body: "An editorial world map focused on the active jurisdictions, designed to feel like part of the system rather than a technical block.",
      countLabel: "jurisdictions",
    };

const regions = [
  { label: "US", class: "us", x: "26%", y: "36%" },
  { label: "Mexico", class: "mexico", x: "29%", y: "47%" },
  { label: "Argentina", class: "argentina", x: "36%", y: "75%" },
  { label: "Brasil", class: "brazil", x: "49%", y: "63%" },
  { label: "PCT", class: "pct", x: "64%", y: "28%" },
  { label: "EPO", class: "epo", x: "73%", y: "40%" },
];
---

<section class="jurisdictions" aria-labelledby="jurisdictions-heading">
  <div class="jurisdictions__inner">
    <div class="jurisdictions__copy">
      <div class="jurisdictions__eyebrow">{copy.eyebrow}</div>
      <h2 id="jurisdictions-heading">{copy.title}</h2>
      <p>{copy.body}</p>
    </div>

    <div class="jurisdictions__visual" aria-label={copy.title}>
      <div class="jurisdictions__map">
        <svg viewBox="0 0 920 560" role="img" aria-hidden="true">
          <defs>
            <radialGradient id="globeGlow" cx="50%" cy="42%" r="65%">
              <stop offset="0%" stop-color="rgba(107,42,47,0.04)" />
              <stop offset="70%" stop-color="rgba(107,42,47,0.02)" />
              <stop offset="100%" stop-color="rgba(107,42,47,0.0)" />
            </radialGradient>
          </defs>

          <circle cx="460" cy="274" r="210" fill="url(#globeGlow)" />
          <circle cx="460" cy="274" r="214" fill="none" stroke="#6b2a2f" stroke-opacity=".26" stroke-width="2" />
          <circle cx="460" cy="274" r="188" fill="none" stroke="#6b2a2f" stroke-opacity=".16" stroke-width="1.5" />
          <ellipse cx="460" cy="274" rx="188" ry="188" fill="none" stroke="#6b2a2f" stroke-opacity=".18" stroke-width="1.5" />

          <path d="M272 274c0-103.8 84.2-188 188-188s188 84.2 188 188-84.2 188-188 188-188-84.2-188-188Z" fill="none" stroke="#6b2a2f" stroke-opacity=".16" stroke-width="1.4" />
          <path d="M460 86c-58 46-96 108-96 188s38 142 96 188c58-46 96-108 96-188s-38-142-96-188Z" fill="none" stroke="#6b2a2f" stroke-opacity=".12" stroke-width="1.2" />
          <path d="M352 114c18 34 28 78 28 160s-10 126-28 160M568 114c-18 34-28 78-28 160s10 126 28 160" fill="none" stroke="#6b2a2f" stroke-opacity=".11" stroke-width="1.2" />
          <path d="M286 206c62-26 142-38 174-38 32 0 112 12 174 38M278 274c74-18 120-28 182-28s108 10 182 28M286 342c62 26 142 38 174 38 32 0 112-12 174-38" fill="none" stroke="#6b2a2f" stroke-opacity=".11" stroke-width="1.2" />

          <path d="M410 138c-22 18-30 43-29 65 1 16 4 24 4 38 0 17-9 24-23 32-23 13-38 33-41 58-3 27 4 52 17 71 13 18 32 31 47 42 18 13 20 22 34 35 13 12 30 20 45 18 17-2 22-16 33-30 12-15 28-28 36-48 6-15 8-32 3-48-6-22-22-34-30-53-6-13-5-28-2-43 3-14 11-28 6-44-4-13-16-24-31-31-17-9-37-11-55-6-14 4-28 13-34 24Z" fill="#6b2a2f" fill-opacity=".18" stroke="#6b2a2f" stroke-opacity=".28" stroke-width="2" />
          <path d="M505 151c18 12 29 28 32 45 3 16-2 27 4 40 6 14 23 18 35 28 12 10 19 25 18 42-1 15-8 28-18 40-12 14-19 30-21 49-3 28 5 53 27 70 16 13 34 16 45 24 11 8 16 19 20 31" fill="none" stroke="#6b2a2f" stroke-opacity=".22" stroke-width="2" stroke-linecap="round"/>
          <path d="M466 102c39 28 70 68 85 116 13 42 15 98 2 147-14 52-43 95-87 132" fill="none" stroke="#6b2a2f" stroke-opacity=".14" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M377 162c16-20 36-31 56-31 17 0 31 7 41 19 11 13 14 31 11 49-3 15-14 30-30 40-14 9-20 18-31 33-12 17-25 31-43 38-14 5-30 5-44 1-14-4-26-13-33-24-8-13-9-30-5-44 7-22 24-34 38-51 10-13 16-20 40-30Z" fill="#6b2a2f" fill-opacity=".24" stroke="#6b2a2f" stroke-opacity=".22" stroke-width="2" />
        </svg>

        <div class="jurisdictions__center">
          <strong class="jurisdictions__count" data-jurisdictions-count="6">0</strong>
          <span>{copy.countLabel}</span>
        </div>

        {regions.map((region) => (
          <div class={`jurisdictions__node jurisdictions__node--${region.class}`} style={`left:${region.x};top:${region.y};`} data-analytics-label={`Jurisdiction ${region.label}`}>
            <span>{region.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.currentScript && document.currentScript.closest('.jurisdictions');
      if (!root) return;

      var counter = root.querySelector('[data-jurisdictions-count]');
      if (counter && 'IntersectionObserver' in window) {
        var started = false;
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting || started) return;
            started = true;
            var end = parseInt(counter.getAttribute('data-jurisdictions-count') || '6', 10);
            var current = 0;
            var steps = 24;
            var tick = function () {
              current += 1;
              counter.textContent = String(Math.min(end, Math.ceil((current / steps) * end)));
              if (current < steps) window.requestAnimationFrame(tick);
            };
            window.requestAnimationFrame(tick);
            observer.disconnect();
          });
        }, { threshold: 0.38 });

        observer.observe(root);
      } else if (counter) {
        counter.textContent = '6';
      }
    })();
  </script>
</section>

<style>
  .jurisdictions {
    position: relative;
    overflow: hidden;
    background: #fff;
    padding: 22px clamp(18px, 5vw, 80px) 96px;
  }

  .jurisdictions__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 30px;
    align-items: center;
  }

  .jurisdictions__copy h2 {
    margin: 10px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .jurisdictions__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 35px;
    padding: 0 18px;
    border-radius: 999px;
    background: #6b2a2f;
    color: #ededed;
    font-family: "Roboto Slab", serif;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .jurisdictions__copy p {
    margin: 18px 0 0;
    max-width: 540px;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.6;
  }

  .jurisdictions__visual {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jurisdictions__map {
    position: relative;
    width: min(100%, 720px);
    aspect-ratio: 1.55 / 1;
  }

  .jurisdictions__map svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .jurisdictions__center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 176px;
    height: 176px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    border: 2px solid rgba(107, 42, 47, 0.24);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(4px);
    box-shadow:
      0 0 0 18px rgba(107, 42, 47, 0.035),
      0 26px 52px rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    z-index: 3;
  }

  .jurisdictions__count {
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 58px;
    font-weight: 800;
    line-height: 1;
  }

  .jurisdictions__center span {
    margin-top: 8px;
    color: #8f6e72;
    font-family: "Roboto", sans-serif;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .24em;
  }

  .jurisdictions__node {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 4;
    padding: 9px 13px;
    border-radius: 999px;
    border: 1px solid rgba(107, 42, 47, 0.20);
    background: #fff;
    color: #4c0815;
    box-shadow: 0 10px 24px rgba(76, 8, 21, 0.08);
  }

  .jurisdictions__node span {
    display: block;
    font-family: "Roboto", sans-serif;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .14em;
    white-space: nowrap;
  }

  .jurisdictions__node--us { animation: jurisFloat 4.8s ease-in-out infinite; }
  .jurisdictions__node--mexico { animation: jurisFloat 4.8s ease-in-out infinite .2s; }
  .jurisdictions__node--argentina { animation: jurisFloat 4.8s ease-in-out infinite .4s; }
  .jurisdictions__node--brazil { animation: jurisFloat 4.8s ease-in-out infinite .6s; }
  .jurisdictions__node--pct { animation: jurisFloat 4.8s ease-in-out infinite .8s; }
  .jurisdictions__node--epo { animation: jurisFloat 4.8s ease-in-out infinite 1s; }

  @keyframes jurisFloat {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-7px); }
  }

  @media (max-width: 980px) {
    .jurisdictions__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .jurisdictions__visual {
      min-height: 460px;
    }

    .jurisdictions__map {
      width: 100%;
      max-width: 720px;
    }
  }

  @media (max-width: 640px) {
    .jurisdictions {
      padding: 26px 16px 80px;
    }

    .jurisdictions__copy p {
      font-size: 16px;
    }

    .jurisdictions__visual {
      min-height: 360px;
    }

    .jurisdictions__center {
      width: 128px;
      height: 128px;
    }

    .jurisdictions__count {
      font-size: 42px;
    }

    .jurisdictions__node {
      padding: 7px 10px;
    }

    .jurisdictions__node span {
      font-size: 10px;
    }
  }
</style>
