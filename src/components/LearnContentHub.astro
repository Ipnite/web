---
import { seoPages, type Locale } from "../data/seoContent";
interface Props { lang?: Locale; }
const { lang = "en" } = Astro.props;
const prefix = lang === "es" ? "/es" : lang === "pt" ? "/pt-br" : "";
const articles = seoPages.filter((page)=>page.kind==="article");
const copy = lang === "es" ? { eyebrow:"BIBLIOTECA DE PATENTES",title:"Guías para tomar mejores decisiones de propiedad intelectual",lead:"Explora conceptos, procesos y preguntas frecuentes. Cada guía conecta con herramientas relevantes de IPnite y conserva los límites del asesoramiento educativo.",read:"Leer la guía" } : lang === "pt" ? { eyebrow:"BIBLIOTECA DE PATENTES",title:"Guias para tomar melhores decisões de propriedade intelectual",lead:"Explore conceitos, processos e perguntas frequentes. Cada guia se conecta às ferramentas relevantes da IPnite e mantém os limites do conteúdo educativo.",read:"Ler o guia" } : { eyebrow:"PATENT RESOURCE LIBRARY",title:"Guides for better intellectual property decisions",lead:"Explore concepts, processes, and common questions. Each guide connects to relevant IPnite tools while preserving the limits of educational content.",read:"Read the guide" };
---
<section class="content-hub" aria-labelledby="content-hub-title"><div class="content-hub__inner"><p class="kicker">{copy.eyebrow}</p><h2 id="content-hub-title">{copy.title}</h2><p class="content-hub__lead">{copy.lead}</p><div class="content-hub__grid">{articles.map((page,index)=><article><span>{String(index+1).padStart(2,"0")}</span><h3>{page.locales[lang].h1}</h3><p>{page.locales[lang].lead}</p><a href={`${prefix}/${page.slug}/`}>{copy.read} →</a></article>)}</div></div></section>
<style>.content-hub{padding:82px clamp(18px,5vw,80px);background:#fff}.content-hub__inner{width:min(100%,1280px);margin:auto;text-align:center}.content-hub h2{max-width:900px;margin:18px auto 0;color:#4c0815;font:800 clamp(38px,4vw,56px)/1.1 "Roboto Slab",serif}.content-hub__lead{max-width:800px;margin:20px auto 40px;font:500 18px/1.6 Roboto,sans-serif}.content-hub__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;text-align:left}.content-hub article{border:1px solid rgba(107,42,47,.14);border-radius:28px;padding:25px;background:#fff;box-shadow:0 14px 32px rgba(107,42,47,.06)}.content-hub article>span{color:#938d8e;font:800 12px "Roboto Slab",serif}.content-hub h3{margin:18px 0 10px;color:#6b2a2f;font:800 23px/1.2 "Roboto Slab",serif}.content-hub article p{margin:0;font:500 15px/1.55 Roboto,sans-serif}.content-hub article a{display:inline-block;margin-top:18px;color:#4c0815;font:800 14px "Roboto Slab",serif}@media(max-width:900px){.content-hub__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.content-hub__grid{grid-template-columns:1fr}}</style>
