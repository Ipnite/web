---
interface Props { lang?: "en" | "es" | "pt"; }
const { lang = "en" } = Astro.props;
const copy=lang==="es"?{eyebrow:"IPNITE LEARNING",title:["Fundamentos de patentes,","sin la neblina."],subtitle:"Entiende los conceptos esenciales de las patentes y las solicitudes provisionales en un lenguaje sencillo.",lead:"Aprende primero. Estructura mejor tu invención después.",primary:"Empezar a aprender",secondary:"Comenzar a redactar",steps:[["IDEA","El concepto inicial"],["BORRADOR","Detalles estructurados"],["12 MESES","Ventana de plazo"],["ESTADO","Patente en trámite"]],note:"Conceptos claros · Ejemplos prácticos · Flujo guiado"}:lang==="pt"?{eyebrow:"IPNITE LEARNING",title:["Fundamentos de patentes,","sem complicação."],subtitle:"Entenda os conceitos essenciais de patentes e pedidos provisórios em uma linguagem simples.",lead:"Aprenda primeiro. Estruture melhor sua invenção depois.",primary:"Começar a aprender",secondary:"Começar a redigir",steps:[["IDEIA","O conceito inicial"],["RASCUNHO","Detalhes estruturados"],["12 MESES","Janela de prazo"],["STATUS","Patente pendente"]],note:"Conceitos claros · Exemplos práticos · Fluxo guiado"}:{eyebrow:"IPNITE LEARNING",title:["Patent Basics,","Without the Fog."],subtitle:"Understand essential patent and provisional-application concepts in plain language.",lead:"Learn first. Structure your invention better next.",primary:"Start learning",secondary:"Start drafting",steps:[["IDEA","The initial concept"],["DRAFT","Structured details"],["12 MONTHS","The time window"],["STATUS","Patent pending"]],note:"Clear concepts · Practical examples · Guided workflow"};
---
<section class="learning-hero" aria-labelledby="learning-heading"><div class="learning-copy"><p class="eyebrow">{copy.eyebrow}</p><h1 id="learning-heading"><span>{copy.title[0]}</span><strong>{copy.title[1]}</strong></h1><p class="subtitle">{copy.subtitle}</p><p class="lead">{copy.lead}</p><div class="actions"><a class="button primary" href="#learn-core">{copy.primary}</a><a class="button" href="https://app.ipnite.com/" target="_blank" rel="noopener noreferrer">{copy.secondary}</a></div><p class="note">{copy.note}</p></div><div class="learning-visual"><img src="/images/cerebro.png" alt="" aria-hidden="true" class="brain"/><div class="flow">{copy.steps.map((step,index)=><article class="step"><div class={`icon icon-${index}`} aria-hidden="true">{index===0?"✦":index===1?"≡":index===2?"12":"✓"}</div><div><strong>{step[0]}</strong><span>{step[1]}</span></div>{index<3&&<i aria-hidden="true">↓</i>}</article>)}</div></div></section>
<style>
.learning-hero{position:relative;width:min(100%,1280px);min-height:650px;display:grid;grid-template-columns:minmax(0,.92fr) minmax(430px,1.08fr);align-items:center;gap:clamp(34px,5vw,78px);isolation:isolate;overflow:hidden;border-radius:clamp(28px,3vw,50px);background:radial-gradient(circle at 87% 22%,rgba(107,42,47,.16),transparent 35%),rgba(217,217,217,.16);padding:clamp(34px,5vw,70px);box-shadow:inset 0 1px 0 rgba(255,255,255,.52),inset 0 -1px 1px rgba(0,0,0,.1);text-align:left}.learning-copy{position:relative;z-index:3}.eyebrow{margin:0 0 18px;color:#6b2a2f;font:900 13px Roboto,sans-serif;letter-spacing:.13em}.learning-hero h1{margin:0;color:#505050;font-family:"Roboto Slab",serif;font-size:clamp(47px,5vw,68px);font-weight:800;letter-spacing:-.025em;line-height:1.02;text-wrap:balance}.learning-hero h1 span,.learning-hero h1 strong{display:block}.learning-hero h1 strong{color:#6b2a2f}.subtitle{max-width:610px;margin:24px 0 0;font:500 clamp(18px,1.5vw,20px)/1.52 Roboto,sans-serif}.lead{margin:12px 0 0;color:#6b2a2f;font:800 16px Roboto,sans-serif}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.button{min-height:46px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #6b2a2f;border-radius:999px;background:#ededed;padding:10px 22px;color:#4c0815;font:800 16px "Roboto Slab",serif;text-decoration:none;transition:.18s}.button.primary,.button:hover{background:#6b2a2f;color:#fff}.button:hover{transform:translateY(-2px)}.note{margin:22px 0 0;color:#777;font:700 12px/1.4 Roboto,sans-serif}.learning-visual{position:relative;min-height:510px;display:grid;place-items:center}.brain{position:absolute;right:-170px;top:-80px;width:570px;opacity:.18;filter:blur(1px)}.flow{position:relative;z-index:2;width:min(100%,500px);display:grid;gap:12px;border:1px solid rgba(107,42,47,.13);border-radius:32px;background:rgba(255,255,255,.9);padding:22px;box-shadow:0 24px 55px rgba(76,8,21,.13)}.step{position:relative;display:grid;grid-template-columns:64px 1fr;align-items:center;gap:16px;min-height:88px;border:1px solid rgba(107,42,47,.1);border-radius:20px;background:#fff;padding:12px 18px}.icon{width:58px;height:58px;display:grid;place-items:center;border-radius:17px;background:#f4eeee;color:#6b2a2f;font:900 22px "Roboto Slab",serif}.icon-0{background:#6b2a2f;color:#fff}.step strong,.step span{display:block;font-family:Roboto,sans-serif}.step strong{color:#6b2a2f;font-size:13px;font-weight:900;letter-spacing:.1em}.step span{margin-top:5px;color:#5f5a5b;font-size:14px;font-weight:700}.step i{position:absolute;z-index:4;left:38px;bottom:-19px;width:26px;height:26px;display:grid;place-items:center;border-radius:50%;background:#fff;color:#6b2a2f;box-shadow:0 3px 10px rgba(76,8,21,.12);font:900 14px Roboto,sans-serif;font-style:normal}
@media(max-width:980px){.learning-hero{grid-template-columns:1fr}.learning-copy{text-align:center}.subtitle{margin-left:auto;margin-right:auto}.actions{justify-content:center}.learning-visual{width:min(100%,600px);min-height:480px;margin:-8px auto 0}}@media(max-width:600px){.learning-hero{min-height:0;padding:32px 20px 24px;border-radius:28px}.learning-hero h1{font-size:clamp(42px,12.5vw,54px)}.subtitle{font-size:17px}.actions{display:grid}.button{width:100%}.note{font-size:11px}.learning-visual{min-height:0;margin-top:24px}.flow{gap:10px;border-radius:24px;padding:12px}.step{grid-template-columns:52px 1fr;min-height:74px;gap:12px;padding:10px 12px;border-radius:17px}.icon{width:48px;height:48px;border-radius:14px;font-size:18px}.step i{left:29px;bottom:-17px;width:24px;height:24px}.brain{right:-180px;top:-80px;width:430px}}@media(prefers-reduced-motion:reduce){.button{transition:none}}
</style>
