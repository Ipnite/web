---
import PageHeroImage from "@components/PageHeroImage.astro";

interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      eyebrow: "IPnite Learning",
      title: "Fundamentos de patentes, sin la neblina.",
      subtitle: ["Aprende qué hacen las patentes y las solicitudes provisionales en ", "inglés simple."],
      lead: "Esta página explica los primeros conceptos que todo inventor debería entender antes de convertir una idea en un borrador de patente.",
      primary: "Empezar a redactar",
      secondary: "Empezar a aprender",
      heroLabel: "Hero de la plataforma IPnite para redacción de patentes",
      stageLabel: "Flujo animado de aprendizaje de patentes",
      idea: ["IDEA", "El concepto bruto"],
      draft: ["BORRADOR", "Detalles estructurados"],
      months: ["12 MESES", "Ventana de plazo"],
      status: ["ESTADO", "Patente en trámite"],
      coreHeading: "Las ideas centrales.",
      coreLead: "Empieza aquí. Estos conceptos explican qué intenta hacer un proceso de patente.",
      core: [
        { title: "Patente", body: "Una patente es un derecho legal que puede permitirte impedir que otros fabriquen, usen, vendan o importen la invención reivindicada." },
        { title: "Provisional", body: "Una solicitud provisional es una primera presentación que puede asegurar una fecha temprana de prioridad en EE. UU. No se convierte en patente por sí sola." },
        { title: "Reivindicaciones", body: "Las reivindicaciones son los límites legales. Describen qué intentas proteger, no solo cómo se ve tu producto." },
        { title: "Patente pendiente", body: "Después de presentar, puedes decir “patente pendiente”. Eso significa que se presentó una solicitud, no que se concedió una patente." },
      ],
      compareHeading: "Provisional vs. no provisional.",
      compareLead: "La versión simple: una puede plantar la bandera, la otra pide la patente.",
      compare: [
        {
          eyebrow: "Solicitud provisional",
          title: "Planta tu bandera.",
          body: "Una solicitud provisional suele usarse como una primera presentación temprana. Puede darte tiempo para refinar la invención, probar el mercado, levantar capital o preparar la solicitud completa.",
          bullets: [
            "No se examina sobre el fondo.",
            "Expira automáticamente después de 12 meses.",
            "Puede respaldar el estado de patente pendiente.",
            "Solo protege lo que realmente describas con suficiente detalle.",
          ],
        },
        {
          eyebrow: "Solicitud no provisional",
          title: "Pide la patente.",
          body: "Una solicitud no provisional es la solicitud formal que examina la oficina de patentes. Este es el camino que eventualmente puede llevar a una patente concedida.",
          bullets: [
            "Es examinada por la oficina de patentes.",
            "Necesita reivindicaciones que definan la invención.",
            "Puede reclamar prioridad sobre una solicitud provisional.",
            "Puede convertirse en una patente concedida si se aprueba.",
          ],
        },
      ],
      timelineHeading: "El reloj de 12 meses.",
      timelineLead: "Piensa en una provisional como un temporizador, no como la línea de meta.",
      timeline: [
        ["Presentar", "Presenta una solicitud provisional con suficiente detalle para respaldar la invención."],
        ["Construir", "Prueba, mejora, presenta el proyecto, levanta capital o prepara una solicitud completa más sólida."],
        ["Convertir", "Dentro de 12 meses, presenta una solicitud no provisional si quieres conservar el beneficio de prioridad."],
        ["Expira", "Si no haces nada, la provisional se abandona y no se convertirá en una patente."],
      ],
      tabsHeading: "Lo que los fundadores suelen malinterpretar.",
      tabsLead: "Haz clic en cada tema.",
      tabs: [
        { title: "Lo presenté, así que es mío.", body: "Presentar te da un registro y puede respaldar la prioridad. Pero la titularidad, la inventiva, las cesiones, el alcance de las reivindicaciones, el arte previo y la estrategia de presentación siguen importando." },
        { title: "Una provisional es una patente.", body: "Una solicitud provisional no se examina y no se emite como patente. Es útil, pero debe seguirse con el siguiente paso correcto." },
        { title: "Los detalles pueden esperar.", body: "Una provisional débil puede no respaldar las reivindicaciones posteriores. El trabajo de patentes recompensa una divulgación técnica clara y completa." },
        { title: "Las reivindicaciones son solo texto legal.", body: "Tu descripción explica la invención. Tus reivindicaciones definen lo que intentas poseer." },
      ],
      quizHeading: "Chequeo rápido.",
      quizLead: "¿Cuál es la forma más segura de pensar en una solicitud provisional?",
      quizOptions: [
        "Ya es una patente concedida.",
        "Es una presentación temprana que inicia un reloj de 12 meses.",
        "Protege cualquier cosa que invente después.",
      ],
      quizCorrect: "<strong>Correcto.</strong> Una solicitud provisional es una presentación temprana que puede respaldar una fecha de prioridad, pero expira después de 12 meses a menos que tomes el siguiente paso correcto.",
      quizWrong: "<strong>No exactamente.</strong> Una solicitud provisional no es una patente concedida y no protege detalles posteriores que nunca fueron descritos.",
      noteStrong: "Solo educativo.",
      noteBody: "Esta página explica conceptos generales de patentes en lenguaje simple. No es asesoramiento legal y no crea una relación abogado-cliente.",
      ctaHeading: "¿Listo para estructurar tu invención?",
      ctaBody: "Usa IPnite para organizar la divulgación técnica, la dirección de las reivindicaciones, los embodiments/modalidades y las secciones del borrador antes de la revisión profesional.",
      ctaButton: "Empezar a redactar",
      ctaLabel: "Empezar a redactar la patente",
    }
  : lang === "pt"
  ? {
      eyebrow: "IPnite Learning",
      title: "Fundamentos de patentes, sem a neblina.",
      subtitle: ["Aprenda o que patentes e pedidos provisórios fazem em ", "inglês simples."],
      lead: "Esta página explica os primeiros conceitos que todo inventor deve entender antes de transformar uma ideia em um rascunho de patente.",
      primary: "Começar a redigir",
      secondary: "Começar a aprender",
      heroLabel: "Hero da plataforma IPnite para redacao de patentes",
      stageLabel: "Fluxo animado de aprendizagem de patentes",
      idea: ["IDEIA", "O conceito bruto"],
      draft: ["RASCUNHO", "Detalhes estruturados"],
      months: ["12 MESES", "Janela de prazo"],
      status: ["STATUS", "Patente pendente"],
      coreHeading: "As ideias centrais.",
      coreLead: "Comece aqui. Esses conceitos explicam o que um processo de patente tenta fazer.",
      core: [
        { title: "Patente", body: "Uma patente é um direito legal que pode permitir impedir que outros fabriquem, usem, vendam ou importem a invenção reivindicada." },
        { title: "Provisório", body: "Um pedido provisório é um primeiro depósito que pode garantir uma data inicial de prioridade nos EUA. Ele não se torna uma patente por si só." },
        { title: "Reivindicações", body: "As reivindicações são os limites legais. Elas descrevem o que você está tentando proteger, não apenas como seu produto parece." },
        { title: "Patente pendente", body: "Depois do depósito, você pode dizer “patente pendente”. Isso significa que um pedido foi apresentado, não que uma patente foi concedida." },
      ],
      compareHeading: "Provisório vs. não provisório.",
      compareLead: "A versão simples: um pode fincar a bandeira, o outro pede a patente.",
      compare: [
        {
          eyebrow: "Pedido provisório",
          title: "Fincar a bandeira.",
          body: "Um pedido provisório costuma ser usado como um primeiro depósito inicial. Ele pode dar tempo para refinar a invenção, testar o mercado, captar recursos ou preparar o pedido completo.",
          bullets: [
            "Não é examinado no mérito.",
            "Expira automaticamente após 12 meses.",
            "Pode sustentar o status de patente pendente.",
            "Só protege o que você realmente descrever bem o suficiente.",
          ],
        },
        {
          eyebrow: "Pedido não provisório",
          title: "Pedir a patente.",
          body: "Um pedido não provisório é o pedido formal que é examinado pelo órgão de patentes. Esse é o caminho que pode levar a uma patente concedida.",
          bullets: [
            "É examinado pelo órgão de patentes.",
            "Precisa de reivindicações que definam a invenção.",
            "Pode reivindicar prioridade sobre um pedido provisório.",
            "Pode se tornar uma patente concedida se for aceito.",
          ],
        },
      ],
      timelineHeading: "O relógio de 12 meses.",
      timelineLead: "Pense em um provisório como um timer, não como a linha de chegada.",
      timeline: [
        ["Depositar", "Envie um pedido provisório com detalhes suficientes para sustentar a invenção."],
        ["Construir", "Teste, melhore, apresente, capte recursos ou prepare um pedido completo mais forte."],
        ["Converter", "Dentro de 12 meses, apresente um pedido não provisório se quiser manter o benefício de prioridade."],
        ["Expira", "Se você não fizer nada, o provisório é abandonado e não se tornará uma patente."],
      ],
      tabsHeading: "O que os fundadores costumam entender errado.",
      tabsLead: "Clique em cada tema.",
      tabs: [
        { title: "Depositei, então é meu.", body: "Depositar lhe dá um registro e pode sustentar prioridade. Mas titularidade, inventoria, cessões, escopo das reivindicações, arte anterior e estratégia de depósito ainda importam." },
        { title: "Um provisório é uma patente.", body: "Um pedido provisório não é examinado e não é emitido como patente. Ele é útil, mas precisa ser seguido pelo próximo passo correto." },
        { title: "Os detalhes podem esperar.", body: "Um provisório fraco pode não sustentar as reivindicações posteriores. O trabalho de patente recompensa uma divulgação técnica clara e completa." },
        { title: "Reivindicações são só texto jurídico.", body: "Sua descrição explica a invenção. Suas reivindicações definem o que você está tentando possuir." },
      ],
      quizHeading: "Checagem rápida.",
      quizLead: "Qual é a forma mais segura de pensar em um pedido provisório?",
      quizOptions: [
        "Já é uma patente concedida.",
        "É um depósito inicial que inicia um relógio de 12 meses.",
        "Protege tudo o que eu inventar depois.",
      ],
      quizCorrect: "<strong>Correto.</strong> Um pedido provisório é um depósito inicial que pode sustentar uma data de prioridade, mas expira após 12 meses a menos que você tome o próximo passo correto.",
      quizWrong: "<strong>Não exatamente.</strong> Um pedido provisório não é uma patente concedida e não protege detalhes posteriores que nunca foram descritos.",
      noteStrong: "Apenas educativo.",
      noteBody: "Esta página explica conceitos gerais de patentes em linguagem simples. Não é aconselhamento jurídico e não cria uma relação advogado-cliente.",
      ctaHeading: "Pronto para estruturar sua invenção?",
      ctaBody: "Use a IPnite para organizar a divulgação técnica, a direção das reivindicações, os embodiments/modalidades e as seções do rascunho antes da revisão profissional.",
      ctaButton: "Começar a redigir",
      ctaLabel: "Começar a redigir a patente",
    }
  : {
      eyebrow: "IPnite Learning",
      title: "Patent Basics, Without the Fog.",
      subtitle: ["Learn what patents and provisional applications do in ", "plain English."],
      lead: "This page explains the first concepts every inventor should understand before turning an idea into a patent draft.",
      primary: "Start drafting",
      secondary: "Start learning",
      heroLabel: "IPnite patent drafting platform hero",
      stageLabel: "Animated patent learning workflow",
      idea: ["IDEA", "The raw concept"],
      draft: ["DRAFT", "Structured details"],
      months: ["12 MONTHS", "Deadline window"],
      status: ["STATUS", "Patent pending"],
      coreHeading: "The core ideas.",
      coreLead: "Start here. These concepts explain what a patent process is trying to do.",
      core: [
        { title: "Patent", body: "A patent is a legal right that can let you stop others from making, using, selling, or importing the claimed invention." },
        { title: "Provisional", body: "A provisional application is a first filing that can secure an early U.S. filing date. It does not become a patent by itself." },
        { title: "Claims", body: "Claims are the legal boundaries. They describe what you are trying to protect, not just what your product looks like." },
        { title: "Patent Pending", body: "After filing, you may be able to say “patent pending.” That means an application was filed, not that a patent was granted." },
      ],
      compareHeading: "Provisional vs. nonprovisional.",
      compareLead: "The simple version: one can plant the flag, the other asks for the patent.",
      compare: [
        {
          eyebrow: "Provisional application",
          title: "Plant your flag.",
          body: "A provisional application is usually used as an early first filing. It can give you time to refine the invention, test the market, raise money, or prepare the full application.",
          bullets: [
            "Not examined on the merits.",
            "Automatically expires after 12 months.",
            "Can support patent pending status.",
            "Only protects what you actually describe well enough.",
          ],
        },
        {
          eyebrow: "Nonprovisional application",
          title: "Ask for the patent.",
          body: "A nonprovisional application is the formal application that gets examined by the patent office. This is the path that can eventually lead to an issued patent.",
          bullets: [
            "Examined by the patent office.",
            "Needs claims that define the invention.",
            "Can claim priority to a provisional filing.",
            "Can become a granted patent if allowed.",
          ],
        },
      ],
      timelineHeading: "The 12-month clock.",
      timelineLead: "Think of a provisional as a timer, not the finish line.",
      timeline: [
        ["File", "Submit a provisional application with enough detail to support the invention."],
        ["Build", "Test, improve, pitch, raise, or prepare a stronger full application."],
        ["Convert", "Within 12 months, file a nonprovisional if you want to keep the priority benefit."],
        ["Expires", "If you do nothing, the provisional is abandoned and will not become a patent."],
      ],
      tabsHeading: "What founders usually misunderstand.",
      tabsLead: "Click each topic.",
      tabs: [
        { title: "I filed, so I own it.", body: "Filing gives you a record and may support priority. But ownership, inventorship, assignments, claim scope, prior art, and filing strategy still matter." },
        { title: "A provisional is a patent.", body: "A provisional application is not examined and does not issue as a patent. It is useful, but must be followed by the right next step." },
        { title: "Details can wait.", body: "A weak provisional can fail to support later claims. Patent work rewards clear, complete technical disclosure." },
        { title: "Claims are just legal text.", body: "Your description explains the invention. Your claims define what you are trying to own." },
      ],
      quizHeading: "Quick check.",
      quizLead: "What is the safest way to think about a provisional application?",
      quizOptions: [
        "It is already a granted patent.",
        "It is an early filing that starts a 12-month clock.",
        "It protects anything I invent later.",
      ],
      quizCorrect: "<strong>Correct.</strong> A provisional application is an early filing that can support a priority date, but it expires after 12 months unless you take the right next step.",
      quizWrong: "<strong>Not quite.</strong> A provisional application is not a granted patent and does not protect later details that were never described.",
      noteStrong: "Educational only.",
      noteBody: "This page explains general patent concepts in simple language. It is not legal advice and does not create an attorney-client relationship.",
      ctaHeading: "Ready to structure your invention?",
      ctaBody: "Use IPnite to organize the technical disclosure, claims direction, embodiments, and draft sections before professional review.",
      ctaButton: "Start drafting",
      ctaLabel: "Start drafting the patent",
    };

const heroTitle = lang === "es"
  ? ["Fundamentos de patentes,", "sin la neblina."]
  : lang === "pt"
  ? ["Fundamentos de patentes,", "sem a neblina."]
  : ["Patent Basics,", "Without the Fog."];

const sectionTitles = lang === "es"
  ? {
      core: ["Las ideas", "centrales."],
      compare: ["Provisional vs.", "no provisional."],
      timeline: ["El reloj de", "12 meses."],
      tabs: ["Lo que los fundadores suelen", "malinterpretar."],
      quiz: ["Chequeo", "rápido."],
    }
  : lang === "pt"
  ? {
      core: ["As ideias", "centrais."],
      compare: ["Provisório vs.", "não provisório."],
      timeline: ["O relógio de", "12 meses."],
      tabs: ["O que os fundadores costumam", "entender errado."],
      quiz: ["Checagem", "rápida."],
    }
  : {
      core: ["The core", "ideas."],
      compare: ["Provisional vs.", "nonprovisional."],
      timeline: ["The 12-month", "clock."],
      tabs: ["What founders usually", "misunderstand."],
      quiz: ["Quick", "check."],
    };
---

<section class="learn-page">
  <section class="learn-hero">
    <h1><span>{heroTitle[0]}</span><strong>{heroTitle[1]}</strong></h1>
    <p class="learn-subtitle">{copy.subtitle[0]}{copy.subtitle[1]}</p>

    <PageHeroImage label={copy.heroLabel} />

    <div class="learn-stage" aria-label={copy.stageLabel}>
      <svg viewBox="0 0 1200 520" role="img" aria-label={copy.stageLabel}>
        <rect width="1200" height="520" rx="28" fill="#fff" />
        <g class="stage-step stage-idea" transform="translate(90 128)">
          <circle class="pulse" cx="86" cy="92" r="58" fill="#7B1D2C" opacity=".08" />
          <circle cx="86" cy="92" r="28" fill="#fff" stroke="#7B1D2C" stroke-width="5" />
          <path d="M86 64 C68 76 68 98 84 109 L84 122 L91 122 L91 109 C108 98 105 76 86 64Z" fill="none" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <line x1="78" y1="134" x2="96" y2="134" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
          <text x="86" y="230" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">{copy.idea[0]}</text>
          <text x="86" y="256" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">{copy.idea[1]}</text>
        </g>
        <g transform="translate(396 122)">
          <rect x="0" y="0" width="158" height="184" rx="22" fill="#fff" stroke="#ECE7E5" stroke-width="3" />
          <g class="draft-lines">
            <path d="M30 46 H126" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
            <path d="M30 80 H112" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
            <path d="M30 114 H122" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
          </g>
          <rect x="30" y="140" width="76" height="10" rx="5" fill="#7B1D2C" opacity=".16" />
          <text x="79" y="240" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">{copy.draft[0]}</text>
          <text x="79" y="266" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">{copy.draft[1]}</text>
        </g>
        <g transform="translate(690 122)">
          <circle cx="76" cy="100" r="66" fill="#fff" stroke="#ECE7E5" stroke-width="3" />
          <circle cx="76" cy="100" r="42" fill="#fff" stroke="#7B1D2C" stroke-width="4" opacity=".86" />
          <line x1="76" y1="100" x2="76" y2="72" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
          <g class="clock-hand"><line x1="76" y1="100" x2="103" y2="100" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" /></g>
          <circle cx="76" cy="100" r="5" fill="#7B1D2C" />
          <text x="76" y="236" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">{copy.months[0]}</text>
          <text x="76" y="262" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">{copy.months[1]}</text>
        </g>
        <g transform="translate(1000 128)">
          <path class="shield-glow" d="M76 0 L142 24 V82 C142 128 112 157 76 176 C40 157 10 128 10 82 V24 Z" fill="#7B1D2C" opacity=".14" />
          <path d="M76 12 L128 32 V82 C128 116 107 140 76 158 C45 140 24 116 24 82 V32 Z" fill="#fff" stroke="#7B1D2C" stroke-width="4" />
          <text x="76" y="84" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="12" font-weight="900" letter-spacing="2">{copy.status[0]}</text>
          <circle class="spark spark-a" cx="148" cy="32" r="4" fill="#7B1D2C" />
          <circle class="spark spark-b" cx="14" cy="142" r="3" fill="#7B1D2C" />
          <circle class="spark spark-c" cx="156" cy="138" r="3" fill="#7B1D2C" />
          <text x="76" y="228" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">{copy.status[1].toUpperCase()}</text>
          <text x="76" y="254" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">{lang === "en" ? "Patent pending" : lang === "es" ? "Patente pendiente" : "Patente pendente"}</text>
        </g>
      </svg>
    </div>
  </section>

  <section id="learn-core" class="learn-section">
    <div class="learn-head">
      <h2><span>{sectionTitles.core[0]}</span>{" "}<strong>{sectionTitles.core[1]}</strong></h2>
      <p>{copy.coreLead}</p>
    </div>
    <div class="core-grid">
      {copy.core.map((card, index) => (
        <article class="core-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{card.title}</h3>
          <div class={`mini ${index === 0 ? "mini-shield" : index === 1 ? "mini-clock" : index === 2 ? "mini-claims" : "mini-pending"}`} aria-hidden="true">{index === 3 ? "PENDING" : null}</div>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="learn-compare" class="learn-section">
    <div class="learn-head">
      <h2><span>{sectionTitles.compare[0]}</span>{" "}<strong>{sectionTitles.compare[1]}</strong></h2>
      <p>{copy.compareLead}</p>
    </div>
    <div class="compare-grid">
      {copy.compare.map((item) => (
        <article>
          <small>{item.eyebrow}</small>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul>
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="learn-timeline" class="learn-section">
    <div class="learn-head">
      <h2><span>{sectionTitles.timeline[0]}</span>{" "}<strong>{sectionTitles.timeline[1]}</strong></h2>
      <p>{copy.timelineLead}</p>
    </div>
    <div class="timeline">
      {copy.timeline.map(([title, body], index) => (
        <article>
          <span>{index + 1}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="learn-misconceptions" class="learn-section tabs-section">
    <div class="learn-head">
      <h2><span>{sectionTitles.tabs[0]}</span>{" "}<strong>{sectionTitles.tabs[1]}</strong></h2>
      <p>{copy.tabsLead}</p>
    </div>
    <div class="tabs-shell">
      <div class="tab-list" role="tablist" aria-label={lang === "en" ? "Patent misconceptions" : lang === "es" ? "Ideas erróneas sobre patentes" : "Equívocos sobre patentes"}>
        {copy.tabs.map((tab, index) => (
          <button class={`tab-button ${index === 0 ? "active" : ""}`} type="button" data-tab={`tab-${index + 1}`}>
            {tab.title}
          </button>
        ))}
      </div>
      <div class="tab-panel">
        {copy.tabs.map((tab, index) => (
          <article id={`tab-${index + 1}`} class={`tab-content ${index === 0 ? "active" : ""}`}>
            <h3>{tab.title}</h3>
            <p>{tab.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="learn-quiz" class="learn-section quiz-section">
    <div class="learn-head">
