---
interface Props {
  label?: string;
}

const { label = "IPnite platform preview" } = Astro.props;
---

<figure class="page-hero-brain" aria-label={label} aria-hidden="true">
  <img src="/images/cerebro.png" alt="" loading="eager" />
</figure>

<style>
  :global(.faq-hero),
  :global(.learn-hero),
  :global(.about-hero),
  :global(.coming-hero),
  :global(.terms-header),
  :global(.faq-es),
  :global(.learn-es),
  :global(.simple-page),
  :global(.soon-es),
  :global(.terms-es),
  :global(.es-hero) {
    position: relative;
    overflow: hidden;
  }

  .page-hero-brain {
    position: absolute;
    z-index: 0;
    right: max(-260px, -18vw);
    top: clamp(38px, 7vw, 86px);
    width: clamp(420px, 52vw, 720px);
    height: auto;
    margin: 0;
    pointer-events: none;
    opacity: 0.22;
    filter: blur(2px);
  }

  .page-hero-brain img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 620px) {
    .page-hero-brain {
      right: -190px;
      top: 96px;
      width: 330px;
      opacity: 0.18;
    }
  }
</style>
