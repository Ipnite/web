---
interface Props { lang?: "en" | "es" | "pt"; }
const { lang = "en" } = Astro.props;
const prefix = lang === "es" ? "/es" : lang === "pt" ? "/pt-br" : "";
const copy = lang === "es" ? {
  eyebrow: "UNA PLATAFORMA INTEGRAL DE PATENTES", title: "Del descubrimiento a la cartera de propiedad intelectual",
  lead: "IPnite conecta las tareas esenciales del trabajo de patentes para que inventores, equipos y profesionales de toda Latinoamérica puedan avanzar con contexto y control.",
  cards: [["Búsqueda de anterioridades","Investiga referencias relevantes y organiza los hallazgos antes de redactar.","/prior-art-search/"],["Redacción con IA","Convierte la divulgación técnica en reivindicaciones y un borrador estructurado.","/ai-patent-drafting/"],["Dibujos de patentes","Crea figuras de referencia conectadas con la descripción de la invención.","/patent-drawings/"],["Gestión de cartera","Mantén solicitudes, documentos, fechas y alertas en un solo espacio.","/patent-portfolio-management/"]],
} : lang === "pt" ? {
  eyebrow: "UMA PLATAFORMA INTEGRADA DE PATENTES", title: "Da descoberta ao portfólio de propriedade intelectual",
  lead: "A IPnite conecta as tarefas essenciais do trabalho de patentes para que inventores, equipes e profissionais de toda a América Latina avancem com contexto e controle.",
  cards: [["Busca de anterioridade","Pesquise referências relevantes e organize os resultados antes de redigir.","/prior-art-search/"],["Redação com IA","Transforme a divulgação técnica em reivindicações e um rascunho estruturado.","/ai-patent-drafting/"],["Desenhos de patentes","Crie figuras de referência conectadas à descrição da invenção.","/patent-drawings/"],["Gestão de portfólio","Mantenha pedidos, documentos, prazos e alertas em um só espaço.","/patent-portfolio-management/"]],
} : {
  eyebrow: "A COMPLETE PATENT WORKFLOW", title: "From discovery to intellectual property portfolio",
  lead: "IPnite connects the essential parts of patent work so inventors, teams, and professionals across Latin America can move forward with context and control.",
  cards: [["Prior-art search","Investigate relevant references and organize findings before drafting.","/prior-art-search/"],["AI-assisted drafting","Turn a technical disclosure into claims and a structured application draft.","/ai-patent-drafting/"],["Patent drawings","Create reference figures connected to the invention description.","/patent-drawings/"],["Portfolio management","Keep applications, documents, deadlines, and alerts in one workspace.","/patent-portfolio-management/"]],
};
const productEvents: Record<string, string> = {
  "/prior-art-search/": "prior_art_search_clicked",
  "/ai-patent-drafting/": "start_drafting_clicked",
  "/patent-drawings/": "patent_drawing_clicked",
  "/patent-portfolio-management/": "portfolio_management_clicked",
};
---
<section class="platform-overview" aria-labelledby="platform-overview-heading" data-analytics-location="platform_overview"><div class="platform-overview__inner"><p class="kicker">{copy.eyebrow}</p><h2 id="platform-overview-heading">{copy.title}</h2><p class="platform-overview__lead">{copy.lead}</p><div class="platform-overview__grid">{copy.cards.map(([title,body,path],index)=><a href={`${prefix}${path}`} data-analytics-cta={path.replaceAll("/", "").replaceAll("-", "_")} data-analytics-event={productEvents[path]}><span>{String(index+1).padStart(2,"0")}</span><h3>{title}</h3><p>{body}</p><strong>{lang === "es" ? "Conocer la herramienta" : lang === "pt" ? "Conhecer a ferramenta" : "Explore the tool"} →</strong></a>)}</div></div></section>
<style>.platform-overview{padding:50px clamp(18px,5vw,80px) 86px;background:radial-gradient(circle at 50% 45%,rgba(107,42,47,.09),transparent 55%),#fff}.platform-overview__inner{width:min(100%,1280px);margin:auto;text-align:center}.platform-overview h2{max-width:880px;margin:18px auto 0;color:#4c0815;font:800 clamp(38px,4vw,56px)/1.1 "Roboto Slab",serif;text-wrap:balance}.platform-overview__lead{max-width:830px;margin:20px auto 38px;font:500 19px/1.6 Roboto,sans-serif}.platform-overview__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;text-align:left}.platform-overview__grid a{min-height:285px;border:1px solid rgba(107,42,47,.14);border-radius:30px;background:rgba(255,255,255,.82);padding:27px;text-decoration:none;box-shadow:0 16px 34px rgba(107,42,47,.07);transition:.2s}.platform-overview__grid a:hover{transform:translateY(-4px);box-shadow:0 22px 44px rgba(107,42,47,.13)}.platform-overview__grid span{color:#938d8e;font:800 13px "Roboto Slab",serif}.platform-overview__grid h3{margin:22px 0 12px;color:#6b2a2f;font:800 25px/1.15 "Roboto Slab",serif}.platform-overview__grid p{margin:0;color:#505050;font:500 15px/1.55 Roboto,sans-serif}.platform-overview__grid strong{display:block;margin-top:20px;color:#4c0815;font:800 14px "Roboto Slab",serif}@media(max-width:920px){.platform-overview__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.platform-overview__grid{grid-template-columns:1fr}.platform-overview__grid a{min-height:0}}</style>
