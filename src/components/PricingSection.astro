---
interface Props {
  lang?: "en" | "es" | "pt";
}
import { marketPricing, defaultMarketForLocale, formatPrice, type PlanCode } from "../config/pricing";
const { lang = "en" } = Astro.props;
const check = "✓";
const defaultMarket = defaultMarketForLocale[lang];
const defaultPricing = marketPricing[defaultMarket];
const price = (plan: PlanCode, period: "monthly" | "annual") => formatPrice(defaultPricing.prices[plan][period], defaultPricing.currency, lang);
const priceData = Object.fromEntries(Object.entries(marketPricing).map(([market, config]) => [market, { currency: config.currency, locale: config.locale, prices: config.prices, additionalUser: config.additionalUser, singleDraft: config.singleDraft }]));
const unit = lang === "es" ? "/mes" : lang === "pt" ? "/mês" : "/mo";
const annualText = (plan: PlanCode) => lang === "es" ? `o ${price(plan,"annual")}/año · ahorra 2 meses` : lang === "pt" ? `ou ${price(plan,"annual")}/ano · economize 2 meses` : `or ${price(plan,"annual")}/yr · save 2 months`;
const copy = lang === "es"
