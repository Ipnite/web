---
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;
const check = "✓";
const prefix = lang === "es" ? "/es" : lang === "pt" ? "/pt-br" : "";
const localizedPath = (path) => `${prefix}${path}`;

const copy = lang === "es"
  ? {
      heading: ["Mantenlo simple. ", "Tres planes"],
      freemium: { title: "Freemium", price: "$0.00", lede: "IPnite invierte en ti.", copy: "Para fundadores seleccionados en etapa temprana. El acceso puede ofrecerse a cambio de un pequeño porcentaje del emprendimiento, sujeto a términos separados.", features: ["Redacción asistida.", "Contacto con despachos en el país objetivo.", "Punto de entrada amigable para fundadores."], cta: "Empezar gratis" },
      starter: { eyebrow: "Paga sobre la marcha", title: "Inicial", price: "Desde $99.00", lede: "Precio basado en paquetes de créditos.", copy: "Compra créditos según necesites y úsalos en redacción, revisión de arte previo, variantes, reivindicaciones y exportación.", features: ["Paquetes de créditos flexibles.", "Ahorra más de $3,000 por borrador frente a costos tradicionales típicos."], cta: "Empezar tu borrador" },
      pro: { title: "Profesional", price: "$499.00", lede: "Facturación mensual o anual.", copy: "Para fundadores y equipos que necesitan capacidad recurrente de redacción, iteración y soporte estratégico más profundo.", note: "Especialmente para startups, universidades y aceleradoras.", features: ["Gestión de portafolio.", "Búsqueda de patentes recurrente.", "Análisis de patentes mejorado."], cta: "Elegir Profesional" },
    }
  : lang === "pt"
  ? {
      heading: ["Mantenha simples. ", "Tres planos"],
      freemium: { title: "Freemium", price: "$0.00", lede: "A IPnite investe em você.", copy: "Para fundadores selecionados em fase inicial. O acesso pode ser oferecido em troca de uma pequena porcentagem do empreendimento, sujeito a termos separados.", features: ["Redação assistida.", "Contato com escritórios no país pretendido.", "Ponto de entrada amigável para fundadores."], cta: "Começar grátis" },
      starter: { eyebrow: "Pague conforme usar", title: "Inicial", price: "A partir de $99.00", lede: "Precificação baseada em pacotes de créditos.", copy: "Compre créditos conforme precisar e use-os em redação, revisão de arte anterior, variantes, reivindicações e exportação.", features: ["Pacotes de créditos flexíveis.", "Economize mais de $3,000 por rascunho em comparação com custos tradicionais típicos."], cta: "Começar seu rascunho" },
      pro: { title: "Profissional", price: "$499.00", lede: "Faturamento mensal ou anual.", copy: "Para fundadores e equipes que precisam de capacidade recorrente de redação, iteração e suporte estratégico mais profundo.", note: "Especialmente para startups, universidades e aceleradoras.", features: ["Gestão de portfólio.", "Busca de patentes recorrente.", "Análise de patentes aprimorada."], cta: "Escolher Profissional" },
    }
  : {
      heading: ["Keep It Simple. ", "Three Plans"],
      freemium: { title: "Freemium", price: "$0.00", lede: "IPnite invests in you.", copy: "For selected early-stage founders. Access may be offered in exchange for a small percentage of the venture, subject to separate terms.", features: ["Assisted drafting.", "Contact with law firms in the intended country.", "Founder-friendly entry point."], cta: "Start free" },
      starter: { eyebrow: "Pay as you go", title: "Starter", price: "From $99.00", lede: "Credit pack-based pricing.", copy: "Buy credits as needed and use them across drafting, prior-art review, variants, claims, and export actions.", features: ["Flexible credit packs.", "Save $3,000+ per patent draft compared with typical traditional preparation costs."], cta: "Start your draft" },
      pro: { title: "Professional", price: "$499.00", lede: "Monthly or yearly billing.", copy: "For founders and teams that need recurring drafting capacity, iteration, and deeper strategy support.", note: "Especially for startups, universities, and accelerators.", features: ["Portfolio management.", "Recurring patent search.", "Enhanced patent analysis."], cta: "Choose Professional" },
    };
---

<section id="plans" aria-labelledby="pricing-heading" class="pricing">
  <div class="pricing__inner">
    <h2 id="pricing-heading">
      <span>{copy.heading[0]}</span>
      <strong>{copy.heading[1]}</strong>
    </h2>

    <div class="pricing__cards">
      <article class="plan-card">
        <header>
          <h3>{copy.freemium.title}</h3>
          <p class="plan-card__price">{copy.freemium.price}</p>
          <p class="plan-card__lede">{copy.freemium.lede}</p>
        </header>

        <p class="plan-card__copy">
          {copy.freemium.copy}
        </p>

        <ul class="plan-card__features">
          {copy.freemium.features.map((feature) => <li><span>{check}</span>{feature}</li>)}
        </ul>

        <a
          class="plan-card__cta"
          href={localizedPath("/coming-soon")}
          data-analytics-label={`pricing_${lang}_freemium_coming_soon`}
        >
          {copy.freemium.cta}
        </a>
      </article>

      <article class="plan-card plan-card--featured">
        <header>
          <p class="plan-card__eyebrow">{copy.starter.eyebrow}</p>
          <h3>{copy.starter.title}</h3>
          <p class="plan-card__price">{copy.starter.price}</p>
          <p class="plan-card__lede">{copy.starter.lede}</p>
        </header>

        <p class="plan-card__copy">
          {copy.starter.copy}
        </p>

        <div class="credit-packs" aria-label="Starter credit packs">
          <div>
            <strong>Basic</strong>
            <span>$99 USD</span>
            <small>150 credits</small>
          </div>
          <div>
            <strong>Pro</strong>
            <span>$199 USD</span>
            <small>350 credits</small>
          </div>
        </div>

        <ul class="plan-card__features">
          {copy.starter.features.map((feature) => <li><span>{check}</span>{feature}</li>)}
        </ul>

        <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer">
          {copy.starter.cta}
        </a>
      </article>

      <article class="plan-card">
        <header>
          <h3>{copy.pro.title}</h3>
          <p class="plan-card__price">{copy.pro.price}</p>
          <p class="plan-card__lede">{copy.pro.lede}</p>
        </header>

        <p class="plan-card__copy">
          {copy.pro.copy}
          <small class="plan-card__note">{copy.pro.note}</small>
        </p>

        <ul class="plan-card__features">
          {copy.pro.features.map((feature) => <li><span>{check}</span>{feature}</li>)}
        </ul>

        <a
          class="plan-card__cta"
          href={localizedPath("/coming-soon")}
          data-analytics-label={`pricing_${lang}_professional_coming_soon`}
        >
          {copy.pro.cta}
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: #fff;
    padding: 18px clamp(18px, 5vw, 80px) 88px;
    overflow: hidden;
  }

  .pricing__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .pricing h2 {
    margin: 0;
    text-align: center;
    font-family: "Roboto Slab", serif;
    font-size: clamp(42px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.18;
    color: #505050;
    letter-spacing: 0;
  }

  .pricing h2 strong {
    color: #6b2a2f;
    font-weight: 800;
  }

  .pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
    align-items: stretch;
  }

  .plan-card {
    display: flex;
    min-height: 610px;
    flex-direction: column;
    border: 1px solid rgba(107, 42, 47, 0.45);
    border-radius: 24px;
    background: #fff;
    padding: 30px 30px 28px;
    text-align: center;
    box-shadow: 0 10px 28px rgba(76, 8, 21, 0.04);
  }

  .plan-card--featured {
    border-color: rgba(107, 42, 47, 0.75);
    box-shadow: 0 16px 36px rgba(107, 42, 47, 0.12);
  }

  .plan-card__eyebrow {
    margin: -4px 0 8px;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.2;
  }

  .plan-card h3 {
    margin: 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(36px, 3vw, 48px);
    font-weight: 800;
    line-height: 1.1;
  }

  .plan-card__price {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 2.8vw, 42px);
    font-weight: 800;
    line-height: 1.08;
  }

  .plan-card__lede {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.35;
  }

  .plan-card__copy {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .plan-card__note {
    display: block;
    margin-top: 8px;
    color: #8f6e72;
    font-family: "Roboto", sans-serif;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .credit-packs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
  }

  .credit-packs div {
    border-radius: 16px;
    background: #ededed;
    padding: 14px 10px;
    color: #4c0815;
    font-family: "Roboto", sans-serif;
  }

  .credit-packs strong,
  .credit-packs span,
  .credit-packs small {
    display: block;
  }

  .credit-packs strong {
    font-family: "Roboto Slab", serif;
    font-size: 22px;
    font-weight: 800;
  }

  .credit-packs span {
    margin-top: 5px;
    font-size: 17px;
    font-weight: 800;
  }

  .credit-packs small {
    margin-top: 4px;
    color: #505050;
    font-size: 14px;
    font-weight: 700;
  }

  .plan-card__features {
    display: grid;
    gap: 13px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .plan-card__features li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.32;
  }

  .plan-card__features span {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    font-weight: 900;
    line-height: 1;
  }

  .plan-card__cta {
    display: inline-flex;
    min-height: 45px;
    margin: auto auto 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    background: #ededed;
    padding: 0 24px;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
    line-height: 1;
    text-decoration: underline;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .plan-card__cta:hover {
    background: #6b2a2f;
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 1040px) {
    .pricing__cards {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }

    .plan-card {
      min-height: auto;
    }
  }

  @media (max-width: 560px) {
    .pricing {
      padding-inline: 16px;
    }

    .pricing h2 span,
    .pricing h2 strong {
      display: block;
    }

    .plan-card {
      padding: 26px 20px 24px;
    }

    .plan-card__eyebrow {
      font-size: 15px;
    }

    .plan-card h3 {
      font-size: 34px;
    }

    .plan-card__price {
      font-size: 28px;
    }

    .plan-card__lede {
      font-size: 17px;
      line-height: 1.3;
    }

    .plan-card__copy {
      font-size: 15px;
      line-height: 1.45;
    }

    .plan-card__features li {
      font-size: 15px;
      line-height: 1.3;
    }

    .plan-card__cta {
      width: 100%;
      font-size: 16px;
      white-space: normal;
      text-align: center;
    }

    .credit-packs {
      grid-template-columns: 1fr;
    }

    .credit-packs div {
      padding: 12px 10px;
    }

    .credit-packs strong {
      font-size: 20px;
    }

    .credit-packs span {
      font-size: 15px;
    }

    .credit-packs small {
      font-size: 13px;
    }
  }
</style>
