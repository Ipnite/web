          "1 colaborador externo.",
          "1 GB de armazenamento seguro.",
          "Análise FTO disponível como complemento.†",
        ],
        cta: "Começar agora",
      },
      startup: {
        title: "STARTUP",
        copy: "Para startups que constroem e gerenciam um portfólio de propriedade intelectual.",
        features: [
          "Até 10 projetos ativos.",
          "10 buscas de anterioridade por mês.",
          "Busca de patenteabilidade.†",
          "Redação, desenhos e controle de qualidade assistidos por IA.",
          "Exportação em DOCX, JSON e ZIP.",
          "Gestão de portfólio e depósitos.",
          "Até 3 colaboradores por projeto.",
          "15 GB de armazenamento seguro.",
          "Análise FTO disponível como complemento.†",
        ],
        cta: "Começar agora",
      },
      institutional: {
        title: "INSTITUCIONAL",
        copy: "Para escritórios, universidades, NITs e equipes de propriedade intelectual. Inclui 3 usuários.",
        features: [
          "Projetos ativos ilimitados.*",
          "50 buscas de anterioridade por mês.",
          "Todos os módulos da IPnite.",
          "Módulo FTO incluído.†",
          "Exportação em DOCX, JSON e ZIP.",
          "Gestão avançada de portfólio e depósitos.",
          "Gestão de equipes e permissões.",
          "Gestão de divulgações de invenção.",
          "50 GB de armazenamento seguro.",
        ],
        cta: "Falar com vendas",
      },
      additionalUsers: "Usuários adicionais",
      showAll: "Ver todos os benefícios",
      trialTitle: "Experimente a IPnite grátis",
      trialBody: "Explore sua invenção com o Agente de descoberta e faça sua primeira busca de anterioridade. 7 dias, 1 busca, sem cartão e sem cobranças automáticas.",
      trialCta: "Começar teste grátis",
      fairUse: "*Sujeito a uma política de uso razoável.",
      reviewNote: "†As análises de patenteabilidade e FTO são entregáveis assistidos por IA. Você é responsável por revisá-las ou enviá-las para revisão profissional; a IPnite não garante suas conclusões.",
      regionalNote: "Selecione seu país ou região para ver preços locais. Os planos são renovados automaticamente a cada mês ou ano até que você cancele; você pode cancelar a qualquer momento pela sua conta e mantém o acesso até o fim do período pago. Impostos, tarifas e total final são confirmados no pagamento.",
    }
  : {
      heading: ["Search, draft and manage. ", "Three plans"],
      inventor: {
        title: "INVENTOR",
        copy: "For independent inventors protecting and managing their ideas.",
        features: [
          "1 active project.",
          "2 prior-art searches per month.",
          "Patentability search.†",
          "AI-assisted drafting, drawings and QA.",
          "DOCX export.",
          "Filing management, calendar and next-step guidance.",
          "1 external collaborator.",
          "1 GB secure storage.",
          "FTO analysis available as an add-on.†",
        ],
        cta: "Start now",
      },
      startup: {
        title: "STARTUP",
        copy: "For startups building and managing an IP portfolio.",
        features: [
          "Up to 10 active projects.",
          "10 prior-art searches per month.",
          "Patentability search.†",
          "AI-assisted drafting, drawings and QA.",
          "DOCX, JSON and ZIP export.",
          "Portfolio and filing management.",
          "Up to 3 collaborators per project.",
          "15 GB secure storage.",
          "FTO analysis available as an add-on.†",
        ],
        cta: "Start now",
      },
      institutional: {
        title: "INSTITUTIONAL",
        copy: "For law firms, universities, TTOs and IP teams. Includes 3 users.",
        features: [
          "Unlimited active projects.*",
          "50 prior-art searches per month.",
          "All IPnite modules.",
          "FTO module included.†",
          "DOCX, JSON and ZIP export.",
          "Advanced portfolio and filing management.",
          "Team management and permissions.",
          "Invention disclosure management.",
          "50 GB secure storage.",
        ],
        cta: "Talk to Sales",
      },
      additionalUsers: "Additional users",
      showAll: "View all benefits",
      trialTitle: "Try IPnite free",
      trialBody: "Explore your invention with the Discovery Agent and run your first prior-art search. 7 days, 1 search, no credit card and no automatic charges.",
      trialCta: "Start your free trial",
      fairUse: "*Subject to a reasonable-use policy.",
      reviewNote: "†Patentability and FTO analyses are AI-assisted deliverables. You are responsible for reviewing them or having them professionally reviewed; IPnite does not guarantee their conclusions.",
      regionalNote: "Select your country or region to see local pricing. Plans renew automatically every month or year until you cancel; you can cancel anytime from your account and keep access until the end of the paid period. Taxes, fees and the final total are confirmed at checkout.",
    };
const singleDraftCopy = lang === "es"
  ? {
      heading: "¿Solo necesitas redactar una patente?",
      body: "¿Aún no quieres una suscripción? Crea un borrador completo de patente para una sola invención con un pago único.",
      payment: "Pago único. Sin suscripción.",
      cta: "Crear un borrador de patente",
      ongoing: "Para seguir trabajando en tus invenciones y gestionar tu propiedad intelectual a lo largo del tiempo, elige una suscripción.",
    }
  : lang === "pt"
  ? {
      heading: "Precisa redigir apenas uma patente?",
      body: "Ainda não quer uma assinatura? Crie uma minuta completa de patente para uma única invenção com um pagamento único.",
      payment: "Pagamento único. Sem assinatura.",
      cta: "Criar uma minuta de patente",
      ongoing: "Para continuar trabalhando nas suas invenções e gerenciar sua propriedade intelectual ao longo do tempo, escolha uma assinatura.",
    }
  : {
      heading: "Need just one draft?",
      body: "Not ready for a subscription? Create one complete patent draft for a single invention with a one-time payment.",
      payment: "One-time payment. No subscription required.",
      cta: "Create a single draft",
      ongoing: "Choose a subscription to keep working on your inventions and managing your intellectual property over time.",
    };
const plans: Array<{ code: PlanCode; content: typeof copy.inventor; featured?: boolean; sales?: boolean }> = [
  { code: "inventor", content: copy.inventor },
  { code: "startup", content: copy.startup, featured: true },
  { code: "institutional", content: copy.institutional, sales: true },
];
const contactPath = lang === "es" ? "/es/?plan=institutional#contact" : lang === "pt" ? "/pt-br/?plan=institutional#contact" : "/?plan=institutional#contact";
---

<section id="plans" aria-labelledby="pricing-heading" class="pricing" data-analytics-location="pricing">
  <div class="pricing__inner">
    <h2 id="pricing-heading"><span>{copy.heading[0]}</span><strong>{copy.heading[1]}</strong></h2>
    <div class="pricing__trial">
      <strong>{copy.trialTitle}</strong>
      <p>{copy.trialBody}</p>
      <a class="pricing__trial-cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta="try_ipnite_free" data-analytics-event="pricing_cta_clicked" data-analytics-plan="free_trial">
        {copy.trialCta}
      </a>
    </div>
    <div class="pricing__cards">
      {plans.map(({ code, content, featured, sales }) => (
        <article class:list={["plan-card", { "plan-card--featured": featured }]}>
          <header>
            <h3>{content.title}</h3>
            <p class="plan-card__price" data-price-plan={code}>{price(code,"monthly")}<span class="plan-card__price-unit">{unit}</span></p>
            <p class="plan-card__lede" data-annual-plan={code}>{annualText(code)}</p>
          </header>
          <p class="plan-card__copy">{content.copy}</p>
          <ul class="plan-card__features plan-card__features--primary">
            {content.features.slice(0, 4).map((feature) => <li><span>{check}</span>{feature}</li>)}
          </ul>
          <details class="plan-card__details">
            <summary>{copy.showAll}</summary>
            <ul class="plan-card__features plan-card__features--extra">
              {content.features.slice(4).map((feature) => <li><span>{check}</span>{feature}</li>)}
            </ul>
            {code === "institutional" && (
              <p class="plan-card__additional" data-additional-user>{copy.additionalUsers}: {formatPrice(defaultPricing.additionalUser.monthly, defaultPricing.currency, lang)}{unit} · {formatPrice(defaultPricing.additionalUser.annual, defaultPricing.currency, lang)}/{lang === "es" ? "año" : lang === "pt" ? "ano" : "yr"}</p>
            )}
          </details>
          <a class="plan-card__cta" href={sales ? contactPath : "https://app.ipnite.com"} target={sales ? undefined : "_blank"} rel={sales ? undefined : "noopener noreferrer"} data-analytics-cta={sales ? "talk_to_sales" : `start_${code}`} data-analytics-event="pricing_cta_clicked" data-analytics-plan={code}>
            {content.cta}
          </a>
        </article>
      ))}
    </div>
    <div class="pricing__research pricing__single-draft">
      <strong>{singleDraftCopy.heading}</strong>
      <p>{singleDraftCopy.body}</p>
      <p><b>Single Draft · <span data-single-draft-price>{formatPrice(defaultPricing.singleDraft, defaultPricing.currency, lang)}</span></b></p>
      <p>{singleDraftCopy.payment}</p>
      <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta="single_draft" data-analytics-event="pricing_cta_clicked" data-analytics-plan="single_draft">
        {singleDraftCopy.cta}
      </a>
      <p>{singleDraftCopy.ongoing}</p>
    </div>
    <p class="pricing__fair-use">{copy.fairUse}</p>
    <p class="pricing__fair-use pricing__review-note">{copy.reviewNote}</p>
    <p class="pricing__regional-note">{copy.regionalNote}</p>
  </div>
</section>

<script is:inline define:vars={{ priceData, lang, unit }}>
  (() => {
    const locale = lang === "es" ? "es-MX" : lang === "pt" ? "pt-BR" : "en-US";
    const defaultMarket = lang === "es" ? "LATAM" : lang === "pt" ? "BR" : "US";
    const format = (amount, currency) => new Intl.NumberFormat(locale, { style: "currency", currency, maximumFractionDigits: 0 }).format(amount);
    // A market only applies on pages in its own language (US → en, MX/AR/LATAM → es, BR → pt).
    const marketFor = (market) => priceData[market] && priceData[market].locale === lang ? market : defaultMarket;
    function update(market) {
      const config = priceData[marketFor(market)];
      document.querySelectorAll("[data-price-plan]").forEach((node) => {
        const plan = node.getAttribute("data-price-plan");
        node.innerHTML = `${format(config.prices[plan].monthly, config.currency)}<span class="plan-card__price-unit">${unit}</span>`;
      });
      document.querySelectorAll("[data-annual-plan]").forEach((node) => {
        const plan = node.getAttribute("data-annual-plan");
        const annual = format(config.prices[plan].annual, config.currency);
        node.textContent = lang === "es" ? `o ${annual}/año · ahorra 2 meses` : lang === "pt" ? `ou ${annual}/ano · economize 2 meses` : `or ${annual}/yr · save 2 months`;
      });
      document.querySelectorAll("[data-additional-user]").forEach((node) => {
        const monthly = format(config.additionalUser.monthly, config.currency);
        const annual = format(config.additionalUser.annual, config.currency);
        const label = lang === "es" ? "Usuarios adicionales" : lang === "pt" ? "Usuários adicionais" : "Additional users";
        const year = lang === "es" ? "año" : lang === "pt" ? "ano" : "yr";
        node.textContent = `${label}: ${monthly}${unit} · ${annual}/${year}`;
      });
      document.querySelectorAll("[data-single-draft-price]").forEach((node) => {
        node.textContent = format(config.singleDraft, config.currency);
      });
      document.documentElement.classList.remove("pricing-pending");
    }
    let market = defaultMarket;
    try { market = localStorage.getItem("ipnite_market") || defaultMarket; } catch (error) {}
    update(market);
    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement) || !target.matches("[data-country-selector]")) return;
      update(target.value);
    });
  })();
</script>

<style>
  .pricing {
    background: #fff;
    padding: 18px clamp(18px, 5vw, 80px) 88px;
    overflow: hidden;
  }

  .pricing__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .pricing h2 {
    margin: 0;
    text-align: center;
    font-family: "Roboto Slab", serif;
    font-size: clamp(42px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.18;
    color: #505050;
    letter-spacing: 0;
  }

  .pricing h2 span { color: #6b2a2f; font-weight: 400; }
  .pricing h2 strong { color: #505050; font-weight: 700; }

  .pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
    align-items: start;
  }

  .plan-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(107, 42, 47, 0.45);
    border-radius: 24px;
    background: #fff;
    padding: 30px 30px 28px;
    text-align: center;
    box-shadow: 0 10px 28px rgba(76, 8, 21, 0.04);
  }

  .plan-card--featured {
    border-color: rgba(107, 42, 47, 0.75);
    box-shadow: 0 16px 36px rgba(107, 42, 47, 0.12);
  }

  .plan-card h3 {
    margin: 0;
    overflow-wrap: normal;
    word-break: normal;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(28px, 2.4vw, 40px);
    font-weight: 800;
    line-height: 1.1;
  }

  .plan-card__price {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 2.8vw, 42px);
    font-weight: 800;
    line-height: 1.08;
  }

  .plan-card__price-unit {
    margin-left: 4px;
    color: #8f6e72;
    font-family: "Roboto", sans-serif;
    font-size: clamp(15px, 1.3vw, 18px);
    font-weight: 700;
  }

  .plan-card__lede {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.35;
  }

  .plan-card__copy {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .plan-card__features {
    display: grid;
    gap: 13px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .plan-card__features li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.32;
  }

  .plan-card__features span {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    font-weight: 900;
    line-height: 1;
  }

  .plan-card__details {
    margin: 22px 0 0;
    border-top: 1px solid rgba(107, 42, 47, 0.16);
    padding-top: 16px;
    text-align: left;
  }

  .plan-card__details summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  .plan-card__details summary::-webkit-details-marker { display: none; }

  .plan-card__details summary::after {
    content: "+";
    display: inline-flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(107, 42, 47, 0.4);
    border-radius: 999px;
    font-family: "Roboto", sans-serif;
    line-height: 1;
  }

  .plan-card__details[open] summary::after { content: "−"; }

  .plan-card__details summary:focus-visible {
    border-radius: 6px;
    outline: 3px solid rgba(107, 42, 47, 0.24);
    outline-offset: 4px;
  }

  .plan-card__features--extra { margin-top: 18px; }

  .plan-card__additional {
    margin: 22px 0 0;
    color: #4c0815;
    font-family: "Roboto", sans-serif;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.45;
  }

  .plan-card__cta {
    display: inline-flex;
    min-height: 45px;
    margin: 24px auto 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    background: #ededed;
    padding: 0 24px;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
    line-height: 1;
    text-decoration: underline;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .plan-card__cta:hover {
    background: #6b2a2f;
    color: #fff;
    transform: translateY(-1px);
  }

  .pricing__trial {
    display: flex;
    max-width: 820px;
    margin: 40px auto 0;
    border-radius: 24px;
    background: #f7f3f3;
    padding: 28px clamp(20px, 4vw, 38px);
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .pricing__trial-cta {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    padding: 0 34px;
    color: #fff;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 12px 28px rgba(107, 42, 47, 0.2);
    transition: background 180ms ease, transform 180ms ease;
  }

  .pricing__trial-cta:hover {
    background: #4c0815;
    transform: translateY(-1px);
  }

  .pricing__trial strong {
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 26px;
  }

  .pricing__trial p {
    max-width: 640px;
    margin: 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .pricing__research {
    max-width: 820px;
    margin: 34px auto 0;
    border: 1px solid rgba(107, 42, 47, 0.24);
    border-radius: 24px;
    background: rgba(107, 42, 47, 0.04);
    padding: 24px clamp(20px, 4vw, 38px);
    text-align: center;
  }

  .pricing__research strong {
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 24px;
  }

  .pricing__research p,
  .pricing__fair-use,
  .pricing__regional-note {
    max-width: 760px;
    margin: 10px auto 0;
    color: #777071;
    font-family: "Roboto", sans-serif;
