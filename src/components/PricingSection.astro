---
const check = "✓";
---

<section id="plans" aria-labelledby="pricing-heading" class="pricing">
  <div class="pricing__inner">
    <h2 id="pricing-heading">
      <span>Keep It Simple. </span>
      <strong>Three Plans</strong>
    </h2>

    <div class="pricing__cards">
      <article class="plan-card">
        <header>
          <h3>Freemium</h3>
          <p class="plan-card__price">$0.00</p>
          <p class="plan-card__lede">IPnite invests in you.</p>
        </header>

        <p class="plan-card__copy">
          For selected early-stage founders. Access may be offered in exchange
          for a small percentage of the venture, subject to separate terms.
        </p>

        <ul class="plan-card__features">
          <li><span>{check}</span>Initial guided workflow.</li>
          <li><span>{check}</span>Founder-friendly entry point.</li>
        </ul>

        <a class="plan-card__cta" href="/coming-soon">
          Start free
        </a>
      </article>

      <article class="plan-card plan-card--featured">
        <header>
          <p class="plan-card__eyebrow">Pay as you go</p>
          <h3>Starter</h3>
          <p class="plan-card__price">From $99.00</p>
          <p class="plan-card__lede">Credit pack-based pricing.</p>
        </header>

        <p class="plan-card__copy">
          Buy credits as needed and use them across drafting, prior-art review,
          variants, claims, and export actions.
        </p>

        <div class="credit-packs" aria-label="Starter credit packs">
          <div>
            <strong>Basic</strong>
            <span>$99 USD</span>
            <small>150 credits</small>
          </div>
          <div>
            <strong>Pro</strong>
            <span>$199 USD</span>
            <small>500 credits</small>
          </div>
        </div>

        <ul class="plan-card__features">
          <li><span>{check}</span>Flexible credit packs.</li>
          <li><span>{check}</span>Save $3,000+ per patent draft compared with typical traditional preparation costs.</li>
        </ul>

        <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer">
          Start your draft
        </a>
      </article>

      <article class="plan-card">
        <header>
          <h3>Professional</h3>
          <p class="plan-card__price">$299.00</p>
          <p class="plan-card__lede">Monthly or yearly billing.</p>
        </header>

        <p class="plan-card__copy">
          For founders and teams that need recurring drafting capacity,
          iteration, and deeper strategy support.
        </p>

        <ul class="plan-card__features">
          <li><span>{check}</span>Recurring workflow access.</li>
          <li><span>{check}</span>More room to iterate.</li>
        </ul>

        <a class="plan-card__cta" href="/coming-soon">
          Choose Professional
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: #fff;
    padding: 35px clamp(18px, 5vw, 80px) 120px;
    overflow: hidden;
  }

  .pricing__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .pricing h2 {
    margin: 0;
    text-align: center;
    font-family: "Roboto Slab", serif;
    font-size: clamp(42px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.18;
    color: #505050;
    letter-spacing: 0;
  }

  .pricing h2 strong {
    color: #6b2a2f;
    font-weight: 800;
  }

  .pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
    align-items: stretch;
  }

  .plan-card {
    display: flex;
    min-height: 610px;
    flex-direction: column;
    border: 1px solid rgba(107, 42, 47, 0.45);
    border-radius: 24px;
    background: #fff;
    padding: 30px 30px 28px;
    text-align: center;
    box-shadow: 0 10px 28px rgba(76, 8, 21, 0.04);
  }

  .plan-card--featured {
    border-color: rgba(107, 42, 47, 0.75);
    box-shadow: 0 16px 36px rgba(107, 42, 47, 0.12);
  }

  .plan-card__eyebrow {
    margin: -4px 0 8px;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.2;
  }

  .plan-card h3 {
    margin: 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(36px, 3vw, 48px);
    font-weight: 800;
    line-height: 1.1;
  }

  .plan-card__price {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 2.8vw, 42px);
    font-weight: 800;
    line-height: 1.08;
  }

  .plan-card__lede {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.35;
  }

  .plan-card__copy {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .credit-packs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
  }

  .credit-packs div {
    border-radius: 16px;
    background: #ededed;
    padding: 14px 10px;
    color: #4c0815;
    font-family: "Roboto", sans-serif;
  }

  .credit-packs strong,
  .credit-packs span,
  .credit-packs small {
    display: block;
  }

  .credit-packs strong {
    font-family: "Roboto Slab", serif;
    font-size: 22px;
    font-weight: 800;
  }

  .credit-packs span {
    margin-top: 5px;
    font-size: 17px;
    font-weight: 800;
  }

  .credit-packs small {
    margin-top: 4px;
    color: #505050;
    font-size: 14px;
    font-weight: 700;
  }

  .plan-card__features {
    display: grid;
    gap: 13px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .plan-card__features li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.32;
  }

  .plan-card__features span {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    font-weight: 900;
    line-height: 1;
  }

  .plan-card__cta {
    display: inline-flex;
    min-height: 45px;
    margin: auto auto 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    background: #ededed;
    padding: 0 24px;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
    line-height: 1;
    text-decoration: underline;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .plan-card__cta:hover {
    background: #6b2a2f;
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 1040px) {
    .pricing__cards {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }

    .plan-card {
      min-height: auto;
    }
  }

  @media (max-width: 560px) {
    .pricing {
      padding-inline: 16px;
    }

    .pricing h2 span,
    .pricing h2 strong {
      display: block;
    }

    .plan-card {
      padding: 26px 20px 24px;
    }

    .credit-packs {
      grid-template-columns: 1fr;
    }
  }
</style>
