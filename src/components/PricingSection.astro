      },
      startup: {
        title: "STARTUP",
        copy: "Para startups que construyen y gestionan una cartera de propiedad intelectual.",
        features: [
          "Hasta 10 proyectos activos.",
          "10 búsquedas de antecedentes por mes.",
          "Búsqueda de patentabilidad.†",
          "Redacción, dibujos y control de calidad asistidos por IA.",
          "Exportación en DOCX, JSON y ZIP.",
          "Gestión de cartera y presentaciones.",
          "Hasta 3 colaboradores por proyecto.",
          "15 GB de almacenamiento seguro.",
          "Análisis FTO disponible como complemento.†",
        ],
        cta: "Comenzar ahora",
      },
      institutional: {
        title: "INSTITUCIONAL",
        copy: "Para despachos, universidades, TTOs y equipos de propiedad intelectual. Incluye 3 usuarios.",
        features: [
          "Proyectos activos ilimitados.*",
          "50 búsquedas de antecedentes por mes.",
          "Todos los módulos de IPnite.",
          "Módulo FTO incluido.†",
          "Exportación en DOCX, JSON y ZIP.",
          "Gestión avanzada de cartera y presentaciones.",
          "Gestión de equipos y permisos.",
          "Gestión de divulgaciones de invención.",
          "50 GB de almacenamiento seguro.",
        ],
        cta: "Hablar con ventas",
      },
      additionalUsers: "Usuarios adicionales",
      showAll: "Ver todos los beneficios",
      trialTitle: "Prueba IPnite gratis",
      trialBody: "Explora tu invención con el Agente de descubrimiento y haz tu primera búsqueda de antecedentes. 7 días, 1 búsqueda, sin tarjeta y sin cobros automáticos.",
      trialCta: "Comenzar prueba gratis",
      fairUse: "*Sujeto a una política de uso razonable.",
      reviewNote: "†Los análisis de patentabilidad y FTO son entregables asistidos por IA. Tú eres responsable de revisarlos o de enviarlos a revisión profesional; IPnite no garantiza sus conclusiones.",
      regionalNote: "Selecciona tu país o región para ver precios locales. Los planes se renuevan automáticamente cada mes o cada año hasta que canceles; puedes cancelar en cualquier momento desde tu cuenta y conservas el acceso hasta el final del periodo pagado. Impuestos, comisiones y total final se confirman al pagar.",
    }
  : lang === "pt"
  ? {
      heading: ["Pesquise, redija e gerencie. ", "Três planos"],
      inventor: {
        title: "INVENTOR",
        copy: "Para inventores independentes que protegem e gerenciam suas ideias.",
        features: [
          "1 projeto ativo.",
          "2 buscas de anterioridade por mês.",
          "Busca de patenteabilidade.†",
          "Redação, desenhos e controle de qualidade assistidos por IA.",
          "Exportação em DOCX.",
