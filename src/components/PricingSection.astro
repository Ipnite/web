---
interface Props {
  lang?: "en" | "es" | "pt";
  mode?: "all" | "entry" | "subscriptions";
}
import { marketPricing, defaultMarketForLocale, formatPrice, type PlanCode } from "../config/pricing";
const { lang = "en", mode = "all" } = Astro.props;
const check = "✓";
const defaultMarket = defaultMarketForLocale[lang];
const defaultPricing = marketPricing[defaultMarket];
const price = (plan: PlanCode, period: "monthly" | "annual") => formatPrice(defaultPricing.prices[plan][period], defaultPricing.currency, lang);
const priceData = Object.fromEntries(Object.entries(marketPricing).map(([market, config]) => [market, { currency: config.currency, locale: config.locale, prices: config.prices, additionalUser: config.additionalUser, singleDraft: config.singleDraft, draftAddon: config.draftAddon, ftoAddon: config.ftoAddon }]));
const unit = lang === "es" ? "/mes" : lang === "pt" ? "/mês" : "/mo";
const annualText = (plan: PlanCode) => lang === "es" ? `o ${price(plan,"annual")}/año · ahorra 2 meses` : lang === "pt" ? `ou ${price(plan,"annual")}/ano · economize 2 meses` : `or ${price(plan,"annual")}/yr · save 2 months`;
const copy = lang === "es"
  ? {
      heading: ["Busca, redacta y gestiona. ", "Tres planes"],
      inventor: {
        title: "INVENTOR",
        copy: "Para inventores independientes que protegen y gestionan sus ideas.",
        features: [
          "1 proyecto activo.",
          "2 búsquedas de antecedentes por mes.",
          "Espacio de trabajo, portafolio, documentos, fechas y alertas.",
          "Borradores completos disponibles como complementos con descuento.",
          "Búsqueda de patentabilidad.",
          "Exportación DOCX de los borradores adquiridos.",
          "1 colaborador externo.",
          "1 GB de almacenamiento seguro.",
        ],
        cta: "Comenzar ahora",
      },
      startup: {
        title: "STARTUP",
        copy: "Para startups que construyen y gestionan un portafolio de propiedad intelectual.",
        features: [
          "Hasta 10 proyectos activos.",
          "10 búsquedas de antecedentes por mes.",
          "Redacción, dibujos y revisión de calidad según los límites del plan.",
          "FTO como complemento, por jurisdicción.",
          "Gestión de portafolio y colaboración.",
          "Búsqueda de patentabilidad.",
          "Exportación en DOCX, JSON y ZIP.",
          "Hasta 3 colaboradores por proyecto.",
          "15 GB de almacenamiento seguro.",
        ],
        cta: "Comenzar ahora",
      },
      institutional: {
        title: "INSTITUCIONAL",
        copy: "Para despachos, universidades, oficinas de transferencia tecnológica y equipos de propiedad intelectual. Incluye 3 usuarios.",
        features: [
          "Gestión de proyectos de alto volumen.",
          "50 búsquedas de antecedentes por mes.",
          "Redacción de alto volumen y gestión de portafolio.",
          "FTO incluido.",
          "Todos los módulos de IPnite.",
          "Exportación en DOCX, JSON y ZIP.",
          "Gestión de equipos y permisos.",
          "Gestión de divulgaciones de invención.",
          "50 GB de almacenamiento seguro.",
        ],
        cta: "Hablar con ventas",
      },
      additionalUsers: "Usuarios adicionales",
      showAll: "Ver todos los beneficios",
      trialTitle: "Prueba IPnite gratis",
      trialBody: "7 días, sin tarjeta y sin cobros automáticos.",
      draftAddon: "Borrador completo para el plan Inventor",
      ftoAddon: "FTO para el plan Startup, por jurisdicción",
    }
  : lang === "pt"
  ? {
      heading: ["Pesquise, redija e gerencie. ", "Três planos"],
      inventor: {
        title: "INVENTOR",
        copy: "Para inventores independentes que protegem e gerenciam suas ideias.",
        features: [
          "1 projeto ativo.",
          "2 buscas de anterioridade por mês.",
          "Workspace, portfólio, documentos, datas e alertas.",
          "Minutas completas disponíveis como adicionais com desconto.",
          "Busca de patenteabilidade.",
          "Exportação DOCX de minutas adquiridas.",
          "1 colaborador externo.",
          "1 GB de armazenamento seguro.",
        ],
        cta: "Começar agora",
      },
      startup: {
        title: "STARTUP",
        copy: "Para startups que constroem e gerenciam um portfólio de propriedade intelectual.",
        features: [
          "Até 10 projetos ativos.",
          "10 buscas de anterioridade por mês.",
          "Redação, desenhos e QA conforme os limites do plano.",
          "FTO como adicional, por jurisdição.",
          "Gestão de portfólio e colaboração.",
          "Busca de patenteabilidade.",
          "Exportação em DOCX, JSON e ZIP.",
          "Até 3 colaboradores por projeto.",
          "15 GB de armazenamento seguro.",
        ],
        cta: "Começar agora",
      },
      institutional: {
        title: "INSTITUCIONAL",
        copy: "Para escritórios, universidades, NITs e equipes de propriedade intelectual. Inclui 3 usuários.",
        features: [
          "Gestão de projetos de alto volume.",
          "50 buscas de anterioridade por mês.",
          "Redação de alto volume e gestão de portfólio.",
          "FTO incluído.",
          "Todos os módulos da IPnite.",
          "Exportação em DOCX, JSON e ZIP.",
          "Gestão de equipes e permissões.",
          "Gestão de divulgações de invenção.",
          "50 GB de armazenamento seguro.",
        ],
        cta: "Falar com vendas",
      },
      additionalUsers: "Usuários adicionais",
      showAll: "Ver todos os benefícios",
      trialTitle: "Experimente a IPnite grátis",
      trialBody: "7 dias, sem cartão e sem cobranças automáticas.",
      draftAddon: "Minuta completa para Inventor",
      ftoAddon: "FTO para Startup, por jurisdição",
    }
  : {
      heading: ["Search, draft and manage. ", "Three plans"],
      inventor: {
        title: "INVENTOR",
        copy: "For independent inventors protecting and managing their ideas.",
        features: [
          "1 active project.",
          "2 prior-art searches per month.",
          "Workspace, portfolio, documents, dates and alerts.",
          "Full patent drafts available as discounted add-ons.",
          "Patentability search.",
          "DOCX export of purchased drafts.",
          "1 external collaborator.",
          "1 GB secure storage.",
        ],
        cta: "Start now",
      },
      startup: {
        title: "STARTUP",
        copy: "For startups building and managing an IP portfolio.",
        features: [
          "Up to 10 active projects.",
          "10 prior-art searches per month.",
          "Drafting, drawings and QA within plan limits.",
          "FTO available as an add-on, per jurisdiction.",
          "Portfolio management and collaboration.",
          "Patentability search.",
          "DOCX, JSON and ZIP export.",
          "Up to 3 collaborators per project.",
          "15 GB secure storage.",
        ],
        cta: "Start now",
      },
      institutional: {
        title: "INSTITUTIONAL",
        copy: "For law firms, universities, TTOs and IP teams. Includes 3 users.",
        features: [
          "High-volume project management.",
          "50 prior-art searches per month.",
          "High-volume drafting and portfolio management.",
          "FTO included.",
          "All IPnite modules.",
          "DOCX, JSON and ZIP export.",
          "Team management and permissions.",
          "Invention disclosure management.",
          "50 GB secure storage.",
        ],
        cta: "Talk to Sales",
      },
      additionalUsers: "Additional users",
      showAll: "View all benefits",
      trialTitle: "Try IPnite free",
      trialBody: "7 days, no credit card and no automatic charges.",
      draftAddon: "Full draft for Inventor",
      ftoAddon: "FTO for Startup, per jurisdiction",
    };
const singleDraftCopy = lang === "es"
  ? {
      tag: "El Redactor",
      heading: "Tu borrador de patente, listo para revisión",
      unit: "por borrador",
      payment: "Pago único. Sin suscripción.",
      includes: ["Reivindicaciones independientes y dependientes", "Descripción técnica y resumen", "Dibujos de referencia", "Revisión de calidad", "Exportación en DOCX"],
      cta: "Crear mi borrador",
      trialLead: "¿Vas a proteger varias ideas?",
      trialLink: "Prueba la plataforma 7 días gratis, sin tarjeta",
      imageAlt: "Inventora sosteniendo su borrador de patente listo para revisión",
    }
  : lang === "pt"
  ? {
      tag: "The Drafter",
      heading: "Sua minuta de patente, pronta para revisão",
      unit: "por minuta",
      payment: "Pagamento único. Sem assinatura.",
      includes: ["Reivindicações independentes e dependentes", "Relatório descritivo e resumo", "Desenhos de referência", "Revisão de qualidade (QA)", "Exportação em DOCX"],
      cta: "Criar minha minuta",
      trialLead: "Vai proteger várias ideias?",
      trialLink: "Experimente a plataforma grátis por 7 dias, sem cartão",
      imageAlt: "Inventora segurando sua minuta de patente pronta para revisão",
    }
  : {
      tag: "The Drafter",
      heading: "Your patent draft, ready for review",
      unit: "per draft",
      payment: "One-time payment. No subscription.",
      includes: ["Independent and dependent claims", "Technical specification and abstract", "Reference drawings", "Quality review (QA)", "DOCX export"],
      cta: "Create my draft",
      trialLead: "Protecting several ideas?",
      trialLink: "Try the platform free for 7 days, no credit card",
      imageAlt: "Inventor holding a patent draft ready for review",
    };
const entryHeading = lang === "es" ? "Empieza con tu invención" : lang === "pt" ? "Comece com sua invenção" : "Start with your invention";
const plans: Array<{ code: PlanCode; content: typeof copy.inventor; featured?: boolean; sales?: boolean }> = [
  { code: "inventor", content: copy.inventor },
  { code: "startup", content: copy.startup, featured: true },
  { code: "institutional", content: copy.institutional, sales: true },
];
const contactPath = lang === "es" ? "/es/?plan=institutional#contact" : lang === "pt" ? "/pt-br/?plan=institutional#contact" : "/?plan=institutional#contact";
---

<section id={mode === "entry" ? "draft-options" : "plans"} aria-labelledby={mode === "entry" ? "draft-options-heading" : "pricing-heading"} class="pricing" data-analytics-location="pricing">
  <div class="pricing__inner">
    {mode === "entry" ? <h2 id="draft-options-heading">{entryHeading}</h2> : <h2 id="pricing-heading"><span>{copy.heading[0]}</span><strong>{copy.heading[1]}</strong></h2>}
    {mode !== "entry" && <p class="pricing__trial-link pricing__trial-link--top"><strong>{copy.trialTitle}.</strong> {copy.trialBody}</p>}
    {mode !== "subscriptions" && (<>
    <article class="drafter-offer" aria-labelledby="drafter-offer-heading">
      <div class="drafter-offer__info">
        <h3 id="drafter-offer-heading">{singleDraftCopy.tag}</h3>
        <p class="plan-card__price"><span data-single-draft-price>{formatPrice(defaultPricing.singleDraft, defaultPricing.currency, lang)}</span><span class="plan-card__price-unit">{singleDraftCopy.unit}</span></p>
        <p class="plan-card__lede">{singleDraftCopy.heading}</p>
        <p class="plan-card__copy">{singleDraftCopy.payment}</p>
        <ul class="plan-card__features">
          {singleDraftCopy.includes.map((item) => <li><span aria-hidden="true">{check}</span>{item}</li>)}
        </ul>
        <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta="single_draft" data-analytics-event="pricing_cta_clicked" data-analytics-plan="single_draft">
          {singleDraftCopy.cta}
        </a>
      </div>
      <div class="drafter-offer__art">
        <img src="/images/drafter-offer.webp" width="502" height="562" alt={singleDraftCopy.imageAlt} loading="lazy" decoding="async" />
      </div>
    </article>
    </>)}
    {mode !== "entry" && (<>
    <div class="pricing__cards">
      {plans.map(({ code, content, featured, sales }) => (
        <article class:list={["plan-card", { "plan-card--featured": featured }]}>
          <header>
            <h3>{content.title}</h3>
            <p class="plan-card__price" data-price-plan={code}>{price(code,"monthly")}<span class="plan-card__price-unit">{unit}</span></p>
            <p class="plan-card__lede" data-annual-plan={code}>{annualText(code)}</p>
          </header>
          <p class="plan-card__copy">{content.copy}</p>
          <ul class="plan-card__features plan-card__features--primary">
            {content.features.slice(0, 4).map((feature) => <li><span>{check}</span>{feature}</li>)}
          </ul>
          <details class="plan-card__details">
            <summary>{copy.showAll}</summary>
            <ul class="plan-card__features plan-card__features--extra">
              {content.features.slice(4).map((feature) => <li><span>{check}</span>{feature}</li>)}
            </ul>
            {code === "inventor" && <p class="plan-card__additional">{copy.draftAddon}: <span data-draft-addon>{formatPrice(defaultPricing.draftAddon, defaultPricing.currency, lang)}</span></p>}
            {code === "startup" && <p class="plan-card__additional">{copy.ftoAddon}: <span data-fto-addon>{formatPrice(defaultPricing.ftoAddon, defaultPricing.currency, lang)}</span></p>}
            {code === "institutional" && (
              <p class="plan-card__additional" data-additional-user>{copy.additionalUsers}: {formatPrice(defaultPricing.additionalUser.monthly, defaultPricing.currency, lang)}{unit} · {formatPrice(defaultPricing.additionalUser.annual, defaultPricing.currency, lang)}/{lang === "es" ? "año" : lang === "pt" ? "ano" : "yr"}</p>
            )}
          </details>
          <a class="plan-card__cta" href={sales ? contactPath : "https://app.ipnite.com"} target={sales ? undefined : "_blank"} rel={sales ? undefined : "noopener noreferrer"} data-analytics-cta={sales ? "talk_to_sales" : `start_${code}`} data-analytics-event="pricing_cta_clicked" data-analytics-plan={code}>
            {content.cta}
          </a>
        </article>
      ))}
    </div>
    </>)}
    {mode !== "subscriptions" && (<>
    <p class="pricing__trial-link">
      {singleDraftCopy.trialLead}{" "}
      <a href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta="try_ipnite_free" data-analytics-event="pricing_cta_clicked" data-analytics-plan="free_trial">{singleDraftCopy.trialLink} →</a>
    </p>
    </>)}
  </div>
</section>

<script is:inline define:vars={{ priceData, lang, unit }}>
  (() => {
    const locale = lang === "es" ? "es-MX" : lang === "pt" ? "pt-BR" : "en-US";
    const defaultMarket = lang === "es" ? "LATAM" : lang === "pt" ? "BR" : "US";
    const format = (amount, currency) => new Intl.NumberFormat(locale, { style: "currency", currency, currencyDisplay: currency === "MXN" ? "code" : "symbol", maximumFractionDigits: 0 }).format(amount);
    // A market only applies on pages in its own language (US → en, MX/AR/LATAM → es, BR → pt).
    const marketFor = (market) => priceData[market] && priceData[market].locale === lang ? market : defaultMarket;
    function update(market) {
      const config = priceData[marketFor(market)];
      document.querySelectorAll("[data-price-plan]").forEach((node) => {
        const plan = node.getAttribute("data-price-plan");
        node.innerHTML = `${format(config.prices[plan].monthly, config.currency)}<span class="plan-card__price-unit">${unit}</span>`;
      });
      document.querySelectorAll("[data-annual-plan]").forEach((node) => {
        const plan = node.getAttribute("data-annual-plan");
        const annual = format(config.prices[plan].annual, config.currency);
        node.textContent = lang === "es" ? `o ${annual}/año · ahorra 2 meses` : lang === "pt" ? `ou ${annual}/ano · economize 2 meses` : `or ${annual}/yr · save 2 months`;
      });
      document.querySelectorAll("[data-additional-user]").forEach((node) => {
        const monthly = format(config.additionalUser.monthly, config.currency);
        const annual = format(config.additionalUser.annual, config.currency);
        const label = lang === "es" ? "Usuarios adicionales" : lang === "pt" ? "Usuários adicionais" : "Additional users";
        const year = lang === "es" ? "año" : lang === "pt" ? "ano" : "yr";
        node.textContent = `${label}: ${monthly}${unit} · ${annual}/${year}`;
      });
      document.querySelectorAll("[data-single-draft-price]").forEach((node) => {
        node.textContent = format(config.singleDraft, config.currency);
      });
      document.querySelectorAll("[data-draft-addon]").forEach((node) => { node.textContent = format(config.draftAddon, config.currency); });
      document.querySelectorAll("[data-fto-addon]").forEach((node) => { node.textContent = format(config.ftoAddon, config.currency); });
      document.documentElement.classList.remove("pricing-pending");
    }
    let market = defaultMarket;
    try { market = localStorage.getItem("ipnite_market") || defaultMarket; } catch (error) {}
    update(market);
    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement) || !target.matches("[data-country-selector]")) return;
      update(target.value);
    });
  })();
</script>

<style>
  #draft-options { padding-bottom: 24px; }

  .drafter-offer {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    max-width: 1040px;
    margin: 36px auto 0;
    border: 1px solid rgba(107, 42, 47, 0.75);
    border-radius: 24px;
    background: #fff;
    padding: clamp(26px, 4vw, 48px);
    box-shadow: 0 16px 36px rgba(107, 42, 47, 0.12);
    overflow: hidden;
  }
  .drafter-offer h3 {
    margin: 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(28px, 2.4vw, 40px);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .drafter-offer .plan-card__price-unit { margin-left: 8px; }
  .drafter-offer .plan-card__lede,
  .drafter-offer .plan-card__copy { margin-top: 12px; }
  .drafter-offer .plan-card__cta { margin-left: 0; }
  .drafter-offer__art { display: flex; justify-content: center; align-self: end; margin-bottom: calc(-1 * clamp(26px, 4vw, 48px)); }
  .drafter-offer__art img { display: block; width: min(100%, 420px); height: auto; }
  .pricing__trial-link { max-width: 820px; margin: 22px auto 0; color: #505050; text-align: center; font: 500 16px/1.5 Roboto, sans-serif; }
  .pricing__trial-link--top { margin: 14px auto 0; font-size: 17px; }
  .pricing__trial-link strong { color: #6b2a2f; }
  .pricing__trial-link a { color: #6b2a2f; font-weight: 700; text-decoration: underline; }

  .pricing {
    background: #fff;
    padding: 18px clamp(18px, 5vw, 80px) 88px;
    overflow: hidden;
  }

  .pricing__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .pricing h2 {
    margin: 0;
    text-align: center;
    font-family: "Roboto Slab", serif;
    font-size: clamp(42px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.18;
    color: #505050;
    letter-spacing: 0;
  }

  .pricing h2 span { color: #6b2a2f; font-weight: 400; }
  .pricing h2 strong { color: #505050; font-weight: 700; }

  .pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
    align-items: start;
  }

  .plan-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(107, 42, 47, 0.45);
    border-radius: 24px;
    background: #fff;
    padding: 30px 30px 28px;
    text-align: center;
    box-shadow: 0 10px 28px rgba(76, 8, 21, 0.04);
  }

  .plan-card--featured {
    border-color: rgba(107, 42, 47, 0.75);
    box-shadow: 0 16px 36px rgba(107, 42, 47, 0.12);
  }

  .plan-card h3 {
    margin: 0;
    overflow-wrap: normal;
    word-break: normal;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(28px, 2.4vw, 40px);
    font-weight: 800;
    line-height: 1.1;
  }

  .plan-card__price {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 2.8vw, 42px);
    font-weight: 800;
    line-height: 1.08;
  }

  .plan-card__price-unit {
    margin-left: 4px;
    color: #8f6e72;
    font-family: "Roboto", sans-serif;
    font-size: clamp(15px, 1.3vw, 18px);
    font-weight: 700;
  }

  .plan-card__lede {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.35;
  }

  .plan-card__copy {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .plan-card__features {
    display: grid;
    gap: 13px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .plan-card__features li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.32;
  }

  .plan-card__features span {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    font-weight: 900;
    line-height: 1;
  }

  .plan-card__details {
    margin: 22px 0 0;
    border-top: 1px solid rgba(107, 42, 47, 0.16);
    padding-top: 16px;
    text-align: left;
  }

  .plan-card__details summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  .plan-card__details summary::-webkit-details-marker { display: none; }

  .plan-card__details summary::after {
    content: "+";
    display: inline-flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(107, 42, 47, 0.4);
    border-radius: 999px;
    font-family: "Roboto", sans-serif;
    line-height: 1;
  }

  .plan-card__details[open] summary::after { content: "−"; }

  .plan-card__details summary:focus-visible {
    border-radius: 6px;
    outline: 3px solid rgba(107, 42, 47, 0.24);
    outline-offset: 4px;
  }

  .plan-card__features--extra { margin-top: 18px; }

  .plan-card__additional {
    margin: 22px 0 0;
    color: #4c0815;
    font-family: "Roboto", sans-serif;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.45;
  }

  .plan-card__cta {
    display: inline-flex;
    min-height: 45px;
    margin: 24px auto 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    background: #ededed;
    padding: 0 24px;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
