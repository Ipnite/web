---
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;
const check = "✓";

const copy = lang === "es"
  ? {
      heading: ["Mantenlo simple. ", "Tres planes"],
      basic: {
        title: "Basic",
        price: "$20",
        priceUnit: "/mes",
        lede: "o $200/año.",
        copy: "Para trabajo individual y enfocado en patentes.",
        features: [
          "1 proyecto activo.",
          "2 búsquedas de arte previo por mes.",
          "Espacio de trabajo individual.",
          "1 GiB de almacenamiento seguro.",
        ],
        cta: "Elegir Basic",
      },
      starter: {
        title: "Inicial",
        price: "$199",
        priceUnit: "/mes",
        lede: "o $1,990/año.",
        copy: "Para inventores y equipos chicos que necesitan más de un proyecto y capacidad para invitar colaboradores.",
        features: [
          "Hasta 10 proyectos activos.",
          "10 búsquedas de arte previo por mes.",
          "Hasta 2 colaboradores activos por proyecto.",
          "El dueño puede exportar proyectos como JSON y ZIP.",
        ],
        cta: "Elegir Inicial",
      },
      pro: {
        title: "Profesional",
        price: "$499",
        priceUnit: "/mes",
        lede: "o $4,990/año.",
        copy: "Para startups, universidades y aceleradoras que necesitan capacidad recurrente de redacción, búsqueda FTO y equipos más grandes.",
        features: [
          "Proyectos activos ilimitados.",
          "50 búsquedas de arte previo por mes.",
          "Hasta 10 colaboradores activos por proyecto.",
          "Incluye búsqueda FTO.",
          "El dueño puede exportar proyectos como JSON y ZIP.",
        ],
        cta: "Elegir Profesional",
      },
      trial: {
        cta: "Prueba Basic gratis durante 7 días",
        finePrint: "Se requiere tarjeta. La facturación comienza automáticamente después del trial, salvo que canceles.",
      },
    }
  : lang === "pt"
  ? {
      heading: ["Mantenha simples. ", "Tres planos"],
      basic: {
        title: "Basic",
        price: "$20",
        priceUnit: "/mês",
        lede: "ou $200/ano.",
        copy: "Para trabalho individual e focado em patentes.",
        features: [
          "1 projeto ativo.",
          "2 buscas de arte anterior por mês.",
          "Espaço de trabalho individual.",
          "1 GiB de armazenamento seguro.",
        ],
        cta: "Escolher Basic",
      },
      starter: {
        title: "Inicial",
        price: "$199",
        priceUnit: "/mês",
        lede: "ou $1,990/ano.",
        copy: "Para inventores e equipes pequenas que precisam de mais de um projeto e capacidade para convidar colaboradores.",
        features: [
          "Até 10 projetos ativos.",
          "10 buscas de arte anterior por mês.",
          "Até 2 colaboradores ativos por projeto.",
          "O dono pode exportar projetos como JSON e ZIP.",
        ],
        cta: "Escolher Inicial",
      },
      pro: {
        title: "Profissional",
        price: "$499",
        priceUnit: "/mês",
        lede: "ou $4,990/ano.",
        copy: "Para startups, universidades e aceleradoras que precisam de capacidade recorrente de redação, busca FTO e equipes maiores.",
        features: [
          "Projetos ativos ilimitados.",
          "50 buscas de arte anterior por mês.",
          "Até 10 colaboradores ativos por projeto.",
          "Inclui busca FTO.",
          "O dono pode exportar projetos como JSON e ZIP.",
        ],
        cta: "Escolher Profissional",
      },
      trial: {
        cta: "Experimente o Basic grátis por 7 dias",
        finePrint: "É necessário um cartão. A cobrança começa automaticamente após o período de teste, salvo cancelamento.",
      },
    }
  : {
      heading: ["Keep It Simple. ", "Three Plans"],
      basic: {
        title: "Basic",
        price: "$20",
        priceUnit: "/mo",
        lede: "or $200/yr.",
        copy: "For focused individual patent work.",
        features: [
          "1 active project.",
          "2 Prior Art searches per month.",
          "Individual workspace.",
          "1 GiB secure storage.",
        ],
        cta: "Choose Basic",
      },
      starter: {
        title: "Starter",
        price: "$199",
        priceUnit: "/mo",
        lede: "or $1,990/yr.",
        copy: "For inventors and small teams who need more than one project and the ability to invite collaborators.",
        features: [
          "Up to 10 active projects.",
          "10 Prior Art searches per month.",
          "Up to 2 active collaborators per project.",
          "Owner can export projects as JSON and ZIP.",
        ],
        cta: "Choose Starter",
      },
      pro: {
        title: "Professional",
        price: "$499",
        priceUnit: "/mo",
        lede: "or $4,990/yr.",
        copy: "For startups, universities, and accelerators that need recurring drafting capacity, FTO search, and larger teams.",
        features: [
          "Unlimited active projects.",
          "50 Prior Art searches per month.",
          "Up to 10 active collaborators per project.",
          "FTO Search included.",
          "Owner can export projects as JSON and ZIP.",
        ],
        cta: "Choose Professional",
      },
      trial: {
        cta: "Try Basic free for 7 days",
        finePrint: "A card is required. Billing starts automatically after the trial unless you cancel.",
      },
    };
---

<section id="plans" aria-labelledby="pricing-heading" class="pricing">
  <div class="pricing__inner">
    <h2 id="pricing-heading">
      <span>{copy.heading[0]}</span>
      <strong>{copy.heading[1]}</strong>
    </h2>

    <div class="pricing__cards">
      <article class="plan-card">
        <header>
          <h3>{copy.basic.title}</h3>
          <p class="plan-card__price">{copy.basic.price}<span class="plan-card__price-unit">{copy.basic.priceUnit}</span></p>
          <p class="plan-card__lede">{copy.basic.lede}</p>
        </header>

        <p class="plan-card__copy">
          {copy.basic.copy}
        </p>

        <ul class="plan-card__features">
          {copy.basic.features.map((feature) => <li><span>{check}</span>{feature}</li>)}
        </ul>

        <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer">
          {copy.basic.cta}
        </a>
      </article>

      <article class="plan-card">
        <header>
          <h3>{copy.pro.title}</h3>
          <p class="plan-card__price">{copy.pro.price}<span class="plan-card__price-unit">{copy.pro.priceUnit}</span></p>
          <p class="plan-card__lede">{copy.pro.lede}</p>
        </header>

        <p class="plan-card__copy">
          {copy.pro.copy}
        </p>

        <ul class="plan-card__features">
          {copy.pro.features.map((feature) => <li><span>{check}</span>{feature}</li>)}
        </ul>

        <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer">
          {copy.pro.cta}
        </a>
      </article>

      <article class="plan-card plan-card--featured">
        <header>
          <h3>{copy.starter.title}</h3>
          <p class="plan-card__price">{copy.starter.price}<span class="plan-card__price-unit">{copy.starter.priceUnit}</span></p>
          <p class="plan-card__lede">{copy.starter.lede}</p>
        </header>

        <p class="plan-card__copy">
          {copy.starter.copy}
        </p>

        <ul class="plan-card__features">
          {copy.starter.features.map((feature) => <li><span>{check}</span>{feature}</li>)}
        </ul>

        <a class="plan-card__cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer">
          {copy.starter.cta}
        </a>
      </article>
    </div>

    <div class="pricing__trial">
      <a class="pricing__trial-cta" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer">
        {copy.trial.cta}
      </a>
      <p>{copy.trial.finePrint}</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: #fff;
    padding: 18px clamp(18px, 5vw, 80px) 88px;
    overflow: hidden;
  }

  .pricing__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .pricing h2 {
    margin: 0;
    text-align: center;
    font-family: "Roboto Slab", serif;
    font-size: clamp(42px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.18;
    color: #505050;
    letter-spacing: 0;
  }

  .pricing h2 strong {
    color: #6b2a2f;
    font-weight: 800;
  }

  .pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
    align-items: stretch;
  }

  .plan-card {
    display: flex;
    min-height: 610px;
    flex-direction: column;
    border: 1px solid rgba(107, 42, 47, 0.45);
    border-radius: 24px;
    background: #fff;
    padding: 30px 30px 28px;
    text-align: center;
    box-shadow: 0 10px 28px rgba(76, 8, 21, 0.04);
  }

  .plan-card--featured {
    border-color: rgba(107, 42, 47, 0.75);
    box-shadow: 0 16px 36px rgba(107, 42, 47, 0.12);
  }

  .plan-card h3 {
    margin: 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(36px, 3vw, 48px);
    font-weight: 800;
    line-height: 1.1;
  }

  .plan-card__price {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 2.8vw, 42px);
    font-weight: 800;
    line-height: 1.08;
  }

  .plan-card__price-unit {
    margin-left: 4px;
    color: #8f6e72;
    font-family: "Roboto", sans-serif;
    font-size: clamp(15px, 1.3vw, 18px);
    font-weight: 700;
  }

  .plan-card__lede {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.35;
  }

  .plan-card__copy {
    margin: 18px 0 0;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .plan-card__features {
    display: grid;
    gap: 13px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .plan-card__features li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.32;
  }

  .plan-card__features span {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    font-weight: 900;
    line-height: 1;
  }

  .plan-card__cta {
    display: inline-flex;
    min-height: 45px;
    margin: auto auto 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    background: #ededed;
    padding: 0 24px;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
    line-height: 1;
    text-decoration: underline;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .plan-card__cta:hover {
    background: #6b2a2f;
    color: #fff;
    transform: translateY(-1px);
  }

  .pricing__trial {
    display: flex;
    max-width: 620px;
    margin: 38px auto 0;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .pricing__trial-cta {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    padding: 0 34px;
    color: #fff;
    font-family: "Roboto Slab", serif;
    font-size: 21px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 12px 28px rgba(107, 42, 47, 0.2);
    transition: background 180ms ease, transform 180ms ease;
  }

  .pricing__trial-cta:hover {
    background: #4c0815;
    transform: translateY(-1px);
  }

  .pricing__trial p {
    margin: 0;
    color: #777071;
    font-family: "Roboto", sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
  }

  @media (max-width: 1040px) {
    .pricing__cards {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }

    .plan-card {
      min-height: auto;
    }
  }

  @media (max-width: 560px) {
    .pricing {
      padding-inline: 16px;
    }

    .pricing h2 span,
    .pricing h2 strong {
      display: block;
    }

    .plan-card {
      padding: 26px 20px 24px;
    }

    .plan-card h3 {
      font-size: 34px;
    }

    .plan-card__price {
      font-size: 28px;
    }

    .plan-card__lede {
      font-size: 17px;
      line-height: 1.3;
    }

    .plan-card__copy {
      font-size: 15px;
      line-height: 1.45;
    }

    .plan-card__features li {
      font-size: 15px;
      line-height: 1.3;
    }

    .plan-card__cta {
      width: 100%;
      font-size: 16px;
      white-space: normal;
      text-align: center;
    }

    .pricing__trial-cta {
      width: 100%;
      padding: 14px 22px;
      font-size: 17px;
      line-height: 1.25;
      text-align: center;
    }
  }
</style>
