---
// Static redirect for URLs that moved. GitHub Pages cannot send 301s, so this page
// points crawlers to the new canonical URL and forwards visitors immediately.
interface Props { to: string; lang?: string; }
const { to, lang = "en" } = Astro.props;
const target = new URL(to, "https://www.ipnite.com").toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>IPnite</title>
  </head>
  <body>
    <p><a href={to}>{target}</a></p>
  </body>
</html>
