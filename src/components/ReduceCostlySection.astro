---
const cards = [
  { id: "weak-scope", risk: "Weak scope", help: "Suggests broader variants" },
  { id: "prior-art", risk: "Conflicts with prior art", help: "Detects similar inventions" },
  { id: "incomplete-drafts", risk: "Incomplete drafts", help: "Guides a proper structure" },
  { id: "premature-disclosure", risk: "Premature disclosure", help: "Encourages early filing" },
];
---

<section id="reduce-costly-mistakes" aria-labelledby="reduce-heading" class="reduce">
  <div class="reduce__inner">
    <div class="kicker">IP TEAM</div>

    <h2 id="reduce-heading">
      <span>Reduce Costly</span>
      <strong>Mistakes</strong>
    </h2>

    <div class="reduce__cards">
      {cards.map((card) => (
        <article class="mistake-card">
          <div class="mistake-card__risk">
            <span>Risk:</span>
            <strong>{card.risk}</strong>
          </div>

          <div class="mistake-card__icon" aria-hidden="true">
            <img src="/images/cerebro.png" alt="" loading="lazy" />
          </div>

          <div class="mistake-card__help">
            <h3>How Ipnite Helps</h3>
            <p>{card.help}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reduce {
    position: relative;
    overflow: hidden;
    background: #fff;
    padding: clamp(48px, 5vw, 72px) clamp(18px, 5.5vw, 80px) clamp(62px, 6vw, 88px);
  }

  .reduce__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .reduce .kicker {
    margin-bottom: 22px;
  }

  .reduce h2 {
    margin: 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(40px, 4.1vw, 54px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .reduce h2 span,
  .reduce h2 strong {
    display: inline;
  }

  .reduce h2 strong {
    font-weight: 800;
  }

  .reduce__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
    margin-top: clamp(42px, 4.6vw, 60px);
  }

  .mistake-card {
    position: relative;
    min-height: 310px;
  }

  .mistake-card__risk {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 92px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 16px 22px 18px;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    text-align: center;
    font-family: "Roboto Slab", serif;
    box-shadow: 0 10px 24px rgba(76, 8, 21, 0.05);
  }

  .mistake-card__risk span {
    font-size: clamp(20px, 1.6vw, 24px);
    font-weight: 800;
    line-height: 1.05;
  }

  .mistake-card__risk strong {
    margin-top: 4px;
    font-family: "Roboto", sans-serif;
    font-size: clamp(18px, 1.48vw, 22px);
    font-weight: 700;
    line-height: 1.12;
  }

  .mistake-card__icon {
    position: absolute;
    z-index: 4;
    top: 106px;
    left: 50%;
    width: 116px;
    height: 102px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .mistake-card__icon img {
    width: 120px;
    height: 106px;
    object-fit: contain;
    opacity: 0.9;
    filter: drop-shadow(0 8px 12px rgba(76, 8, 21, 0.16));
  }

  .mistake-card__help {
    position: relative;
    z-index: 3;
    min-height: 186px;
    margin-top: 78px;
    padding: 66px 24px 28px;
    border-radius: 26px;
    background: #fff;
    text-align: center;
    box-shadow: 0 5px 12px rgba(107, 42, 47, 0.18);
  }

  .mistake-card__help h3 {
    margin: 0;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: clamp(22px, 2vw, 27px);
    font-weight: 800;
    line-height: 1.18;
  }

  .mistake-card__help p {
    margin: 22px auto 0;
    max-width: 220px;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 700;
    line-height: 1.16;
  }

  @media (max-width: 1100px) {
    .reduce__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 34px;
    }
  }

  @media (max-width: 640px) {
    .reduce {
      padding-inline: 18px;
    }

    .reduce h2 span,
    .reduce h2 strong {
      display: block;
    }

    .reduce__cards {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .mistake-card {
      min-height: 292px;
    }

    .mistake-card__risk {
      min-height: 84px;
    }

    .mistake-card__icon {
      top: 100px;
      width: 96px;
      height: 84px;
    }

    .mistake-card__icon img {
      width: 100px;
      height: 88px;
    }

    .mistake-card__help {
      min-height: 170px;
      margin-top: 66px;
      padding-top: 58px;
    }
  }
</style>
