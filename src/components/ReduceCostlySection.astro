---
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      kicker: "REDUCE EL RIESGO",
      heading: ["Reduce", "Errores Costosos"],
      riskLabel: "Riesgo:",
      helpHeading: "Como ayuda IPnite",
      cards: [
        { risk: "Alcance débil", help: "Sugiere variantes más amplias" },
        { risk: "Conflictos con arte previo", help: "Detecta invenciones similares" },
        { risk: "Borradores incompletos", help: "Guía una estructura correcta" },
        { risk: "Divulgación prematura", help: "Fomenta presentar temprano" },
      ],
    }
  : lang === "pt"
  ? {
      kicker: "REDUZA O RISCO",
      heading: ["Reduza", "Erros Custosos"],
      riskLabel: "Risco:",
      helpHeading: "Como a IPnite ajuda",
      cards: [
        { risk: "Escopo fraco", help: "Sugere variantes mais amplas" },
        { risk: "Conflitos com arte anterior", help: "Detecta invenções similares" },
        { risk: "Rascunhos incompletos", help: "Guia uma estrutura correta" },
        { risk: "Divulgação prematura", help: "Incentiva o depósito cedo" },
      ],
    }
  : {
      kicker: "REDUCE RISK",
      heading: ["Reduce Costly", "Mistakes"],
      riskLabel: "Risk:",
      helpHeading: "How Ipnite Helps",
      cards: [
        { risk: "Weak scope", help: "Suggests broader variants" },
        { risk: "Conflicts with prior art", help: "Detects similar inventions" },
        { risk: "Incomplete drafts", help: "Guides a proper structure" },
        { risk: "Premature disclosure", help: "Encourages early filing" },
      ],
    };

const cards = [
  { icon: "/icons/lupa.svg", iconClass: "icon-search" },
  { icon: "/images/cerebro.png", iconClass: "icon-brain" },
  { icon: "/icons/lapiz.svg", iconClass: "icon-pencil" },
  { icon: "/icons/candado.svg", iconClass: "icon-lock" },
];
---

<section id="reduce-costly-mistakes" aria-labelledby="reduce-heading" class="reduce">
  <div class="reduce__inner">
    <h2 id="reduce-heading"><span>{copy.heading[0]}</span>{" "}<strong>{copy.heading[1]}</strong></h2>

    <div class="reduce__cards">
      {cards.map((card, index) => (
        <article class="mistake-card">
          <div class="mistake-card__risk">
            <span>{copy.riskLabel}</span>
            <strong>{copy.cards[index].risk}</strong>
          </div>

          <div class={`mistake-card__icon ${card.iconClass}`} aria-hidden="true">
            <img src={card.icon} alt="" loading="lazy" />
          </div>

          <div class="mistake-card__help">
            <h3>{copy.helpHeading}</h3>
            <p>{copy.cards[index].help}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reduce {
    position: relative;
    overflow: hidden;
    background: #fff;
    padding: 64px clamp(18px, 5.5vw, 80px);
  }

  .reduce__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
  }

  .reduce .kicker {
    margin-bottom: 22px;
  }

  .reduce h2 {
    width: 100%;
    margin: 0;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: clamp(42px, 4.45vw, 64px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0;
    text-align: center;
    text-wrap: balance;
  }

  .reduce h2 span,
  .reduce h2 strong {
    display: inline;
  }

  .reduce h2 span { color: #6b2a2f; font-weight: 400; }
  .reduce h2 strong { color: #505050; font-weight: 700; }

  .reduce__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
    margin-top: clamp(42px, 4.6vw, 60px);
  }

  .mistake-card {
    position: relative;
    min-height: 346px;
    display: flex;
    flex-direction: column;
  }

  .mistake-card__risk {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 92px;
    height: 92px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 16px 22px 18px;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    text-align: center;
    font-family: "Roboto Slab", serif;
    box-shadow: 0 10px 24px rgba(76, 8, 21, 0.05);
  }

  .mistake-card__risk span {
    font-size: clamp(20px, 1.6vw, 24px);
    font-weight: 800;
    line-height: 1.05;
  }

  .mistake-card__risk strong {
    margin-top: 4px;
    font-family: "Roboto", sans-serif;
    font-size: clamp(18px, 1.48vw, 22px);
    font-weight: 700;
    line-height: 1.12;
  }

  .mistake-card__icon {
    position: absolute;
    z-index: 4;
    top: 124px;
    left: 50%;
    width: 87px;
    height: 87px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    border: 2px solid #6b2a2f;
    border-radius: 999px;
    background: transparent;
    box-shadow: 0 8px 18px rgba(107, 42, 47, 0.10);
  }

  .mistake-card__icon img {
    width: 62px;
    height: 62px;
    object-fit: contain;
    opacity: 1;
    filter: none;
    background: transparent;
  }

  .mistake-card__icon.icon-brain img {
    width: 58px;
    height: 58px;
    filter: saturate(1.35) contrast(1.08);
  }

  .mistake-card__help {
    position: relative;
    z-index: 3;
    min-height: 186px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin-top: 98px;
    padding: 78px 24px 28px;
    border-radius: 26px;
    background: #fff;
    text-align: center;
    box-shadow: 0 5px 12px rgba(107, 42, 47, 0.18);
  }

  .mistake-card__help h3 {
    margin: 0;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: clamp(22px, 2vw, 27px);
    font-weight: 800;
    line-height: 1.18;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mistake-card__help p {
    margin: 22px auto 0;
    max-width: 220px;
    color: #505050;
    font-family: "Roboto", sans-serif;
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 700;
    line-height: 1.16;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 1100px) {
    .reduce__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 34px;
    }
  }

  @media (max-width: 640px) {
    .reduce {
      padding: 56px 18px;
    }

    .reduce h2 {
      font-size: 42px;
      line-height: 1.08;
    }

    .reduce h2 span,
    .reduce h2 strong {
      display: block;
    }

    .reduce__cards {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .mistake-card {
      min-height: 330px;
    }

    .mistake-card__risk {
      min-height: 84px;
      height: auto;
    }

    .mistake-card__icon {
      top: 112px;
      width: 78px;
      height: 78px;
    }

    .mistake-card__icon img {
      width: 54px;
      height: 54px;
    }

    .mistake-card__icon.icon-brain img {
      width: 50px;
      height: 50px;
    }

    .mistake-card__help {
      min-height: 170px;
      margin-top: 86px;
      padding-top: 70px;
    }
  }
</style>
