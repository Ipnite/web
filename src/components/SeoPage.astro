---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { SeoPage } from "../data/seo/types";
import { routeFor, type Locale } from "../data/routes";
import { SITE_URL, ORGANIZATION_ID, FOUNDER_ID, SOFTWARE_ID } from "../data/structuredData";

interface Props { page: SeoPage; locale: Locale; }
const { page, locale } = Astro.props;
const copy = page.locales[locale];
const canonicalPath = copy.path;
const alternates = { en: page.locales.en.path, es: page.locales.es.path, "pt-BR": page.locales.pt.path, "x-default": page.locales.en.path };
const isArticle = page.kind === "article" || page.kind === "jurisdiction";
const published = "2026-09-26";
const modified = "2026-09-26";
const labels = locale === "es"
  ? { home: "Inicio", learn: "Aprende", start: "Probar IPnite gratis", guide: "Leer la guía", related: "Explora el flujo completo", note: "Contenido educativo. IPnite no presta asesoría legal ni sustituye la revisión profesional.", reviewed: "Revisado por Rafael Betanzos San Juan · 26 de septiembre de 2026", faq: "Preguntas frecuentes", sources: "Fuentes oficiales" }
  : locale === "pt"
  ? { home: "Início", learn: "Aprenda", start: "Experimentar a IPnite grátis", guide: "Ler o guia", related: "Explore o fluxo completo", note: "Conteúdo educativo. A IPnite não presta aconselhamento jurídico nem substitui a revisão profissional.", reviewed: "Revisado por Rafael Betanzos San Juan · 26 de setembro de 2026", faq: "Perguntas frequentes", sources: "Fontes oficiais" }
  : { home: "Home", learn: "Learn", start: "Try IPnite free", guide: "Read the guide", related: "Explore the complete workflow", note: "Educational content. IPnite does not provide legal advice or replace professional review.", reviewed: "Reviewed by Rafael Betanzos San Juan · September 26, 2026", faq: "Frequently asked questions", sources: "Official sources" };
const relatedNames: Record<string, Record<Locale, string>> = {
  "ai-drafting": { en: "AI patent drafting", es: "Redacción de patentes con IA", pt: "Redação de patentes com IA" },
  "invention-disclosure": { en: "Invention disclosure", es: "Divulgación de la invención", pt: "Divulgação da invenção" },
  "patent-specification": { en: "Patent specification", es: "Descripción de la patente", pt: "Relatório descritivo" },
  "patent-quality-review": { en: "Draft quality review", es: "Revisión de calidad", pt: "Revisão de qualidade" },
  "patent-export": { en: "DOCX export", es: "Exportación en DOCX", pt: "Exportação em DOCX" },
  "prior-art": { en: "Prior-art search", es: "Búsqueda de antecedentes", pt: "Busca de anterioridade" },
  drawings: { en: "Patent drawings", es: "Dibujos de patentes", pt: "Desenhos de patentes" },
  portfolio: { en: "Portfolio management", es: "Gestión de portafolio", pt: "Gestão de portfólio" },
  provisional: { en: "Provisional applications", es: "Solicitudes provisionales", pt: "Pedidos provisórios" },
  search: { en: "Patent search", es: "Búsqueda de patentes", pt: "Busca de patentes" },
  security: { en: "Security and privacy", es: "Seguridad y privacidad", pt: "Segurança e privacidade" },
  startups: { en: "For startups", es: "Para startups", pt: "Para startups" },
  attorneys: { en: "For patent attorneys", es: "Para abogados y agentes", pt: "Para advogados e agentes" },
  universities: { en: "For universities", es: "Para universidades", pt: "Para universidades" },
  "jurisdiction-us": { en: "Patents in the United States", es: "Patentes en Estados Unidos", pt: "Patentes nos Estados Unidos" },
  "jurisdiction-mx": { en: "Patents in Mexico", es: "Patentes en México", pt: "Patentes no México" },
  "jurisdiction-ar": { en: "Patents in Argentina", es: "Patentes en Argentina", pt: "Patentes na Argentina" },
  "jurisdiction-br": { en: "Patents in Brazil", es: "Patentes en Brasil", pt: "Patentes no Brasil" },
  "jurisdiction-pct": { en: "The PCT process", es: "El proceso PCT", pt: "O processo PCT" },
  learn: { en: "Learning center", es: "Centro de aprendizaje", pt: "Central de aprendizado" },
};
const related = page.related.map((key) => ({ name: relatedNames[key]?.[locale] ?? key, href: routeFor(key, locale) }));
const home = routeFor("home", locale);
const learn = routeFor("learn", locale);
const inLanguage = locale === "pt" ? "pt-BR" : locale;
const breadcrumb = [
  { name: labels.home, item: `${SITE_URL}${home}` },
  ...(page.kind === "article" ? [{ name: labels.learn, item: `${SITE_URL}${learn}` }] : []),
  { name: copy.h1, item: `${SITE_URL}${canonicalPath}` },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": isArticle ? "Article" : "WebPage",
    "@id": `${SITE_URL}${canonicalPath}#webpage`,
    url: `${SITE_URL}${canonicalPath}`,
    headline: copy.h1,
    name: copy.title,
    description: copy.description,
    inLanguage,
    image: `${SITE_URL}/og-image.png`,
    publisher: { "@id": ORGANIZATION_ID },
    about: page.kind === "product" || page.kind === "trust" ? { "@id": SOFTWARE_ID } : undefined,
    ...(isArticle ? { datePublished: published, dateModified: modified, author: { "@id": FOUNDER_ID }, reviewedBy: { "@id": FOUNDER_ID }, mainEntityOfPage: `${SITE_URL}${canonicalPath}` } : {}),
    ...(copy.sources?.length ? { citation: copy.sources.map((source) => source.url) } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumb.map((entry, index) => ({ "@type": "ListItem", position: index + 1, name: entry.name, item: entry.item })),
  },
  ...(copy.faqs?.length ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: copy.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
  }] : []),
];
const founderProfile = locale === "es" ? "/es/rafael-betanzos-san-juan/" : locale === "pt" ? "/pt-br/rafael-betanzos-san-juan/" : "/rafael-betanzos-san-juan/";
---

<BaseLayout lang={locale} title={copy.title} description={copy.description} canonicalPath={canonicalPath} alternatePaths={alternates} structuredData={structuredData} ogType={isArticle ? "article" : "website"} pageKey={page.locales.en.path}>
  <article class="seo-page">
    <header class="seo-hero">
      <div class="seo-hero__copy">
        <nav aria-label="Breadcrumb"><a href={home}>{labels.home}</a><span aria-hidden="true">/</span>{page.kind === "article" && <><a href={learn}>{labels.learn}</a><span aria-hidden="true">/</span></>}<strong>{copy.h1}</strong></nav>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.h1}</h1>
        <p class="seo-hero__lead">{copy.lead}</p>
        <div class="seo-actions" data-analytics-location="seo_hero"><a class="primary" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta={page.primaryAction.name} data-analytics-event={page.primaryAction.event}>{labels.start}</a><a href="#guide">{labels.guide}</a></div>
        {isArticle && <p class="reviewed"><a href={founderProfile}>{labels.reviewed}</a></p>}
      </div>
      <div class="seo-hero__visual"><img class="brain" src="/images/cerebro.png" width="543" height="481" alt="" aria-hidden="true"/><img class="laptop" src="/images/notebook-2.png" alt={locale === "es" ? "Plataforma IPnite para redactar patentes" : locale === "pt" ? "Plataforma IPnite para redigir patentes" : "IPnite patent drafting platform"} width="560" height="339" loading="eager" decoding="async"/><span class="visual-pill">IPnite</span></div>
    </header>

    <div id="guide" class="seo-content">
      {copy.sections.map((section, index) => (
        <section>
          <div class="section-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          </div>
        </section>
      ))}

      {copy.faqs && copy.faqs.length > 0 && (
        <section class="seo-faq" aria-labelledby="seo-faq-title">
          <div class="section-number" aria-hidden="true">?</div>
          <div>
            <h2 id="seo-faq-title">{labels.faq}</h2>
            {copy.faqs.map((faq, index) => (
              <details open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {copy.sources && copy.sources.length > 0 && (
        <aside class="sources">
          <h2>{labels.sources}</h2>
          <ul>{copy.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul>
        </aside>
      )}

      <aside class="educational-note"><img src="/icons/candado.svg" alt="" aria-hidden="true"/><p>{labels.note}</p></aside>
    </div>

    <section class="related" aria-labelledby="related-title"><h2 id="related-title">{labels.related}</h2><div>{related.map(({ name, href }) => <a href={href}>{name}<span aria-hidden="true">→</span></a>)}</div></section>
    <section class="seo-cta" data-analytics-location="seo_final_cta"><img src="/images/cerebro.png" width="543" height="481" alt="" aria-hidden="true"/><div><h2>{copy.cta}</h2><p>{copy.ctaBody}</p><a href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta={page.primaryAction.name} data-analytics-event={page.primaryAction.event}>{labels.start}</a></div></section>
  </article>
</BaseLayout>

<style>
.seo-page{overflow:hidden;background:#fff;color:#505050}.seo-hero{width:min(calc(100% - 36px),1280px);min-height:610px;margin:28px auto 68px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:40px;border-radius:50px;background:radial-gradient(circle at 82% 28%,rgba(107,42,47,.16),transparent 35%),rgba(217,217,217,.18);padding:clamp(34px,5vw,72px);box-shadow:inset 0 1px rgba(255,255,255,.7),inset 0 -1px rgba(0,0,0,.1)}.seo-hero nav{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;color:#7d7476;font:700 13px Roboto,sans-serif}.seo-hero nav a{color:#6b2a2f}.eyebrow{margin:0 0 15px;color:#6b2a2f;font:900 13px/1.3 Roboto,sans-serif;letter-spacing:.13em}.seo-hero h1{margin:0;color:#4c0815;font:800 clamp(36px,4.6vw,64px)/1.06 "Roboto Slab",serif;letter-spacing:-.025em;text-wrap:balance}.seo-hero__lead{max-width:680px;margin:24px 0 0;font:500 clamp(17px,1.5vw,20px)/1.6 Roboto,sans-serif}.seo-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.seo-actions a,.seo-cta a{min-height:48px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #6b2a2f;border-radius:999px;padding:10px 23px;color:#4c0815;background:#ededed;font:800 17px "Roboto Slab",serif;text-decoration:none}.seo-actions .primary,.seo-cta a{background:#6b2a2f;color:#fff}.reviewed{margin:22px 0 0;color:#7d7476;font:700 13px Roboto,sans-serif;text-transform:uppercase;letter-spacing:.08em}.seo-hero__visual{position:relative;min-height:420px;display:grid;place-items:center}.seo-hero__visual .brain{position:absolute;width:90%;opacity:.14}.seo-hero__visual .laptop{position:relative;z-index:1;width:115%;filter:drop-shadow(0 24px 35px rgba(76,8,21,.17))}.visual-pill{position:absolute;z-index:2;right:2%;top:15%;border:1px solid rgba(107,42,47,.15);border-radius:18px;background:#fff;padding:12px 18px;color:#6b2a2f;font:800 15px "Roboto Slab",serif;box-shadow:0 14px 30px rgba(76,8,21,.12)}.seo-content{width:min(calc(100% - 36px),1040px);margin:auto}.seo-content>section{display:grid;grid-template-columns:80px 1fr;gap:24px;padding:50px 0;border-bottom:1px solid rgba(107,42,47,.14)}.section-number{color:rgba(107,42,47,.28);font:900 38px "Roboto Slab",serif}.seo-content h2,.sources h2{margin:0;color:#6b2a2f;font:800 clamp(30px,3vw,43px)/1.15 "Roboto Slab",serif}.seo-content section p{margin:18px 0 0;font:500 18px/1.75 Roboto,sans-serif}.seo-faq details{margin-top:14px;border:1px solid rgba(107,42,47,.14);border-radius:18px;background:#fff;padding:16px 20px}.seo-faq summary{cursor:pointer;color:#4c0815;font:800 18px/1.4 "Roboto Slab",serif}.seo-faq details p{margin:12px 0 0!important;font-size:17px!important}.reviewed a{color:inherit;text-decoration:underline;text-underline-offset:3px}.seo-content ul{margin:24px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;list-style:none}.seo-content li{position:relative;border:1px solid rgba(107,42,47,.13);border-radius:18px;background:rgba(107,42,47,.035);padding:16px 18px 16px 40px;font:600 15px/1.5 Roboto,sans-serif}.seo-content li:before{content:"✓";position:absolute;left:17px;color:#6b2a2f;font-weight:900}.seo-content a{color:#6b2a2f}.sources{margin-top:46px;border-radius:30px;background:#f7f3f3;padding:30px}.sources h2{font-size:28px}.sources ul{grid-template-columns:1fr}.educational-note{display:flex;gap:16px;align-items:center;margin:40px 0;border:1px solid rgba(107,42,47,.16);border-radius:22px;padding:20px}.educational-note img{width:28px;height:28px}.educational-note p{margin:0;font:700 14px/1.6 Roboto,sans-serif}.related{padding:80px 18px;background:radial-gradient(circle,rgba(107,42,47,.09),transparent 65%);text-align:center}.related h2{margin:0;color:#4c0815;font:800 clamp(34px,4vw,52px) "Roboto Slab",serif}.related>div{width:min(100%,1100px);margin:30px auto 0;display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.related a{display:flex;justify-content:space-between;gap:10px;border:1px solid rgba(107,42,47,.15);border-radius:24px;background:#fff;padding:22px;color:#6b2a2f;font:800 16px/1.3 "Roboto Slab",serif;text-decoration:none;text-align:left}.seo-cta{width:min(calc(100% - 36px),1280px);margin:0 auto 80px;display:flex;align-items:center;justify-content:center;gap:30px;border-radius:42px;background:#6b2a2f;padding:46px;color:#fff;text-align:center}.seo-cta>img{width:90px;filter:brightness(0) invert(1);opacity:.8}.seo-cta h2{margin:0;font:800 clamp(34px,4vw,52px)/1.1 "Roboto Slab",serif}.seo-cta p{max-width:680px;margin:15px auto 22px;font:500 18px/1.5 Roboto,sans-serif}.seo-cta a{background:#fff;color:#4c0815}@media(max-width:850px){.seo-hero{grid-template-columns:1fr;padding:34px 24px}.seo-hero__visual{min-height:280px}.seo-content>section{grid-template-columns:1fr}.related>div{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.seo-hero{width:calc(100% - 24px);border-radius:30px}.seo-content ul,.related>div{grid-template-columns:1fr}.seo-cta{flex-direction:column;padding:34px 22px}}
</style>
