---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale, SeoPage } from "../data/seoContent";

interface Props { page: SeoPage; locale: Locale; }
const { page, locale } = Astro.props;
const copy = page.locales[locale];
const prefix = locale === "es" ? "/es" : locale === "pt" ? "/pt-br" : "";
const canonicalPath = `${prefix}/${page.slug}/`.replace(/\/+/g,"/");
const alternates = { en:`/${page.slug}/`, es:`/es/${page.slug}/`, "pt-BR":`/pt-br/${page.slug}/`, "x-default":`/${page.slug}/` };
const siteUrl = "https://www.ipnite.com";
const isArticle = page.kind === "article" || page.kind === "jurisdiction";
const labels = locale === "es" ? { home:"Inicio", learn:"Aprende", start:"Probar IPnite", related:"Explora el flujo integral", note:"Contenido educativo. IPnite no presta asesoramiento legal ni sustituye la revisión profesional.", reviewed:"Revisado el 26 de septiembre de 2026", source:"Fuente oficial" } : locale === "pt" ? { home:"Início", learn:"Aprenda", start:"Experimentar a IPnite", related:"Explore o fluxo integrado", note:"Conteúdo educativo. A IPnite não presta aconselhamento jurídico nem substitui revisão profissional.", reviewed:"Revisado em 26 de setembro de 2026", source:"Fonte oficial" } : { home:"Home", learn:"Learn", start:"Try IPnite", related:"Explore the complete workflow", note:"Educational content. IPnite does not provide legal advice or replace professional review.", reviewed:"Reviewed September 26, 2026", source:"Official source" };
const related = [
  [locale==="es"?"Redacción de patentes con IA":locale==="pt"?"Redação de patentes com IA":"AI patent drafting","/ai-patent-drafting/"],
  [locale==="es"?"Búsqueda de anterioridades":locale==="pt"?"Busca de anterioridade":"Prior-art search","/prior-art-search/"],
  [locale==="es"?"Dibujos de patentes":locale==="pt"?"Desenhos de patentes":"Patent drawings","/patent-drawings/"],
  [locale==="es"?"Gestión de cartera":locale==="pt"?"Gestão de portfólio":"Portfolio management","/patent-portfolio-management/"],
];
const structuredData = [
  { "@context":"https://schema.org", "@type":isArticle?"Article":"WebPage", "@id":`${siteUrl}${canonicalPath}#webpage`, url:`${siteUrl}${canonicalPath}`, headline:copy.h1, name:copy.title, description:copy.description, inLanguage:locale==="pt"?"pt-BR":locale, publisher:{"@id":`${siteUrl}/#organization`}, ...(isArticle?{datePublished:"2026-09-26",dateModified:"2026-09-26",author:{"@id":`${siteUrl}/#organization`}}:{}) },
  { "@context":"https://schema.org", "@type":"BreadcrumbList", itemListElement:[{"@type":"ListItem",position:1,name:labels.home,item:`${siteUrl}${prefix||"/"}`},{"@type":"ListItem",position:2,name:copy.h1,item:`${siteUrl}${canonicalPath}`}] },
];
const vertexSources = page.id === "security" ? [
  ["Google Cloud: Vertex AI and zero data retention","https://docs.cloud.google.com/gemini-enterprise-agent-platform/resources/zero-data-retention"],
  ["Google Cloud Platform Terms of Service","https://cloud.google.com/terms"],
  ["IPnite Privacy Policy",`${prefix}/privacy/`],
] : [];
const primaryAction = page.id === "ai-drafting"
  ? { name: "start_drafting", event: "start_drafting_clicked" }
  : page.id === "prior-art" || page.id === "search"
  ? { name: "search_prior_art", event: "prior_art_search_clicked" }
  : page.id === "drawings"
  ? { name: "create_patent_drawing", event: "patent_drawing_clicked" }
  : page.id === "portfolio"
  ? { name: "manage_patent_portfolio", event: "portfolio_management_clicked" }
  : { name: "try_ipnite", event: undefined };
---

<BaseLayout lang={locale} title={copy.title} description={copy.description} canonicalPath={canonicalPath} alternatePaths={alternates} structuredData={structuredData} ogType={isArticle?"article":"website"}>
  <article class="seo-page">
    <header class="seo-hero">
      <div class="seo-hero__copy">
        <nav aria-label="Breadcrumb"><a href={`${prefix}/`}>{labels.home}</a><span>/</span>{isArticle&&<><a href={`${prefix}/learn/`}>{labels.learn}</a><span>/</span></>}<strong>{copy.h1}</strong></nav>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.h1}</h1>
        <p class="seo-hero__lead">{copy.lead}</p>
        <div class="seo-actions" data-analytics-location="seo_hero"><a class="primary" href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta={primaryAction.name} data-analytics-event={primaryAction.event}>{labels.start}</a><a href="#guide">{locale==="es"?"Ver la guía":locale==="pt"?"Ver o guia":"Read the guide"}</a></div>
        {isArticle && <p class="reviewed">{labels.reviewed}</p>}
      </div>
      <div class="seo-hero__visual" aria-label="IPnite patent workflow preview"><img class="brain" src="/images/cerebro.png" alt="" aria-hidden="true"/><img class="laptop" src="/images/notebook-2.png" alt="IPnite patent workflow platform" width="1050" height="782" loading="eager" decoding="async"/><span class="visual-pill">IPnite</span></div>
    </header>

    <div id="guide" class="seo-content">
      {copy.sections.map((section,index)=><section><div class="section-number">{String(index+1).padStart(2,"0")}</div><div><h2>{section.heading}</h2><p>{section.body}</p>{section.bullets&&<ul>{section.bullets.map((bullet)=><li>{bullet.startsWith("http")?<a href={bullet} target="_blank" rel="noopener noreferrer">{labels.source}: {bullet}</a>:bullet}</li>)}</ul>}</div></section>)}

      {vertexSources.length>0&&<aside class="sources"><h2>{locale==="es"?"Documentación y políticas":locale==="pt"?"Documentação e políticas":"Documentation and policies"}</h2><ul>{vertexSources.map(([name,href])=><li><a href={href} target={href.startsWith("http")?"_blank":undefined} rel={href.startsWith("http")?"noopener noreferrer":undefined}>{name}</a></li>)}</ul></aside>}

      <aside class="educational-note"><img src="/icons/candado.svg" alt="" aria-hidden="true"/><p>{labels.note}</p></aside>
    </div>

    <section class="related" aria-labelledby="related-title"><h2 id="related-title">{labels.related}</h2><div>{related.map(([name,path])=><a href={`${prefix}${path}`}>{name}<span>→</span></a>)}</div></section>
    <section class="seo-cta" data-analytics-location="seo_final_cta"><img src="/images/cerebro.png" alt="" aria-hidden="true"/><div><h2>{copy.cta}</h2><p>{copy.ctaBody}</p><a href="https://app.ipnite.com" target="_blank" rel="noopener noreferrer" data-analytics-cta={primaryAction.name} data-analytics-event={primaryAction.event}>{labels.start}</a></div></section>
  </article>
</BaseLayout>

<style>
.seo-page{overflow:hidden;background:#fff;color:#505050}.seo-hero{width:min(calc(100% - 36px),1280px);min-height:610px;margin:28px auto 68px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:40px;border-radius:50px;background:radial-gradient(circle at 82% 28%,rgba(107,42,47,.16),transparent 35%),rgba(217,217,217,.18);padding:clamp(34px,5vw,72px);box-shadow:inset 0 1px rgba(255,255,255,.7),inset 0 -1px rgba(0,0,0,.1)}.seo-hero nav{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;color:#7d7476;font:700 13px Roboto,sans-serif}.seo-hero nav a{color:#6b2a2f}.eyebrow{margin:0 0 15px;color:#6b2a2f;font:900 13px/1.3 Roboto,sans-serif;letter-spacing:.13em}.seo-hero h1{margin:0;color:#4c0815;font:800 clamp(45px,5.2vw,72px)/1.02 "Roboto Slab",serif;letter-spacing:-.025em;text-wrap:balance}.seo-hero__lead{max-width:680px;margin:24px 0 0;font:500 clamp(17px,1.5vw,20px)/1.6 Roboto,sans-serif}.seo-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.seo-actions a,.seo-cta a{min-height:48px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #6b2a2f;border-radius:999px;padding:10px 23px;color:#4c0815;background:#ededed;font:800 17px "Roboto Slab",serif;text-decoration:none}.seo-actions .primary,.seo-cta a{background:#6b2a2f;color:#fff}.reviewed{margin:22px 0 0;color:#7d7476;font:700 12px Roboto,sans-serif;text-transform:uppercase;letter-spacing:.08em}.seo-hero__visual{position:relative;min-height:420px;display:grid;place-items:center}.seo-hero__visual .brain{position:absolute;width:90%;opacity:.14}.seo-hero__visual .laptop{position:relative;z-index:1;width:115%;filter:drop-shadow(0 24px 35px rgba(76,8,21,.17))}.visual-pill{position:absolute;z-index:2;right:2%;top:15%;border:1px solid rgba(107,42,47,.15);border-radius:18px;background:#fff;padding:12px 18px;color:#6b2a2f;font:800 15px "Roboto Slab",serif;box-shadow:0 14px 30px rgba(76,8,21,.12)}.seo-content{width:min(calc(100% - 36px),1040px);margin:auto}.seo-content>section{display:grid;grid-template-columns:80px 1fr;gap:24px;padding:50px 0;border-bottom:1px solid rgba(107,42,47,.14)}.section-number{color:rgba(107,42,47,.28);font:900 38px "Roboto Slab",serif}.seo-content h2,.sources h2{margin:0;color:#6b2a2f;font:800 clamp(30px,3vw,43px)/1.15 "Roboto Slab",serif}.seo-content section p{margin:18px 0 0;font:500 18px/1.75 Roboto,sans-serif}.seo-content ul{margin:24px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;list-style:none}.seo-content li{position:relative;border:1px solid rgba(107,42,47,.13);border-radius:18px;background:rgba(107,42,47,.035);padding:16px 18px 16px 40px;font:600 15px/1.5 Roboto,sans-serif}.seo-content li:before{content:"✓";position:absolute;left:17px;color:#6b2a2f;font-weight:900}.seo-content a{color:#6b2a2f}.sources{margin-top:46px;border-radius:30px;background:#f7f3f3;padding:30px}.sources h2{font-size:28px}.sources ul{grid-template-columns:1fr}.educational-note{display:flex;gap:16px;align-items:center;margin:40px 0;border:1px solid rgba(107,42,47,.16);border-radius:22px;padding:20px}.educational-note img{width:28px;height:28px}.educational-note p{margin:0;font:700 14px/1.6 Roboto,sans-serif}.related{padding:80px 18px;background:radial-gradient(circle,rgba(107,42,47,.09),transparent 65%);text-align:center}.related h2{margin:0;color:#4c0815;font:800 clamp(34px,4vw,52px) "Roboto Slab",serif}.related>div{width:min(100%,1100px);margin:30px auto 0;display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.related a{display:flex;justify-content:space-between;gap:10px;border:1px solid rgba(107,42,47,.15);border-radius:24px;background:#fff;padding:22px;color:#6b2a2f;font:800 16px/1.3 "Roboto Slab",serif;text-decoration:none;text-align:left}.seo-cta{width:min(calc(100% - 36px),1280px);margin:0 auto 80px;display:flex;align-items:center;justify-content:center;gap:30px;border-radius:42px;background:#6b2a2f;padding:46px;color:#fff;text-align:center}.seo-cta>img{width:90px;filter:brightness(0) invert(1);opacity:.8}.seo-cta h2{margin:0;font:800 clamp(34px,4vw,52px)/1.1 "Roboto Slab",serif}.seo-cta p{max-width:680px;margin:15px auto 22px;font:500 18px/1.5 Roboto,sans-serif}.seo-cta a{background:#fff;color:#4c0815}@media(max-width:850px){.seo-hero{grid-template-columns:1fr;padding:34px 24px}.seo-hero__visual{min-height:280px}.seo-content>section{grid-template-columns:1fr}.related>div{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.seo-hero{width:calc(100% - 24px);border-radius:30px}.seo-content ul,.related>div{grid-template-columns:1fr}.seo-cta{flex-direction:column;padding:34px 22px}}
</style>
