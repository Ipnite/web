---
// Fuente: TrustCredentialsSection.tsx (Figma 4:390)
// top: 3880, height: 596
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      badge: "POR QUÉ CONFIAR EN IPNITE",
      headingTop: "Estándar profesional",
      headingBottom: "Hecho para inventores tempranos",
      confidential: "Confidencial por diseño",
      privacy: "No usamos tus datos para entrenar,\nni para quedarnos con tus ideas",
      workflow: "Flujo de patentes estructurado",
      exportable: "Borradores exportables de patente",
      disclaimer: "IPnite no reemplaza asesoría legal. Acelera y estructura el proceso de redacción.",
    }
  : lang === "pt"
  ? {
      badge: "POR QUE CONFIAR NA IPNITE",
      headingTop: "Padrão profissional",
      headingBottom: "Feito para inventores em fase inicial",
      confidential: "Confidencial por padrão",
      privacy: "Não usamos seus dados para treinar,\nnem para ficar com suas ideias",
      workflow: "Fluxo de patente estruturado",
      exportable: "Rascunhos exportáveis de patente",
      disclaimer: "A IPnite não substitui aconselhamento jurídico. Acelera e estrutura o processo de redação.",
    }
  : {
      badge: "WHY TRUST IPNITE",
      headingTop: "Professional Standard",
      headingBottom: "Built for Early Inventors",
      confidential: "Confidential by design",
      privacy: "We don’t use your data for training,\nnor do we keep your ideas",
      workflow: "Structured patent workflow",
      exportable: "Exportable patent drafts",
      disclaimer: "IPnite does not replace legal advice. It accelerates and structures the drafting process.",
    };
---

<section
  id="why-trust-ipnite"
  aria-labelledby="trust-heading"
  class="trust-section relative w-full overflow-hidden bg-white"
  style="height: 585px;"
>
  <div class="absolute inset-0 flex flex-col" style="width:1440px;margin:auto;left:0;right:0;">
    <!-- Heading -->
    <div class="trust-heading"><h2 id="trust-heading"><span>{copy.headingTop}</span><strong>{copy.headingBottom}</strong></h2></div>

    <div class="relative mt-[32px] h-[166px] w-[760px] self-center">
      <div class="absolute left-[66px] top-0 h-[78px] w-[628px] rounded-[78px] bg-[#ededed]"></div>
      <h3 class="absolute left-[66px] top-0 flex h-[78px] w-[628px] items-center justify-center text-center [font-family:'Roboto_Slab',serif] text-[46px] font-extrabold leading-[70px] tracking-[1.6px] text-[#4c0815]">
        {copy.confidential}
      </h3>
      <img
        class="absolute right-[22px] top-[-9px] h-[50px] w-[50px]"
        alt=""
        aria-hidden="true"
        src="/icons/lapiz.svg"
      />
      <img
        class="absolute left-[18px] top-[54px] h-[50px] w-[50px]"
        alt=""
        aria-hidden="true"
        src="/icons/candado.svg"
      />
      <p class="absolute left-1/2 top-[96px] w-[560px] -translate-x-1/2 text-center [font-family:'Roboto_Slab',serif] text-[24px] font-medium leading-[34px] tracking-[-0.45px] text-[#505050]">
        <span class="whitespace-pre-line">{copy.privacy.split("\n")[0]}</span>
        <br />
        <strong class="font-bold text-[#4c0815]">{copy.privacy.split("\n")[1]}</strong>
      </p>
    </div>

    <!-- Core benefits -->
    <div class="trust-benefits" role="group" aria-label="Core drafting benefits">
      <div class="trust-benefit">{copy.workflow}</div>
      <img alt="" aria-hidden="true" src="/icons/engranaje.svg" />
      <div class="trust-benefit">{copy.exportable}</div>
    </div>

    <!-- Disclaimer -->
    <p class="mt-12 h-[25px] w-[860px] self-center text-center [font-family:'Roboto',sans-serif] text-xl font-normal leading-[30px] tracking-[-0.38px] text-[#505050] whitespace-nowrap">
      {copy.disclaimer}
    </p>
  </div>
</section>

<style>
  .trust-section {
    height: auto !important;
    padding: 64px clamp(18px, 5vw, 80px);
  }

  .trust-section > .absolute.inset-0.flex.flex-col {
    position: relative !important;
    inset: auto !important;
    width: min(100%, 1280px) !important;
    margin: 0 auto !important;
    align-items: center;
  }

  .trust-section > .absolute.inset-0.flex.flex-col > * {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    width: 100% !important;
    height: auto !important;
    margin-left: 0 !important;
  }

  .trust-heading { display: flex; width: 100%; align-self: center; justify-content: center; text-align: center; }
  .trust-heading h2 { flex: 0 1 940px; width: min(100%, 940px) !important; margin-left: auto !important; margin-right: auto !important; }
  .trust-section h2 { max-width: 940px; margin: 18px auto 0 !important; font-family: "Roboto Slab", serif; font-size: clamp(44px, 4.5vw, 64px) !important; font-weight: 400; line-height: 1.12 !important; text-align: center; text-wrap: balance; }
  .trust-section h2 { align-self: center; width: min(100%, 940px) !important; }
  .trust-section h2 span, .trust-section h2 strong { display: block; width: 100%; text-align: center; }
  .trust-section h2 span { color: #6b2a2f; font-weight: 400; }
  .trust-section h2 strong { color: #505050; font-weight: 700; }

  .trust-section .relative.mt-\[32px\] {
    display: grid !important;
    gap: 16px !important;
    width: min(100%, 760px) !important;
    margin-top: 34px !important;
  }

  .trust-section .relative.mt-\[32px\] > div,
  .trust-section .relative.mt-\[32px\] > img {
    display: none;
  }

  .trust-section .relative.mt-\[32px\] > h3,
  .trust-section .relative.mt-\[32px\] > p {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    height: auto !important;
    transform: none !important;
  }

  .trust-section .relative.mt-\[32px\] > h3 {
    width: fit-content !important;
    max-width: 100%;
    justify-self: center;
    min-height: 74px !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #ededed;
    padding: 12px 28px;
    font-size: clamp(32px, 3.2vw, 46px) !important;
