  }

  .trust-section .relative.mt-\[54px\] {
    width: fit-content !important;
    max-width: 100%;
    height: auto !important;
    margin: 42px auto 0 !important;
    display: grid !important;
    grid-template-columns: max-content 56px max-content;
    gap: 18px;
    align-items: center;
  }

  .trust-section .relative.mt-\[54px\] > div,
  .trust-section .relative.mt-\[54px\] > img {
    position: relative !important;
    inset: auto !important;
    left: auto !important;
    top: auto !important;
    width: 100% !important;
    height: auto !important;
  }

  .trust-section .relative.mt-\[54px\] > div {
    width: fit-content !important;
    max-width: 100%;
  }

  .trust-section .relative.mt-\[54px\] > img {
    width: 50px !important;
    justify-self: center;
  }

  .trust-section .relative.mt-\[54px\] > div > div:first-child {
    display: none;
  }

  .trust-section .relative.mt-\[54px\] .absolute.top-\[7px\] {
    position: relative !important;
    inset: auto !important;
    width: fit-content !important;
    max-width: 100%;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #ededed;
    padding: 10px 18px;
    white-space: normal !important;
    font-size: clamp(18px, 1.6vw, 24px) !important;
    line-height: 1.2 !important;
  }

  .trust-section > .absolute.inset-0.flex.flex-col > p:last-child {
    max-width: 860px;
    margin-top: 36px !important;
    white-space: normal !important;
    height: auto !important;
    font-size: 16px !important;
    line-height: 1.5 !important;
  }

  @media (max-width: 900px) {
    .trust-section {
      height: auto !important;
      padding: 56px 16px;
      overflow: hidden;
    }

    .trust-section > .absolute.inset-0.flex.flex-col {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px;
      margin: 0 auto !important;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .trust-section > .absolute.inset-0.flex.flex-col > * {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      width: 100% !important;
      height: auto !important;
      margin-left: 0 !important;
    }

    .trust-section h2 {
      font-size: 40px !important;
      line-height: 1.08 !important;
      height: auto !important;
      width: 100% !important;
      text-wrap: balance;
    }

    .trust-section h3 {
      font-size: 26px !important;
      line-height: 1.15 !important;
    }

    .trust-section p {
      font-size: 18px !important;
      line-height: 1.45 !important;
      width: 100% !important;
      max-width: 100% !important;
      white-space: normal !important;
      text-wrap: pretty;
    }

    .trust-section .relative.mt-\[32px\] {
      display: grid !important;
      gap: 14px !important;
      margin-top: 22px !important;
      width: 100% !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[32px\] > div {
      display: none;
    }

    .trust-section .relative.mt-\[32px\] > h3,
    .trust-section .relative.mt-\[32px\] > p {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      transform: none !important;
    }

    .trust-section .relative.mt-\[32px\] > h3 {
      display: flex !important;
      min-height: 64px !important;
      align-items: center;
      justify-content: center;
      border-radius: 32px;
      background: #ededed;
      padding: 14px 18px;
      letter-spacing: 0 !important;
    }

    .trust-section .relative.mt-\[32px\] > img {
      display: none;
    }

    .trust-section .relative.mt-\[54px\] {
      margin-top: 28px !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 12px !important;
      width: 100% !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[54px\] > div {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      min-height: 50px !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[54px\] > div > div {
      width: 100% !important;
      left: auto !important;
      right: auto !important;
    }

    .trust-section .relative.mt-\[54px\] > img {
      display: none;
    }

    .trust-section .relative.mt-\[54px\] p {
      top: auto !important;
      margin-top: 12px !important;
    }

    .trust-section .relative.mt-\[54px\] .absolute.top-0 {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      min-height: 50px !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[54px\] .absolute.top-\[7px\] {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      text-align: center !important;
      padding: 10px 14px !important;
      white-space: normal !important;
      font-size: 18px !important;
      line-height: 1.25 !important;
    }

    .trust-section .relative.mt-\[32px\] > h3,
    .trust-section .relative.mt-\[54px\],
    .trust-section .relative.mt-\[54px\] > div,
    .trust-section .relative.mt-\[54px\] .absolute.top-\[7px\] {
      width: fit-content !important;
      max-width: 100% !important;
      justify-self: center;
    }

    .trust-section > .absolute.inset-0.flex.flex-col > p:last-child {
      margin-top: 22px !important;
      height: auto !important;
    }
  }
  .trust-benefits {
    width: fit-content !important;
    max-width: 100%;
    margin: 42px auto 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
