---
// Fuente: TrustCredentialsSection.tsx (Figma 4:390)
// top: 3880, height: 596
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      badge: "CÓMO FUNCIONA",
      headingTop: "Estándar profesional",
      headingBottom: "Hecho para inventores tempranos",
      confidential: "Confidencial por diseño",
      privacy: "No usamos tus datos para entrenar,\nni para quedarnos con tus ideas",
      workflow: "Flujo de patentes estructurado",
      exportable: "Borradores exportables de patente",
      disclaimer: "IPnite no reemplaza asesoría legal. Acelera y estructura el proceso de redacción.",
    }
  : lang === "pt"
  ? {
      badge: "COMO FUNCIONA",
      headingTop: "Padrão profissional",
      headingBottom: "Feito para inventores em fase inicial",
      confidential: "Confidencial por padrão",
      privacy: "Não usamos seus dados para treinar,\nnem para ficar com suas ideias",
      workflow: "Fluxo de patente estruturado",
      exportable: "Rascunhos exportáveis de patente",
      disclaimer: "A IPnite não substitui aconselhamento jurídico. Acelera e estrutura o processo de redação.",
    }
  : {
      badge: "HOW IT WORKS",
      headingTop: "Professional Standard",
      headingBottom: "Built for Early Inventors",
      confidential: "Confidential by design",
      privacy: "We don’t use your data for training,\nnor do we keep your ideas",
      workflow: "Structured patent workflow",
      exportable: "Exportable patent drafts",
      disclaimer: "IPnite does not replace legal advice. It accelerates and structures the drafting process.",
    };
---

<section
  aria-labelledby="trust-heading"
  class="trust-section relative w-full overflow-hidden bg-white"
  style="height: 585px;"
>
  <div class="absolute inset-0 flex flex-col" style="width:1440px;margin:auto;left:0;right:0;">
    <!-- Badge "HOW IT WORKS" -->
    <div class="ml-[625px] mt-px flex min-w-[191px] items-start">
      <div class="flex w-[191px] justify-center">
        <div class="relative ml-0.5 h-[35px] w-[193px]">
          <div class="absolute left-[calc(50%-96px)] top-0 h-[35px] w-[191px] rounded-[33px] bg-[#6b2a2f]"></div>
          <div class="absolute top-[calc(50%-12px)] left-5 flex h-[23px] w-[151px] items-center justify-center whitespace-nowrap text-center [font-family:'Roboto_Slab',serif] text-[17.9px] font-extrabold leading-[26.8px] tracking-[-0.34px] text-[#ededed]">
            {copy.badge}
          </div>
        </div>
      </div>
    </div>

    <!-- Heading -->
    <h2
      id="trust-heading"
      class="mt-[5px] h-[154px] w-[918px] self-center text-center [font-family:'Roboto_Slab',serif] text-[64px] font-normal leading-[75px] tracking-[0] text-[#505050]"
    >
      {copy.headingTop} <br />
      <strong class="font-bold">{copy.headingBottom}</strong>
    </h2>

    <div class="relative mt-[32px] h-[166px] w-[760px] self-center">
      <div class="absolute left-[66px] top-0 h-[78px] w-[628px] rounded-[78px] bg-[#ededed]"></div>
      <h3 class="absolute left-[66px] top-0 flex h-[78px] w-[628px] items-center justify-center text-center [font-family:'Roboto_Slab',serif] text-[46px] font-extrabold leading-[70px] tracking-[1.6px] text-[#4c0815]">
        {copy.confidential}
      </h3>
      <img
        class="absolute right-[22px] top-[-9px] h-[50px] w-[50px]"
        alt=""
        aria-hidden="true"
        src="/icons/lapiz.svg"
      />
      <img
        class="absolute left-[18px] top-[54px] h-[50px] w-[50px]"
        alt=""
        aria-hidden="true"
        src="/icons/candado.svg"
      />
      <p class="absolute left-1/2 top-[96px] w-[560px] -translate-x-1/2 text-center [font-family:'Roboto_Slab',serif] text-[24px] font-medium leading-[34px] tracking-[-0.45px] text-[#505050]">
        <span class="whitespace-pre-line">{copy.privacy.split("\n")[0]}</span>
        <br />
        <strong class="font-bold text-[#4c0815]">{copy.privacy.split("\n")[1]}</strong>
      </p>
    </div>

    <!-- Pills de beneficios -->
    <div class="relative mt-[54px] ml-[307px] h-[50px] w-[827px]" role="group" aria-label="Core drafting benefits">
      <!-- Structured patent workflow -->
      <div class="absolute top-0 left-[calc(50%-414px)] w-96 h-[50px]">
        <div class="absolute top-0 left-[calc(50%-192px)] w-[382px] h-[50px] bg-white rounded-[40px]"></div>
        <div class="absolute top-[7px] left-[19px] w-[343px] [font-family:'Roboto_Slab',serif] font-extrabold text-[#4c0815] text-2xl text-center tracking-[0.96px] leading-9 whitespace-nowrap">
          {copy.workflow}
        </div>
      </div>

      <!-- Ícono conector (SVG ya incluye círculo) -->
      <img
        class="absolute top-0 left-[407px] w-[50px] h-[50px]"
        alt="" aria-hidden="true"
        src="/icons/engranaje.svg"
      />

      <!-- Exportable patent drafts -->
      <div class="absolute top-0 left-[calc(50%+68px)] w-[347px] h-[50px]">
        <div class="absolute top-0 left-[calc(50%-174px)] w-[345px] h-[50px] bg-[#ededed] rounded-[40px]"></div>
        <div class="absolute top-[7px] left-[22px] w-[302px] [font-family:'Roboto_Slab',serif] font-extrabold text-[#4c0815] text-2xl text-center tracking-[0.96px] leading-9 whitespace-nowrap">
          {copy.exportable}
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <p class="mt-12 h-[25px] w-[860px] self-center text-center [font-family:'Roboto',sans-serif] text-xl font-normal leading-[30px] tracking-[-0.38px] text-[#505050] whitespace-nowrap">
      {copy.disclaimer}
    </p>
  </div>
</section>

<style>
  .trust-section {
    height: auto !important;
    padding: 64px clamp(18px, 5vw, 80px) 74px;
  }

  .trust-section > .absolute.inset-0.flex.flex-col {
    position: relative !important;
    inset: auto !important;
    width: min(100%, 1000px) !important;
    margin: 0 auto !important;
    align-items: center;
  }

  .trust-section > .absolute.inset-0.flex.flex-col > * {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    width: 100% !important;
    height: auto !important;
    margin-left: 0 !important;
  }

  .trust-section h2 {
    max-width: 940px;
    margin-top: 18px !important;
    font-size: clamp(44px, 4.5vw, 64px) !important;
    line-height: 1.12 !important;
    text-wrap: balance;
  }

  .trust-section .relative.mt-\[32px\] {
    display: grid !important;
    gap: 16px !important;
    width: min(100%, 760px) !important;
    margin-top: 34px !important;
  }

  .trust-section .relative.mt-\[32px\] > div,
  .trust-section .relative.mt-\[32px\] > img {
    display: none;
  }

  .trust-section .relative.mt-\[32px\] > h3,
  .trust-section .relative.mt-\[32px\] > p {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    height: auto !important;
    transform: none !important;
  }

  .trust-section .relative.mt-\[32px\] > h3 {
    min-height: 74px !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #ededed;
    padding: 12px 28px;
    font-size: clamp(32px, 3.2vw, 46px) !important;
    line-height: 1.12 !important;
    letter-spacing: 0 !important;
  }

  .trust-section .relative.mt-\[32px\] > p {
    margin: 0 auto !important;
    max-width: 640px !important;
    font-size: clamp(20px, 1.8vw, 24px) !important;
    line-height: 1.45 !important;
  }

  .trust-section .relative.mt-\[54px\] {
    width: min(100%, 860px) !important;
    height: auto !important;
    margin: 42px auto 0 !important;
    display: grid !important;
    grid-template-columns: 1fr 56px 1fr;
    gap: 18px;
    align-items: center;
  }

  .trust-section .relative.mt-\[54px\] > div,
  .trust-section .relative.mt-\[54px\] > img {
    position: relative !important;
    inset: auto !important;
    left: auto !important;
    top: auto !important;
    width: 100% !important;
    height: auto !important;
  }

  .trust-section .relative.mt-\[54px\] > img {
    width: 50px !important;
    justify-self: center;
  }

  .trust-section .relative.mt-\[54px\] > div > div:first-child {
    display: none;
  }

  .trust-section .relative.mt-\[54px\] .absolute.top-\[7px\] {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #ededed;
    padding: 10px 18px;
    white-space: normal !important;
    font-size: clamp(18px, 1.6vw, 24px) !important;
    line-height: 1.2 !important;
  }

  .trust-section > .absolute.inset-0.flex.flex-col > p:last-child {
    max-width: 860px;
    margin-top: 36px !important;
    white-space: normal !important;
    height: auto !important;
    font-size: 16px !important;
    line-height: 1.5 !important;
  }

  @media (max-width: 900px) {
    .trust-section {
      height: auto !important;
      padding: 56px 16px 72px;
      overflow: hidden;
    }

    .trust-section > .absolute.inset-0.flex.flex-col {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px;
      margin: 0 auto !important;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .trust-section > .absolute.inset-0.flex.flex-col > * {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      width: 100% !important;
      height: auto !important;
      margin-left: 0 !important;
    }

    .trust-section h2 {
      font-size: 40px !important;
      line-height: 1.08 !important;
      height: auto !important;
      width: 100% !important;
      text-wrap: balance;
    }

    .trust-section h3 {
      font-size: 26px !important;
      line-height: 1.15 !important;
    }

    .trust-section p {
      font-size: 18px !important;
      line-height: 1.45 !important;
      width: 100% !important;
      max-width: 100% !important;
      white-space: normal !important;
      text-wrap: pretty;
    }

    .trust-section .relative.mt-\[32px\] {
      display: grid !important;
      gap: 14px !important;
      margin-top: 22px !important;
      width: 100% !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[32px\] > div {
      display: none;
    }

    .trust-section .relative.mt-\[32px\] > h3,
    .trust-section .relative.mt-\[32px\] > p {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      transform: none !important;
    }

    .trust-section .relative.mt-\[32px\] > h3 {
      display: flex !important;
      min-height: 64px !important;
      align-items: center;
      justify-content: center;
      border-radius: 32px;
      background: #ededed;
      padding: 14px 18px;
      letter-spacing: 0 !important;
    }

    .trust-section .relative.mt-\[32px\] > img {
      display: none;
    }

    .trust-section .relative.mt-\[54px\] {
      margin-top: 28px !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 12px !important;
      width: 100% !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[54px\] > div {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      min-height: 50px !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[54px\] > div > div {
      width: 100% !important;
      left: auto !important;
      right: auto !important;
    }

    .trust-section .relative.mt-\[54px\] > img {
      display: none;
    }

    .trust-section .relative.mt-\[54px\] p {
      top: auto !important;
      margin-top: 12px !important;
    }

    .trust-section .relative.mt-\[54px\] .absolute.top-0 {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      min-height: 50px !important;
      height: auto !important;
    }

    .trust-section .relative.mt-\[54px\] .absolute.top-\[7px\] {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      text-align: center !important;
      padding: 10px 14px !important;
      white-space: normal !important;
      font-size: 18px !important;
      line-height: 1.25 !important;
    }

    .trust-section > .absolute.inset-0.flex.flex-col > p:last-child {
      margin-top: 22px !important;
      height: auto !important;
    }
  }
</style>
