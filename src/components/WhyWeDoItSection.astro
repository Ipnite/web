---
// Fuente: index.tsx — sección "Who We Do It For" (antes "Why We Do It", Figma 4:206)
// Las tarjetas tienen flip: frente blanco con título, dorso rojo con texto
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: "Soluciones de Redacción de Patentes para Cada Perfil",
      intro: "IPnite ofrece flujos de redacción y gestión de patentes para profesionales de PI, inventores, startups, universidades y centros de I+D.",
      emphasis: "Si estás construyendo algo que vale la pena proteger, IPnite es para ti.",
      cards: [
        { title: ["Para Abogados y Agentes", "de Patentes (IP Law Firms)"], image: "/images/lawyer-card.webp", alt: "Abogados y agentes de patentes", back: "Aumenta la capacidad de tu firma. Automatiza la redacción del borrador técnico inicial, la estructuración de reivindicaciones dependientes y la búsqueda de arte previo antes de la revisión jurídica formal." },
        { title: ["Para Startups", "e Inventores"], image: "/images/startups-card.webp", alt: "Startups e inventores", back: "Prepara borradores estructurados y profesionalizados para proteger tu tecnología antes de presentarla o revisarla con tu consejero legal." },
        { title: ["Para Universidades y", "Centros de I+D (TTOs)"], image: "/images/academic-card.webp", alt: "Universidades y centros de investigación y desarrollo", back: "Gestiona divulgaciones de invención y acelera la evaluación de patentes corporativas." },
      ],
    }
  : lang === "pt"
  ? {
      heading: "Soluções de Redação de Patentes para Cada Perfil",
      intro: "A IPnite oferece fluxos de redação e gestão de patentes para profissionais de PI, inventores, startups, universidades e centros de P&D.",
      emphasis: "Se você está construindo algo que vale a pena proteger, a IPnite é para você.",
      cards: [
        { title: ["Para Advogados e Agentes", "de Patentes (IP Law Firms)"], image: "/images/lawyer-card.webp", alt: "Advogados e agentes de patentes", back: "Aumente a capacidade da sua firma. Automatize a redação do rascunho técnico inicial, a estruturação de reivindicações dependentes e a pesquisa de anterioridade antes da revisão jurídica formal." },
        { title: ["Para Startups", "e Inventores"], image: "/images/startups-card.webp", alt: "Startups e inventores", back: "Prepare rascunhos estruturados e profissionalizados para proteger sua tecnologia antes de apresentá-la ou revisá-la com seu assessor jurídico." },
        { title: ["Para Universidades e", "Centros de P&D (TTOs)"], image: "/images/academic-card.webp", alt: "Universidades e centros de pesquisa e desenvolvimento", back: "Gerencie divulgações de invenção e acelere a avaliação de patentes corporativas." },
      ],
    }
  : {
      heading: "Patent Drafting Solutions for Every Profile",
      intro: "IPnite provides patent drafting and management workflows for IP professionals, inventors, startups, universities, and R&D centers.",
      emphasis: "If you're building something worth protecting, IPnite is for you.",
      cards: [
        { title: ["For Patent Attorneys", "& IP Agents (Law Firms)"], image: "/images/lawyer-card.webp", alt: "Patent attorneys and IP agents", back: "Increase your firm capacity. Automate the initial technical draft, dependent-claim structuring, and prior-art search before formal legal review." },
        { title: ["For Startups", "& Inventors"], image: "/images/startups-card.webp", alt: "Startups and inventors", back: "Prepare structured, professionalized drafts to protect your technology before presenting it or reviewing it with legal counsel." },
        { title: ["For Universities &", "R&D Centers (TTOs)"], image: "/images/academic-card.webp", alt: "Universities and research and development centers", back: "Manage invention disclosures and accelerate corporate patent evaluation." },
      ],
    };
---

<section
  id="who-we-do-it-for"
  aria-labelledby="who-heading"
  class="relative z-0 w-full overflow-hidden bg-white"
  style="padding-top: 12px; padding-bottom: 88px;"
>
  <!-- Gradiente decorativo -->
  <div class="absolute top-0 left-0 w-[1439px] h-[1260px] opacity-15 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[#6b2a2f] rounded-[50%] blur-[250px] opacity-50"></div>
    <div class="absolute top-[227px] left-[201px] w-[1075px] h-[779px] rounded-[50%] blur-[400px] opacity-50"
      style="background:linear-gradient(197deg,rgba(245,245,245,.8) 0%,rgba(245,245,245,.8) 100%)">
    </div>
  </div>

  <div class="relative w-[1440px] mx-auto">
    <h2 id="who-heading" class="relative [font-family:'Roboto_Slab',serif] font-bold text-[#4c0815] text-5xl text-center tracking-[0] leading-[64.8px]">{copy.heading}</h2>
    <div class="relative h-[3px] bg-[#6b2a2f] opacity-40"></div>
    <p class="relative [font-family:'Roboto',sans-serif] text-[#505050] text-[22px] text-center tracking-[-0.42px] leading-[33px]"><span class="font-medium">{copy.intro}</span></p>

    <!-- Audience cards -->
    {copy.cards.map((card) => (
      <article class="who-card">
        <div class="who-card-art"><span aria-hidden="true"></span><img src={card.image} alt={card.alt} width="800" height="800" loading="lazy" decoding="async" /></div>
        <div class="who-card-content"><h3>{card.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3><p>{card.back}</p></div>
      </article>
    ))}

    <!-- Énfasis final -->
    <p class="who-emphasis [font-family:'Roboto',sans-serif] font-bold text-[#4c0815] text-center">
      {copy.emphasis}
    </p>
  </div>
</section>

<style>
#who-we-do-it-for{padding:64px clamp(18px,5vw,80px)!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto{position:relative;width:min(100%,1280px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}#who-we-do-it-for h2{grid-column:1/-1;width:min(100%,760px)!important;margin:0 auto!important;font-size:clamp(44px,4vw,58px)!important;line-height:1.12!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto>div:first-of-type{grid-column:1/-1;width:min(395px,70vw)!important;margin:-8px auto 0!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto>p{grid-column:1/-1;width:min(100%,820px)!important;margin:0 auto 32px!important;font-size:clamp(18px,1.65vw,22px)!important;line-height:1.5!important}.who-card:last-of-type:nth-of-type(3){grid-column:1/-1;width:calc((100% - 28px)/2);justify-self:center}.who-card{min-height:270px;overflow:hidden;display:grid;grid-template-columns:minmax(170px,34%) 1fr;border:1px solid rgba(107,42,47,.12);border-radius:30px;background:#fff;box-shadow:0 15px 34px rgba(107,42,47,.08);transition:.3s}.who-card:hover{transform:translateY(-5px);box-shadow:0 24px 50px rgba(107,42,47,.16)}.who-card-art{position:relative;min-height:270px;overflow:visible;background:transparent}.who-card-art span{position:absolute;inset:16% 8% 7% 8%;border-radius:28px;background:#7d4147;box-shadow:0 18px 30px rgba(76,8,21,.16);transition:transform .35s ease,box-shadow .35s ease}.who-card-art img{position:absolute;z-index:1;left:50%;bottom:0;width:112%;height:96%;object-fit:contain;object-position:center bottom;transform:translateX(-50%);transition:transform .35s ease}.who-card:hover .who-card-art img{transform:translateX(-50%) translateY(-3px)}.who-card:hover .who-card-art span{transform:translateY(-2px);box-shadow:0 22px 36px rgba(76,8,21,.22)}.who-card-content{display:flex;flex-direction:column;justify-content:center;padding:28px 30px}.who-card h3{margin:0;font-family:'Roboto Slab',serif;font-size:clamp(27px,2.5vw,35px);line-height:1.15;color:#6b2a2f}.who-card p{margin:14px 0 0;font-family:Roboto,sans-serif;font-size:16px;line-height:1.5;color:#505050}.who-emphasis{grid-column:1/-1;width:min(100%,820px);margin:32px auto 0;font-size:clamp(20px,2vw,24px);line-height:1.4}@media(max-width:900px){.who-card:last-of-type:nth-of-type(3){width:100%}#who-we-do-it-for{padding:56px 16px!important}#who-we-do-it-for>div:first-child{display:none}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto{width:100%;display:flex;flex-direction:column;align-items:center;gap:16px}#who-we-do-it-for h2{width:100%!important;max-width:360px;font-size:42px!important;line-height:1.15!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto>p{width:100%!important;max-width:360px;margin:0 0 16px!important;font-size:18px!important}.who-card{width:100%;max-width:360px;grid-template-columns:1fr}.who-card:hover{transform:none}.who-card-art{min-height:280px;overflow:visible}.who-card-art span{inset:18% 10% 6% 10%;border-radius:26px}.who-card-art img{width:min(112%,340px);height:270px;left:50%;bottom:0;transform:translateX(-50%)}.who-card:hover .who-card-art img{transform:translateX(-50%)}.who-card-content{padding:24px 22px 26px;text-align:center}.who-card h3{font-size:28px}.who-emphasis{width:100%;max-width:360px;margin:16px 0 0;font-size:19px}}@media(prefers-reduced-motion:reduce){.who-card,.who-card-art img,.who-card-art span{transition:none}}
</style>
