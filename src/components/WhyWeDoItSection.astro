---
// Fuente: index.tsx — sección "Who We Do It For" (antes "Why We Do It", Figma 4:206)
// Las tarjetas tienen flip: frente blanco con título, dorso rojo con texto
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: "Para quién lo hacemos",
      intro: "Desde un inventor que presenta su primera idea hasta una oficina de transferencia tecnológica universitaria, IPnite está pensado para quien convierte una idea en propiedad intelectual protegida.",
      emphasis: "Si estás construyendo algo que vale la pena proteger, IPnite es para vos.",
      cards: [
        { title: ["Inventores"], image: "/images/inventor-card.webp", alt: "Inventor", back: "Inventores independientes que convierten una idea en un borrador de patente estructurado y listo para revisión, sin necesitar un abogado desde el primer día." },
        { title: ["Startups"], image: "/images/startups-card.webp", alt: "Startup", back: "Fundadores y equipos de producto que documentan invenciones y gestionan su PI como parte de construir su empresa." },
        { title: ["Centros de Investigación", "y Universidades"], image: "/images/academic-card.webp", alt: "Investigación académica", back: "Instituciones y oficinas de transferencia tecnológica que preparan divulgaciones y borradores de patente para las invenciones de sus laboratorios." },
        { title: ["Profesionales", "de PI"], image: "/images/lawyer-card.webp", alt: "Profesional de propiedad intelectual", back: "Abogados y agentes que usan IPnite para acelerar la redacción, la revisión de arte previo y la tramitación para sus clientes." },
      ],
    }
  : lang === "pt"
  ? {
      heading: "Para quem fazemos isso",
      intro: "De um inventor que apresenta sua primeira ideia a um escritório de transferência de tecnologia universitário, a IPnite é feita para quem transforma uma ideia em propriedade intelectual protegida.",
      emphasis: "Se você está construindo algo que vale a pena proteger, a IPnite é para você.",
      cards: [
        { title: ["Inventores"], image: "/images/inventor-card.webp", alt: "Inventor", back: "Inventores independentes que transformam uma ideia em um rascunho de patente estruturado e pronto para revisão, sem precisar de um advogado desde o primeiro dia." },
        { title: ["Startups"], image: "/images/startups-card.webp", alt: "Startup", back: "Fundadores e equipes de produto que documentam invenções e gerenciam sua PI como parte da construção da empresa." },
        { title: ["Centros de Pesquisa", "e Universidades"], image: "/images/academic-card.webp", alt: "Pesquisa acadêmica", back: "Instituições e escritórios de transferência de tecnologia que preparam divulgações e rascunhos de patente para as invenções de seus laboratórios." },
        { title: ["Profissionais", "de PI"], image: "/images/lawyer-card.webp", alt: "Profissional de propriedade intelectual", back: "Advogados e agentes que usam a IPnite para acelerar a redação, a revisão de arte anterior e a prosecução para seus clientes." },
      ],
    }
  : {
      heading: "Who We Do It For",
      intro: "From a first-time inventor to a university tech transfer office, IPnite is built for anyone turning an idea into protected intellectual property.",
      emphasis: "If you're building something worth protecting, IPnite is for you.",
      cards: [
        { title: ["Inventors"], image: "/images/inventor-card.webp", alt: "Inventor", back: "Independent inventors turning a raw idea into a structured, review-ready patent draft without needing an attorney from day one." },
        { title: ["Startups"], image: "/images/startups-card.webp", alt: "Startup", back: "Founders and product teams documenting inventions and managing IP as part of building their company." },
        { title: ["Research Centers", "& Universities"], image: "/images/academic-card.webp", alt: "Academic research", back: "Institutions and tech transfer offices preparing disclosures and patent drafts for the inventions coming out of their labs." },
        { title: ["IP", "Professionals"], image: "/images/lawyer-card.webp", alt: "Intellectual property professional", back: "Attorneys and agents who use IPnite to speed up drafting, prior-art review, and prosecution work for their clients." },
      ],
    };
---

<section
  id="who-we-do-it-for"
  aria-labelledby="who-heading"
  class="relative z-0 w-full overflow-hidden bg-white"
  style="padding-top: 12px; padding-bottom: 88px;"
>
  <!-- Gradiente decorativo -->
  <div class="absolute top-0 left-0 w-[1439px] h-[1260px] opacity-15 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[#6b2a2f] rounded-[50%] blur-[250px] opacity-50"></div>
    <div class="absolute top-[227px] left-[201px] w-[1075px] h-[779px] rounded-[50%] blur-[400px] opacity-50"
      style="background:linear-gradient(197deg,rgba(245,245,245,.8) 0%,rgba(245,245,245,.8) 100%)">
    </div>
  </div>

  <div class="relative w-[1440px] mx-auto">
    <h2 id="who-heading" class="relative [font-family:'Roboto_Slab',serif] font-bold text-[#4c0815] text-5xl text-center tracking-[0] leading-[64.8px]">{copy.heading}</h2>
    <div class="relative h-[3px] bg-[#6b2a2f] opacity-40"></div>
    <p class="relative [font-family:'Roboto',sans-serif] text-[#505050] text-[22px] text-center tracking-[-0.42px] leading-[33px]"><span class="font-medium">{copy.intro}</span></p>

    <!-- Audience cards -->
    {copy.cards.map((card) => (
      <article class="who-card">
        <div class="who-card-art"><span aria-hidden="true"></span><img src={card.image} alt={card.alt} width="800" height="800" loading="lazy" decoding="async" /></div>
        <div class="who-card-content"><h3>{card.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3><p>{card.back}</p></div>
      </article>
    ))}

    <!-- Énfasis final -->
    <p class="who-emphasis [font-family:'Roboto',sans-serif] font-bold text-[#4c0815] text-center">
      {copy.emphasis}
    </p>
  </div>
</section>

<style>
#who-we-do-it-for{padding:64px clamp(18px,5vw,80px)!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto{position:relative;width:min(100%,1280px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}#who-we-do-it-for h2{grid-column:1/-1;width:min(100%,760px)!important;margin:0 auto!important;font-size:clamp(44px,4vw,58px)!important;line-height:1.12!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto>div:first-of-type{grid-column:1/-1;width:min(395px,70vw)!important;margin:-8px auto 0!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto>p{grid-column:1/-1;width:min(100%,820px)!important;margin:0 auto 32px!important;font-size:clamp(18px,1.65vw,22px)!important;line-height:1.5!important}.who-card{min-height:270px;overflow:hidden;display:grid;grid-template-columns:minmax(170px,34%) 1fr;border:1px solid rgba(107,42,47,.12);border-radius:30px;background:#fff;box-shadow:0 15px 34px rgba(107,42,47,.08);transition:.3s}.who-card:hover{transform:translateY(-5px);box-shadow:0 24px 50px rgba(107,42,47,.16)}.who-card-art{position:relative;min-height:270px;overflow:visible;background:transparent}.who-card-art span{position:absolute;inset:16% 8% 7% 8%;border-radius:28px;background:#7d4147;box-shadow:0 18px 30px rgba(76,8,21,.16);transition:transform .35s ease,box-shadow .35s ease}.who-card-art img{position:absolute;z-index:1;left:50%;bottom:0;width:112%;height:96%;object-fit:contain;object-position:center bottom;transform:translateX(-50%);transition:transform .35s ease}.who-card:hover .who-card-art img{transform:translateX(-50%) translateY(-3px)}.who-card:hover .who-card-art span{transform:translateY(-2px);box-shadow:0 22px 36px rgba(76,8,21,.22)}.who-card-content{display:flex;flex-direction:column;justify-content:center;padding:28px 30px}.who-card h3{margin:0;font-family:'Roboto Slab',serif;font-size:clamp(27px,2.5vw,35px);line-height:1.15;color:#6b2a2f}.who-card p{margin:14px 0 0;font-family:Roboto,sans-serif;font-size:16px;line-height:1.5;color:#505050}.who-emphasis{grid-column:1/-1;width:min(100%,820px);margin:32px auto 0;font-size:clamp(20px,2vw,24px);line-height:1.4}@media(max-width:900px){#who-we-do-it-for{padding:56px 16px!important}#who-we-do-it-for>div:first-child{display:none}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto{width:100%;display:flex;flex-direction:column;align-items:center;gap:16px}#who-we-do-it-for h2{width:100%!important;max-width:360px;font-size:42px!important;line-height:1.15!important}#who-we-do-it-for>.relative.w-\[1440px\].mx-auto>p{width:100%!important;max-width:360px;margin:0 0 16px!important;font-size:18px!important}.who-card{width:100%;max-width:360px;grid-template-columns:1fr}.who-card:hover{transform:none}.who-card-art{min-height:280px;overflow:visible}.who-card-art span{inset:18% 10% 6% 10%;border-radius:26px}.who-card-art img{width:min(112%,340px);height:270px;left:50%;bottom:0;transform:translateX(-50%)}.who-card:hover .who-card-art img{transform:translateX(-50%)}.who-card-content{padding:24px 22px 26px;text-align:center}.who-card h3{font-size:28px}.who-emphasis{width:100%;max-width:360px;margin:16px 0 0;font-size:19px}}@media(prefers-reduced-motion:reduce){.who-card,.who-card-art img,.who-card-art span{transition:none}}
</style>
