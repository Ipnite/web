---
// Fuente: index.tsx — sección "Why We Do It" (Figma 4:206)
// Las tarjetas tienen flip: frente blanco con título, dorso rojo con texto
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: "Por qué lo hacemos",
      intro: "Las ideas son una de las monedas más valiosas del mundo, pero demasiadas se pierden porque los inventores creen que la protección solo es para grandes corporaciones.",
      emphasis: "IPnite existe para cambiar esa narrativa.",
      cards: [
        { title: ["Ninguna idea", "es demasiado pequena"], back: "Si es importante para ti, tambien lo es para nosotros. Cada chispa merece la oportunidad de convertirse en una llama." },
        { title: ["Simple y", "transparente"], back: "Sin pasos confusos ni barreras innecesarias. Solo un camino claro y guiado desde la idea hasta el borrador estructurado." },
        { title: ["Impulsamos", "a los creadores"], back: "Herramientas para fundadores, inventores y equipos tecnicos que necesitan avanzar con seriedad." },
      ],
    }
  : lang === "pt"
  ? {
      heading: "Por que fazemos isso",
      intro: "As ideias são uma das moedas mais valiosas do mundo, mas muitas se perdem porque os inventores acham que a proteção é só para grandes empresas.",
      emphasis: "A IPnite existe para mudar essa narrativa.",
      cards: [
        { title: ["Nenhuma ideia", "é pequena demais"], back: "Se é importante para você, também é importante para nós. Cada centelha merece a chance de virar uma chama." },
        { title: ["Simples e", "transparente"], back: "Sem passos confusos nem barreiras desnecessárias. Apenas um caminho claro e guiado da ideia ao rascunho estruturado." },
        { title: ["Fortalecemos", "os criadores"], back: "Ferramentas para fundadores, inventores e equipes técnicas que precisam avançar com seriedade." },
      ],
    }
  : {
      heading: "Why we do it",
      intro: "Ideas are the world's most valuable currency, but too many are lost because inventors believe protection is only for large corporations.",
      emphasis: "IPnite exists to change that narrative.",
      cards: [
        { title: ["No Idea", "Too Small"], back: "If it's important to you, it's important to us. Every spark deserves a chance to become a flame." },
        { title: ["Simple &", "Transparent"], back: "No confusing first steps. Just a guided path from idea to structured draft." },
        { title: ["Empowering", "Creators"], back: "Tools for builders, founders, and creators preparing their inventions for review." },
      ],
    };
---

<section
  id="why-we-do-it"
  aria-labelledby="why-heading"
  class="relative z-0 w-full overflow-hidden bg-white"
  style="padding-top: 12px; padding-bottom: 88px;"
>
  <!-- Gradiente decorativo -->
  <div class="absolute top-0 left-0 w-[1439px] h-[1260px] opacity-15 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[#6b2a2f] rounded-[50%] blur-[250px] opacity-50"></div>
    <div class="absolute top-[227px] left-[201px] w-[1075px] h-[779px] rounded-[50%] blur-[400px] opacity-50"
      style="background:linear-gradient(197deg,rgba(245,245,245,.8) 0%,rgba(245,245,245,.8) 100%)">
    </div>
  </div>

  <div class="relative w-[1440px] mx-auto">
    <!-- Heading -->
    <h2
      id="why-heading"
      class="absolute top-[36px] left-[calc(50%-216px)] w-[433px] [font-family:'Roboto_Slab',serif] font-bold text-[#4c0815] text-5xl text-center tracking-[0] leading-[64.8px]"
    >
      {copy.heading}
    </h2>

    <!-- Separador -->
    <div class="absolute top-[116px] left-[calc(50%-197px)] w-[395px] h-[3px] bg-[#6b2a2f] opacity-40"></div>

    <!-- Párrafo -->
    <p class="absolute top-[133px] left-[calc(50%-380px)] w-[760px] [font-family:'Roboto',sans-serif] text-[#505050] text-[22px] text-center tracking-[-0.42px] leading-[33px]">
      <span class="font-medium">
        {copy.intro}
      </span>
      <br />
      <strong class="[font-family:'Roboto',sans-serif] font-bold">{copy.emphasis}</strong>
    </p>

    <!-- Card 1: No Idea Too Small -->
    <article class="absolute top-[275px] left-[85px] w-[405px] h-[180px] group cursor-default">
      <!-- Dorso (rojo) -->
      <div class="absolute inset-0 rounded-[30px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-6"
        style="background:linear-gradient(180deg,#996c6f 0%,#865155 49%,#6c2b30 100%)">
        <p class="[font-family:'Roboto',sans-serif] font-normal text-white text-xl text-center tracking-[-0.38px] leading-[30px]">
          {copy.cards[0].back}
        </p>
      </div>
      <!-- Frente (blanco) -->
      <div class="absolute inset-0 rounded-[30px] bg-white flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300">
        <div class="[font-family:'Roboto_Slab',serif] font-semibold text-[#6b2a2f] text-[42px] text-center tracking-[0] leading-[50.4px]">
          {copy.cards[0].title[0]}<br />{copy.cards[0].title[1]}
        </div>
      </div>
    </article>

    <!-- Card 2: Simple & Transparent -->
    <article class="absolute top-[356px] left-[519px] w-[405px] h-[180px] group cursor-default">
      <div class="absolute inset-0 rounded-[30px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-6"
        style="background:linear-gradient(180deg,#996c6f 0%,#865155 49%,#6c2b30 100%)">
        <p class="[font-family:'Roboto',sans-serif] font-normal text-white text-xl text-center tracking-[-0.38px] leading-[30px]">
          {copy.cards[1].back}
        </p>
      </div>
      <div class="absolute inset-0 rounded-[30px] bg-white flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300">
        <div class="[font-family:'Roboto_Slab',serif] font-semibold text-[#6b2a2f] text-[42px] text-center tracking-[0] leading-[50.4px]">
          {copy.cards[1].title[0]}<br />{copy.cards[1].title[1]}
        </div>
      </div>
    </article>

    <!-- Card 3: Empowering Creators -->
    <article class="absolute top-[275px] left-[954px] w-[405px] h-[180px] group cursor-default">
      <div class="absolute inset-0 rounded-[30px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-6"
        style="background:linear-gradient(180deg,#996c6f 0%,#865155 49%,#6c2b30 100%)">
        <p class="[font-family:'Roboto',sans-serif] font-normal text-white text-xl text-center tracking-[-0.38px] leading-[30px]">
          {copy.cards[2].back}
        </p>
      </div>
      <div class="absolute inset-0 rounded-[30px] bg-white flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300">
        <div class="[font-family:'Roboto_Slab',serif] font-semibold text-[#6b2a2f] text-[42px] text-center tracking-[0] leading-[50.4px]">
          {copy.cards[2].title[0]}<br />{copy.cards[2].title[1]}
        </div>
      </div>
    </article>

    <!-- Ícono entre card 1 y 2 -->
    <div class="why-brain-ring absolute top-[415px] left-[465px] w-[75px] h-[75px] rounded-full flex items-center justify-center" aria-hidden="true">
      <img class="why-brain-icon w-[44px] h-[40px] object-contain" alt="" src="/images/cerebro.png" />
    </div>

    <!-- Ícono entre card 2 y 3 -->
    <div class="why-brain-ring absolute top-[365px] left-[899px] w-[75px] h-[75px] rounded-full flex items-center justify-center" aria-hidden="true">
      <img class="why-brain-icon w-[44px] h-[40px] object-contain" alt="" src="/images/cerebro.png" />
    </div>
  </div>

  <!-- Spacer para que el section ocupe altura correcta (tarjetas absolutas) -->
  <div style="height: 570px;"></div>
</section>

<style>
  .why-brain-ring {
    border: 2px solid #6b2a2f;
    background: transparent;
    box-shadow: 0 8px 18px rgba(107, 42, 47, 0.10);
  }

  .why-brain-icon {
    filter: saturate(1.35) contrast(1.08);
  }

  #why-we-do-it {
    padding: 52px clamp(18px, 5vw, 80px) 96px !important;
  }

  #why-we-do-it > .relative.w-\[1440px\].mx-auto {
    width: min(100%, 1280px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: stretch;
  }

  #why-we-do-it h2,
  #why-we-do-it > .relative.w-\[1440px\].mx-auto > p,
  #why-we-do-it article,
  #why-we-do-it > .relative.w-\[1440px\].mx-auto > div {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
  }

  #why-we-do-it h2 {
    grid-column: 1 / -1;
    width: min(100%, 760px) !important;
    margin: 0 auto !important;
    font-size: clamp(44px, 4vw, 58px) !important;
    line-height: 1.12 !important;
    text-wrap: balance;
  }

  #why-we-do-it > .relative.w-\[1440px\].mx-auto > div:first-of-type {
    grid-column: 1 / -1;
    width: min(395px, 70vw) !important;
    height: 3px !important;
    margin: -8px auto 0 !important;
  }

  #why-we-do-it > .relative.w-\[1440px\].mx-auto > p {
    grid-column: 1 / -1;
    width: min(100%, 820px) !important;
    margin: 0 auto 32px !important;
    font-size: clamp(18px, 1.65vw, 22px) !important;
    line-height: 1.5 !important;
    letter-spacing: 0 !important;
  }

  #why-we-do-it article {
    width: 100% !important;
    min-height: 190px;
    height: auto !important;
  }

  #why-we-do-it article:nth-of-type(1),
  #why-we-do-it article:nth-of-type(2),
  #why-we-do-it article:nth-of-type(3) {
    grid-column: auto;
  }

  #why-we-do-it .why-brain-ring {
    display: none;
  }

  #why-we-do-it > div:last-child {
    display: none;
  }

  @media (max-width: 900px) {
    #why-we-do-it {
      padding: 58px 16px 72px !important;
      overflow: hidden;
    }

    #why-we-do-it > div:first-child {
      display: none;
    }

    #why-we-do-it > .relative.w-\[1440px\].mx-auto {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    #why-we-do-it h2,
    #why-we-do-it p,
    #why-we-do-it article,
    #why-we-do-it > .relative.w-\[1440px\].mx-auto > div {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      transform: none !important;
    }

    #why-we-do-it h2 {
      order: 1;
      width: 100% !important;
      max-width: 360px;
      margin: 0 !important;
      font-size: 42px !important;
      line-height: 1.15 !important;
      text-wrap: balance;
    }

    #why-we-do-it > .relative.w-\[1440px\].mx-auto > div:first-of-type {
      order: 2;
      width: min(260px, 74vw) !important;
      height: 3px !important;
      margin: 0 auto 2px !important;
    }

    #why-we-do-it > .relative.w-\[1440px\].mx-auto > p {
      order: 3;
      width: 100% !important;
      max-width: 360px;
      margin: 0 0 16px !important;
      font-size: 18px !important;
      line-height: 1.5 !important;
      letter-spacing: 0 !important;
      text-wrap: pretty;
    }

    #why-we-do-it article {
      order: 4;
      width: 100% !important;
      max-width: 360px;
      height: auto !important;
      margin-top: 6px;
      display: grid;
      overflow: hidden;
      border-radius: 30px;
      background: #fff;
      box-shadow: 0 14px 30px rgba(107, 42, 47, 0.08);
    }

    #why-we-do-it article > div {
      position: relative !important;
      inset: auto !important;
      opacity: 1 !important;
      border-radius: 0 !important;
      min-height: 0 !important;
      transition: none !important;
    }

    #why-we-do-it article > div:first-child {
      order: 2;
    }

    #why-we-do-it article > div:nth-child(2) {
      order: 1;
    }

    #why-we-do-it article [class*="text-[42px]"] {
      padding: 24px 20px 12px;
      font-size: 30px !important;
      line-height: 1.15 !important;
    }

    #why-we-do-it article p {
      max-width: none;
      padding: 18px 20px 22px;
      font-size: 16px !important;
      line-height: 1.45 !important;
    }

    #why-we-do-it > .relative.w-\[1440px\].mx-auto > div:not(:first-of-type) {
      display: none;
    }

    #why-we-do-it > div:last-child {
      height: 0 !important;
    }
  }
</style>
