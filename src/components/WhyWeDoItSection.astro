---
// Fuente: index.tsx — sección "Who We Do It For" (antes "Why We Do It", Figma 4:206)
// Las tarjetas tienen flip: frente blanco con título, dorso rojo con texto
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: "Para quién lo hacemos",
      intro: "Desde un inventor que presenta su primera idea hasta una oficina de transferencia tecnológica universitaria, IPnite está pensado para quien convierte una idea en propiedad intelectual protegida.",
      emphasis: "Si estás construyendo algo que vale la pena proteger, IPnite es para vos.",
      cards: [
        { title: ["Inventores"], back: "Inventores independientes que convierten una idea en un borrador de patente estructurado y listo para revisión, sin necesitar un abogado desde el primer día." },
        { title: ["Startups"], back: "Fundadores y equipos de producto que documentan invenciones y gestionan su PI como parte de construir su empresa." },
        { title: ["Centros de Investigación", "y Universidades"], back: "Instituciones y oficinas de transferencia tecnológica que preparan divulgaciones y borradores de patente para las invenciones de sus laboratorios." },
        { title: ["Profesionales", "de PI"], back: "Abogados y agentes que usan IPnite para acelerar la redacción, la revisión de arte previo y la tramitación para sus clientes." },
      ],
    }
  : lang === "pt"
  ? {
      heading: "Para quem fazemos isso",
      intro: "De um inventor que apresenta sua primeira ideia a um escritório de transferência de tecnologia universitário, a IPnite é feita para quem transforma uma ideia em propriedade intelectual protegida.",
      emphasis: "Se você está construindo algo que vale a pena proteger, a IPnite é para você.",
      cards: [
        { title: ["Inventores"], back: "Inventores independentes que transformam uma ideia em um rascunho de patente estruturado e pronto para revisão, sem precisar de um advogado desde o primeiro dia." },
        { title: ["Startups"], back: "Fundadores e equipes de produto que documentam invenções e gerenciam sua PI como parte da construção da empresa." },
        { title: ["Centros de Pesquisa", "e Universidades"], back: "Instituições e escritórios de transferência de tecnologia que preparam divulgações e rascunhos de patente para as invenções de seus laboratórios." },
        { title: ["Profissionais", "de PI"], back: "Advogados e agentes que usam a IPnite para acelerar a redação, a revisão de arte anterior e a prosecução para seus clientes." },
      ],
    }
  : {
      heading: "Who We Do It For",
      intro: "From a first-time inventor to a university tech transfer office, IPnite is built for anyone turning an idea into protected intellectual property.",
      emphasis: "If you're building something worth protecting, IPnite is for you.",
      cards: [
        { title: ["Inventors"], back: "Independent inventors turning a raw idea into a structured, review-ready patent draft without needing an attorney from day one." },
        { title: ["Startups"], back: "Founders and product teams documenting inventions and managing IP as part of building their company." },
        { title: ["Research Centers", "& Universities"], back: "Institutions and tech transfer offices preparing disclosures and patent drafts for the inventions coming out of their labs." },
        { title: ["IP", "Professionals"], back: "Attorneys and agents who use IPnite to speed up drafting, prior-art review, and prosecution work for their clients." },
      ],
    };
---

<section
  id="who-we-do-it-for"
  aria-labelledby="who-heading"
  class="relative z-0 w-full overflow-hidden bg-white"
  style="padding-top: 12px; padding-bottom: 88px;"
>
  <!-- Gradiente decorativo -->
  <div class="absolute top-0 left-0 w-[1439px] h-[1260px] opacity-15 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[#6b2a2f] rounded-[50%] blur-[250px] opacity-50"></div>
    <div class="absolute top-[227px] left-[201px] w-[1075px] h-[779px] rounded-[50%] blur-[400px] opacity-50"
      style="background:linear-gradient(197deg,rgba(245,245,245,.8) 0%,rgba(245,245,245,.8) 100%)">
    </div>
  </div>

  <div class="relative w-[1440px] mx-auto">
    <!-- Heading -->
    <h2
      id="who-heading"
      class="relative [font-family:'Roboto_Slab',serif] font-bold text-[#4c0815] text-5xl text-center tracking-[0] leading-[64.8px]"
    >
      {copy.heading}
    </h2>

    <!-- Separador -->
    <div class="relative h-[3px] bg-[#6b2a2f] opacity-40"></div>

    <!-- Párrafo -->
    <p class="relative [font-family:'Roboto',sans-serif] text-[#505050] text-[22px] text-center tracking-[-0.42px] leading-[33px]">
      <span class="font-medium">
        {copy.intro}
      </span>
    </p>

    <!-- Audience cards -->
    {copy.cards.map((card) => (
      <article class="who-card group cursor-default">
        <!-- Dorso (rojo) -->
        <div class="absolute inset-0 rounded-[30px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-6"
          style="background:linear-gradient(180deg,#996c6f 0%,#865155 49%,#6c2b30 100%)">
          <p class="[font-family:'Roboto',sans-serif] font-normal text-white text-xl text-center tracking-[-0.38px] leading-[30px]">
            {card.back}
          </p>
        </div>
        <!-- Frente (blanco) -->
        <div class="absolute inset-0 rounded-[30px] bg-white flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300 p-6">
          <div class="[font-family:'Roboto_Slab',serif] font-semibold text-[#6b2a2f] text-[36px] text-center tracking-[0] leading-[43.2px]">
            {card.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
          </div>
        </div>
      </article>
    ))}

    <!-- Énfasis final -->
    <p class="who-emphasis [font-family:'Roboto',sans-serif] font-bold text-[#4c0815] text-center">
      {copy.emphasis}
    </p>
  </div>
</section>

<style>
  #who-we-do-it-for {
    padding: 52px clamp(18px, 5vw, 80px) 56px !important;
  }

  #who-we-do-it-for > .relative.w-\[1440px\].mx-auto {
    position: relative;
    width: min(100%, 1280px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    align-items: stretch;
  }

  #who-we-do-it-for h2 {
    grid-column: 1 / -1;
    width: min(100%, 760px) !important;
    margin: 0 auto !important;
    font-size: clamp(44px, 4vw, 58px) !important;
    line-height: 1.12 !important;
    text-wrap: balance;
  }

  #who-we-do-it-for > .relative.w-\[1440px\].mx-auto > div:first-of-type {
    grid-column: 1 / -1;
    width: min(395px, 70vw) !important;
    margin: -8px auto 0 !important;
  }

  #who-we-do-it-for > .relative.w-\[1440px\].mx-auto > p {
    grid-column: 1 / -1;
    width: min(100%, 820px) !important;
    margin: 0 auto 32px !important;
    font-size: clamp(18px, 1.65vw, 22px) !important;
    line-height: 1.5 !important;
    letter-spacing: 0 !important;
  }

  .who-card {
    position: relative;
    width: 100%;
    min-height: 190px;
    height: auto;
  }

  .who-emphasis {
    grid-column: 1 / -1;
    width: min(100%, 820px);
    margin: 32px auto 0;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    #who-we-do-it-for {
      padding: 58px 16px 44px !important;
      overflow: hidden;
    }

    #who-we-do-it-for > div:first-child {
      display: none;
    }

    #who-we-do-it-for > .relative.w-\[1440px\].mx-auto {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    #who-we-do-it-for h2 {
      width: 100% !important;
      max-width: 360px;
      margin: 0 !important;
      font-size: 42px !important;
      line-height: 1.15 !important;
      text-wrap: balance;
    }

    #who-we-do-it-for > .relative.w-\[1440px\].mx-auto > div:first-of-type {
      width: min(260px, 74vw) !important;
      margin: 0 auto 2px !important;
    }

    #who-we-do-it-for > .relative.w-\[1440px\].mx-auto > p {
      width: 100% !important;
      max-width: 360px;
      margin: 0 0 16px !important;
      font-size: 18px !important;
      line-height: 1.5 !important;
      letter-spacing: 0 !important;
      text-wrap: pretty;
    }

    .who-card {
      width: 100% !important;
      max-width: 360px;
      height: auto !important;
      margin-top: 6px;
      display: grid;
      overflow: hidden;
      border-radius: 30px;
      background: #fff;
      box-shadow: 0 14px 30px rgba(107, 42, 47, 0.08);
    }

    .who-card > div {
      position: relative !important;
      inset: auto !important;
      opacity: 1 !important;
      border-radius: 0 !important;
      min-height: 0 !important;
      transition: none !important;
    }

    .who-card > div:first-child {
      order: 2;
    }

    .who-card > div:nth-child(2) {
      order: 1;
    }

    .who-card [class*="text-[36px]"] {
      padding: 24px 20px 12px;
      font-size: 28px !important;
      line-height: 1.18 !important;
    }

    .who-card p {
      max-width: none;
      padding: 18px 20px 22px;
      font-size: 16px !important;
      line-height: 1.45 !important;
    }

    .who-emphasis {
      width: 100%;
      max-width: 360px;
      margin: 16px 0 0;
      font-size: 19px;
      line-height: 1.4;
    }
  }
</style>
