---
// Fuente: index.tsx + PlatformHighlightsSection.tsx (Figma 4:252)
// height Figma: 600px, top: 2080
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;

const copy = lang === "es"
  ? {
      heading: ["Tu equipo de PI en", "una sola interfaz"],
      discoveryTitle: "Agente de descubrimiento",
      discoveryBody: "Te ayuda a estructurar ideas e identificar tecnologías similares",
      draftingTitle: "Agente de redacción",
      draftingBody: "Genera un borrador de solicitud de patente estructurado",
      ftoTitle: "Agente FTO",
      ftoBody: "Ayuda a analizar la libertad de operación para revisión profesional",
      drawingTitle: "Agente de dibujos",
      drawingBody: "Genera diagramas y dibujos de referencia",
      strategyTitle: "Agente de estrategia",
      strategyBody: "Te ayuda a planificar los próximos pasos para proteger tu innovación",
      portfolioTitle: "Agente de gestión de cartera",
      portfolioBody: "Organiza tus invenciones, documentos y fechas importantes",
      laptopAlt: "Espacio de trabajo de IPnite en una laptop",
    }
  : lang === "pt"
  ? {
      heading: ["Seu time de PI em", "uma única interface"],
      discoveryTitle: "Agente de descoberta",
      discoveryBody: "Ajuda a estruturar ideias e identificar tecnologias semelhantes",
      draftingTitle: "Agente de redação",
      draftingBody: "Gera um rascunho estruturado de pedido de patente",
      ftoTitle: "Agente FTO",
      ftoBody: "Ajuda a analisar a liberdade de operação para revisão profissional",
      drawingTitle: "Agente de desenhos",
      drawingBody: "Gera diagramas e desenhos de referência",
      strategyTitle: "Agente de estratégia",
      strategyBody: "Ajuda a planejar os próximos passos para proteger sua inovação",
      portfolioTitle: "Agente de gestão de portfólio",
      portfolioBody: "Organiza suas invenções, documentos e datas importantes",
      laptopAlt: "Espaço de trabalho da IPnite em um laptop",
    }
  : {
      heading: ["Your IP Team in", "One Interface"],
      discoveryTitle: "Discovery Agent",
      discoveryBody: "Helps you structure ideas and identify similar technologies",
      draftingTitle: "Drafter Agent",
      draftingBody: "Generates a structured patent application draft",
      ftoTitle: "FTO Agent",
      ftoBody: "Helps analyze freedom to operate for professional review",
      drawingTitle: "Drawing Agent",
      drawingBody: "Generates diagrams and reference drawings",
      strategyTitle: "Strategy Agent",
      strategyBody: "Helps plan the next steps to protect your innovation",
      portfolioTitle: "Portfolio Manager Agent",
      portfolioBody: "Organizes your inventions, documents, and important dates",
      laptopAlt: "IPnite workspace on a laptop",
    };
---

<section
  id="ip-team"
  aria-labelledby="ipteam-heading"
  class="relative w-full overflow-hidden bg-white"
  style="height: 600px;"
>
  <div class="absolute inset-0 w-[1440px] mx-auto" style="left:0;right:0;margin:auto;">
    <!-- Glass card de fondo -->
    <div
      class="absolute top-[77px] left-[75px] w-[1283px] h-[446px] bg-[#d9d9d933] rounded-[50px] backdrop-blur-[2px]"
      style="box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 1px 0 0 rgba(255,255,255,.32),inset 0 -1px 1px rgba(0,0,0,.13),inset -1px 0 1px rgba(0,0,0,.11)"
      aria-hidden="true"
    ></div>

    <!-- MacBook mockup izquierda -->
    <div class="absolute top-[131px] left-[20px] w-[560px] h-[339px]">
      <img
        src="/images/notebook-1.png" width="750" height="457"
        alt={copy.laptopAlt}
        class="w-full h-full object-contain"
        loading="lazy"
      />
    </div>

    <!-- Textos derecha -->
    <div class="absolute top-[141px] left-[544px] w-[786px]">
      <h2 id="ipteam-heading" class="[font-family:'Roboto_Slab',serif] font-normal text-[#6b2a2f] text-5xl text-center tracking-[0] leading-[72px] whitespace-nowrap" style="margin-left:27px">{copy.heading[0]} <strong class="font-bold">{copy.heading[1]}</strong></h2>

      <!-- Top row agentes -->
      <div class="relative mt-6 flex gap-0" style="height:96px">
        <!-- Discovery Agent -->
        <p class="absolute top-0 left-0 w-[301px] [font-family:'Roboto',sans-serif] text-xl text-center tracking-[-0.38px] leading-[30px]">
          <strong class="font-black text-[#6b2a2f]">{copy.discoveryTitle} </strong>
          <span class="font-medium text-[#505050]">{copy.discoveryBody}</span>
        </p>
        <!-- FTO Agent -->
        <p class="absolute top-0 left-[290px] w-[242px] [font-family:'Roboto',sans-serif] text-xl text-center tracking-[-0.38px] leading-[30px]">
          <strong class="font-black text-[#6b2a2f]">{copy.ftoTitle} </strong>
          <span class="font-medium text-[#505050]">{copy.ftoBody}</span>
        </p>
        <!-- Drafter Agent -->
        <p class="absolute top-0 left-[521px] w-[265px] [font-family:'Roboto',sans-serif] text-xl text-center tracking-[-0.38px] leading-[30px]">
          <strong class="font-black text-[#6b2a2f]">{copy.draftingTitle} </strong>
          <span class="font-medium text-[#505050]">{copy.draftingBody}</span>
        </p>
      </div>

      <!-- Bottom row agentes -->
      <div class="relative mt-6 ml-[134px] flex gap-2.5" style="height:96px">
        <p class="w-[237px] [font-family:'Roboto',sans-serif] text-xl text-center tracking-[-0.38px] leading-[30px]">
          <strong class="font-black text-[#6b2a2f]">{copy.portfolioTitle} </strong>
          <span class="font-medium text-[#505050]">{copy.portfolioBody}</span>
        </p>
        <p class="w-[237px] [font-family:'Roboto',sans-serif] text-xl text-center tracking-[-0.38px] leading-[30px]">
          <strong class="font-black text-[#6b2a2f]">{copy.drawingTitle} </strong>
          <span class="font-medium text-[#505050]">{copy.drawingBody}</span>
        </p>
        <p class="w-[306px] [font-family:'Roboto',sans-serif] text-xl text-center tracking-[-0.38px] leading-[30px]">
          <strong class="font-black text-[#6b2a2f]">{copy.strategyTitle} </strong>
          <span class="font-medium text-[#505050]">{copy.strategyBody}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  #ip-team {
    height: auto !important;
    padding: 64px clamp(18px, 5vw, 80px);
    overflow: visible !important;
  }

  #ip-team > div {
    position: relative !important;
    inset: auto !important;
    width: min(100%, 1280px) !important;
    display: grid;
    grid-template-columns: minmax(260px, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
    border-radius: 50px;
    background: rgba(217, 217, 217, 0.2);
    padding: clamp(30px, 3.6vw, 50px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.4), inset 1px 0 0 rgba(255,255,255,.32), inset 0 -1px 1px rgba(0,0,0,.13), inset -1px 0 1px rgba(0,0,0,.11);
  }

  #ip-team > div > div:first-child {
    display: none;
  }

  #ip-team > div > div:nth-child(2),
  #ip-team > div > div:nth-child(3) {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    width: 100% !important;
    height: auto !important;
  }

  #ip-team > div > div:nth-child(2) img {
    height: auto !important;
  }

  #ip-team > div > div:nth-child(3) {
    display: grid;
    gap: 20px;
  }

  #ipteam-heading {
    width: 100% !important;
    margin: 0 !important;
    font-size: clamp(38px, 3.6vw, 48px) !important;
    line-height: 1.16 !important;
    white-space: normal !important;
    text-wrap: balance;
  }

  #ip-team > div > div:nth-child(3) > div {
    position: static !important;
    height: auto !important;
    margin: 0 !important;
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px !important;
  }

  #ip-team > div > div:nth-child(3) > div:last-child {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
  }

  #ip-team p {
    position: static !important;
    width: 100% !important;
    min-height: 104px;
    display: block;
    border-radius: 18px;
    padding: 16px 14px;
    background: rgba(255, 255, 255, 0.65);
    font-size: clamp(13px, 1.05vw, 16px) !important;
    line-height: 1.28 !important;
    letter-spacing: 0 !important;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  #ip-team p strong,
  #ip-team p span {
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  #ip-team p strong {
    display: block;
    margin-bottom: 6px;
    line-height: 1.15;
  }

  @media (max-width: 1060px) {
    #ip-team > div {
      grid-template-columns: 1fr;
    }

    #ip-team > div > div:nth-child(2) {
      max-width: 520px;
      margin: 0 auto;
    }
  }

  @media (max-width: 760px) {
    #ip-team {
      height: auto !important;
      overflow: visible !important;
      padding: 56px 16px;
    }

    #ip-team > div {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 420px !important;
      display: grid;
      gap: 22px;
      padding: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    #ip-team > div > div:first-child {
      display: none;
    }

    #ip-team > div > div:nth-child(2),
    #ip-team > div > div:nth-child(3) {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
    }

    #ip-team > div > div:nth-child(2) {
      order: 2;
      max-width: 330px;
      margin: 0 auto;
    }

    #ip-team > div > div:nth-child(2) img {
      height: auto !important;
    }

    #ip-team > div > div:nth-child(3) {
      order: 1;
      display: grid;
      gap: 16px;
    }

    #ipteam-heading {
      width: 100% !important;
      margin: 0 !important;
      font-size: 34px !important;
      line-height: 1.12 !important;
      white-space: normal !important;
    }

    #ip-team > div > div:nth-child(3) > div {
      position: static !important;
      height: auto !important;
      margin: 0 !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 10px !important;
    }

    #ip-team p {
      position: static !important;
      width: 100% !important;
      min-height: 0 !important;
      padding: 16px 18px;
      border: 1px solid rgba(107, 42, 47, 0.12);
      border-radius: 20px;
      background: #fff;
      box-shadow: 0 14px 30px rgba(107, 42, 47, 0.06);
      font-size: 15px !important;
      line-height: 1.45 !important;
      letter-spacing: 0 !important;
    }
  }
</style>
