---
import "../styles/global.css";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  keywords?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  lang?: "en" | "es" | "pt";
  alternatePath?: string;
  robots?: string;
}

const {
  title = "IPnite — Patent Drafting for Everyone",
  description = "AI-powered provisional patent drafting. Protect your ideas with a serious, guided workflow built for inventors.",
  canonicalPath = Astro.url.pathname,
  keywords = "IPnite, AI patent drafting, patent preparation, provisional patent draft, intellectual property, inventors, founders, patent workflow, prior art review, patent claims",
  structuredData = [],
  lang = "en",
  alternatePath,
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

const siteUrl = "https://www.ipnite.com";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();

function localizedCanonicalPath(targetLocale: "en" | "es" | "pt") {
  const stripped = canonicalPath.replace(/^\/(es|pt-br)(?=\/|$)/, "") || "/";
  const prefixMap = { en: "", es: "/es", pt: "/pt-br" };
  const targetPrefix = prefixMap[targetLocale];
  if (stripped === "/") return targetPrefix ? targetPrefix + "/" : "/";
  return targetPrefix + stripped;
}

const alternateUrls = [
  { hreflang: "en", href: new URL(localizedCanonicalPath("en"), siteUrl).toString() },
  { hreflang: "es", href: new URL(localizedCanonicalPath("es"), siteUrl).toString() },
  { hreflang: "pt-BR", href: new URL(localizedCanonicalPath("pt"), siteUrl).toString() },
  { hreflang: "x-default", href: new URL(localizedCanonicalPath("en"), siteUrl).toString() },
];
const schemaItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "IPnite",
    legalName: "IPnite",
    url: siteUrl,
    logo: `${siteUrl}/logo.png`,
    email: "info@ipnite.com",
    foundingLocation: [
      { "@type": "Place", name: "United States" },
      { "@type": "Place", name: "Argentina" },
      { "@type": "Place", name: "Mexico" },
    ],
    areaServed: [
      { "@type": "Country", name: "United States" },
      { "@type": "Place", name: "Latin America" },
      { "@type": "Place", name: "European Patent Office jurisdictions" },
    ],
    contactPoint: {
      "@type": "ContactPoint",
      email: "info@ipnite.com",
      contactType: "customer support",
      areaServed: ["US", "MX", "AR", "LATAM", "EPO"],
      availableLanguage: ["English", "Spanish", "Portuguese"],
    },
    sameAs: [
      "https://www.linkedin.com/company/ipnite/",
      "https://www.instagram.com/ip_nite",
      "https://x.com/ip_nite",
      "https://www.tiktok.com/@ipnite",
    ],
    description:
      "IPnite is an AI-assisted patent preparation platform that helps independent inventors, entrepreneurs, startups, and venture-backed teams generate structured patent application drafts faster and at lower cost for the United States, Latin America, and EPO-oriented workflows.",
    knowsAbout: [
      "AI patent drafting",
      "provisional patent applications",
      "patent claims",
      "prior-art review",
      "invention disclosure",
      "startup intellectual property",
      "patent preparation in the United States",
      "patent preparation in Latin America",
      "EPO patent workflows",
    ],
  },
  ...schemaItems,
].filter(Boolean);
---

<html lang={lang === "pt" ? "pt-BR" : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="IPnite information for AI assistants" />
    {alternateUrls.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/png" href="/images/cerebro.png" />
    <link rel="apple-touch-icon" href="/images/cerebro.png" />
    <meta property="og:site_name" content="IPnite" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/logo.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KHW3X20ZSJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-KHW3X20ZSJ");
    </script>
    <script is:inline>
      (function () {
        var measurementId = "G-KHW3X20ZSJ";
        var minSectionMs = 1500;
        var sectionTimes = {};
        var activeSections = {};
        var observer;

        function clean(value) {
          return String(value || "")
            .replace(/\s+/g, " ")
            .trim()
            .slice(0, 140);
        }

        function getElementLabel(element) {
          return clean(
            element.getAttribute("data-analytics-label") ||
              element.getAttribute("aria-label") ||
              element.innerText ||
              element.textContent ||
              element.getAttribute("href") ||
              element.tagName
          );
        }

        function getSectionName(element) {
          var section = element.closest("section, article, header, footer, main, [id]");
          if (!section) return "unknown";
          return clean(
            section.getAttribute("data-analytics-section") ||
              section.getAttribute("aria-label") ||
              section.id ||
              section.className ||
              section.tagName
          );
        }

        function sendEvent(name, params) {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", name, Object.assign({
            page_path: window.location.pathname,
            page_title: document.title,
          }, params || {}));
        }

        function trackClick(event) {
          var target = event.target && event.target.closest && event.target.closest("a, button");
          if (!target) return;

          var href = target.getAttribute("href") || "";
          var isExternal = false;
          try {
            isExternal = href ? new URL(href, window.location.href).origin !== window.location.origin : false;
          } catch (error) {}

          sendEvent("ipnite_button_click", {
            button_text: getElementLabel(target),
            button_type: target.tagName.toLowerCase(),
            button_url: href || "none",
            section_name: getSectionName(target),
            is_external: isExternal ? "true" : "false",
          });
        }

        function sectionId(section, index) {
          if (section.id) return section.id;
          var heading = section.querySelector && section.querySelector("h1, h2, h3");
          if (heading) return clean(heading.textContent).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
          return "section-" + index;
        }

        function startSection(id) {
          if (!activeSections[id]) activeSections[id] = Date.now();
        }

        function stopSection(id) {
          if (!activeSections[id]) return;
          sectionTimes[id] = (sectionTimes[id] || 0) + Date.now() - activeSections[id];
          delete activeSections[id];
        }

        function flushSections(reason) {
          Object.keys(activeSections).forEach(stopSection);
          Object.keys(sectionTimes).forEach(function (id) {
            var ms = sectionTimes[id];
            if (ms < minSectionMs) return;
            sendEvent("ipnite_section_engagement", {
              section_name: id,
              engagement_time_msec: Math.round(ms),
              engagement_seconds: Math.round(ms / 1000),
              engagement_reason: reason || "flush",
            });
            sectionTimes[id] = 0;
          });
        }

        function initSectionTracking() {
          if (!("IntersectionObserver" in window)) return;
          var sections = Array.prototype.slice.call(document.querySelectorAll("main section, main article, main header"));
          sections.forEach(function (section, index) {
            section.setAttribute("data-analytics-section", section.getAttribute("data-analytics-section") || sectionId(section, index));
          });

          observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              var id = entry.target.getAttribute("data-analytics-section");
              if (!id) return;
              if (entry.isIntersecting && entry.intersectionRatio >= 0.45 && !document.hidden) {
                startSection(id);
              } else {
                stopSection(id);
              }
            });
          }, { threshold: [0, 0.45, 0.75] });

          sections.forEach(function (section) { observer.observe(section); });
        }

        document.addEventListener("click", trackClick, true);
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) flushSections("visibility_hidden");
        });
        window.addEventListener("pagehide", function () { flushSections("pagehide"); });
        window.addEventListener("beforeunload", function () { flushSections("beforeunload"); });
        window.addEventListener("load", initSectionTracking);

        window.ipniteAnalytics = {
          flushSections: flushSections,
          measurementId: measurementId,
        };
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(baseStructuredData)} />
  </head>
  <body class="bg-white text-gris3 antialiased">
    <Navbar lang={lang} alternatePath={alternatePath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
