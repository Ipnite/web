---
import "../styles/global.css";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  keywords?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  lang?: "en" | "es" | "pt";
  alternatePath?: string;
  robots?: string;
}

const {
  title = "IPnite — Patent Drafting for Everyone",
  description = "AI-powered provisional patent drafting. Protect your ideas with a serious, guided workflow built for inventors.",
  canonicalPath = Astro.url.pathname,
  keywords = "IPnite, AI patent drafting, patent preparation, provisional patent draft, intellectual property, inventors, founders, patent workflow, prior art review, patent claims",
  structuredData = [],
  lang = "en",
  alternatePath,
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

const siteUrl = "https://www.ipnite.com";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();

function localizedCanonicalPath(targetLocale: "en" | "es" | "pt") {
  const stripped = canonicalPath.replace(/^\/(es|pt-br)(?=\/|$)/, "") || "/";
  const prefixMap = { en: "", es: "/es", pt: "/pt-br" };
  const targetPrefix = prefixMap[targetLocale];
  if (stripped === "/") return targetPrefix ? targetPrefix + "/" : "/";
  return targetPrefix + stripped;
}

const alternateUrls = [
  { hreflang: "en", href: new URL(localizedCanonicalPath("en"), siteUrl).toString() },
  { hreflang: "es", href: new URL(localizedCanonicalPath("es"), siteUrl).toString() },
  { hreflang: "pt-BR", href: new URL(localizedCanonicalPath("pt"), siteUrl).toString() },
  { hreflang: "x-default", href: new URL(localizedCanonicalPath("en"), siteUrl).toString() },
];
const schemaItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "IPnite",
    legalName: "IPnite",
    url: siteUrl,
    logo: `${siteUrl}/logo.png`,
    email: "info@ipnite.com",
    foundingLocation: [
      { "@type": "Place", name: "United States" },
      { "@type": "Place", name: "Argentina" },
      { "@type": "Place", name: "Mexico" },
    ],
    areaServed: [
      { "@type": "Country", name: "United States" },
      { "@type": "Place", name: "Latin America" },
      { "@type": "Place", name: "European Patent Office jurisdictions" },
    ],
    contactPoint: {
      "@type": "ContactPoint",
      email: "info@ipnite.com",
      contactType: "customer support",
      areaServed: ["US", "MX", "AR", "LATAM", "EPO"],
      availableLanguage: ["English", "Spanish", "Portuguese"],
    },
    sameAs: [
      "https://www.linkedin.com/company/ipnite/",
      "https://www.instagram.com/ip_nite",
      "https://x.com/ip_nite",
      "https://www.tiktok.com/@ipnite",
    ],
    description:
      "IPnite is an AI-assisted patent preparation platform that helps independent inventors, entrepreneurs, startups, and venture-backed teams generate structured patent application drafts faster and at lower cost for the United States, Latin America, and EPO-oriented workflows.",
    knowsAbout: [
      "AI patent drafting",
      "provisional patent applications",
      "patent claims",
      "prior-art review",
      "invention disclosure",
      "startup intellectual property",
      "patent preparation in the United States",
      "patent preparation in Latin America",
      "EPO patent workflows",
    ],
  },
  ...schemaItems,
].filter(Boolean);
const consentCopy=lang==="es"?{title:"Tu privacidad importa",body:"Usamos Analytics solo con tu permiso para entender qué páginas y funciones resultan útiles. No usamos publicidad ni enviamos contenido de proyectos. Rechazar mantiene activas las funciones esenciales de seguridad y sesión.",accept:"Aceptar Analytics",reject:"Rechazar",settings:"Privacidad",policy:"Ver política de privacidad"}:lang==="pt"?{title:"Sua privacidade importa",body:"Usamos o Analytics somente com sua permissão para entender quais páginas e recursos são úteis. Não usamos publicidade nem enviamos conteúdo de projetos. Recusar mantém ativas as funções essenciais de segurança e sessão.",accept:"Aceitar Analytics",reject:"Recusar",settings:"Privacidade",policy:"Ver política de privacidade"}:{title:"Your privacy matters",body:"We use Analytics only with your permission to understand which pages and features are useful. We do not use advertising or send project content. Reject keeps essential security and session functions active.",accept:"Accept Analytics",reject:"Reject",settings:"Privacy",policy:"View privacy policy"};
const privacyPath=lang==="es"?"/es/privacy/":lang==="pt"?"/pt-br/privacy/":"/privacy/";
---

<html lang={lang === "pt" ? "pt-BR" : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="IPnite information for AI assistants" />
    {alternateUrls.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/png" href="/images/cerebro.png" />
    <link rel="apple-touch-icon" href="/images/cerebro.png" />
    <meta property="og:site_name" content="IPnite" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/logo.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script src="/ipnite-analytics.js" defer></script>
    <script type="application/ld+json" set:html={JSON.stringify(baseStructuredData)} />
  </head>
  <body class="bg-white text-gris3 antialiased">
    <Navbar lang={lang} alternatePath={alternatePath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <aside id="analytics-consent" class="analytics-consent" hidden aria-labelledby="analytics-consent-title"><div><strong id="analytics-consent-title">{consentCopy.title}</strong><p>{consentCopy.body} <a href={privacyPath}>{consentCopy.policy}</a>.</p></div><div class="analytics-consent-actions"><button type="button" data-consent-choice="denied">{consentCopy.reject}</button><button type="button" class="primary" data-consent-choice="granted">{consentCopy.accept}</button></div></aside>
    <button type="button" id="analytics-preferences" class="analytics-preferences">{consentCopy.settings}</button>
  </body>
</html>

<style is:global>
.analytics-consent{position:fixed;z-index:10000;left:18px;right:18px;bottom:18px;max-width:860px;margin:auto;padding:18px;border:1px solid rgba(107,42,47,.22);border-radius:18px;background:rgba(255,255,255,.98);color:#3f1018;box-shadow:0 20px 60px rgba(47,10,17,.2);display:flex;align-items:center;justify-content:space-between;gap:24px;font-family:Roboto,sans-serif}.analytics-consent[hidden]{display:none}.analytics-consent strong{display:block;margin-bottom:5px;font-family:'Roboto Slab',serif;font-size:18px}.analytics-consent p{margin:0;max-width:590px;color:#505050;font-size:14px;line-height:1.5}.analytics-consent a{color:#6b2a2f;text-decoration:underline}.analytics-consent-actions{display:flex;flex-shrink:0;gap:8px}.analytics-consent button,.analytics-preferences{border:1px solid rgba(107,42,47,.3);border-radius:999px;background:#fff;color:#6b2a2f;padding:10px 15px;font-weight:700;cursor:pointer}.analytics-consent button.primary{background:#6b2a2f;color:#fff}.analytics-preferences{position:fixed;z-index:9998;left:12px;bottom:10px;padding:6px 10px;background:rgba(255,255,255,.92);font-size:11px}@media(max-width:720px){.analytics-consent{align-items:stretch;flex-direction:column;gap:14px}.analytics-consent-actions button{flex:1}}
</style>
