---
// Fuente: ApplicationFooterSection.tsx (Figma 4:498)
// height: 325
import NewsletterForm from "@components/NewsletterForm.astro";
import { routeFor } from "../data/routes";

interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;
const home = routeFor("home", lang);
const footerLinks = [
  { label: lang === "es" ? "Redacción con IA" : lang === "pt" ? "Redação com IA" : "AI Patent Drafting", href: routeFor("ai-drafting", lang) },
  { label: lang === "es" ? "Búsqueda de antecedentes" : lang === "pt" ? "Busca de anterioridade" : "Prior Art Search", href: routeFor("prior-art", lang) },
  { label: lang === "es" ? "Dibujos de patentes" : lang === "pt" ? "Desenhos de patentes" : "Patent Drawings", href: routeFor("drawings", lang) },
  { label: lang === "es" ? "Gestión de cartera" : lang === "pt" ? "Gestão de portfólio" : "Portfolio Management", href: routeFor("portfolio", lang) },
  { label: lang === "es" ? "Seguridad y privacidad" : lang === "pt" ? "Segurança e privacidade" : "Security", href: routeFor("security", lang) },
  { label: lang === "es" ? "Planes" : lang === "pt" ? "Planos" : "Plans", href: `${home}#plans` },
  { label: lang === "es" ? "Aprende" : lang === "pt" ? "Aprenda" : "Learn", href: routeFor("learn", lang) },
  { label: "FAQs", href: routeFor("faqs", lang) },
  { label: lang === "es" ? "Nosotros" : lang === "pt" ? "Sobre nós" : "About", href: routeFor("about", lang) },
];

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/ipnite/" },
  { label: "Instagram", href: "https://www.instagram.com/ip_nite" },
  { label: "X", href: "https://x.com/ipnite" },
  { label: "TikTok", href: "https://www.tiktok.com/@ipnite" },
  { label: "Facebook", href: "https://www.facebook.com/ipnite" },
];

const year = new Date().getFullYear();
const privacySettingsLabel = lang === "es" ? "Preferencias de privacidad" : lang === "pt" ? "Preferências de privacidade" : "Privacy settings";
const legalLinks = [
  {
    label: lang === "es" ? "Términos y condiciones" : lang === "pt" ? "Termos e condições" : "Terms and Conditions",
    href: routeFor("terms", lang),
  },
  {
    label: lang === "es" ? "Política de privacidad" : lang === "pt" ? "Política de privacidade" : "Privacy Policy",
    href: routeFor("privacy", lang),
  },
];
---

<footer
  class="site-footer relative overflow-hidden bg-[#6b2a2f]"
  style="min-height: 325px;"
  aria-label={lang === "es" ? "Pie de página" : lang === "pt" ? "Rodapé" : "Footer"}
>
  <div class="site-footer__inner relative mx-auto h-[325px] w-full max-w-[1440px]">
    <!-- Logo -->
    <div class="site-footer__brand absolute left-[69px] top-[39px]">
      <img
        class="h-[68px] w-[217px] object-contain"
        alt="IPnite logo"
        src="/logo-white.png" width="948" height="298"
        loading="lazy"
      />
    </div>

    <!-- Legal text -->
    <div class="site-footer__notice absolute left-[81px] top-[123px] w-[433px]">
        <p class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
          {lang === "es"
            ? "Aviso legal: IPnite es una herramienta de redacción asistida por IA y no constituye asesoría legal ni crea una relación abogado-cliente. Revisa tus borradores antes de presentarlos o envíalos a revisión con un profesional de patentes."
            : lang === "pt"
            ? "Aviso legal: a IPnite é uma ferramenta de redação assistida por IA e não constitui aconselhamento jurídico nem cria uma relação advogado-cliente. Revise seus rascunhos antes do depósito ou envie-os para revisão com um profissional de patentes."
            : "Legal notice: IPnite is an AI-assisted drafting tool. It does not provide legal advice or create an attorney-client relationship. Review your drafts before filing or have them reviewed by a patent professional."}
        </p>
      <p class="[font-family:'Roboto',sans-serif] mt-[22px] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
        {lang === "es" ? `© ${year} Ik-Holcan LLC. Todos los derechos reservados.` : lang === "pt" ? `© ${year} Ik-Holcan LLC. Todos os direitos reservados.` : `© ${year} Ik-Holcan LLC. All rights reserved.`}
      </p>
      <p class="[font-family:'Roboto',sans-serif] mt-[22px] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
        {lang === "es" ? "IPnite es un producto de Ik-Holcan LLC." : lang === "pt" ? "IPnite é um produto da Ik-Holcan LLC." : "IPnite is a product of Ik-Holcan LLC."}
      </p>
      <p class="[font-family:'Roboto',sans-serif] mt-[22px] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
        {lang === "es" ? "Contacto, aclaraciones y reclamaciones:" : lang === "pt" ? "Contato, dúvidas e reclamações:" : "Contact, questions, and complaints:"} <a href="mailto:info@ipnite.com" class="underline">info@ipnite.com</a>
      </p>
    </div>

    <!-- Nav links -->
    <nav class="footer-nav absolute left-[1059px] top-[123px]" aria-label={lang === "es" ? "Navegación del pie de página" : lang === "pt" ? "Navegação do rodapé" : "Footer navigation"}>
      <ul class="m-0 list-none p-0">
        {footerLinks.map((link) => (
          <li class="flex h-[25px]">
            <a
              href={link.href}
              class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[28.5px] tracking-[-0.28px] text-white hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
        {legalLinks.map((link) => (
          <li class="flex">
            <a
              href={link.href}
              class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[22px] tracking-[-0.28px] text-white hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="flex">
          <button type="button" id="analytics-preferences" class="footer-privacy-button [font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[22px] tracking-[-0.28px] text-white hover:underline">
            {privacySettingsLabel}
          </button>
        </li>
      </ul>
    </nav>

    <!-- Social links -->
    <nav class="footer-social absolute left-[1059px] top-[244px]" aria-label={lang === "es" ? "Redes sociales" : lang === "pt" ? "Redes sociais" : "Social links"}>
      <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[20px] tracking-[-0.28px] text-white hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Newsletter -->
    <div class="footer-newsletter">
      <NewsletterForm lang={lang} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 44px clamp(24px, 5vw, 80px) 38px;
    overflow: visible;
  }

  .site-footer__inner {
    height: auto !important;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(260px, auto);
    grid-template-areas:
      "links social"
      "newsletter newsletter"
      "brand notice";
    gap: 40px clamp(40px, 8vw, 120px);
    align-items: start;
  }

  .site-footer__inner > div,
  .site-footer__inner nav {
    position: static !important;
    width: auto !important;
    left: auto !important;
    top: auto !important;
  }

  .site-footer__brand {
    grid-area: brand;
    align-self: end;
    display: flex;
    align-items: flex-end;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .site-footer__notice {
    grid-area: notice;
    max-width: 720px;
    justify-self: end;
    align-self: end;
    padding-top: 26px;
    text-align: right;
  }

  .footer-nav {
    grid-area: links;
    justify-self: start;
  }

  .footer-social {
    grid-area: social;
    justify-self: end;
    text-align: right;
  }

  .footer-newsletter {
    grid-area: newsletter;
  }

  .footer-newsletter :global(.newsletter-form) {
    max-width: 420px;
  }

  .site-footer li {
    height: auto !important;
    min-height: 0;
    margin-top: 0 !important;
  }

  .site-footer nav a,
  .footer-privacy-button {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
  }

  .footer-privacy-button {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
  }

  .site-footer a,
  .site-footer p {
    overflow-wrap: anywhere;
  }

  .site-footer nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }

  .site-footer .footer-social ul {
    justify-content: flex-end;
  }

  .site-footer__notice p {
    margin-top: 10px !important;
  }

  .site-footer__notice p:first-child {
    margin-top: 0 !important;
  }

  @media (max-width: 760px) {
    .site-footer {
      min-height: auto !important;
      padding: 36px 20px 34px;
      overflow: visible !important;
    }

    .site-footer__inner {
      width: 100% !important;
      height: auto !important;
      max-width: 420px !important;
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas: none;
      gap: 24px;
    }

    .site-footer__inner > div,
    .site-footer__inner nav {
      width: 100% !important;
      grid-column: auto !important;
      grid-row: auto !important;
      grid-area: auto !important;
    }

    .site-footer__brand,
    .site-footer__notice {
      padding-top: 0;
      border-top: 0;
      justify-self: start;
      text-align: left;
    }

    .site-footer__brand {
      order: 3;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }

    .site-footer__notice {
      order: 4;
    }

    .footer-nav {
      order: 1;
    }

    .footer-legal,
    .footer-social {
      order: 2;
      margin-top: 0;
      justify-self: start;
      text-align: left;
    }

    .footer-newsletter {
      order: 2;
      justify-self: start;
      text-align: left;
    }

    .site-footer img[alt="IPnite logo"] {
      width: 150px !important;
      height: auto !important;
    }

    .site-footer nav ul {
      display: grid;
      gap: 4px;
    }

    .site-footer .footer-social ul {
      display: flex;
      justify-content: flex-start;
      gap: 6px 18px;
    }

    .site-footer nav a,
    .footer-privacy-button {
      min-height: 32px;
    }
  }
</style>
