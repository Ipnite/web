---
// Fuente: ApplicationFooterSection.tsx (Figma 4:498)
// height: 325
interface Props {
  lang?: "en" | "es" | "pt";
}

const { lang = "en" } = Astro.props;
const prefix = lang === "es" ? "/es" : lang === "pt" ? "/pt-br" : "";
const footerLinks = lang === "es"
  ? [
      { label: "Por que hacemos esto", href: `${prefix}/#why-we-do-it` },
      { label: "Equipo IP", href: `${prefix}/#ip-team` },
      { label: "Como funciona", href: `${prefix}/#how-it-works` },
      { label: "Planes", href: `${prefix}/#plans` },
      { label: "Contacto", href: `${prefix}/#contact` },
    ]
  : lang === "pt"
  ? [
      { label: "Por que fazemos isso", href: `${prefix}/#why-we-do-it` },
      { label: "Equipe IP", href: `${prefix}/#ip-team` },
      { label: "Como funciona", href: `${prefix}/#how-it-works` },
      { label: "Planos", href: `${prefix}/#plans` },
      { label: "Contato", href: `${prefix}/#contact` },
    ]
  : [
      { label: "Why We Do It", href: "/#why-we-do-it" },
      { label: "IP Team", href: "/#ip-team" },
      { label: "How It Works", href: "/#how-it-works" },
      { label: "Plans", href: "/#plans" },
      { label: "Contact", href: "/#contact" },
    ];

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/ipnite/" },
  { label: "Instagram", href: "https://www.instagram.com/ip_nite" },
  { label: "X", href: "https://x.com/ipnite" },
  { label: "TikTok", href: "https://www.tiktok.com/@ipnite" },
  { label: "Facebook", href: "https://www.facebook.com/ipnite" },
];

const legalLinks = [
  {
    label: lang === "es" ? "Términos y condiciones" : lang === "pt" ? "Termos e condições" : "Terms and Conditions",
    href: `${prefix}/termsandconditions`,
  },
  {
    label: lang === "es" ? "Política de privacidad" : lang === "pt" ? "Política de privacidade" : "Privacy Policy",
    href: `${prefix}/privacy`,
  },
];
---

<footer
  class="site-footer relative overflow-hidden bg-[#6b2a2f]"
  style="min-height: 325px;"
  aria-label={lang === "es" ? "Pie de página" : lang === "pt" ? "Rodapé" : "Footer"}
>
  <div class="site-footer__inner relative mx-auto h-[325px] w-full max-w-[1440px]">
    <!-- Logo -->
    <div class="site-footer__brand absolute left-[69px] top-[39px]">
      <img
        class="h-[68px] w-[217px] object-contain"
        alt="IPnite logo"
        src="/logo-white.png"
        loading="lazy"
      />
    </div>

    <!-- Legal text -->
    <div class="site-footer__notice absolute left-[81px] top-[123px] w-[433px]">
        <p class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
          {lang === "es"
            ? "Aviso legal: Esta herramienta es un asistente de escritura con IA y no constituye asesoramiento legal ni una relacion abogado-cliente formal. Revisa todos los borradores con un profesional registrado."
            : lang === "pt"
            ? "Aviso legal: Esta ferramenta e um assistente de escrita com IA e nao constitui aconselhamento juridico nem uma relacao formal advogado-cliente. Revise todos os rascunhos com um profissional registrado."
            : "Legal Notice: This tool is an AI writing assistant and does not constitute legal advice or a formal attorney-client relationship. Please review all drafts with a registered patent practitioner."}
        </p>
      <p class="[font-family:'Roboto',sans-serif] mt-[22px] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
        {lang === "es" ? "© IPnite — Todos los derechos reservados" : lang === "pt" ? "© IPnite — Todos os direitos reservados" : "© IPnite — All rights reserved"}
      </p>
      <p class="[font-family:'Roboto',sans-serif] mt-[22px] text-[15px] font-medium leading-[22.5px] tracking-[-0.28px] text-white">
        {lang === "es" ? "Impulsado por Ik-Holcán" : lang === "pt" ? "Desenvolvido por Ik-Holcán" : "Powered by Ik-Holcán"}
      </p>
    </div>

    <!-- Nav links -->
    <nav class="footer-nav absolute left-[1059px] top-[123px]" aria-label="Footer navigation">
      <ul class="m-0 list-none p-0">
        {footerLinks.map((link, i) => (
          <li class={`flex h-[25px] ${i > 0 ? "mt-[4px]" : ""}`}>
            <a
              href={link.href}
              class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[28.5px] tracking-[-0.28px] text-white hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
        {legalLinks.map((link) => (
          <li class="flex">
            <a
              href={link.href}
              class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[22px] tracking-[-0.28px] text-white hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Social links -->
    <nav class="footer-social absolute left-[1059px] top-[244px]" aria-label="Social links">
      <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="[font-family:'Roboto',sans-serif] text-[15px] font-medium leading-[20px] tracking-[-0.28px] text-white hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 44px clamp(24px, 5vw, 80px) 38px;
    overflow: visible;
  }

  .site-footer__inner {
    height: auto !important;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(260px, auto);
    grid-template-areas:
      "links social"
      "brand notice";
    gap: 40px clamp(40px, 8vw, 120px);
    align-items: start;
  }

  .site-footer__inner > div,
  .site-footer__inner nav {
    position: static !important;
    width: auto !important;
    left: auto !important;
    top: auto !important;
  }

  .site-footer__brand {
    grid-area: brand;
    align-self: end;
    display: flex;
    align-items: flex-end;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .site-footer__notice {
    grid-area: notice;
    max-width: 720px;
    justify-self: end;
    align-self: end;
    padding-top: 26px;
    text-align: right;
  }

  .footer-nav {
    grid-area: links;
    justify-self: start;
  }

  .footer-social {
    grid-area: social;
    justify-self: end;
    text-align: right;
  }

  .site-footer li {
    height: auto !important;
    min-height: 0;
    margin-top: 0 !important;
  }

  .site-footer a,
  .site-footer p {
    overflow-wrap: anywhere;
  }

  .site-footer nav ul {
    display: grid;
    gap: 7px;
  }

  .site-footer .footer-social ul {
    justify-content: flex-end;
  }

  .site-footer__notice p {
    margin-top: 10px !important;
  }

  .site-footer__notice p:first-child {
    margin-top: 0 !important;
  }

  @media (max-width: 760px) {
    .site-footer {
      min-height: auto !important;
      padding: 36px 20px 34px;
      overflow: visible !important;
    }

    .site-footer__inner {
      width: 100% !important;
      height: auto !important;
      max-width: 420px !important;
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas: none;
      gap: 24px;
    }

    .site-footer__inner > div,
    .site-footer__inner nav {
      width: 100% !important;
      grid-column: auto !important;
      grid-row: auto !important;
      grid-area: auto !important;
    }

    .site-footer__brand,
    .site-footer__notice {
      padding-top: 0;
      border-top: 0;
      justify-self: start;
      text-align: left;
    }

    .site-footer__brand {
      order: 3;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }

    .site-footer__notice {
      order: 4;
    }

    .footer-nav {
      order: 1;
    }

    .footer-legal,
    .footer-social {
      order: 2;
      margin-top: 0;
      justify-self: start;
      text-align: left;
    }

    .site-footer img[alt="IPnite logo"] {
      width: 150px !important;
      height: auto !important;
    }

    .site-footer nav ul {
      display: grid;
      gap: 4px;
    }

    .site-footer .footer-social ul {
      display: flex;
      gap: 10px 16px;
    }
  }
</style>
