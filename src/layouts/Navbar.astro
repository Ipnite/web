---
interface Props {
  lang?: "en" | "es" | "pt";
  alternatePath?: string;
}

import CountrySelector from "../components/CountrySelector.astro";

const { lang = "en" } = Astro.props;
const isEs = lang === "es";
const isPt = lang === "pt";
const home = isEs ? "/es" : isPt ? "/pt-br" : "/";
const prefix = isEs ? "/es" : isPt ? "/pt-br" : "";
const navLinks = isEs
  ? [
      { label: "Producto", href: `${prefix}/ai-patent-drafting/` },
      { label: "Anterioridades", href: `${prefix}/prior-art-search/` },
      { label: "Soluciones", href: `${prefix}/for-startups/` },
      { label: "Seguridad", href: `${prefix}/patent-ai-security/` },
      { label: "Aprende", href: `${prefix}/learn/` },
    ]
  : isPt
  ? [
      { label: "Produto", href: `${prefix}/ai-patent-drafting/` },
      { label: "Anterioridade", href: `${prefix}/prior-art-search/` },
      { label: "Soluções", href: `${prefix}/for-startups/` },
      { label: "Segurança", href: `${prefix}/patent-ai-security/` },
      { label: "Aprenda", href: `${prefix}/learn/` },
    ]
  : [
      { label: "Product", href: "/ai-patent-drafting/" },
      { label: "Prior Art", href: "/prior-art-search/" },
      { label: "Solutions", href: "/for-startups/" },
      { label: "Security", href: "/patent-ai-security/" },
      { label: "Learn", href: "/learn/" },
    ];

---

<header class="site-nav" data-site-nav>
  <div class="site-nav__inner">
    <a href={home} aria-label="IPnite — Home" class="site-nav__logo">
      <img src="/images/cerebro.png" alt="IPnite" loading="eager" />
    </a>

    <button class="site-nav__toggle" type="button" aria-label={isEs ? "Abrir menu" : isPt ? "Abrir menu" : "Open menu"} aria-expanded="false" data-nav-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="site-nav__menu" data-nav-menu>
      <nav aria-label={isEs ? "Navegacion principal" : isPt ? "Navegação principal" : "Primary navigation"} class="site-nav__links">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <a href={`${prefix}/#contact`} class="site-nav__contact">{isEs ? "Contacto" : isPt ? "Contato" : "Contact"}</a>

      <CountrySelector lang={lang} />
    </div>
  </div>
</header>

<div class="site-nav__spacer" aria-hidden="true"></div>

<script is:inline>
  document.querySelectorAll("[data-site-nav]").forEach((nav) => {
    const toggle = nav.querySelector("[data-nav-toggle]");
    const menu = nav.querySelector("[data-nav-menu]");
    if (!toggle || !menu) return;

    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });

  });
</script>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    width: 100%;
    background: rgba(249, 249, 251, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(107, 42, 47, 0.08);
  }

  .site-nav__inner {
    width: min(100%, 1440px);
    min-height: 80px;
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.2vw, 34px);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 80px);
  }

  .site-nav__logo {
    flex: 0 0 auto;
  }

  .site-nav__logo img {
    width: 42px;
    height: 38px;
    display: block;
    object-fit: contain;
  }

  .site-nav__menu {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(18px, 2vw, 32px);
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.5vw, 48px);
  }

  .site-nav a,
  .site-nav__toggle {
    font-family: "Roboto Slab", serif;
    font-weight: 700;
  }

  .site-nav__links a {
    color: #505050;
    font-size: 16px;
    line-height: 1.5;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .site-nav__links a:hover {
    color: #4c0815;
  }

  .site-nav__contact {
    min-width: 84px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    color: #6b2a2f;
    font-size: 16px;
    line-height: 1;
  }


  .site-nav__toggle {
    display: none;
    width: 42px;
    height: 42px;
    margin-left: auto;
    border: 1px solid rgba(107, 42, 47, 0.25);
    border-radius: 999px;
    background: #fff;
    color: #4c0815;
    cursor: pointer;
  }

  .site-nav__toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    border-radius: 999px;
    background: #4c0815;
  }

  .site-nav__spacer {
    height: 80px;
  }

  @media (max-width: 1120px) {
    .site-nav__toggle {
      display: block;
    }

    .site-nav__inner {
      min-height: 72px;
    }

    .site-nav__menu {
      position: absolute;
      left: clamp(14px, 4vw, 32px);
      right: clamp(14px, 4vw, 32px);
      top: calc(100% + 10px);
      max-height: calc(100dvh - 96px);
      overflow-y: auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 22px;
      border: 1px solid rgba(107, 42, 47, 0.12);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.98);
      box-shadow: 0 24px 54px rgba(107, 42, 47, 0.14);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .site-nav.is-open .site-nav__menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-nav__links {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
      text-align: center;
    }

    .site-nav__links a {
      font-size: 18px;
      white-space: normal;
    }

    .site-nav__contact {
      justify-self: center;
    }

    .site-nav__contact {
      min-width: 132px;
      height: 38px;
    }

    .site-nav__spacer {
      height: 72px;
    }
  }
</style>
