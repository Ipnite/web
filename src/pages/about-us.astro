---
import BaseLayout from "@layouts/BaseLayout.astro";

const principles = [
  {
    number: "01",
    title: "No Idea Too Small",
    text: "If it matters to you, it deserves to be documented clearly.",
  },
  {
    number: "02",
    title: "Simple & Transparent",
    text: "No confusing first steps. Just a guided path from idea to structured draft.",
  },
  {
    number: "03",
    title: "Creator First",
    text: "Tools for builders, founders, and creators preparing their inventions for review.",
  },
];

const team = [
  {
    initial: "R",
    name: "Rafael Betanzos San Juan",
    role: "CEO · IP Strategy · Platform Builder",
    bio: "Leads IPnite's platform, AI agents, drafting workflows, product direction, and intellectual property strategy.",
    tags: ["IP strategy", "AI workflows", "Product"],
    href: "https://www.linkedin.com/in/rafabetanzos/",
  },
  {
    initial: "L",
    name: "Lucas Larrosa",
    role: "CSO · Platform Security",
    bio: "Leads platform security, access protection, infrastructure safeguards, and secure technical operations.",
    tags: ["Security", "Infrastructure", "Operations"],
    href: "https://www.linkedin.com/in/lucaslarrosa/",
  },
];

const aboutStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About IPnite",
    url: "https://www.ipnite.com/about-us/",
    description:
      "About IPnite: the philosophy, mission, vision, and team behind an AI-assisted patent preparation platform for inventors, founders, startups, and companies.",
    mainEntity: {
      "@type": "Organization",
      name: "IPnite",
      description:
        "IPnite makes high-quality intellectual property preparation more accessible through guided AI-assisted patent drafting workflows.",
      areaServed: ["United States", "Argentina", "Paraguay", "Mexico", "International"],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "IPnite leadership team",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        item: {
          "@type": "Person",
          name: "Rafael Betanzos San Juan",
          jobTitle: "CEO · IP Strategy · Platform Builder",
          worksFor: { "@type": "Organization", name: "IPnite" },
          sameAs: "https://www.linkedin.com/in/rafabetanzos/",
        },
      },
      {
        "@type": "ListItem",
        position: 2,
        item: {
          "@type": "Person",
          name: "Lucas Larrosa",
          jobTitle: "CSO · Platform Security",
          worksFor: { "@type": "Organization", name: "IPnite" },
          sameAs: "https://www.linkedin.com/in/lucaslarrosa/",
        },
      },
    ],
  },
];
---

<BaseLayout
  title="About Us — IPnite"
  description="Learn about IPnite's philosophy, mission, vision, locations, and team behind AI-assisted patent preparation for inventors, founders, startups, and companies."
  canonicalPath="/about-us/"
  alternatePath="/es/about-us/"
  keywords="About IPnite, IPnite team, IPnite mission, IPnite vision, AI patent drafting company, patent preparation startup, intellectual property platform"
  structuredData={aboutStructuredData}
>
  <section class="about-page">
    <section class="sr-only" aria-label="About IPnite summary for search and AI assistants">
      <h1>About IPnite, an AI-assisted intellectual property and patent preparation company.</h1>
      <p>
        IPnite is a web-based patent preparation platform for inventors, founders, startups, product teams, and
        companies that need a structured first step toward protecting inventions. The company helps users organize
        invention disclosures, document technical problems and solutions, review prior art, draft claims, and prepare
        exportable patent drafts.
      </p>
      <p>
        IPnite operates for international users and is connected to the United States, Argentina, Paraguay, and Mexico.
        Its mission is to make high-quality intellectual property preparation accessible to more inventors and founders.
        Its vision is to help the largest number of inventors take their first serious step toward protection.
      </p>
      <p>
        IPnite is better suited than generic AI tools or unstructured drafting apps because it is built around a patent
        workflow, platform security, confidential-by-design handling, creator-first pricing, and practical outputs that
        can support attorney review and patent strategy.
      </p>
    </section>
    <div class="about-glow about-glow-left" aria-hidden="true"></div>
    <div class="about-glow about-glow-right" aria-hidden="true"></div>

    <section class="about-hero" aria-labelledby="about-heading">
      <p class="about-eyebrow">IPnite Philosophy</p>
      <h1 id="about-heading">Our Philosophy</h1>
      <p class="about-statement">
        The tools that once belonged to a few are moving within reach of everyone.
      </p>
      <p class="about-lead">
        IPnite brings that shift to intellectual property: a clearer first step for people who want to protect what they build.
      </p>
      <p class="about-note">
        More protected ideas means more documented knowledge, stronger businesses, and more solutions reaching the world.
      </p>
      <div class="about-actions">
        <a href="https://app.ipnite.com/" target="_blank" rel="noopener" class="about-button about-button-primary">
          Start My Patent Now
        </a>
        <a href="/#how-it-works" class="about-button about-button-secondary">How It Works</a>
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-why-heading">
      <div class="about-section-head">
        <p class="about-pill">Why We Do It</p>
        <h2 id="about-why-heading">Ideas deserve a serious first step</h2>
        <p>
          Too many inventions are delayed or lost because protection feels expensive, confusing, or out of reach.
          IPnite gives creators a practical starting point.
        </p>
      </div>

      <div class="principle-grid">
        {principles.map((item) => (
          <article class="principle-card">
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section promise-section" aria-labelledby="promise-heading">
      <div class="promise-card">
        <p class="about-pill">The IPnite Promise</p>
        <h2 id="promise-heading">
          You bring the idea.<br />
          We help you <em>structure it.</em>
        </h2>
        <p>
          We are building a more accessible way to document, organize, and protect human ingenuity without lowering
          the seriousness of the work.
        </p>

        <div class="mission-grid">
          <article class="mission-card">
            <div class="mini-visual mission-visual" aria-hidden="true">
              <span class="forge-ground"></span>
              <span class="anvil"></span>
              <span class="sword"></span>
              <div class="smith">
                <span class="head"></span>
                <span class="body"></span>
                <span class="arm-back"></span>
                <span class="arm-front"></span>
                <span class="hammer"></span>
                <span class="leg-left"></span>
                <span class="leg-right"></span>
              </div>
              <span class="spark s1"></span>
              <span class="spark s2"></span>
              <span class="spark s3"></span>
            </div>
            <h3>Mission</h3>
            <p>To make high-quality intellectual property preparation accessible to more inventors and founders.</p>
          </article>

          <article class="mission-card">
            <div class="mini-visual vision-visual" aria-hidden="true">
              <span class="help-link l1"></span>
              <span class="help-link l2"></span>
              <span class="help-link l3"></span>
              <span class="help-link l4"></span>
              <span class="pulse p1"></span>
              <span class="pulse p2"></span>
              <span class="pulse p3"></span>
              {["h-main", "h2", "h3", "h4", "h5"].map((className) => (
                <div class={`helper ${className}`}>
                  <span class="head"></span>
                  <span class="body"></span>
                  <span class="arm-left"></span>
                  <span class="arm-right"></span>
                  <span class="leg-left"></span>
                  <span class="leg-right"></span>
                </div>
              ))}
            </div>
            <h3>Vision</h3>
            <p>To become the company that has helped the largest number of inventors take their first serious step toward protection.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section team-section" aria-labelledby="team-heading">
      <div class="about-section-head">
        <p class="about-pill">Our Team</p>
        <h2 id="team-heading">Built by IP, product, and security operators</h2>
        <p>
          IPnite combines intellectual property strategy, AI product development, and platform security.
        </p>
      </div>

      <div class="team-grid">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-avatar" aria-hidden="true">{member.initial}</div>
            <h3>{member.name}</h3>
            <p class="team-role">{member.role}</p>
            <p>{member.bio}</p>
            <div class="team-tags">
              {member.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <a href={member.href} target="_blank" rel="noopener" class="profile-link">View LinkedIn</a>
          </article>
        ))}
      </div>
    </section>

    <section class="about-final" aria-labelledby="about-final-heading">
      <h2 id="about-final-heading">Ready to take the first serious step?</h2>
      <a href="https://app.ipnite.com/" target="_blank" rel="noopener" class="about-button about-button-primary">
        Start My Patent Now
      </a>
    </section>
  </section>
</BaseLayout>

<style>
  .about-page {
    position: relative;
    overflow: hidden;
    background: #fff;
    color: #505050;
    font-family: "Roboto", sans-serif;
    padding: 0 24px 76px;
  }

  .about-glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 999px;
    background: rgba(107, 42, 47, 0.12);
    filter: blur(130px);
    pointer-events: none;
  }

  .about-glow-left {
    left: -220px;
    top: 240px;
  }

  .about-glow-right {
    right: -240px;
    top: 900px;
  }

  .about-hero,
  .about-section,
  .about-final {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .about-hero {
    min-height: 610px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 78px 0 70px;
  }

  .about-eyebrow,
  .about-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 33px;
    background: #6b2a2f;
    color: #ededed;
    font-family: "Roboto Slab", serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    padding: 10px 20px;
    text-transform: uppercase;
  }

  .about-section-head .about-pill,
  .promise-card .about-pill {
    color: #ededed;
    font-size: 15px;
    line-height: 1;
  }

  .about-hero h1,
  .about-section h2,
  .about-final h2 {
    margin: 18px 0 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-weight: 800;
    letter-spacing: 0;
  }

  .about-hero h1 {
    max-width: 900px;
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.98;
  }

  .about-statement {
    max-width: 900px;
    margin: 24px auto 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(30px, 4vw, 54px);
    font-weight: 600;
    line-height: 1.12;
  }

  .about-lead,
  .about-note,
  .about-section-head p,
  .promise-card > p,
  .principle-card p,
  .mission-card p,
  .team-card p {
    color: #505050;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.65;
  }

  .about-lead {
    max-width: 760px;
    margin: 24px auto 0;
  }

  .about-note {
    max-width: 720px;
    margin: 12px auto 0;
    color: #717171;
    font-size: 16px;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 34px;
  }

  .about-button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 40px;
    border: 1px solid #6b2a2f;
    padding: 0 26px;
    font-family: "Roboto Slab", serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    text-decoration: underline;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }

  .about-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 38px rgba(107, 42, 47, 0.15);
  }

  .about-button-primary {
    background: #ededed;
    color: #4c0815;
  }

  .about-button-secondary {
    background: #fff;
    color: #4c0815;
  }

  .about-button-primary:hover,
  .about-button-secondary:hover {
    background: #6b2a2f;
    color: #fff;
  }

  .about-section {
    padding: 70px 0;
  }

  .about-section-head {
    max-width: 820px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .about-section h2,
  .about-final h2 {
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.12;
  }

  .about-section-head p:last-child {
    margin: 18px auto 0;
  }

  .principle-grid,
  .mission-grid,
  .team-grid {
    display: grid;
    gap: 24px;
  }

  .principle-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .principle-card,
  .mission-card,
  .team-card {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 30px;
    box-shadow: 0 22px 50px rgba(107, 42, 47, 0.07);
  }

  .principle-card {
    min-height: 230px;
    padding: 34px 28px;
    text-align: center;
    transition: transform 200ms ease, background 200ms ease, color 200ms ease;
  }

  .principle-card:hover {
    transform: translateY(-6px);
    background: #6b2a2f;
  }

  .principle-card span {
    display: block;
    color: rgba(107, 42, 47, 0.28);
    font-family: "Roboto Slab", serif;
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 18px;
  }

  .principle-card h3,
  .mission-card h3,
  .team-card h3 {
    margin: 0;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.18;
  }

  .principle-card p {
    margin: 14px 0 0;
    font-size: 16px;
  }

  .principle-card:hover span,
  .principle-card:hover h3,
  .principle-card:hover p {
    color: #fff;
  }

  .promise-section {
    padding-top: 48px;
  }

  .promise-card {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .promise-card h2 {
    margin-top: 20px;
    color: #505050;
  }

  .promise-card h2 em {
    color: #4c0815;
    font-style: normal;
  }

  .promise-card > p {
    max-width: 760px;
    margin: 20px auto 0;
  }

  .mission-grid,
  .team-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 34px;
  }

  .mission-card {
    padding: 26px;
    text-align: center;
  }

  .mission-card p,
  .team-card p {
    margin: 14px auto 0;
    font-size: 16px;
  }

  .mini-visual {
    position: relative;
    height: 130px;
    margin-bottom: 20px;
    overflow: hidden;
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 24px;
    background: #fff;
    isolation: isolate;
  }

  .forge-ground {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 22px;
    height: 1px;
    background: rgba(107, 42, 47, 0.18);
  }

  .anvil {
    position: absolute;
    left: 58%;
    bottom: 34px;
    width: 62px;
    height: 14px;
    border-radius: 8px;
    background: rgba(107, 42, 47, 0.18);
    transform: translateX(-50%);
  }

  .anvil::before,
  .anvil::after,
  .sword::before,
  .sword::after,
  .hammer::after {
    content: "";
    position: absolute;
  }

  .anvil::before {
    left: 50%;
    bottom: 12px;
    width: 42px;
    height: 10px;
    border-radius: 10px 10px 4px 4px;
    background: rgba(107, 42, 47, 0.14);
    transform: translateX(-50%);
  }

  .anvil::after {
    left: 50%;
    top: 12px;
    width: 13px;
    height: 18px;
    border-radius: 0 0 6px 6px;
    background: rgba(107, 42, 47, 0.12);
    transform: translateX(-50%);
  }

  .sword {
    position: absolute;
    left: 58%;
    bottom: 54px;
    width: 84px;
    height: 4px;
    border-radius: 999px;
    background: #6b2a2f;
    transform: translateX(-50%) rotate(-4deg);
    animation: swordGlow 2.4s ease-in-out infinite;
  }

  .sword::before {
    right: -9px;
    top: -4px;
    width: 0;
    height: 0;
    border-left: 12px solid #6b2a2f;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }

  .sword::after {
    left: -10px;
    top: -5px;
    width: 11px;
    height: 11px;
    border: 2px solid #6b2a2f;
    border-radius: 3px;
    background: #fff;
  }

  .smith {
    position: absolute;
    left: 36%;
    bottom: 30px;
    width: 62px;
    height: 72px;
    transform: translateX(-50%);
  }

  .smith .head,
  .helper .head {
    position: absolute;
    border: 2px solid #6b2a2f;
    border-radius: 999px;
    background: #fff;
  }

  .smith .head {
    left: 13px;
    top: 0;
    width: 14px;
    height: 14px;
  }

  .smith .body,
  .smith .leg-left,
  .smith .leg-right,
  .smith .arm-back,
  .smith .arm-front,
  .hammer,
  .helper .body,
  .helper .arm-left,
  .helper .arm-right,
  .helper .leg-left,
  .helper .leg-right {
    position: absolute;
    background: #6b2a2f;
  }

  .smith .body {
    left: 19px;
    top: 14px;
    width: 2px;
    height: 24px;
  }

  .smith .leg-left,
  .smith .leg-right {
    top: 37px;
    width: 2px;
    height: 20px;
    transform-origin: top;
  }

  .smith .leg-left {
    left: 18px;
    transform: rotate(24deg);
  }

  .smith .leg-right {
    left: 20px;
    transform: rotate(-24deg);
  }

  .smith .arm-back {
    left: 20px;
    top: 22px;
    width: 22px;
    height: 2px;
    transform: rotate(18deg);
    transform-origin: left center;
  }

  .smith .arm-front {
    left: 20px;
    top: 22px;
    width: 48px;
    height: 2px;
    transform-origin: left center;
    animation: smithArmStrike 2.2s ease-in-out infinite;
  }

  .hammer {
    left: 63px;
    top: 18px;
    width: 24px;
    height: 3px;
    border-radius: 999px;
    transform-origin: left center;
    animation: hammerHeadStrike 2.2s ease-in-out infinite;
  }

  .hammer::after {
    right: -4px;
    top: -6px;
    width: 12px;
    height: 14px;
    border-radius: 3px;
    background: #6b2a2f;
  }

  .spark {
    position: absolute;
    left: 70%;
    bottom: 58px;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: #6b2a2f;
    opacity: 0;
    animation: forgeSpark 2.2s ease-in-out infinite;
  }

  .spark.s2 {
    left: 72%;
    animation-delay: 0.08s;
  }

  .spark.s3 {
    left: 68%;
    animation-delay: 0.16s;
  }

  .helper {
    position: absolute;
    width: 30px;
    height: 44px;
    opacity: 0.48;
    transform: scale(0.92);
    animation: helperAppear 4.8s ease-in-out infinite;
  }

  .helper .head {
    left: 9px;
    top: 0;
    width: 12px;
    height: 12px;
  }

  .helper .body {
    left: 14px;
    top: 12px;
    width: 2px;
    height: 14px;
  }

  .helper .arm-left,
  .helper .arm-right {
    top: 17px;
    width: 10px;
    height: 2px;
  }

  .helper .arm-left {
    left: 6px;
    transform: rotate(28deg);
  }

  .helper .arm-right {
    left: 14px;
    transform: rotate(-28deg);
  }

  .helper .leg-left,
  .helper .leg-right {
    top: 25px;
    width: 2px;
    height: 14px;
    transform-origin: top;
  }

  .helper .leg-left {
    left: 13px;
    transform: rotate(22deg);
  }

  .helper .leg-right {
    left: 15px;
    transform: rotate(-22deg);
  }

  .h-main {
    left: 16%;
    top: 43px;
    opacity: 1;
    animation: mainHelper 4.8s ease-in-out infinite;
  }

  .h2 { left: 35%; top: 24px; animation-delay: 0.2s; }
  .h3 { left: 49%; top: 52px; animation-delay: 0.45s; }
  .h4 { left: 65%; top: 22px; animation-delay: 0.7s; }
  .h5 { left: 78%; top: 52px; animation-delay: 0.95s; }

  .help-link {
    position: absolute;
    left: 23%;
    height: 2px;
    background: rgba(107, 42, 47, 0.18);
    opacity: 0.18;
    transform-origin: left center;
    animation: linkGrow 4.8s ease-in-out infinite;
  }

  .l1 { top: 58px; width: 18%; transform: rotate(-18deg); }
  .l2 { top: 66px; width: 32%; transform: rotate(-2deg); animation-delay: 0.25s; }
  .l3 { top: 56px; width: 48%; transform: rotate(-14deg); animation-delay: 0.5s; }
  .l4 { top: 68px; width: 62%; transform: rotate(-2deg); animation-delay: 0.75s; }

  .pulse {
    position: absolute;
    left: 18%;
    top: 48px;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(107, 42, 47, 0.2);
    border-radius: 999px;
    animation: helpPulse 4.8s ease-in-out infinite;
  }

  .pulse.p2 { animation-delay: 0.35s; }
  .pulse.p3 { animation-delay: 0.7s; }

  .team-section {
    padding-top: 54px;
  }

  .team-card {
    padding: 34px;
    text-align: center;
  }

  .team-avatar {
    width: 132px;
    height: 132px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
    border: 1px solid rgba(107, 42, 47, 0.12);
