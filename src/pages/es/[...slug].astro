---
import SeoPage from "../../components/SeoPage.astro";
import RedirectPage from "../../components/RedirectPage.astro";
import { staticPathsForLocale } from "../../data/seoContent";
export function getStaticPaths() {
  return staticPathsForLocale("es");
}
const { page, redirectTo } = Astro.props;
---
{redirectTo ? <RedirectPage to={redirectTo} lang="es" /> : <SeoPage page={page} locale="es" />}
