---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";
---

<BaseLayout lang="es" title="Acerca de IPnite" description="Conoce la filosofia, mision, vision y equipo detras de IPnite." canonicalPath="/es/about-us/" alternatePath="/about-us/">
  <section class="simple-page">
    <p>Acerca de IPnite</p>
    <h1>Nuestra filosofia</h1>
    <h2>Las herramientas que antes pertenecian a unos pocos ahora estan al alcance de mas creadores.</h2>
    <PageHeroImage label="Hero de la plataforma IPnite para redaccion de patentes" />
    <div class="cards">
      <article><h3>Mision</h3><p>Hacer que la preparacion de propiedad intelectual de alta calidad sea mas accesible para inventores y fundadores.</p></article>
      <article><h3>Vision</h3><p>Ayudar al mayor numero de inventores a dar su primer paso serio hacia la proteccion.</p></article>
    </div>
  </section>
</BaseLayout>

<style>.simple-page{max-width:1060px;margin:0 auto;padding:86px 24px 120px;text-align:center}.simple-page>p{display:inline-flex;border-radius:999px;background:#6b2a2f;color:#ededed;padding:10px 20px;font-family:"Roboto Slab",serif;font-weight:800;text-transform:uppercase}.simple-page h1{margin:22px 0 0;color:#4c0815;font-family:"Roboto Slab",serif;font-size:clamp(54px,8vw,96px);font-weight:800;line-height:1}.simple-page h2{max-width:880px;margin:24px auto 0;color:#505050;font-family:"Roboto Slab",serif;font-size:clamp(30px,4vw,50px);font-weight:700;line-height:1.15}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:54px}.cards article{border:1px solid rgba(107,42,47,.16);border-radius:28px;background:#fff;padding:32px;box-shadow:0 18px 44px rgba(107,42,47,.07)}.cards h3{margin:0;color:#6b2a2f;font-family:"Roboto Slab",serif;font-size:32px;font-weight:800}.cards p{margin:14px 0 0;color:#505050;font-family:"Roboto",sans-serif;font-size:18px;font-weight:500;line-height:1.6}@media(max-width:760px){.cards{grid-template-columns:1fr}.simple-page{padding:56px 16px 80px}.simple-page h1{font-size:48px}}</style>
