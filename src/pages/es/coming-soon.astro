---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";
---
<BaseLayout lang="es" title="Muy pronto — IPnite" description="Algunas herramientas de IPnite aun estan en desarrollo." canonicalPath="/es/coming-soon/" alternatePath="/coming-soon/">
  <section class="soon-es"><p>IPnite Platform</p><h1>Muy pronto</h1><PageHeroImage label="Hero de la plataforma IPnite para redaccion de patentes" /><h2>Esta herramienta aun no esta disponible, pero algo muy bueno esta en camino.</h2><a href="https://app.ipnite.com/" target="_blank" rel="noopener">Volver a la plataforma</a></section>
</BaseLayout>
<style>.soon-es{max-width:980px;margin:0 auto;padding:90px 20px 130px;text-align:center}.soon-es p{display:inline-flex;border-radius:999px;background:#6b2a2f;color:#ededed;padding:10px 20px;font-family:"Roboto Slab",serif;font-weight:800;text-transform:uppercase}.soon-es h1{margin:24px 0 0;color:#4c0815;font-family:"Roboto Slab",serif;font-size:clamp(64px,10vw,120px);font-weight:800;line-height:.95}.soon-es h2{max-width:760px;margin:28px auto;color:#505050;font-family:"Roboto Slab",serif;font-size:clamp(30px,4vw,48px);font-weight:700;line-height:1.15}.soon-es a{display:inline-flex;min-height:52px;align-items:center;border:1px solid #6b2a2f;border-radius:999px;background:#ededed;padding:0 24px;color:#4c0815;font-family:"Roboto Slab",serif;font-size:18px;font-weight:800;text-decoration:underline}</style>
