---
import FaqPage from "@components/FaqPage.astro";

const faqs = [
  {
    "question": "¿Qué es IPnite?",
    "answer": "IPnite es un espacio de trabajo de preparación de patentes y propiedad intelectual asistido por IA. Guía la divulgación de la invención, investigación de arte previo, reivindicaciones, dibujos, redacción de solicitudes, documentos PI y organización del portafolio."
  },
  {
    "question": "¿IPnite brinda asesoramiento legal o crea una relación abogado-cliente?",
    "answer": "No. IPnite no es un estudio jurídico, no brinda asesoramiento legal y no crea una relación abogado-cliente. La IA puede producir resultados incompletos o inexactos; el usuario debe revisarlos y obtener asesoramiento profesional calificado antes de presentar o confiar en ellos."
  },
  {
    "question": "¿En qué se diferencia IPnite de un chat de IA general?",
    "answer": "IPnite organiza el trabajo en flujos específicos de patentes y jurisdicciones, y mantiene investigación, evidencia, borradores, dibujos y versiones del proyecto relacionados. No garantiza patentabilidad, validez, libertad de operación ni aceptación de una presentación."
  },
  {
    "question": "¿Cuál es la diferencia entre Arte previo y FTO?",
    "answer": "Arte previo ayuda a investigar si ciertas características técnicas ya fueron divulgadas y apoya una evaluación inicial de novedad. Freedom to Operate (FTO) examina derechos potencialmente vigentes relevantes para un producto o actividad. Ninguno sustituye una búsqueda u opinión jurídica profesional."
  },
  {
    "question": "¿Puedo abrir los PDF de patentes de referencia dentro de IPnite?",
    "answer": "Cuando una fuente compatible ofrece un documento accesible, IPnite puede mostrar el PDF de referencia en su visor. La disponibilidad depende de la fuente, el formato, las reglas de seguridad del navegador y el proveedor original."
  },
  {
    "question": "¿Qué planes de suscripción están disponibles?",
    "answer": "Basic cuesta USD 20 al mes o USD 200 al año, Starter USD 199 al mes o USD 1.990 al año y Professional USD 499 al mes o USD 4.990 al año. El checkout selecciona inicialmente la facturación anual y permite cambiar a mensual."
  },
  {
    "question": "¿Cómo funciona el trial Basic de siete días?",
    "answer": "Los nuevos usuarios elegibles pueden iniciar un trial Basic de siete días. Se requiere tarjeta. Si no se cancela, la suscripción Basic comienza automáticamente al terminar el trial con el intervalo y precio mostrados en checkout."
  },
  {
    "question": "¿Qué pasa cuando termina el trial o si lo cancelo?",
    "answer": "Si no se cancela, Stripe inicia automáticamente la suscripción Basic seleccionada. Si se cancela, el acceso pago no comienza. El estado y la facturación pueden revisarse en el portal de suscripción."
  },
  {
    "question": "¿Cuáles son los límites principales de cada plan?",
    "answer": "Basic incluye 1 proyecto activo, 2 búsquedas de Arte previo por mes y 1 GB. Starter incluye hasta 10 proyectos, 10 búsquedas, 2 colaboradores activos por proyecto y 15 GB. Professional incluye proyectos ilimitados, 50 búsquedas, FTO, hasta 10 colaboradores y 50 GB."
  },
  {
    "question": "¿Qué sucede cuando se llena el almacenamiento?",
    "answer": "La aplicación muestra una advertencia. El titular puede borrar material o proyectos innecesarios para recuperar espacio, o abrir la administración de la suscripción para hacer upgrade."
  },
  {
    "question": "¿Puedo cambiar o cancelar mi suscripción?",
    "answer": "Sí. Administrar suscripción abre el portal seguro de Stripe, donde aparecen las opciones de cambio y cancelación disponibles para la cuenta."
  },
  {
    "question": "¿Los proyectos pueden archivarse, compartirse y exportarse?",
    "answer": "Los permisos dependen del plan. El propietario controla invitaciones y exportaciones. Los proyectos archivados no cuentan para el límite de activos y se conservan según la política de retención vigente."
  },
  {
    "question": "¿Cómo maneja IPnite la información confidencial de una invención?",
    "answer": "IPnite declara que las divulgaciones y materiales de patentes no se usan para entrenar modelos de IA de uso general salvo consentimiento expreso o escrito. No deben subirse datos que el usuario no esté autorizado a procesar y debe consultarse la Política de privacidad."
  },
  {
    "question": "¿Qué idiomas admite IPnite?",
    "answer": "La web y la interfaz principal admiten inglés, español y portugués de Brasil. El idioma de redacción y las jurisdicciones disponibles dependen del flujo seleccionado."
  }
];
---

<FaqPage
  lang="es"
  title="FAQs — IPnite"
  description="Preguntas frecuentes sobre IPnite, redaccion de patentes con IA, reivindicaciones, revision profesional, novedad y flujos de preparacion de patentes."
  canonicalPath="/es/faqs/"
  alternatePath="/faqs/"
  keywords="FAQs IPnite, redaccion de patentes con IA, redaccion de patentes DIY, gestion de PI para startups, borradores de patente, reivindicaciones con IA, IPnite vs ChatGPT"
  heroLabel="Hero de la plataforma IPnite para redaccion de patentes"
  heroPill="FAQs de IPnite"
  heroHeading="Preguntas Antes de Redactar"
  heroSubtitle="Entiende como se compara IPnite con las herramientas de IA genericas antes de convertir tu idea en un borrador de patente."
  heroLead="IPnite esta disenado para fundadores, inventores y equipos tecnicos que necesitan una forma estructurada de preparar trabajo de propiedad intelectual antes de una revision profesional."
  primaryActionLabel="Empezar a redactar"
  listActionLabel="Leer FAQs"
  howItWorksLabel="Como funciona"
  noteStrong="Herramienta de redaccion con IA, no un estudio juridico."
  noteText="IPnite ayuda a preparar borradores de patente, pero la estrategia final de presentacion debe revisarse con asesoria calificada o con un profesional de patentes registrado."
  visualNodeOne="Claims"
  visualNodeTwo="Dibujos"
  visualNodeThree="Novedad"
  visualNodeFour="Estrategia"
  visualCenterLabel="Pregunta Mejor"
  listPill="Respuestas Claras"
  listHeading="Preguntas frecuentes"
  listIntro="El objetivo es simple: ayudarte a entender que hace IPnite, que no hace, y por que la estructura importa en la redaccion de patentes."
  trustPill="La Estructura Importa"
  trustHeading="Pensado para trabajo de patentes, no para prompts casuales"
  trustCards={[
    {
      title: "Claims-first",
      body: "Los borradores de patente necesitan limites juridicos, no solo descripciones de producto.",
    },
    {
      title: "Consistencia",
      body: "Los dibujos, las modalidades, las reivindicaciones y las descripciones deben respaldarse entre si.",
    },
    {
      title: "Listo para revisar",
      body: "El objetivo es que el primer borrador sea mas facil de revisar por un profesional.",
    },
  ]}
  ctaHeading="Listo para estructurar tu invencion?"
  ctaText="Usa IPnite para organizar la divulgacion tecnica, la direccion de las reivindicaciones, las modalidades, los dibujos y las secciones del borrador antes de la revision profesional."
  ctaButtonLabel="Empezar a redactar"
  faqs={faqs}
/>
