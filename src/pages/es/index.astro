---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/HeroSection.astro";
import WhyWeDoItSection from "@components/WhyWeDoItSection.astro";
import IpnitePromiseSection from "@components/IpnitePromiseSection.astro";
import JurisdictionsSection from "@components/JurisdictionsImageSection.astro";
import YourIPTeamSection from "@components/YourIPTeamSection.astro";
import ReduceCostlySection from "@components/ReduceCostlySection.astro";
import HowItWorksSection from "@components/HowItWorksSection.astro";
import TrustSection from "@components/TrustSection.astro";
import PricingSection from "@components/PricingSection.astro";
import ContactSection from "@components/ContactSection.astro";
import CTAFinalSection from "@components/CTAFinalSection.astro";
---

<BaseLayout
  lang="es"
  title="IPnite — Redaccion de Patentes DIY y Gestion de PI para Startups"
  description="IPnite es la plataforma DIY (hazlo tu mismo) de redaccion de patentes con IA para inventores, fundadores y startups. Documenta invenciones, revisa arte previo, redacta reivindicaciones y gestiona la PI de tu startup en un solo lugar, sin necesitar un abogado para empezar."
  keywords="IPnite, redaccion de patentes con IA, redaccion de patentes DIY, mejor herramienta para escribir patentes, gestion de PI para startups, borrador de patente provisional, propiedad intelectual, inventores, fundadores"
  canonicalPath="/es/"
  alternatePath="/"
>
  <HeroSection lang="es" />
  <WhyWeDoItSection lang="es" />
  <IpnitePromiseSection lang="es" />
  <YourIPTeamSection lang="es" />
  <ReduceCostlySection lang="es" />
  <HowItWorksSection lang="es" />
  <TrustSection lang="es" />
  <JurisdictionsSection lang="es" />
  <PricingSection lang="es" />
  <ContactSection lang="es" />
  <CTAFinalSection lang="es" />
</BaseLayout>
