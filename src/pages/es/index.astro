---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";
---

<BaseLayout
  lang="es"
  title="IPnite — Redaccion de Patentes Asistida por IA"
  description="IPnite ayuda a inventores, fundadores y equipos tecnicos a documentar invenciones, revisar arte previo, redactar reivindicaciones y preparar borradores de patente."
  canonicalPath="/es/"
  alternatePath="/"
>
  <main class="es-page">
    <section class="es-hero">
      <p class="es-pill">IPnite</p>
      <h1>Proteger una idea no deberia ser un privilegio</h1>
      <p>IPnite ayuda a convertir una idea tecnica en un borrador de patente estructurado, listo para revision profesional.</p>
      <div class="es-actions">
        <a href="https://app.ipnite.com/" target="_blank" rel="noopener">Empezar ahora</a>
        <a href="#how-it-works">Como funciona</a>
      </div>
      <PageHeroImage label="Hero de la plataforma IPnite para redaccion de patentes" />
    </section>

    <section id="why-we-do-it" class="es-section">
      <p class="es-pill">Por que</p>
      <h2>Las ideas merecen un primer paso serio</h2>
      <div class="es-grid">
        <article><h3>Ninguna idea es pequena</h3><p>Si es importante para ti, merece ser documentada con claridad.</p></article>
        <article><h3>Simple y transparente</h3><p>Un flujo guiado desde la descripcion de la invencion hasta un borrador estructurado.</p></article>
        <article><h3>Para creadores</h3><p>Herramientas para fundadores, inventores y equipos tecnicos antes de la revision profesional.</p></article>
      </div>
    </section>

    <section id="ip-team" class="es-section">
      <p class="es-pill">Equipo</p>
      <h2>Producto, propiedad intelectual y seguridad</h2>
      <p class="es-copy">IPnite combina estrategia de propiedad intelectual, desarrollo de producto con IA y seguridad de plataforma.</p>
    </section>

    <section id="how-it-works" class="es-section">
      <p class="es-pill">Como funciona</p>
      <h2>De idea a borrador exportable</h2>
      <div class="es-grid">
        <article><h3>1. Describe</h3><p>Ingresa el problema, la solucion, variantes tecnicas y detalles clave.</p></article>
        <article><h3>2. Estructura</h3><p>IPnite ayuda a ordenar claims, embodiments, dibujos y consistencia interna.</p></article>
        <article><h3>3. Exporta</h3><p>Obtienes un borrador organizado para analizar, iterar y revisar con profesionales.</p></article>
      </div>
    </section>

    <section id="plans" class="es-section">
      <p class="es-pill">Planes</p>
      <h2>Opciones simples</h2>
      <div class="es-actions">
        <a href="/es/coming-soon">Freemium</a>
        <a href="https://app.ipnite.com/" target="_blank" rel="noopener">Starter</a>
        <a href="/es/coming-soon">Professional</a>
      </div>
    </section>

    <section id="contact" class="es-section">
      <p class="es-pill">Contacto</p>
      <h2>Hablemos de tu idea</h2>
      <p class="es-copy">Escribenos para conocer mas sobre IPnite y sus flujos de preparacion de patentes.</p>
      <div class="es-actions"><a href="mailto:info@ipnite.com">info@ipnite.com</a></div>
    </section>
  </main>
</BaseLayout>

<style>
  .es-page{max-width:1180px;margin:0 auto;padding:76px 24px 110px;text-align:center}
  .es-hero{padding:40px 0 72px}.es-pill{display:inline-flex;border-radius:999px;background:#6b2a2f;color:#ededed;padding:10px 20px;font-family:"Roboto Slab",serif;font-weight:800;text-transform:uppercase}.es-hero h1,.es-section h2{margin:20px auto 0;color:#4c0815;font-family:"Roboto Slab",serif;font-size:clamp(44px,7vw,88px);font-weight:800;line-height:1}.es-hero p,.es-copy{max-width:760px;margin:22px auto 0;color:#505050;font-family:"Roboto",sans-serif;font-size:20px;font-weight:500;line-height:1.6}.es-actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:30px}.es-actions a{display:inline-flex;min-height:50px;align-items:center;justify-content:center;border:1px solid #6b2a2f;border-radius:999px;background:#ededed;padding:0 24px;color:#4c0815;font-family:"Roboto Slab",serif;font-size:18px;font-weight:800;text-decoration:underline}.es-section{padding:70px 0}.es-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:36px}.es-grid article{border:1px solid rgba(107,42,47,.16);border-radius:28px;background:#fff;padding:30px;box-shadow:0 18px 44px rgba(107,42,47,.07)}.es-grid h3{margin:0;color:#6b2a2f;font-family:"Roboto Slab",serif;font-size:28px;font-weight:800}.es-grid p{margin:12px 0 0;color:#505050;font-family:"Roboto",sans-serif;font-size:17px;font-weight:500;line-height:1.55}@media(max-width:780px){.es-page{padding:48px 16px 80px}.es-grid{grid-template-columns:1fr}.es-hero h1,.es-section h2{font-size:42px}.es-actions a{width:100%;max-width:330px}}
</style>
