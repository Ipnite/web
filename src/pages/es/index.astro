---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/HeroSection.astro";
import WhyWeDoItSection from "@components/WhyWeDoItSection.astro";
import IpnitePromiseSection from "@components/IpnitePromiseSection.astro";
import JurisdictionsSection from "@components/JurisdictionsImageSection.astro";
import YourIPTeamSection from "@components/YourIPTeamSection.astro";
import ReduceCostlySection from "@components/ReduceCostlySection.astro";
import HowItWorksSection from "@components/HowItWorksSection.astro";
import TrustSection from "@components/TrustSection.astro";
import PricingSection from "@components/PricingSection.astro";
import ContactSection from "@components/ContactSection.astro";
import CTAFinalSection from "@components/CTAFinalSection.astro";
import TrustedByMarquee from "@components/TrustedByMarquee.astro";
import PlatformOverviewSection from "@components/PlatformOverviewSection.astro";
import { softwareSchema } from "../../data/structuredData";
const homeStructuredData = [softwareSchema("es")];
---

<BaseLayout
  lang="es"
  title="IPnite — Redacción de patentes con IA y antecedentes"
  description="Redacta solicitudes de patente con IA, busca antecedentes, crea dibujos y gestiona tu cartera. Prueba gratis 7 días, sin tarjeta."
  canonicalPath="/es/"
  structuredData={homeStructuredData}
>
  <HeroSection lang="es" />
  <TrustedByMarquee lang="es" />
  <WhyWeDoItSection lang="es" />
  <PlatformOverviewSection lang="es" />
  <ReduceCostlySection lang="es" />
  <YourIPTeamSection lang="es" />
  <TrustSection lang="es" />
  <HowItWorksSection lang="es" />
  <JurisdictionsSection lang="es" />
  <IpnitePromiseSection lang="es" />
  <PricingSection lang="es" />
  <ContactSection lang="es" />
  <CTAFinalSection lang="es" />
</BaseLayout>
