---
import FaqPage from "@components/FaqPage.astro";

const faqs = [
  {
    "question": "What is IPnite?",
    "answer": "IPnite is an AI-assisted patent preparation platform operated by Ik-Holcan LLC. Its agents help you search prior art, structure your invention disclosure, draft claims and a complete application with The Drafter, generate patent drawings, run quality checks, export to DOCX, and manage your patent portfolio."
  },
  {
    "question": "Does IPnite provide legal advice or create an attorney-client relationship?",
    "answer": "No. IPnite is software, not a law firm, and it does not create an attorney-client relationship. AI output can contain errors, so you are responsible for reviewing it or having it reviewed by a qualified professional before filing or relying on it."
  },
  {
    "question": "Which patent offices does IPnite support?",
    "answer": "IPnite supports preparation workflows for the USPTO (United States), IMPI (Mexico, including the provisional application available since April 2026), INPI Argentina, INPI Brazil, and international PCT applications. Direct filing with INPI Argentina from the platform is coming soon, followed by trademark filings."
  },
  {
    "question": "Can I try IPnite for free?",
    "answer": "Yes. The free trial lasts 7 days and includes one prior-art search with the Discovery Agent. No credit card is required and there is no automatic charge. To draft with The Drafter, choose a plan."
  },
  {
    "question": "How much do the plans cost?",
    "answer": "Pricing depends on your country or region. In the United States, Inventor costs $50 per month or $500 per year, Startup $199 per month or $1,990 per year, and Institutional $499 per month or $4,990 per year. Mexico, Argentina, Brazil, and the rest of Latin America have local pricing shown when you select your country."
  },
  {
    "question": "Do plans renew automatically?",
    "answer": "Yes. Monthly plans renew every month and annual plans every year until you cancel. You can cancel anytime from your account; cancellation takes effect at the end of the paid period and you keep access until then. Annual billing costs the equivalent of ten monthly payments."
  },
  {
    "question": "What are the main plan limits?",
    "answer": "Inventor includes 1 active project, 2 prior-art searches per month, 1 external collaborator, and 1 GB of storage. Startup includes up to 10 active projects, 10 searches per month, up to 3 collaborators per project, and 15 GB. Institutional includes 3 users, unlimited active projects under a reasonable-use policy, 50 searches per month, the FTO module, team permissions, and 50 GB."
  },
  {
    "question": "Which formats can I export?",
    "answer": "Every plan exports your application as an editable DOCX document. Startup and Institutional also export complete projects as JSON and ZIP."
  },
  {
    "question": "Does IPnite include patentability and FTO analyses?",
    "answer": "Yes. Every paid plan includes a patentability search; FTO is an add-on for Inventor and Startup and is included in Institutional. These are AI-assisted deliverables: you are responsible for reading them or having them professionally reviewed, and IPnite does not guarantee their conclusions."
  },
  {
    "question": "Who owns the drafts IPnite generates?",
    "answer": "You do. Everything generated from your information belongs to you, and you can edit it, file it with any patent office, license it, or share it without restriction."
  },
  {
    "question": "Does IPnite use my inventions to train AI?",
    "answer": "No. IPnite never uses your inventions, prompts, documents, or drafts to train AI models or for any purpose other than providing the service. AI requests run on the enterprise Vertex AI API in IPnite's Google Cloud environment, and Google Cloud's terms state that customer data is not used to train Google's models without the customer's permission."
  },
  {
    "question": "What personal data does IPnite collect?",
    "answer": "Only what is needed to run your account: account details such as name and email, billing records handled by payment processors, and aggregate demographic information such as country and professional profile. Website analytics are used only with your consent and never include project content."
  },
  {
    "question": "Which payment methods are accepted?",
    "answer": "Payments are currently processed by Stripe. Local methods such as Mercado Pago in Argentina and Pix in Brazil will be added. Taxes and the final total are confirmed at checkout."
  },
  {
    "question": "Can I cancel or ask for a refund?",
    "answer": "You can cancel anytime from your account. Fees for periods already started are non-refundable, except where your local consumer law grants a right of withdrawal, such as the 10-day right in Argentina or the 7-day right in Brazil for online purchases. See the Terms and Conditions for details."
  },
  {
    "question": "What happens to archived projects and full storage?",
    "answer": "Archived projects do not count toward your active-project limit and are kept for three months; IPnite notifies the owner about 30, 7, and 1 day before permanent deletion. When storage is full, you can remove material or upgrade your plan."
  },
  {
    "question": "Can patent attorneys and law firms use IPnite?",
    "answer": "Yes. Firms and patent agents use IPnite to speed up disclosure intake, prior-art research, first-draft claims, specifications, and drawings, then refine the DOCX in their usual tools. Strategy and final legal judgment stay with the practitioner."
  },
  {
    "question": "Which languages does IPnite support?",
    "answer": "The website and the application are available in English, Spanish, and Portuguese, and IPnite drafts in the language each patent office requires."
  }
];
---

<FaqPage
  title="FAQs: AI Patent Drafting, Plans and Privacy | IPnite"
  description="Answers about IPnite: free trial, plans and renewals, DOCX export, supported patent offices, data privacy, and who owns your drafts."
  canonicalPath="/faqs/"
  alternatePath="/es/faqs/"
  heroLabel="IPnite patent drafting platform"
  heroPill="IPnite FAQs"
  heroHeading="Questions Before You Draft"
  heroSubtitle="Understand what IPnite does, what it does not do, and how it differs from a generic AI chat before you turn your idea into a patent application."
  heroLead="IPnite is built for inventors, startups, and IP professionals who need a structured way to prepare filing-ready patent applications."
  primaryActionLabel="Try IPnite free"
  listActionLabel="Read FAQs"
  howItWorksLabel="How It Works"
  noteStrong="An AI drafting tool, not a law firm."
  noteText="IPnite helps you prepare your application; review before filing is your responsibility, whether you do it yourself or with a patent professional."
  visualNodeOne="Claims"
  visualNodeTwo="Drawings"
  visualNodeThree="Novelty"
  visualNodeFour="Strategy"
  visualCenterLabel="Ask Better"
  listPill="Clear Answers"
  listHeading="Frequently asked questions"
  listIntro="The goal is simple: help you understand what IPnite does, what it does not do, and why structure matters in patent drafting."
  trustPill="Structure Matters"
  trustHeading="Built for patent work, not casual prompts"
  trustCards={[
    {
      title: "Claims-first",
      body: "A patent application needs legal boundaries, not only a product description.",
    },
    {
      title: "Consistency-aware",
      body: "Drawings, embodiments, claims, and description should support each other.",
    },
    {
      title: "Filing-ready",
      body: "The goal is a complete, consistent application that is easy to review.",
    },
  ]}
  ctaHeading="Ready to structure your invention?"
  ctaText="Start a free 7-day trial: explore your invention with the Discovery Agent and run your first prior-art search. No credit card."
  ctaButtonLabel="Try IPnite free"
  faqs={faqs}
/>
