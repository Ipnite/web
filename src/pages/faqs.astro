---
import FaqPage from "@components/FaqPage.astro";

const faqs = [
  {
    "question": "What is IPnite?",
    "answer": "IPnite is an AI-assisted patent preparation and intellectual property workspace. It guides users through invention disclosure, prior-art research, claim drafting, drawings, application drafting, IP documents, and portfolio organization."
  },
  {
    "question": "Does IPnite provide legal advice or create an attorney-client relationship?",
    "answer": "No. IPnite is not a law firm and does not provide legal advice or create an attorney-client relationship. AI output can be incomplete or inaccurate, so users remain responsible for review and should obtain qualified professional advice before filing or relying on a result."
  },
  {
    "question": "How is IPnite different from a general AI chat tool?",
    "answer": "IPnite organizes work into patent-specific, jurisdiction-aware workflows and keeps related research, evidence, drafts, drawings, and project versions together. It does not guarantee patentability, validity, clearance, or filing acceptance."
  },
  {
    "question": "What is the difference between Prior Art and FTO?",
    "answer": "Prior Art helps investigate whether technical features may already be disclosed and supports an initial novelty assessment. Freedom to Operate (FTO) examines potentially relevant enforceable rights for a planned product or activity. Neither replaces a professional legal search or opinion."
  },
  {
    "question": "Can I open reference patent PDFs inside IPnite?",
    "answer": "When a supported patent source provides an accessible document, IPnite can display the reference PDF in its viewer. Availability can depend on the source, document format, browser security rules, and the original provider."
  },
  {
    "question": "Which subscription plans are available?",
    "answer": "Basic costs $20 monthly or $200 annually, Starter costs $199 monthly or $1,990 annually, and Professional costs $499 monthly or $4,990 annually. Checkout defaults to annual billing, and users can select monthly billing before continuing."
  },
  {
    "question": "How does the seven-day Basic trial work?",
    "answer": "New eligible users can start a seven-day Basic trial. A payment card is required. Unless cancelled, the Basic subscription starts automatically after the trial at the billing interval and price shown during checkout."
  },
  {
    "question": "What happens when the trial ends or I cancel?",
    "answer": "If the trial is not cancelled, Stripe starts the selected Basic subscription automatically. If it is cancelled, paid access does not begin. Subscription status and billing can be reviewed in the subscription management portal."
  },
  {
    "question": "What are the main plan limits?",
    "answer": "Basic includes 1 active project, 2 Prior Art searches per month, and 1 GB of storage. Starter includes up to 10 active projects, 10 searches, 2 active collaborators per project, and 15 GB. Professional includes unlimited active projects, 50 searches, FTO, up to 10 active collaborators per project, and 50 GB."
  },
  {
    "question": "What happens when storage is full?",
    "answer": "The app warns the user when storage reaches its limit. The account owner can remove unneeded project material or projects to recover space, or open subscription management to upgrade."
  },
  {
    "question": "Can I change or cancel my subscription?",
    "answer": "Yes. The Manage subscription action opens Stripe's secure customer portal, where supported billing changes and cancellation options are shown for the account."
  },
  {
    "question": "Can projects be archived, shared, and exported?",
    "answer": "Plan permissions determine collaboration and export access. Project owners control invitations and exports. Archived projects do not count toward the active-project limit and are retained according to the service's current retention policy."
  },
  {
    "question": "How does IPnite handle confidential invention information?",
    "answer": "IPnite states that invention disclosures and patent materials are not used to train general-purpose AI models unless the user expressly opts in or provides written consent. Users should still avoid uploading information they are not authorized to process and review the Privacy Policy."
  },
  {
    "question": "Which languages does IPnite support?",
    "answer": "The website and core application interface support English, Spanish, and Brazilian Portuguese. Patent drafting language and jurisdiction support depend on the selected workflow."
  }
];
---

<FaqPage
  title="FAQs — IPnite"
  description="Frequently asked questions about IPnite, The Drafter, AI patent drafting, attorney-client relationship limits, patent attorneys, claim drafting, novelty checks, drawings, and patent preparation workflows."
  canonicalPath="/faqs/"
  alternatePath="/es/faqs/"
  keywords="IPnite FAQs, The Drafter, AI patent drafting, DIY patent drafting, startup IP management, patent application drafts, provisional patent draft, patent claims AI, novelty assessment, attorney client relationship, patent attorney support, IPnite vs ChatGPT"
  heroLabel="IPnite patent drafting platform hero"
  heroPill="IPnite FAQs"
  heroHeading="Questions Before You Draft"
  heroSubtitle="Understand how IPnite compares to generic AI tools before turning your idea into a patent draft."
  heroLead="IPnite is designed for founders, inventors, and technical teams who need a structured way to prepare intellectual property work before professional review."
  primaryActionLabel="Start Drafting"
  listActionLabel="Read FAQs"
  howItWorksLabel="How It Works"
  noteStrong="AI drafting tool, not a law firm."
  noteText="IPnite helps prepare patent drafts, but final filing strategy should be reviewed by qualified counsel or a registered patent practitioner."
  visualNodeOne="Claims"
  visualNodeTwo="Drawings"
  visualNodeThree="Novelty"
  visualNodeFour="Strategy"
  visualCenterLabel="Ask Better"
  listPill="Clear Answers"
  listHeading="Frequently asked questions"
  listIntro="The goal is simple: help you understand what IPnite does, what it does not do, and why structure matters in patent drafting."
  trustPill="Structure Matters"
  trustHeading="Built for patent work, not casual prompts"
  trustCards={[
    {
      title: "Claims-first",
      body: "Patent drafts need legal boundaries, not only product descriptions.",
    },
    {
      title: "Consistency-aware",
      body: "Drawings, embodiments, claims, and descriptions should support each other.",
    },
    {
      title: "Review-ready",
      body: "The goal is to make the first draft easier for professional review.",
    },
  ]}
  ctaHeading="Ready to structure your invention?"
  ctaText="Use IPnite to organize the technical disclosure, claims direction, embodiments, drawings, and draft sections before professional review."
  ctaButtonLabel="Start Drafting"
  faqs={faqs}
/>
