---
import FaqPage from "@components/FaqPage.astro";

const faqs = [
  {
    question: "Is IPnite just a general LLM?",
    answer:
      "No. IPnite is a structured patent drafting workflow. It uses AI to support invention disclosure, claims, defensibility, draft organization, and patent-specific consistency instead of acting like a generic chat tool.",
  },
  {
    question: "Does IPnite create an attorney-client relationship?",
    answer:
      "No. IPnite is not a law firm, does not replace a patent attorney or patent agent, and does not create an attorney-client relationship. It is a drafting support tool, and professional review is recommended before filing.",
  },
  {
    question: "Who should use IPnite?",
    answer:
      "IPnite is built for independent inventors, entrepreneurs, startups, founders, universities, accelerators, and venture funds that need to prepare or evaluate intellectual property with limited resources.",
  },
  {
    question: "How is IPnite different from ChatGPT?",
    answer:
      "IPnite is built specifically for intellectual property. While ChatGPT is general-purpose, IPnite applies a structured patent methodology designed for legal consistency and stronger patent preparation.",
  },
  {
    question: "Can I write a patent using ChatGPT alone?",
    answer:
      "Yes, but it comes with risks. ChatGPT does not enforce proper claim structure, invention scope expansion, or consistency across sections. IPnite is designed to help with those steps.",
  },
  {
    question: "Why does IPnite produce stronger patent drafts?",
    answer:
      "IPnite expands technical variations, structures broad and dependent claims, and checks internal consistency. This mirrors key parts of how patent professionals organize invention disclosures.",
  },
  {
    question: "Does IPnite replace a patent attorney?",
    answer:
      "No. IPnite reduces early-stage drafting costs and helps organize the invention. For critical filings, professional review is still recommended.",
  },
  {
    question: "What mistakes does IPnite help prevent?",
    answer:
      "IPnite helps reduce overly narrow claims, missing embodiments, inconsistencies between drawings and text, and incomplete disclosures.",
  },
  {
    question: "Does IPnite check if my invention already exists?",
    answer:
      "IPnite performs an initial novelty assessment against existing patent information. This is not a substitute for a full professional patentability search.",
  },
  {
    question: "Does IPnite generate claims automatically?",
    answer:
      "Yes. IPnite creates independent claims and dependent claims, which are typically among the hardest parts of a patent draft to prepare.",
  },
  {
    question: "Are the drawings compliant with patent standards?",
    answer:
      "IPnite is designed to generate black-and-white drawings, proper numbering, and legally consistent references.",
  },
  {
    question: "Why not just use a free tool?",
    answer:
      "Because the real cost is not the tool. The real cost is filing a weak or unusable patent draft.",
  },
  {
    question: "Who is IPnite for?",
    answer:
      "IPnite is for inventors, startups, technical teams, and founders without initial legal budgets.",
  },
  {
    question: "Is IPnite the best DIY tool for writing a patent?",
    answer:
      "IPnite is built specifically for DIY (do-it-yourself) patent drafting: it guides founders and inventors who don't have an attorney yet through invention disclosure, claims, prior-art review, and drawings, producing a structured, review-ready draft instead of a blank page.",
  },
  {
    question: "Can IPnite help my startup manage all of its IP, not just one patent draft?",
    answer:
      "Yes. IPnite works as a lightweight IP management tool for startups: it keeps invention disclosures, claims, drawings, prior-art findings, and draft versions organized in one place as your startup's patent portfolio grows, not just for a single one-off draft.",
  },
];
---

<FaqPage
  title="FAQs — IPnite"
  description="Frequently asked questions about IPnite, The Drafter, AI patent drafting, attorney-client relationship limits, patent attorneys, claim drafting, novelty checks, drawings, and patent preparation workflows."
  canonicalPath="/faqs/"
  alternatePath="/es/faqs/"
  keywords="IPnite FAQs, The Drafter, AI patent drafting, DIY patent drafting, best tool for patent writing, startup IP management, patent application drafts, provisional patent draft, patent claims AI, novelty assessment, attorney client relationship, patent attorney support, IPnite vs ChatGPT"
  heroLabel="IPnite patent drafting platform hero"
  heroPill="IPnite FAQs"
  heroHeading="Questions Before You Draft"
  heroSubtitle="Understand how IPnite compares to generic AI tools before turning your idea into a patent draft."
  heroLead="IPnite is designed for founders, inventors, and technical teams who need a structured way to prepare intellectual property work before professional review."
  primaryActionLabel="Start Drafting"
  listActionLabel="Read FAQs"
  howItWorksLabel="How It Works"
  noteStrong="AI drafting tool, not a law firm."
  noteText="IPnite helps prepare patent drafts, but final filing strategy should be reviewed by qualified counsel or a registered patent practitioner."
  visualNodeOne="Claims"
  visualNodeTwo="Drawings"
  visualNodeThree="Novelty"
  visualNodeFour="Strategy"
  visualCenterLabel="Ask Better"
  listPill="Clear Answers"
  listHeading="Frequently asked questions"
  listIntro="The goal is simple: help you understand what IPnite does, what it does not do, and why structure matters in patent drafting."
  trustPill="Structure Matters"
  trustHeading="Built for patent work, not casual prompts"
  trustCards={[
    {
      title: "Claims-first",
      body: "Patent drafts need legal boundaries, not only product descriptions.",
    },
    {
      title: "Consistency-aware",
      body: "Drawings, embodiments, claims, and descriptions should support each other.",
    },
    {
      title: "Review-ready",
      body: "The goal is to make the first draft easier for professional review.",
    },
  ]}
  ctaHeading="Ready to structure your invention?"
  ctaText="Use IPnite to organize the technical disclosure, claims direction, embodiments, drawings, and draft sections before professional review."
  ctaButtonLabel="Start Drafting"
