---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection          from "@components/HeroSection.astro";
import WhyWeDoItSection     from "@components/WhyWeDoItSection.astro";
import IpnitePromiseSection from "@components/IpnitePromiseSection.astro";
import JurisdictionsSection  from "@components/JurisdictionsImageSection.astro";
import YourIPTeamSection    from "@components/YourIPTeamSection.astro";
import ReduceCostlySection  from "@components/ReduceCostlySection.astro";
import HowItWorksSection    from "@components/HowItWorksSection.astro";
import TrustSection         from "@components/TrustSection.astro";
import PricingSection       from "@components/PricingSection.astro";
import ContactSection       from "@components/ContactSection.astro";
import CTAFinalSection      from "@components/CTAFinalSection.astro";

const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://www.ipnite.com/#website",
    name: "IPnite",
    url: "https://www.ipnite.com/",
    inLanguage: "en",
    publisher: { "@id": "https://www.ipnite.com/#organization" },
    description:
      "IPnite helps independent inventors, entrepreneurs, startups, and venture teams prepare structured patent application drafts with AI-assisted workflows.",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://www.ipnite.com/#the-drafter",
    name: "The Drafter by IPnite",
    alternateName: "IPnite patent drafter",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: "https://www.ipnite.com/",
    creator: { "@id": "https://www.ipnite.com/#organization" },
    audience: [
      { "@type": "Audience", audienceType: "Independent inventors" },
      { "@type": "Audience", audienceType: "Entrepreneurs" },
      { "@type": "Audience", audienceType: "Startups managing IP in-house (DIY)" },
      { "@type": "Audience", audienceType: "Venture capital funds evaluating startup IP" },
    ],
    areaServed: ["United States", "Latin America", "European Patent Office jurisdictions"],
    offers: [
      {
        "@type": "Offer",
        name: "Basic",
        priceSpecification: [
          { "@type": "UnitPriceSpecification", name: "Monthly", price: "20.00", priceCurrency: "USD", billingIncrement: 1, unitCode: "MON" },
          { "@type": "UnitPriceSpecification", name: "Annual", price: "200.00", priceCurrency: "USD", billingIncrement: 12, unitCode: "MON" },
        ],
        description: "1 active project, 2 Prior Art searches per month, and 1 GB of storage. Eligible new users can start a seven-day trial with a card.",
      },
      {
        "@type": "Offer",
        name: "Starter",
        priceSpecification: [
          { "@type": "UnitPriceSpecification", name: "Monthly", price: "199.00", priceCurrency: "USD", billingIncrement: 1, unitCode: "MON" },
          { "@type": "UnitPriceSpecification", name: "Annual", price: "1990.00", priceCurrency: "USD", billingIncrement: 12, unitCode: "MON" },
        ],
        description: "Up to 10 active projects, 10 Prior Art searches per month, and up to 2 active collaborators per project.",
      },
      {
        "@type": "Offer",
        name: "Professional",
        priceSpecification: [
          { "@type": "UnitPriceSpecification", name: "Monthly", price: "499.00", priceCurrency: "USD", billingIncrement: 1, unitCode: "MON" },
          { "@type": "UnitPriceSpecification", name: "Annual", price: "4990.00", priceCurrency: "USD", billingIncrement: 12, unitCode: "MON" },
        ],
        description: "Unlimited active projects, 50 Prior Art searches per month, FTO Search included, and up to 10 active collaborators per project.",
      },
    ],
    description:
      "The Drafter by IPnite is a DIY (do-it-yourself) AI patent drafting tool that gives structure and defensibility to early patent application drafts, especially provisional-style drafts prepared with limited resources, and doubles as a lightweight IP management tool for startups.",
    featureList: [
      "DIY patent drafting for founders without an attorney yet",
      "Guided invention disclosure workflow",
      "Patent application draft generation",
      "Prior-art review support",
      "Independent and dependent claim drafting",
      "Draft variants and invention embodiment expansion",
      "Exportable patent drafts for attorney or agent review",
      "Startup IP management: organize disclosures, claims, and drafts in one place",
      "IP portfolio and evaluation support for startups and funds",
    ],
  },
];
---

<BaseLayout
  title="IPnite — DIY Patent Drafting & Startup IP Management"
  description="IPnite is the AI-assisted DIY patent drafting platform for inventors, founders, and startups. Document inventions, review prior art, draft claims, and manage your startup's IP in one place, without needing an attorney to get started."
  keywords="IPnite, AI patent drafting, DIY patent drafting, startup IP management, provisional patent draft, intellectual property, inventors, founders, patent workflow, prior art review, patent claims"
  canonicalPath="/"
  alternatePath="/es/"
  structuredData={homeStructuredData}
>
  <script is:inline>
    try {
      const chosenLang = localStorage.getItem("ipnite_lang");
      const browserLang = navigator.language || "";
      if (!chosenLang) {
        const normalized = browserLang.toLowerCase();
        if (normalized.startsWith("pt")) {
          window.location.replace("/pt-br/");
        } else if (normalized.startsWith("es")) {
          window.location.replace("/es/");
        }
      }
    } catch (error) {}
  </script>
  <HeroSection />
  <WhyWeDoItSection />
  <ReduceCostlySection />
  <YourIPTeamSection />
  <TrustSection />
  <HowItWorksSection />
  <JurisdictionsSection />
  <IpnitePromiseSection />
  <PricingSection />
  <ContactSection />
  <CTAFinalSection />
</BaseLayout>
