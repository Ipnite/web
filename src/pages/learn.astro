---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Learn Patent Basics — IPnite"
  description="Learn patent basics in plain English: patents, provisional applications, claims, patent pending status, and how IPnite helps structure invention drafts."
  canonicalPath="/learn/"
  alternatePath="/es/learn/"
  keywords="learn patents, patent basics, provisional patent application, patent claims, patent pending, invention disclosure, IPnite learning"
>
  <section class="learn-page">
    <section class="learn-hero">
      <p class="learn-eyebrow">IPnite Learning</p>
      <h1>Patent Basics, Without the Fog.</h1>
      <p class="learn-subtitle">
        Learn what patents and provisional applications do in <span>plain English.</span>
      </p>
      <p class="learn-lead">
        This page explains the first concepts every inventor should understand before turning an idea into a patent draft.
      </p>
      <div class="learn-actions">
        <a class="learn-btn learn-btn-primary" href="https://app.ipnite.com/" target="_blank" rel="noopener">Start drafting</a>
        <a class="learn-btn" href="#learn-core">Start learning</a>
      </div>

      <div class="learn-stage" aria-label="Animated patent learning workflow">
        <svg viewBox="0 0 1200 520" role="img" aria-label="Animated patent education visual">
          <rect width="1200" height="520" rx="28" fill="#fff" />
          <g class="stage-step stage-idea" transform="translate(90 128)">
            <circle class="pulse" cx="86" cy="92" r="58" fill="#7B1D2C" opacity=".08" />
            <circle cx="86" cy="92" r="28" fill="#fff" stroke="#7B1D2C" stroke-width="5" />
            <path d="M86 64 C68 76 68 98 84 109 L84 122 L91 122 L91 109 C108 98 105 76 86 64Z" fill="none" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="78" y1="134" x2="96" y2="134" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
            <text x="86" y="230" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">IDEA</text>
            <text x="86" y="256" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">The raw concept</text>
          </g>
          <g transform="translate(396 122)">
            <rect x="0" y="0" width="158" height="184" rx="22" fill="#fff" stroke="#ECE7E5" stroke-width="3" />
            <g class="draft-lines">
              <path d="M30 46 H126" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
              <path d="M30 80 H112" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
              <path d="M30 114 H122" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
            </g>
            <rect x="30" y="140" width="76" height="10" rx="5" fill="#7B1D2C" opacity=".16" />
            <text x="79" y="240" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">DRAFT</text>
            <text x="79" y="266" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">Structured details</text>
          </g>
          <g transform="translate(690 122)">
            <circle cx="76" cy="100" r="66" fill="#fff" stroke="#ECE7E5" stroke-width="3" />
            <circle cx="76" cy="100" r="42" fill="#fff" stroke="#7B1D2C" stroke-width="4" opacity=".86" />
            <line x1="76" y1="100" x2="76" y2="72" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" />
            <g class="clock-hand"><line x1="76" y1="100" x2="103" y2="100" stroke="#7B1D2C" stroke-width="5" stroke-linecap="round" /></g>
            <circle cx="76" cy="100" r="5" fill="#7B1D2C" />
            <text x="76" y="236" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">12 MONTHS</text>
            <text x="76" y="262" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">Deadline window</text>
          </g>
          <g transform="translate(1000 128)">
            <path class="shield-glow" d="M76 0 L142 24 V82 C142 128 112 157 76 176 C40 157 10 128 10 82 V24 Z" fill="#7B1D2C" opacity=".14" />
            <path d="M76 12 L128 32 V82 C128 116 107 140 76 158 C45 140 24 116 24 82 V32 Z" fill="#fff" stroke="#7B1D2C" stroke-width="4" />
            <text x="76" y="84" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="12" font-weight="900" letter-spacing="2">PENDING</text>
            <circle class="spark spark-a" cx="148" cy="32" r="4" fill="#7B1D2C" />
            <circle class="spark spark-b" cx="14" cy="142" r="3" fill="#7B1D2C" />
            <circle class="spark spark-c" cx="156" cy="138" r="3" fill="#7B1D2C" />
            <text x="76" y="228" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="17" font-weight="900" letter-spacing="2">STATUS</text>
            <text x="76" y="254" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="15" font-weight="700">Patent pending</text>
          </g>
        </svg>
      </div>
    </section>

    <section id="learn-core" class="learn-section">
      <div class="learn-head">
        <h2>The core ideas.</h2>
        <p>Start here. These concepts explain what a patent process is trying to do.</p>
      </div>
      <div class="core-grid">
        <article class="core-card">
          <span>01</span>
          <h3>Patent</h3>
          <div class="mini mini-shield" aria-hidden="true"></div>
          <p>A patent is a legal right that can let you stop others from making, using, selling, or importing the claimed invention.</p>
        </article>
        <article class="core-card">
          <span>02</span>
          <h3>Provisional</h3>
          <div class="mini mini-clock" aria-hidden="true"></div>
          <p>A provisional application is a first filing that can secure an early U.S. filing date. It does not become a patent by itself.</p>
        </article>
        <article class="core-card">
          <span>03</span>
          <h3>Claims</h3>
          <div class="mini mini-claims" aria-hidden="true"></div>
          <p>Claims are the legal boundaries. They describe what you are trying to protect, not just what your product looks like.</p>
        </article>
        <article class="core-card">
          <span>04</span>
          <h3>Patent Pending</h3>
          <div class="mini mini-pending" aria-hidden="true">PENDING</div>
          <p>After filing, you may be able to say "patent pending." That means an application was filed, not that a patent was granted.</p>
        </article>
      </div>
    </section>

    <section class="learn-section">
      <div class="learn-head">
        <h2>Provisional vs. nonprovisional.</h2>
        <p>The simple version: one can plant the flag, the other asks for the patent.</p>
      </div>
      <div class="compare-grid">
        <article>
          <small>Provisional application</small>
          <h3>Plant your flag.</h3>
          <p>A provisional application is usually used as an early first filing. It can give you time to refine the invention, test the market, raise money, or prepare the full application.</p>
          <ul>
            <li>Not examined on the merits.</li>
            <li>Automatically expires after 12 months.</li>
            <li>Can support patent pending status.</li>
            <li>Only protects what you actually describe well enough.</li>
          </ul>
        </article>
        <article>
          <small>Nonprovisional application</small>
          <h3>Ask for the patent.</h3>
          <p>A nonprovisional application is the formal application that gets examined by the patent office. This is the path that can eventually lead to an issued patent.</p>
          <ul>
            <li>Examined by the patent office.</li>
            <li>Needs claims that define the invention.</li>
            <li>Can claim priority to a provisional filing.</li>
            <li>Can become a granted patent if allowed.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="learn-section">
      <div class="learn-head">
        <h2>The 12-month clock.</h2>
        <p>Think of a provisional as a timer, not the finish line.</p>
      </div>
      <div class="timeline">
        {["File", "Build", "Convert", "Expires"].map((title, index) => (
          <article>
            <span>{index + 1}</span>
            <h3>{title}</h3>
            <p>
              {index === 0 && "Submit a provisional application with enough detail to support the invention."}
              {index === 1 && "Test, improve, pitch, raise, or prepare a stronger full application."}
              {index === 2 && "Within 12 months, file a nonprovisional if you want to keep the priority benefit."}
              {index === 3 && "If you do nothing, the provisional is abandoned and will not become a patent."}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="learn-section tabs-section">
      <div class="learn-head">
        <h2>What founders usually misunderstand.</h2>
        <p>Click each topic.</p>
      </div>
      <div class="tabs-shell">
        <div class="tab-list" role="tablist" aria-label="Patent misconceptions">
          <button class="tab-button active" type="button" data-tab="tab-1">I filed, so I own it.</button>
          <button class="tab-button" type="button" data-tab="tab-2">A provisional is a patent.</button>
          <button class="tab-button" type="button" data-tab="tab-3">Details can wait.</button>
          <button class="tab-button" type="button" data-tab="tab-4">Claims are just legal text.</button>
        </div>
        <div class="tab-panel">
          <article id="tab-1" class="tab-content active"><h3>Filing starts the process.</h3><p>Filing gives you a record and may support priority. But ownership, inventorship, assignments, claim scope, prior art, and filing strategy still matter.</p></article>
          <article id="tab-2" class="tab-content"><h3>A provisional is not granted.</h3><p>A provisional application is not examined and does not issue as a patent. It is useful, but must be followed by the right next step.</p></article>
          <article id="tab-3" class="tab-content"><h3>The first draft matters.</h3><p>A weak provisional can fail to support later claims. Patent work rewards clear, complete technical disclosure.</p></article>
          <article id="tab-4" class="tab-content"><h3>Claims define protection.</h3><p>Your description explains the invention. Your claims define what you are trying to own.</p></article>
        </div>
      </div>
    </section>

    <section class="learn-section quiz-section">
      <div class="learn-head">
        <h2>Quick check.</h2>
        <p>What is the safest way to think about a provisional application?</p>
      </div>
      <div class="quiz-box">
        <button type="button" data-answer="wrong">It is already a granted patent.</button>
        <button type="button" data-answer="correct">It is an early filing that starts a 12-month clock.</button>
        <button type="button" data-answer="wrong">It protects anything I invent later.</button>
      </div>
      <p class="quiz-feedback" aria-live="polite">Select an answer to see the explanation.</p>
    </section>

    <aside class="learn-note">
      <strong>Educational only.</strong> This page explains general patent concepts in simple language. It is not legal advice and does not create an attorney-client relationship.
    </aside>

    <section class="learn-cta">
      <h2>Ready to structure your invention?</h2>
      <p>Use IPnite to organize the technical disclosure, claims direction, embodiments, and draft sections before professional review.</p>
      <a class="learn-btn" href="https://app.ipnite.com/" target="_blank" rel="noopener">Start drafting</a>
    </section>
  </section>
</BaseLayout>

<style>
  .learn-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 76px 18px 110px;
    color: #505050;
    font-family: "Roboto", sans-serif;
  }

  .learn-hero,
  .learn-head,
  .quiz-section,
  .learn-cta {
    text-align: center;
  }

  .learn-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #ededed;
    padding: 10px 22px;
    font-family: "Roboto Slab", serif;
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .learn-hero h1,
  .learn-head h2,
  .learn-cta h2 {
    margin: 22px auto 0;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-weight: 800;
    line-height: 1;
  }

  .learn-hero h1 {
    max-width: 980px;
    font-size: clamp(54px, 7.8vw, 104px);
  }

  .learn-subtitle {
    max-width: 820px;
    margin: 24px auto 0;
    color: #505050;
    font-family: "Roboto Slab", serif;
    font-size: clamp(28px, 3.7vw, 48px);
    font-weight: 700;
    line-height: 1.1;
  }

  .learn-subtitle span {
    color: #4c0815;
  }

  .learn-lead,
  .learn-head p,
  .learn-cta p {
    max-width: 760px;
    margin: 20px auto 0;
    color: #505050;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.65;
  }

  .learn-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 30px;
  }

  .learn-btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    border: 1px solid #6b2a2f;
    border-radius: 999px;
    background: #fff;
    padding: 0 22px;
    color: #4c0815;
    font-family: "Roboto Slab", serif;
    font-size: 18px;
    font-weight: 800;
    text-decoration: underline;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }

  .learn-btn-primary,
  .learn-btn:hover {
    background: #6b2a2f;
    color: #fff;
  }

  .learn-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 46px rgba(107, 42, 47, 0.16);
  }

  .learn-stage {
    margin: 38px auto 0;
    max-width: 1060px;
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 40px;
    background: #fff;
    box-shadow: 0 34px 70px -28px rgba(107, 42, 47, 0.2);
    overflow: hidden;
  }

  .learn-stage svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .pulse { animation: ideaPulse 3.4s ease-in-out infinite; transform-origin: center; }
  .draft-lines path { animation: drawStroke 3.4s ease-in-out infinite; stroke-dasharray: 96; stroke-dashoffset: 96; }
  .draft-lines path:nth-child(2) { animation-delay: .18s; }
  .draft-lines path:nth-child(3) { animation-delay: .36s; }
  .clock-hand { animation: clockRotate 6s linear infinite; transform-box: fill-box; transform-origin: left center; }
  .shield-glow { animation: shieldGlow 3.4s ease-in-out infinite; transform-origin: center; }
  .spark { animation: sparkFade 2.6s ease-in-out infinite; transform-origin: center; }
  .spark-b { animation-delay: .3s; }
  .spark-c { animation-delay: .6s; }

  .learn-section {
    padding: 72px 0 0;
  }

  .learn-head h2,
  .learn-cta h2 {
    font-size: clamp(40px, 5vw, 64px);
  }

  .core-grid,
  .compare-grid,
  .timeline,
  .tabs-shell,
  .quiz-box {
    display: grid;
    gap: 18px;
    margin-top: 34px;
  }

  .core-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .core-card,
  .compare-grid article,
  .timeline article,
  .tab-panel,
  .quiz-box button {
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 30px;
    background: #fff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.035);
  }

  .core-card {
    min-height: 250px;
    padding: 24px 20px;
    text-align: center;
    transition: background 220ms ease, color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }

  .core-card:hover {
    background: #6b2a2f;
    color: #fff;
    transform: translateY(-6px);
    box-shadow: 0 34px 70px -28px rgba(107, 42, 47, 0.2);
  }

  .core-card span {
    display: block;
    color: rgba(107, 42, 47, 0.28);
    font-family: "Roboto Slab", serif;
    font-size: 42px;
    font-weight: 800;
    line-height: 1;
  }

  .core-card h3,
  .compare-grid h3,
  .timeline h3,
  .tab-content h3 {
    margin: 12px 0 0;
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
  }

  .core-card p,
  .compare-grid p,
  .timeline p,
  .tab-content p,
  .learn-note,
  .quiz-feedback {
    color: #505050;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
  }

  .core-card p {
    margin: 12px 0 0;
  }

  .core-card:hover span,
  .core-card:hover h3,
  .core-card:hover p {
    color: #fff;
  }

  .mini {
    width: 76px;
    height: 56px;
    margin: 16px auto 0;
    position: relative;
  }

  .mini-shield::before,
  .mini-clock::before,
  .mini-claims::before,
  .mini-pending {
    content: "";
    position: absolute;
    inset: 6px 18px;
    border: 2px solid #6b2a2f;
    background: #fff;
  }

  .mini-shield::before { border-radius: 18px 18px 10px 10px; animation: miniPulse 3s ease-in-out infinite; }
  .mini-clock::before { border-radius: 999px; animation: miniPulse 3s ease-in-out infinite; }
  .mini-clock::after { content: ""; position: absolute; left: 37px; top: 17px; width: 2px; height: 17px; background: #6b2a2f; border-radius: 999px; transform-origin: bottom; animation: clockRotate 3s linear infinite; }
  .mini-claims::before { border-radius: 18px; animation: miniPulse 3s ease-in-out infinite; }
  .mini-claims::after { content: ""; position: absolute; left: 31px; top: 27px; width: 22px; height: 10px; border-left: 3px solid #6b2a2f; border-bottom: 3px solid #6b2a2f; transform: rotate(-45deg); }
  .mini-pending { position: relative; inset: auto; width: 76px; height: 34px; align-items: center; justify-content: center; border-radius: 999px; color: #6b2a2f; font-size: 10px; font-weight: 900; letter-spacing: .06em; animation: miniPulse 3s ease-in-out infinite; }

  .compare-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .compare-grid article {
    padding: 30px;
  }

  .compare-grid small {
    color: #6b2a2f;
    font-family: "Roboto Slab", serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .compare-grid ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .compare-grid li {
    color: #505050;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .compare-grid li::before {
    content: "✓";
    display: inline-flex;
    width: 21px;
    height: 21px;
    align-items: center;
    justify-content: center;
    margin-right: 9px;
    border-radius: 999px;
    background: rgba(107, 42, 47, 0.08);
    color: #6b2a2f;
    font-weight: 900;
  }

  .timeline {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    position: relative;
  }

  .timeline article {
    padding: 26px 22px;
    text-align: center;
  }

  .timeline span {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #6b2a2f;
    color: #fff;
    font-family: "Roboto Slab", serif;
    font-weight: 800;
  }

  .tabs-shell {
    grid-template-columns: .85fr 1.15fr;
  }

  .tab-list {
    display: grid;
    gap: 10px;
  }

  .tab-button,
  .quiz-box button {
    min-height: 64px;
    border: 1px solid rgba(107, 42, 47, 0.12);
    border-radius: 22px;
    background: #fff;
    color: #4c0815;
    padding: 16px;
    font-family: "Roboto Slab", serif;
    font-size: 18px;
    font-weight: 800;
    text-align: left;
    cursor: pointer;
  }

  .tab-button.active,
  .tab-button:hover,
  .quiz-box button.correct {
    background: #6b2a2f;
    color: #fff;
  }

  .tab-panel {
    padding: 32px;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
    animation: panelIn 220ms ease both;
  }

  .quiz-box {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 920px;
    margin-inline: auto;
  }

  .quiz-box button {
    min-height: 112px;
    text-align: center;
  }

  .quiz-box button.wrong {
    background: #fff8e8;
    color: #9a6a20;
    border-color: rgba(154, 106, 32, 0.24);
  }

  .quiz-feedback {
    min-height: 48px;
    max-width: 700px;
    margin: 20px auto 0;
    text-align: center;
  }

  .learn-note {
    max-width: 860px;
    margin: 42px auto 0;
    border: 1px solid rgba(154, 106, 32, 0.24);
    border-radius: 22px;
    background: #fff8e8;
    padding: 16px;
    color: #9a6a20;
  }

  .learn-note strong {
    color: #9a6a20;
  }

  .learn-cta {
    margin-top: 52px;
    border-radius: 40px;
    background: #6b2a2f;
    padding: 64px 28px;
  }

  .learn-cta h2,
  .learn-cta p {
    color: #fff;
  }

  .learn-cta .learn-btn {
    margin-top: 28px;
    border-color: #fff;
    background: #fff;
    color: #4c0815;
  }

  @keyframes ideaPulse { 0%,100% { transform: scale(.92); opacity: .75; } 50% { transform: scale(1.08); opacity: 1; } }
  @keyframes drawStroke { 0%,20% { stroke-dashoffset: 96; opacity: .25; } 50%,80% { stroke-dashoffset: 0; opacity: .8; } 100% { stroke-dashoffset: 96; opacity: .25; } }
  @keyframes clockRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes shieldGlow { 0%,100% { opacity: .12; transform: scale(.96); } 50% { opacity: .28; transform: scale(1.04); } }
  @keyframes sparkFade { 0%,100% { opacity: .25; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.08); } }
  @keyframes miniPulse { 0%,100% { transform: scale(.92); opacity: .8; } 50% { transform: scale(1.06); opacity: 1; } }
  @keyframes panelIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .learn-page *, .learn-page *::before, .learn-page *::after {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 980px) {
    .core-grid,
    .compare-grid,
    .tabs-shell,
    .quiz-box {
      grid-template-columns: 1fr;
    }

    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .learn-page {
      padding: 54px 12px 80px;
    }

    .learn-hero h1 {
      font-size: 48px;
    }

    .learn-subtitle,
    .learn-head h2,
    .learn-cta h2 {
      font-size: 34px;
    }

    .learn-actions,
    .quiz-box,
    .timeline {
      grid-template-columns: 1fr;
    }

    .learn-btn {
      width: 100%;
      max-width: 330px;
    }

    .learn-stage,
    .learn-cta {
      border-radius: 28px;
    }

    .learn-stage svg {
      min-width: 760px;
      transform: translateX(-185px);
    }

    .learn-stage {
      overflow: hidden;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll(".tab-button").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.getAttribute("data-tab");
      document.querySelectorAll(".tab-button").forEach((item) => item.classList.remove("active"));
      document.querySelectorAll(".tab-content").forEach((item) => item.classList.remove("active"));
      button.classList.add("active");
      document.getElementById(id || "")?.classList.add("active");
    });
  });

  const feedback = document.querySelector(".quiz-feedback");
  document.querySelectorAll("[data-answer]").forEach((button) => {
    button.addEventListener("click", () => {
      document.querySelectorAll("[data-answer]").forEach((item) => item.classList.remove("correct", "wrong"));
      const correct = button.getAttribute("data-answer") === "correct";
      button.classList.add(correct ? "correct" : "wrong");
      if (feedback) {
        feedback.innerHTML = correct
          ? "<strong>Correct.</strong> A provisional application is an early filing that can support a priority date, but it expires after 12 months unless you take the right next step."
          : "<strong>Not quite.</strong> A provisional application is not a granted patent and does not protect later details that were never described.";
      }
    });
  });
</script>
