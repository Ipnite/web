---
import BaseLayout from "@layouts/BaseLayout.astro";
import LearnLanding from "@components/LearnLanding.astro";
import LearnContentHub from "@components/LearnContentHub.astro";
import { alternatesFor } from "../data/routes";

const learnStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.ipnite.com/learn/#webpage",
  "url": "https://www.ipnite.com/learn/",
  "name": "IPnite Learn",
  "inLanguage": "en",
  "description": "Learn patent basics in plain English with IPnite, including patents, provisional applications, claims, patent pending status, and invention drafting workflows.",
  "isPartOf": { "@id": "https://www.ipnite.com/#website" },
  "about": { "@id": "https://www.ipnite.com/#organization" },
};
---

<BaseLayout
  title="Learn Patent Basics: Clear Guides | IPnite"
  description="Clear patent guides: how to patent an idea, provisional applications, prior art, claims, patentability, and the PCT, with official sources."
  canonicalPath="/learn/"
  alternatePaths={alternatesFor("learn")}
  keywords="learn patents, patent basics, provisional patent application, patent claims, patent pending, invention disclosure, IPnite learning"
  structuredData={learnStructuredData}
>
  <LearnLanding lang="en" />
  <LearnContentHub lang="en" />
</BaseLayout>
