---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";
import FlagBadge from "@components/FlagBadge.astro";

const aboutStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Sobre a IPnite",
    "url": "https://www.ipnite.com/pt-br/about-us/",
    "description":
      "Sobre a IPnite: filosofia, missao, visao e equipe por tras de uma plataforma assistida por IA para preparacao de patentes.",
    "mainEntity": {
      "@type": "Organization",
      "@id": "https://www.ipnite.com/#organization",
      "name": "IPnite",
      "description":
        "A IPnite torna mais acessivel a preparacao seria de propriedade intelectual por meio de fluxos guiados de redacao de patentes assistidos por IA.",
      "areaServed": ["United States", "Mexico", "Argentina", "Latin America", "European Patent Office jurisdictions"],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Equipe de lideranca da IPnite",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Person",
          "name": "Rafael Betanzos San Juan",
          "jobTitle": "CEO · IP Strategy · Platform Builder",
          "worksFor": { "@type": "Organization", "name": "IPnite" },
          "sameAs": "https://www.linkedin.com/in/rafabetanzos/",
        },
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Person",
          "name": "Lucas Larrosa",
          "jobTitle": "CTO · Platform Security",
          "worksFor": { "@type": "Organization", "name": "IPnite" },
          "sameAs": "https://www.linkedin.com/in/lucaslarrosa/",
        },
      },
    ],
  },
];

const collaborators = [
  {
    photo: "/images/israel.jpeg",
    name: "Israel Flores",
    role: "Advogado de PI · Prosecução",
    country: "Mexico" as const,
    href: "https://mx.linkedin.com/in/israel-flores-a75a44125",
  },
];
---

<BaseLayout
  lang="pt"
  title="Sobre a IPnite"
  description="Conheca a filosofia, missao, visao e equipe por tras da IPnite."
  canonicalPath="/pt-br/about-us/"
  alternatePath="/about-us/"
  keywords="Sobre a IPnite, equipe IPnite, missao IPnite, redacao de patentes DIY, melhor ferramenta para redigir patentes, gestao de PI para startups, plataforma de propriedade intelectual"
  structuredData={aboutStructuredData}
>
  <section class="about-page">
    <div class="about-glow about-glow-left" aria-hidden="true"></div>
    <div class="about-glow about-glow-right" aria-hidden="true"></div>

    <section class="about-hero" aria-labelledby="about-heading">
      <p class="about-eyebrow">Filosofia da IPnite</p>
      <h1 id="about-heading">Nossa filosofia</h1>
      <p class="about-statement">As ferramentas que antes pertenciam a poucos estao passando a estar ao alcance de todos.</p>
      <p class="about-lead">A IPnite leva essa mudanca para a propriedade intelectual: um primeiro passo mais claro para quem quer proteger o que constrói.</p>
      <p class="about-note">Mais ideias protegidas significam mais conhecimento documentado, negocios mais fortes e mais solucoes chegando ao mundo.</p>
      <div class="about-actions">
        <a href="https://app.ipnite.com/" target="_blank" rel="noopener" class="about-button about-button-primary">Comecar minha patente agora</a>
        <a href="/pt-br/#how-it-works" class="about-button about-button-secondary">Como funciona</a>
      </div>
      <PageHeroImage label="Hero da plataforma IPnite para redacao de patentes" />
    </section>

    <section class="about-section" aria-labelledby="about-why-heading">
      <div class="about-section-head">
        <p class="about-pill">Por que fazemos isso</p>
        <h2 id="about-why-heading">As ideias merecem um primeiro passo serio</h2>
        <p>Inumeras invenções sao atrasadas ou perdidas porque a protecao parece cara, confusa ou fora de alcance. A IPnite oferece um ponto de partida pratico.</p>
      </div>
      <div class="principle-grid">
        <article class="principle-card"><span>01</span><h3>Nenhuma ideia e pequena demais</h3><p>Se importa para voce, merece ser documentada com clareza.</p></article>
        <article class="principle-card"><span>02</span><h3>Simples e transparente</h3><p>Sem passos confusos. Apenas um caminho guiado da ideia ate um rascunho estruturado.</p></article>
        <article class="principle-card"><span>03</span><h3>Primeiro o criador</h3><p>Ferramentas para inventores, fundadores e criadores que preparam suas invencoes para revisao.</p></article>
      </div>
    </section>

    <section class="about-section promise-section" aria-labelledby="promise-heading">
      <div class="promise-card">
        <p class="about-pill">Promessa da IPnite</p>
        <h2 id="promise-heading">Voce traz a ideia.<br />Nos ajudamos a <em>estruturá-la.</em></h2>
        <p>Estamos construindo uma forma mais acessivel de documentar, organizar e proteger a engenharia humana sem reduzir a seriedade do trabalho.</p>
      </div>
    </section>

    <section class="about-section team-section" aria-labelledby="team-heading">
      <div class="about-section-head">
        <p class="about-pill">Nossa equipe</p>
        <h2 id="team-heading">Construida por operadores de IP, produto e seguranca</h2>
        <p>A IPnite combina estrategia de propriedade intelectual, desenvolvimento de produto com IA e seguranca de plataforma.</p>
      </div>
      <div class="team-grid">
        <article class="team-card">
          <div class="team-avatar" aria-hidden="true"><img src="/images/rafael.jpg" alt="Rafael Betanzos San Juan" loading="lazy" /></div>
          <h3>Rafael Betanzos San Juan</h3>
          <p class="team-role">CEO · Estrategia de IP · Plataforma</p>
          <FlagBadge country="Mexico" label="México" />
          <p>Ele lidera a plataforma da IPnite, os agentes de IA, os fluxos de redacao, a direcao do produto e a estrategia de propriedade intelectual.</p>
        </article>
        <article class="team-card">
          <div class="team-avatar" aria-hidden="true"><img src="/images/lucas.jpg" alt="Lucas Larrosa" loading="lazy" /></div>
          <h3>Lucas Larrosa</h3>
          <p class="team-role">CTO · Seguranca da plataforma</p>
          <FlagBadge country="Argentina" />
          <p>Ele lidera a seguranca da plataforma, a protecao de acessos, a infraestrutura e as operacoes tecnicas seguras.</p>
        </article>
      </div>
    </section>

    <section class="about-section collaborators-section" aria-labelledby="collaborators-heading">
      <div class="about-section-head">
        <h2 id="collaborators-heading">Nossos Parceiros</h2>
      </div>
      <div class="team-grid collaborators-grid">
        {collaborators.map((person) => (
          <article class="team-card collaborator-card">
            <div class="collaborator-avatar">
              <img src={person.photo} alt={person.name} loading="lazy" />
            </div>
            <h3>{person.name}</h3>
            <p class="team-role">{person.role}</p>
            <div class="collaborator-meta">
              <FlagBadge country={person.country} label="México" />
              <a href={person.href} target="_blank" rel="noopener" class="profile-link">Ver LinkedIn</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-final" aria-labelledby="about-final-heading">
      <h2 id="about-final-heading">Pronto para dar o primeiro passo serio?</h2>
      <a href="https://app.ipnite.com/" target="_blank" rel="noopener" class="about-button about-button-primary">Comecar minha patente agora</a>
    </section>
  </section>
</BaseLayout>

<style>
  .about-page{position:relative;overflow:hidden;background:#fff;color:#505050;font-family:"Roboto",sans-serif;padding:0 24px 76px}
  .about-glow{position:absolute;width:520px;height:520px;border-radius:999px;background:rgba(107,42,47,.12);filter:blur(130px);pointer-events:none}
  .about-glow-left{left:-220px;top:240px}.about-glow-right{right:-240px;top:900px}
  .about-hero,.about-section,.about-final{position:relative;z-index:1;max-width:1180px;margin:0 auto}
  .about-hero{min-height:610px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:78px 0 70px}
  .about-eyebrow,.about-pill{display:inline-flex;align-items:center;justify-content:center;border-radius:33px;background:#6b2a2f;color:#ededed;font-family:"Roboto Slab",serif;font-size:15px;font-weight:800;line-height:1;padding:10px 20px;text-transform:uppercase}
  .about-hero h1,.about-section h2,.about-final h2{margin:18px 0 0;color:#4c0815;font-family:"Roboto Slab",serif;font-weight:800;letter-spacing:0}
  .about-hero h1{max-width:900px;font-size:clamp(56px,8vw,104px);line-height:.98}.about-statement{max-width:900px;margin:24px auto 0;color:#505050;font-family:"Roboto Slab",serif;font-size:clamp(30px,4vw,54px);font-weight:600;line-height:1.12}
  .about-lead,.about-note,.about-section-head p,.promise-card>p,.principle-card p,.team-card p{color:#505050;font-size:18px;font-weight:500;line-height:1.65}
  .about-lead{max-width:760px;margin:24px auto 0}.about-note{max-width:720px;margin:12px auto 0;color:#717171;font-size:16px}
  .about-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin-top:34px}
  .about-button{min-height:52px;display:inline-flex;align-items:center;justify-content:center;border-radius:40px;border:1px solid #6b2a2f;padding:0 26px;font-family:"Roboto Slab",serif;font-size:18px;font-weight:800;line-height:1;text-align:center;text-decoration:underline;transition:transform 180ms ease,box-shadow 180ms ease,background 180ms ease,color 180ms ease}
  .about-button:hover{transform:translateY(-3px);box-shadow:0 18px 38px rgba(107,42,47,.15)}.about-button-primary{background:#ededed;color:#4c0815}.about-button-secondary{background:#fff;color:#4c0815}.about-button-primary:hover,.about-button-secondary:hover{background:#6b2a2f;color:#fff}
  .about-section{padding:70px 0}.about-section-head{max-width:820px;margin:0 auto 34px;text-align:center}.about-section h2,.about-final h2{font-size:clamp(42px,5vw,64px);line-height:1.12}.about-section-head p:last-child{margin:18px auto 0}
  .principle-grid,.team-grid{display:grid;gap:24px}.principle-grid{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:36px}.team-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .principle-card,.team-card{background:rgba(255,255,255,.88);border:1px solid rgba(107,42,47,.12);border-radius:30px;box-shadow:0 22px 50px rgba(107,42,47,.07)}
  .principle-card{min-height:230px;padding:34px 28px;text-align:center}.principle-card span{display:block;color:rgba(107,42,47,.28);font-family:"Roboto Slab",serif;font-size:44px;font-weight:800;line-height:1;margin-bottom:18px}.principle-card h3,.team-card h3{margin:0;color:#6b2a2f;font-family:"Roboto Slab",serif;font-size:30px;font-weight:800;line-height:1.18}.principle-card p{margin:14px 0 0;font-size:16px}
  .promise-section{padding-top:48px}.promise-card{max-width:1000px;margin:0 auto;text-align:center}.promise-card h2 em{color:#6b2a2f;font-style:italic}
  .team-card{padding:28px;text-align:center}.team-avatar{width:72px;height:72px;border-radius:999px;margin:0 auto 18px;overflow:hidden;background:#6b2a2f;color:#fff;display:flex;align-items:center;justify-content:center;font-family:"Roboto Slab",serif;font-size:32px;font-weight:800}.team-avatar img{width:100%;height:100%;object-fit:cover;background:#fff}.team-role{color:#6b2a2f;font-weight:800}
  .team-card :global(.flag-badge){justify-content:center;margin-top:10px}
  .collaborators-section{padding-top:24px}.collaborators-grid{grid-template-columns:repeat(auto-fit,minmax(220px,260px));justify-content:center}
  .collaborator-avatar{width:132px;height:132px;margin:0 auto 22px;border-radius:30px;overflow:hidden;background:#fff;border:1px solid rgba(107,42,47,.12)}.collaborator-avatar img{width:100%;height:100%;object-fit:cover;background:#fff}
  .collaborator-meta{display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:16px}.collaborator-meta :global(.flag-badge){justify-content:center}
  .profile-link{min-height:44px;display:inline-flex;align-items:center;justify-content:center;margin-top:4px;border:1px solid rgba(107,42,47,.18);border-radius:999px;padding:0 18px;color:#4c0815;font-family:"Roboto Slab",serif;font-size:14px;font-weight:800;text-decoration:underline;transition:transform 180ms ease,box-shadow 180ms ease}.profile-link:hover{transform:translateY(-3px);box-shadow:0 18px 38px rgba(107,42,47,.13)}
  .about-final{padding:28px 0 0;text-align:center}
  @media (max-width: 980px){.principle-grid,.team-grid{grid-template-columns:1fr}}
  @media (max-width: 760px){.about-page{padding:0 16px 72px}.about-hero{min-height:0;padding:60px 0 56px}.about-hero h1{font-size:clamp(44px,12vw,70px)}.about-statement{font-size:clamp(24px,7vw,38px)}.about-section{padding:54px 0}}
</style>
