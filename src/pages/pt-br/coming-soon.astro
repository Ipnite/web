---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";
---

<BaseLayout
  lang="pt"
  title="Muito em breve - IPnite"
  description="Algumas ferramentas e fluxos da IPnite ainda estao em desenvolvimento e estarao disponiveis em breve."
  canonicalPath="/pt-br/coming-soon/"
  alternatePath="/coming-soon/"
>
  <section class="coming-page">
    <div class="coming-hero">
      <p class="coming-pill">Plataforma IPnite</p>
      <h1>Muito em breve</h1>
      <PageHeroImage label="Hero da plataforma IPnite para redacao de patentes" />
      <div class="coming-visual" aria-hidden="true">
        <div class="coming-top"><span>Em progresso</span></div>
        <svg viewBox="0 0 1200 620" role="img" aria-label="Ilustracao animada de advogado e cientista">
          <rect width="1200" height="620" rx="26" fill="#fff" />
          <line x1="600" y1="90" x2="600" y2="525" stroke="#ECE7E5" stroke-width="2" />
          <g class="float-doc"><rect x="90" y="72" width="84" height="56" rx="14" fill="#fff" stroke="#ECE7E5"/><line x1="110" y1="92" x2="152" y2="92" stroke="#7B1D2C" stroke-width="3" opacity=".45"/><line x1="110" y1="106" x2="145" y2="106" stroke="#7B1D2C" stroke-width="3" opacity=".25"/></g>
          <g class="float-doc-2"><rect x="470" y="90" width="72" height="48" rx="12" fill="#fff" stroke="#ECE7E5"/><line x1="488" y1="107" x2="523" y2="107" stroke="#7B1D2C" stroke-width="3" opacity=".45"/><line x1="488" y1="120" x2="515" y2="120" stroke="#7B1D2C" stroke-width="3" opacity=".25"/></g>
          <rect x="445" y="250" width="310" height="88" rx="44" fill="#fff" stroke="#ECE7E5"/>
          <text x="600" y="285" text-anchor="middle" fill="#7B1D2C" font-family="Roboto Slab, serif" font-size="34" font-weight="800">Ferramenta em desenvolvimento</text>
          <text x="600" y="313" text-anchor="middle" fill="#71717A" font-family="Roboto, sans-serif" font-size="13" font-weight="700" letter-spacing="2">IPNITE NOVA FERRAMENTA · MUITO EM BREVE</text>
          <rect x="80" y="420" width="390" height="22" rx="11" fill="#7B1D2C"/>
          <circle cx="245" cy="245" r="40" fill="#F0C7B2"/>
          <rect x="205" y="288" width="82" height="98" rx="24" fill="#1F2430"/>
          <rect x="218" y="294" width="56" height="76" rx="18" fill="#fff"/>
          <polygon points="245,314 232,350 258,350" fill="#7B1D2C"/>
          <g class="lawyer-hand"><rect x="315" y="308" width="36" height="16" rx="8" fill="#F0C7B2"/><rect x="343" y="316" width="34" height="5" rx="3" fill="#7B1D2C"/><rect x="374" y="316" width="12" height="5" rx="2.5" fill="#18181B"/></g>
          <rect x="305" y="330" width="120" height="78" rx="16" fill="#fff" stroke="#ECE7E5"/>
          <line class="paper-line-1" x1="330" y1="352" x2="397" y2="352" stroke="#7B1D2C" stroke-width="4" opacity=".55"/>
          <line class="paper-line-2" x1="330" y1="370" x2="385" y2="370" stroke="#7B1D2C" stroke-width="4" opacity=".45"/>
          <line class="paper-line-3" x1="330" y1="388" x2="376" y2="388" stroke="#7B1D2C" stroke-width="4" opacity=".35"/>
          <rect x="730" y="420" width="390" height="22" rx="11" fill="#7B1D2C"/>
          <circle cx="875" cy="235" r="40" fill="#F0C7B2"/>
          <rect x="834" y="278" width="84" height="106" rx="26" fill="#fff" stroke="#ECE7E5"/>
          <g class="scientist-arm"><rect x="952" y="308" width="35" height="15" rx="8" fill="#F0C7B2"/><rect x="983" y="312" width="34" height="5" rx="2.5" fill="#9097A4"/><rect x="1012" y="310" width="12" height="8" rx="4" fill="#7B1D2C"/></g>
          <path d="M1022 328 L1040 328 L1035 356 C1034 362 1038 368 1046 372 L1065 382 C1078 389 1084 398 1084 410 L1084 414 L978 414 L978 410 C978 398 984 389 997 382 L1016 372 C1024 368 1028 362 1027 356 Z" fill="#fff" stroke="#D9D3D1" stroke-width="3"/>
          <path class="liquid-wave" d="M988 395 C1005 387 1018 402 1032 395 C1046 388 1060 402 1074 394 L1074 414 L988 414 Z" fill="#7B1D2C" opacity=".82"/>
          <circle class="bubble-1" cx="1030" cy="382" r="6" fill="#7B1D2C" opacity=".55"/>
          <circle class="bubble-2" cx="1048" cy="375" r="5" fill="#7B1D2C" opacity=".45"/>
          <circle class="bubble-3" cx="1015" cy="388" r="4" fill="#7B1D2C" opacity=".4"/>
          <text x="275" y="495" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="12" font-weight="900" letter-spacing="2.5">FLUXO LEGAL</text>
          <text x="925" y="495" text-anchor="middle" fill="#7B1D2C" font-family="Roboto, sans-serif" font-size="12" font-weight="900" letter-spacing="2.5">FLUXO CIENTIFICO</text>
        </svg>
      </div>
      <p class="coming-subtitle">Esta ferramenta ainda nao esta ativa, mas algo <em>muito bom</em> esta por vir.</p>
      <p class="coming-lead">Algumas ferramentas da plataforma IPnite ainda estao em desenvolvimento. Se voce chegou ate aqui, a funcao que escolheu esta sendo preparada e estara disponivel em breve.</p>
      <div class="coming-actions">
        <a class="coming-btn coming-btn-primary" href="https://app.ipnite.com/" target="_blank" rel="noopener">Voltar para a plataforma</a>
        <a class="coming-btn" href="/pt-br/#contact">Falar conosco</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .coming-page{padding:70px clamp(16px,5vw,80px) 100px;background:#fff;overflow:hidden}
  .coming-hero{max-width:1180px;margin:0 auto;text-align:center}
  .coming-pill,.coming-top span{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;background:#6b2a2f;color:#ededed;font-family:"Roboto Slab",serif;font-weight:800;text-transform:uppercase}
  .coming-pill{padding:10px 20px;font-size:15px}
  .coming-hero h1{margin:22px 0 0;color:#4c0815;font-family:"Roboto Slab",serif;font-size:clamp(60px,10vw,122px);font-weight:800;line-height:.9}
  .coming-visual{margin:38px auto 0;max-width:1080px;border:1px solid rgba(107,42,47,.12);border-radius:40px;background:#fff;box-shadow:0 28px 70px -32px rgba(0,0,0,.18);overflow:hidden}
  .coming-top{display:flex;padding:16px 20px;border-bottom:1px solid #ece7e5}
  .coming-top span{background:rgba(107,42,47,.06);border:1px solid rgba(107,42,47,.18);color:#6b2a2f;padding:8px 12px;font-size:11px}
  .coming-visual svg{display:block;width:100%;height:auto;padding:18px}
  .coming-subtitle{max-width:760px;margin:32px auto 0;color:#505050;font-family:"Roboto Slab",serif;font-size:clamp(28px,4vw,48px);font-weight:700;line-height:1.1}
  .coming-subtitle em{color:#4c0815;font-style:normal}
  .coming-lead{max-width:760px;margin:18px auto 0;color:#505050;font-family:"Roboto",sans-serif;font-size:18px;font-weight:500;line-height:1.65}
  .coming-actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:30px}
  .coming-btn{display:inline-flex;min-height:50px;align-items:center;justify-content:center;border:1px solid #6b2a2f;border-radius:999px;background:#fff;padding:0 22px;color:#4c0815;font-family:"Roboto Slab",serif;font-size:18px;font-weight:800;text-decoration:underline}
  .coming-btn-primary{background:#ededed}
  .coming-btn:hover{background:#6b2a2f;color:#fff}
  .lawyer-hand{transform-origin:245px 295px;animation:writeHand 2.4s ease-in-out infinite}.paper-line-1,.paper-line-2,.paper-line-3{animation:paperFlash 2.4s ease-in-out infinite}.paper-line-2{animation-delay:.2s}.paper-line-3{animation-delay:.4s}.scientist-arm{transform-origin:880px 252px;animation:labArm 2.4s ease-in-out infinite}.bubble-1{animation:bubbleUp 2.6s ease-in-out infinite}.bubble-2{animation:bubbleUp 2.6s ease-in-out infinite .5s}.bubble-3{animation:bubbleUp 2.6s ease-in-out infinite .9s}.liquid-wave{animation:liquidMove 2.2s ease-in-out infinite}.float-doc{animation:floatDoc 4.5s ease-in-out infinite}.float-doc-2{animation:floatDoc 4.5s ease-in-out infinite 1s}
  @keyframes writeHand{0%,100%{transform:rotate(0deg) translateY(0)}50%{transform:rotate(8deg) translateY(4px)}}@keyframes paperFlash{0%,100%{opacity:.55}50%{opacity:1}}@keyframes labArm{0%,100%{transform:rotate(0deg) translateY(0)}50%{transform:rotate(-7deg) translateY(-2px)}}@keyframes bubbleUp{0%{opacity:0;transform:translateY(8px) scale(.6)}30%{opacity:1}100%{opacity:0;transform:translateY(-28px) scale(1)}}@keyframes liquidMove{0%,100%{transform:translateX(0)}50%{transform:translateX(4px)}}@keyframes floatDoc{0%,100%{transform:translateY(0);opacity:.85}50%{transform:translateY(-10px);opacity:1}}
  @media(max-width:620px){.coming-page{padding:46px 12px 70px}.coming-visual{border-radius:28px}.coming-visual svg{padding:10px}.coming-actions{flex-direction:column}.coming-btn{width:100%}}
</style>
