---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/HeroSection.astro";
import WhyWeDoItSection from "@components/WhyWeDoItSection.astro";
import IpnitePromiseSection from "@components/IpnitePromiseSection.astro";
import JurisdictionsSection from "@components/JurisdictionsImageSection.astro";
import YourIPTeamSection from "@components/YourIPTeamSection.astro";
import ReduceCostlySection from "@components/ReduceCostlySection.astro";
import HowItWorksSection from "@components/HowItWorksSection.astro";
import TrustSection from "@components/TrustSection.astro";
import PricingSection from "@components/PricingSection.astro";
import ContactSection from "@components/ContactSection.astro";
import CTAFinalSection from "@components/CTAFinalSection.astro";
---

<BaseLayout
  lang="pt"
  title="IPnite — Redacao de Patentes DIY e Gestao de PI para Startups"
  description="A IPnite e a plataforma DIY (faca voce mesmo) de redacao de patentes com IA para inventores, fundadores e startups. Documente invencoes, revise arte anterior, redija reivindicacoes e gerencie a PI da sua startup em um so lugar, sem precisar de um advogado para comecar."
  keywords="IPnite, redacao de patentes com IA, redacao de patentes DIY, melhor ferramenta para escrever patentes, gestao de PI para startups, rascunho de patente provisorio, propriedade intelectual, inventores, fundadores"
  canonicalPath="/pt-br/"
  alternatePath="/"
>
  <HeroSection lang="pt" />
  <WhyWeDoItSection lang="pt" />
  <IpnitePromiseSection lang="pt" />
  <YourIPTeamSection lang="pt" />
  <ReduceCostlySection lang="pt" />
  <HowItWorksSection lang="pt" />
  <TrustSection lang="pt" />
  <JurisdictionsSection lang="pt" />
  <PricingSection lang="pt" />
  <ContactSection lang="pt" />
  <CTAFinalSection lang="pt" />
</BaseLayout>
