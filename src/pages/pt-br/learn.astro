---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeroImage from "@components/PageHeroImage.astro";
---

<BaseLayout lang="pt" title="Aprenda — IPnite" description="Aprenda como a IPnite ajuda a estruturar rascunhos de patente." canonicalPath="/pt-br/learn/" alternatePath="/learn/">
  <section class="learn-es"><p>Aprenda</p><h1>Aprenda como a IPnite funciona</h1><PageHeroImage label="Hero da plataforma IPnite para redacao de patentes" /><div><a href="/pt-br/#how-it-works">Como funciona</a><a href="/pt-br/faqs">FAQs</a><a href="/pt-br/about-us">Sobre a IPnite</a><a href="/pt-br/termsandconditions">Termos</a></div></section>
</BaseLayout>
<style>.learn-es{max-width:980px;margin:0 auto;padding:86px 20px 120px;text-align:center}.learn-es p{display:inline-flex;border-radius:999px;background:#6b2a2f;color:#ededed;padding:10px 20px;font-family:"Roboto Slab",serif;font-weight:800;text-transform:uppercase}.learn-es h1{margin:22px 0 0;color:#4c0815;font-family:"Roboto Slab",serif;font-size:clamp(48px,8vw,90px);font-weight:800;line-height:1}.learn-es div{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:46px}.learn-es a{border:1px solid rgba(107,42,47,.16);border-radius:24px;background:#fff;padding:28px;color:#6b2a2f;font-family:"Roboto Slab",serif;font-size:26px;font-weight:800;box-shadow:0 14px 32px rgba(107,42,47,.06)}@media(max-width:700px){.learn-es div{grid-template-columns:1fr}}</style>
