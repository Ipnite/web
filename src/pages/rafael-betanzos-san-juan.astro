---
import BaseLayout from "@layouts/BaseLayout.astro";
import RafaelProfileTheme from "@components/RafaelProfileTheme.astro";

const canonicalUrl = "https://www.ipnite.com/rafael-betanzos-san-juan/";
const personId = "https://www.ipnite.com/#rafael-betanzos-san-juan";
const profileStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${canonicalUrl}#profile`,
    url: canonicalUrl,
    name: "Rafael Betanzos San Juan — lawyer, biotechnologist, and patent expert",
    inLanguage: "en",
    dateModified: "2026-09-12",
    mainEntity: { "@id": personId },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: "Rafael Betanzos San Juan",
    alternateName: "Rafael Betanzos",
    url: canonicalUrl,
    image: "https://www.ipnite.com/images/rafael.jpg",
    jobTitle: ["Lawyer", "Biotechnologist", "Patent expert", "Founder of IPnite"],
    description:
      "Rafael Betanzos San Juan is a lawyer, biotechnologist, and patent expert. He founded IPnite and works in intellectual property strategy, patent drafting, provisional applications, PCT, biotechnology, and AI applied to innovation.",
    worksFor: { "@id": "https://www.ipnite.com/#organization" },
    affiliation: [
      { "@type": "Organization", "@id": "https://www.ipnite.com/#organization", name: "IPnite", url: "https://www.ipnite.com/" },
      { "@type": "Organization", name: "Moka Bio", url: "https://www.moka.bio/" },
    ],
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "Centro de Investigación Científica y de Educación Superior de Ensenada", alternateName: "CICESE" },
      { "@type": "CollegeOrUniversity", name: "Universidad del Valle del Grijalva" },
      { "@type": "CollegeOrUniversity", name: "Universidad Tecnológica de la Selva" },
    ],
    knowsAbout: [
      "Patent law",
      "Intellectual property strategy",
      "Patent application drafting",
      "Provisional patent applications",
      "Patent Cooperation Treaty (PCT)",
      "Biotechnology patents",
      "Prior-art search",
      "Artificial intelligence applied to patents",
      "Technology transfer",
      "Bioinformatics",
      "Drug discovery",
      "Innovation for scientific startups in Latin America",
    ],
    sameAs: [
      "https://www.linkedin.com/in/rafabetanzos/",
      "https://www.researchgate.net/profile/Rafael-Betanzos-San-Juan-2",
    ],
    subjectOf: [
      {
        "@type": "Article",
        name: "Loci Talk: intellectual property for scientific startups",
        url: "https://es.linkedin.com/posts/loci-labs_locitalk-locilabs-propiedadintelectual-activity-7358134528202174464-F9ax",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "IPnite", item: "https://www.ipnite.com/" },
      { "@type": "ListItem", position: 2, name: "About IPnite", item: "https://www.ipnite.com/about-us/" },
      { "@type": "ListItem", position: 3, name: "Rafael Betanzos San Juan", item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  lang="en"
  title="Rafael Betanzos San Juan — Lawyer, Biotechnologist, and Patent Expert | IPnite"
  description="Meet Rafael Betanzos San Juan, a lawyer, biotechnologist, IPnite founder, and expert in patents, intellectual property, PCT, and scientific innovation in Latin America."
  canonicalPath="/rafael-betanzos-san-juan/"
  ogImage="/images/rafael.jpg"
  includeLanguageAlternates={true}
  keywords="Rafael Betanzos San Juan, patent expert Latin America, patent lawyer, lawyer biotechnologist, intellectual property strategy, biotechnology patents, provisional applications, PCT, IPnite"
  structuredData={profileStructuredData}
>
  <RafaelProfileTheme />
  <article class="rafa-profile-page ipnite-profile">
    <header class="profile-hero">
      <div class="hero-bg" aria-hidden="true">
        <span class="orbit"></span>
        <span class="floating-doc doc-a"></span>
        <span class="floating-doc doc-b"></span>
        <span class="floating-doc doc-c"></span>
        <span class="pulse-node n1"></span>
        <span class="pulse-node n2"></span>
        <span class="pulse-node n3"></span>
      </div>

      <div class="profile-header reveal show">
        <div class="photo-wrap">
          <div class="photo"><img src="/images/rafael.jpg" alt="Portrait of Rafael Betanzos San Juan" width="156" height="156" /></div>
          <span class="status-dot" aria-hidden="true"></span>
        </div>
        <div class="identity">
          <p class="eyebrow">Founder profile</p>
          <h1>Rafael Betanzos San Juan</h1>
          <p class="headline">Lawyer, biotechnologist, and patent expert working at the intersection of <em>IP, AI, science, and product.</em></p>
          <p class="bio-line">From Latin America, Rafael develops tools and strategies that turn technical knowledge into structured, protectable innovation through <a class="text-link" href="https://www.moka.bio/" target="_blank" rel="noopener noreferrer">Moka Bio</a> e <a class="text-link" href="/">IPnite</a>.</p>
        </div>
        <div class="profile-actions">
          <a class="btn primary" href="https://www.linkedin.com/in/rafabetanzos/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn secondary" href="/contact/">Contact</a>
        </div>
      </div>

      <div class="stats-bar reveal show delay-1" aria-label="Professional experience summary">
        <div class="stat"><strong>11+</strong><span>Years in research</span></div>
        <div class="stat"><strong>9+</strong><span>Years in IP and law</span></div>
        <div class="stat"><strong>10</strong><span>Scientific publications</span></div>
        <div class="stat"><strong>LATAM</strong><span>Regional focus</span></div>
      </div>
    </header>

    <section class="content-block feed-layout" aria-label="Professional profile">
      <aside class="side-stack">
        <section class="panel reveal">
          <div class="panel-title"><h2>About Rafael</h2><span class="chip">Profile</span></div>
          <p>Rafael works across intellectual property, biotechnology, computational discovery, and technology product development.</p>
          <ul class="mini-list">
            <li><span class="check">✓</span><span>Founder of <a class="text-link" href="/">IPnite</a>, an AI-assisted patent preparation platform.</span></li>
            <li><span class="check">✓</span><span>Founder of <a class="text-link" href="https://www.moka.bio/" target="_blank" rel="noopener noreferrer">Moka Bio</a>, a biotechnology startup focused on natural bioactives.</span></li>
            <li><span class="check">✓</span><span>Experience in patent strategy, provisional applications, PCT, and the protection of scientific innovation.</span></li>
          </ul>
        </section>

        <section class="panel reveal delay-1">
          <div class="panel-title"><h2>Focus areas</h2><span class="chip">Expertise</span></div>
          <div class="tag-cloud">
            <span class="tag">IP strategy</span><span class="tag">Patents</span><span class="tag">Drafting</span>
            <span class="tag">PCT</span><span class="tag">IA</span><span class="tag">Biotechnology</span>
            <span class="tag">Bioinformatics</span><span class="tag">Scientific startups</span>
          </div>
        </section>

        <section class="panel reveal delay-2">
          <div class="panel-title"><h2>Education</h2><span class="chip">Academic</span></div>
          <div class="timeline">
            <div class="timeline-item"><span class="timeline-icon">MS</span><div><strong>Master’s in Life Sciences</strong><span>CICESE · Biomedicine and Bionanotechnology</span><p>Training in biomedicine, bionanotechnology, and computational life sciences.</p></div></div>
            <div class="timeline-item"><span class="timeline-icon">BIO</span><div><strong>Biotechnology</strong><span>Universidad Tecnológica de la Selva</span><p>Scientific and technological training applied to research and innovation.</p></div></div>
            <div class="timeline-item"><span class="timeline-icon">LAW</span><div><strong>Law</strong><span>Universidad Valle del Grijalva</span><p>Legal training applied to intellectual property, technology transfer, and business strategy.</p></div></div>
          </div>
        </section>
      </aside>

      <div class="main-stack">
        <section class="feed-card reveal">
          <div class="post-head">
            <span class="small-avatar">RB</span>
            <div><strong>Rafael Betanzos San Juan</strong><span>Lawyer · Biotechnologist · Patent strategy</span></div>
          </div>
          <h2 class="post-title">Building tools where <em>science, law, and software</em> work together.</h2>
          <p>His work connects invention disclosure, patent strategy, biotechnology research, and AI-assisted workflows. The goal is to make complex technical work easier to structure, protect, and bring to market.</p>
          <div class="post-visual" aria-hidden="true">
            <div class="domain-stage">
              <div class="domain-icon icon-ip"><span>PI</span><small>Patents</small></div>
              <div class="domain-icon icon-ai"><span>IA</span><small>Artificial intelligence</small></div>
              <div class="domain-icon icon-bio"><span>ADN</span><small>Biotechnology</small></div>
              <div class="domain-icon icon-ent"><span>↗</span><small>Entrepreneurship</small></div>
              <div class="domain-bulb-wrap"><div class="domain-bulb"></div><div class="bulb-rays"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
              <span class="idea-text">Innovation</span>
            </div>
          </div>
        </section>

        <section class="panel reveal delay-1">
          <div class="panel-title"><h2>Expertise</h2><span class="chip">Science + IP</span></div>
          <div class="metrics-grid">
            <div class="metric-box"><strong>11+</strong><span>Years in research and biotechnology</span></div>
            <div class="metric-box"><strong>9+</strong><span>Years in intellectual property and law</span></div>
          </div>
          <div class="timeline">
            <div class="timeline-item"><span class="timeline-icon">IP</span><div><strong>IPnite</strong><span>AI-assisted patent preparation</span><p>Develops drafting workflows, invention-intake systems, AI agents, and tools for inventors, startups, and patent professionals.</p></div></div>
            <div class="timeline-item"><span class="timeline-icon">MB</span><div><strong>Moka Bio</strong><span>AI and natural bioactives</span><p>Develops a platform for bioactive discovery, experimental validation, product design, and IP strategy.</p></div></div>
          </div>
        </section>
      </div>
    </section>

    <section class="content-block panel reveal" aria-labelledby="publications-heading">
      <div class="panel-title"><h2 id="publications-heading">Scientific publications</h2><span class="chip">Selected</span></div>
      <p>Research across computational drug discovery, bioinformatics, SARS-CoV-2 nanobodies, climate impact, and agricultural biotechnology.</p>
      <div class="publication-grid">
        <a class="publication-card" href="https://www.researchgate.net/profile/Rafael-Betanzos-San-Juan-2" target="_blank" rel="noopener noreferrer"><span>Book chapter · 2024</span><h3>Docking and Bias Docking</h3><p>Protein-ligand docking and computational drug discovery methods.</p></a>
        <a class="publication-card" href="https://www.mdpi.com/1999-4915/16/2/185" target="_blank" rel="noopener noreferrer"><span>Article · 2024</span><h3>SARS-CoV-2 Specific Nanobodies</h3><p>Nanobodies that neutralize variants of concern and reduce viral load.</p></a>
        <a class="publication-card" href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10054972/" target="_blank" rel="noopener noreferrer"><span>Preprint · 2023</span><h3>Nanobodies against SARS-CoV-2</h3><p>Research on the neutralization of Wuhan, Delta, and Omicron variants.</p></a>
        <a class="publication-card" href="https://doi.org/10.1101/2023.07.19.549723" target="_blank" rel="noopener noreferrer"><span>Preprint · 2023</span><h3>DAF-12 ortholog search</h3><p>Hidden Markov Models and structural bioinformatics for Meloidogyne incognita.</p></a>
        <a class="publication-card" href="https://www.researchgate.net/profile/Rafael-Betanzos-San-Juan-2" target="_blank" rel="noopener noreferrer"><span>Research · 2021</span><h3>Climate change and viticulture</h3><p>Climate change, sustainability, and wine production in Baja California.</p></a>
        <a class="publication-card" href="https://cicese.repositorioinstitucional.mx/jspui/handle/1007/3062" target="_blank" rel="noopener noreferrer"><span>Thesis · CICESE</span><h3>Master’s thesis</h3><p>Life sciences research available in the CICESE institutional repository.</p></a>
      </div>
    </section>

    <section class="content-block panel reveal" aria-labelledby="projects-heading">
      <div class="panel-title"><h2 id="projects-heading">Featured work</h2><span class="chip">Projects</span></div>
      <div class="project-grid">
        <a class="project-card" href="/"><span>01</span><h3>IPnite</h3><p>AI-assisted patent preparation and intellectual property workflow management.</p></a>
        <a class="project-card" href="https://www.moka.bio/" target="_blank" rel="noopener noreferrer"><span>02</span><h3>Moka Bio</h3><p>A deeptech platform for natural bioactives, AI discovery, and experimental validation.</p></a>
        <a class="project-card" href="https://www.ikholcan.com/" target="_blank" rel="noopener noreferrer"><span>03</span><h3>Ik-Holcán</h3><p>An innovation studio connecting technology, product development, IP, and scientific opportunities.</p></a>
      </div>
    </section>

    <section class="contact-band reveal">
      <h2>Connect with Rafael.</h2>
      <p>For collaborations, intellectual property strategy, biotechnology innovation, or AI-assisted products.</p>
      <a class="btn" href="https://www.linkedin.com/in/rafabetanzos/" target="_blank" rel="noopener noreferrer">View LinkedIn</a>
    </section>
  </article>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const elements = document.querySelectorAll(".rafa-profile-page .reveal:not(.show)");
      if (!("IntersectionObserver" in window)) {
        elements.forEach((element) => element.classList.add("show"));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("show");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -8% 0px" });
      elements.forEach((element) => observer.observe(element));
    });
  </script>
</BaseLayout>

<style>
  .rafa-profile-page{--wine:#6b2a2f;--wine-dark:#4c0815;--ink:#28282c;--muted:#66666d;--line:#ece7e5;--soft:#faf9f8;max-width:1180px;margin:0 auto;padding:0 24px 80px;color:var(--ink);font-family:Inter,sans-serif}
  .rafa-profile-page *{box-sizing:border-box}.rafa-profile-page a{color:inherit;text-decoration:none}.rafa-profile-page h1,.rafa-profile-page h2,.rafa-profile-page h3{margin:0;font-family:"Playfair Display",Georgia,serif;letter-spacing:-.035em}.rafa-profile-page p{margin:0;color:var(--muted);font-size:15.5px;line-height:1.72}.rafa-profile-page strong{color:var(--ink)}
  .profile-hero{padding-bottom:42px}.hero-bg{position:relative;min-height:260px;overflow:hidden;border-radius:0 0 44px 44px;background-image:linear-gradient(rgba(24,24,27,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(24,24,27,.035) 1px,transparent 1px);background-size:42px 42px}
  .orbit{position:absolute;right:80px;top:42px;width:168px;height:168px;border:1px solid rgba(107,42,47,.2);border-radius:50%;animation:orbit 14s linear infinite}.orbit:before,.orbit:after{content:"";position:absolute;width:12px;height:12px;border-radius:50%;background:var(--wine);box-shadow:0 0 0 8px rgba(107,42,47,.08)}.orbit:before{left:18px;top:25px}.orbit:after{right:12px;bottom:34px}
  .floating-doc{position:absolute;width:82px;height:58px;border:1px solid rgba(107,42,47,.16);border-radius:16px;background:#fff;box-shadow:0 18px 40px rgba(0,0,0,.04);animation:float 4.8s ease-in-out infinite}.floating-doc:before,.floating-doc:after{content:"";position:absolute;left:16px;height:4px;border-radius:20px;background:var(--wine);opacity:.32}.floating-doc:before{top:20px;width:48px}.floating-doc:after{top:34px;width:34px}.doc-a{left:70px;top:54px}.doc-b{left:230px;top:126px;animation-delay:.7s}.doc-c{right:300px;top:84px;animation-delay:1.1s}
  .pulse-node{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--wine);box-shadow:0 0 0 8px rgba(107,42,47,.08);animation:pulse 3.4s ease-in-out infinite}.n1{left:160px;top:64px}.n2{left:360px;top:156px}.n3{right:210px;top:78px}
  .profile-header{position:relative;z-index:2;display:grid;grid-template-columns:auto 1fr auto;gap:28px;align-items:end;margin-top:-82px;padding-bottom:22px}.photo-wrap{position:relative;width:156px;height:156px;padding:6px;border:1px solid #f0ebe9;border-radius:38px;background:#fff;box-shadow:0 18px 42px rgba(0,0,0,.08)}.photo{width:100%;height:100%;overflow:hidden;border-radius:32px;background:#fff}.photo img{width:100%;height:100%;display:block;object-fit:cover}.status-dot{position:absolute;right:12px;bottom:12px;width:22px;height:22px;border:4px solid #fff;border-radius:50%;background:var(--wine);box-shadow:0 0 0 6px rgba(107,42,47,.1)}
  .identity{padding-top:88px}.eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:12px!important;color:#96969e!important;font-size:11px!important;font-weight:900;letter-spacing:.24em;text-transform:uppercase}.eyebrow:before{content:"";width:34px;height:1px;background:var(--wine)}h1{color:var(--wine);font-size:clamp(46px,6.8vw,82px);font-style:italic;line-height:.9}.headline{max-width:760px;margin-top:16px!important;color:#2b2b2f!important;font-family:"Playfair Display",Georgia,serif;font-size:clamp(25px,3.1vw,39px)!important;letter-spacing:-.035em;line-height:1.08!important}.headline em{color:#74747b}.bio-line{max-width:760px;margin-top:16px!important}.text-link{color:var(--wine)!important;font-weight:800;border-bottom:1px solid rgba(107,42,47,.24)}
  .profile-actions{display:flex;flex-direction:column;gap:10px;min-width:180px}.btn{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:0 20px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;transition:.25s}.btn.primary{border-color:var(--wine);background:var(--wine);color:#fff}.btn:hover{transform:translateY(-3px);box-shadow:0 20px 40px rgba(76,8,21,.13)}.btn:focus-visible,a:focus-visible{outline:3px solid var(--wine);outline-offset:3px}
  .stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:8px;overflow:hidden;border:1px solid var(--line);border-radius:44px;background:var(--line)}.stat{padding:18px;background:#fff;text-align:center}.stat strong{display:block;color:var(--wine);font-size:18px;font-weight:900}.stat span{display:block;margin-top:5px;color:var(--muted);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .content-block{margin-top:42px}.feed-layout{display:grid;grid-template-columns:.82fr 1.18fr;gap:18px;align-items:start}.side-stack,.main-stack{display:grid;gap:18px}.panel,.feed-card{padding:28px;border:1px solid #f0ebe9;border-radius:44px;background:#fff;box-shadow:0 14px 34px rgba(0,0,0,.03);transition:.3s}.panel:hover,.feed-card:hover{border-color:rgba(107,42,47,.18);box-shadow:0 28px 54px rgba(76,8,21,.09)}.panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.panel h2{font-size:29px;font-style:italic}.chip{padding:7px 10px;border:1px solid rgba(24,24,27,.08);border-radius:999px;color:var(--wine);font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
  .mini-list{display:grid;gap:10px;margin:18px 0 0;padding:0;list-style:none}.mini-list li{display:flex;gap:10px;color:var(--muted);font-size:14px;line-height:1.55}.check{flex:0 0 auto;width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:#f5f4f3;color:var(--wine);font-weight:900}.tag-cloud{display:flex;flex-wrap:wrap;gap:8px}.tag{padding:8px 10px;border:1px solid rgba(24,24,27,.08);border-radius:999px;background:#f7f6f5;color:var(--wine);font-size:10px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}
  .timeline{display:grid;gap:12px;margin-top:18px}.timeline-item{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:16px;border:1px solid var(--line);border-radius:24px}.timeline-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:16px;background:#f5f4f3;color:var(--wine);font-size:11px;font-weight:900}.timeline-item strong,.timeline-item span{display:block}.timeline-item strong{font-size:14px}.timeline-item div>span{margin-top:4px;color:var(--wine);font-size:10px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.timeline-item p{margin-top:7px;font-size:13px}
